+/* The map's player records also contain spawn positions. Keep that complete
+ * count for respawn masks and SyncPlayers, but admit only the configured
+ * session capacity. idx_13b4_related already includes a dedicated host slot.
+ * Every transport reaches this common game-layer allocation gate. */
+static int sithMulti_FindJoinSlot(void)
+{
+    if (idx_13b4_related <= 0) return -1;
