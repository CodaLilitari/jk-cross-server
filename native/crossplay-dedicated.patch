+static void Observer_ReadPose(const SithThing *thing)
+{
+    if (!thing) return;
+    rdMatrix34 matrix=thing->orient;
+    matrix.scale=thing->position;
+    if (thing->type==SITH_THING_PLAYER || thing->type==SITH_THING_ACTOR) {
