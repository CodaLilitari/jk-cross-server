+    }
+    if (observer.pendingBytes && observer.pendingOffset==observer.pendingBytes) {
+        observer.sentWorld=Observer_Read32(observer.pending+16);
+        observer.sentControl=Observer_Read32(observer.pending+20);
+        observer.sentSequence=Observer_Read32(observer.pending+24);
