+/* Live observation uses its own authorization/lifecycle, never stdCapture. */
+int std3D_ObserverReadback(uint8_t *pixels, int width, int height)
+{
+    if (!jkObserver_IsRenderPass() || !jkObserver_HasContext() || !pixels ||
+        width<1 || height<1 || width>640 || height>360 || Window_xSize!=width || Window_ySize!=height) return 0;
+    GLint readFbo,readBuffer,pack,row,skipRows,skipPixels,pbo;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&readFbo);
+    glGetIntegerv(GL_READ_BUFFER,&readBuffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT,&pack);
+    glGetIntegerv(GL_PACK_ROW_LENGTH,&row);
+    glGetIntegerv(GL_PACK_SKIP_ROWS,&skipRows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS,&skipPixels);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING,&pbo);
+    for (int i=0;i<16 && glGetError()!=GL_NO_ERROR;i++) {}
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,std3D_windowFbo);
+    glReadBuffer(std3D_windowFbo ? GL_COLOR_ATTACHMENT0 : GL_BACK);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER,0);
+    glPixelStorei(GL_PACK_ALIGNMENT,1); glPixelStorei(GL_PACK_ROW_LENGTH,0);
+    glPixelStorei(GL_PACK_SKIP_ROWS,0); glPixelStorei(GL_PACK_SKIP_PIXELS,0);
+    glReadPixels(0,0,width,height,GL_RGBA,GL_UNSIGNED_BYTE,pixels);
+    GLenum error=glGetError();
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,readFbo); glReadBuffer(readBuffer);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER,pbo); glPixelStorei(GL_PACK_ALIGNMENT,pack);
+    glPixelStorei(GL_PACK_ROW_LENGTH,row); glPixelStorei(GL_PACK_SKIP_ROWS,skipRows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS,skipPixels);
+    if (error!=GL_NO_ERROR) return 0;
+    uint8_t line[640*4]; size_t stride=(size_t)width*4;
+    for (int y=0;y<height/2;y++) {
+        uint8_t *top=pixels+(size_t)y*stride, *bottom=pixels+(size_t)(height-y-1)*stride;
+        memcpy(line,top,stride); memcpy(top,bottom,stride); memcpy(bottom,line,stride);
+    }
+    return 1;
+}
diff --git a/src/Platform/Networking/GNS/AdminConnections.h b/src/Platform/Networking/GNS/AdminConnections.h
new file mode 100644
index 00000000..fcecd704
--- /dev/null
+++ b/src/Platform/Networking/GNS/AdminConnections.h
@@ -0,0 +1,57 @@
+#ifndef JK_GNS_ADMIN_CONNECTIONS_H
+#define JK_GNS_ADMIN_CONNECTIONS_H
+
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <map>
+#include <utility>
+
+namespace jk_gateway {
+
+/* Engine-owned incarnations: a transport reconnect, map transition or IPC
+ * disconnect invalidates every old actor binding. No name or chat field can
+ * choose a generation. Exhaustion fails closed instead of reusing a value. */
+class AdminConnections {
+    struct Connection {
+        uint32_t generation = 0;
+        std::deque<uint32_t> recentRequests;
+    };
+    uint32_t serial_ = 0;
+    std::map<uint32_t, Connection> connections_;
+    uint32_t next() {
+        return serial_ == std::numeric_limits<uint32_t>::max() ? 0 : ++serial_;
+    }
+public:
+    void add(uint32_t peer) {
+        if (peer <= 1 || (!connections_.count(peer) && connections_.size() >= 31)) return;
+        Connection connection;
+        connection.generation = next();
+        connections_[peer] = std::move(connection);
+    }
+    void remove(uint32_t peer) { connections_.erase(peer); }
+    void clear() { connections_.clear(); }
+    void renew() {
+        for (auto &entry : connections_) {
+            entry.second.generation = next();
+            entry.second.recentRequests.clear();
+        }
+    }
+    uint32_t generation(uint32_t peer) const {
+        const auto found = connections_.find(peer);
+        return found == connections_.end() ? 0 : found->second.generation;
+    }
+    bool matches(uint32_t peer, uint32_t generation) const {
+        return generation && this->generation(peer) == generation;
+    }
+    bool consume(uint32_t peer, uint32_t generation, uint32_t request) {
+        if (!request || !matches(peer, generation)) return false;
+        auto &recent = connections_.find(peer)->second.recentRequests;
+        for (uint32_t previous : recent) if (previous == request) return false;
+        if (recent.size() >= 64) recent.pop_front();
+        recent.push_back(request);
+        return true;
+    }
+};
+}
+#endif
diff --git a/src/Platform/Networking/GNS/GatewayBridge.h b/src/Platform/Networking/GNS/GatewayBridge.h
new file mode 100644
index 00000000..3e04f24e
--- /dev/null
+++ b/src/Platform/Networking/GNS/GatewayBridge.h
@@ -0,0 +1,172 @@
+#ifndef OPENJKDF2_GATEWAY_BRIDGE_H
+#define OPENJKDF2_GATEWAY_BRIDGE_H
+// Local, authenticated server transport; no client engine changes.
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+namespace jk_gateway {
+inline uint32_t read32(const uint8_t* p) {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) |
+        (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+}
+inline void put32(std::vector<uint8_t>& b, uint32_t v) {
+    b.push_back(uint8_t(v)); b.push_back(uint8_t(v >> 8));
+    b.push_back(uint8_t(v >> 16)); b.push_back(uint8_t(v >> 24));
+}
+struct Frame {
+    uint32_t type, src, dst;
+    std::vector<uint8_t> data;
+};
+
+class Bridge {
+#ifdef _WIN32
+    using Socket = SOCKET;
+    static constexpr Socket invalid = INVALID_SOCKET;
+    static void closeSocket(Socket s) { closesocket(s); }
+    static bool wouldBlock() { return WSAGetLastError() == WSAEWOULDBLOCK; }
+    static bool nonblock(Socket s) { u_long one = 1; return ioctlsocket(s, FIONBIO, &one) == 0; }
+#else
+    using Socket = int;
+    static constexpr Socket invalid = -1;
+    static void closeSocket(Socket s) { close(s); }
+    static bool wouldBlock() { return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR; }
+    static bool nonblock(Socket s) { return fcntl(s, F_SETFL, O_NONBLOCK) == 0; }
+#endif
+    Socket listener_ = invalid, client_ = invalid;
+    std::string token_;
+    bool authorized_ = false, polling_ = false;
+    std::vector<uint8_t> input_, output_;
+    size_t outputOffset_ = 0;
+    std::chrono::steady_clock::time_point accepted_;
+    std::function<void(const Frame&)> receive_;
+    std::function<void()> disconnect_;
+    static constexpr size_t maxFrame = 65536, maxQueued = 1024 * 1024;
+
+    void drop() {
+        if (client_ != invalid) closeSocket(client_);
+        const bool wasAuthorized = authorized_;
+        client_ = invalid; authorized_ = false;
+        input_.clear(); output_.clear(); outputOffset_ = 0;
+        if (wasAuthorized && disconnect_) disconnect_();
+    }
+    void flush() {
+        while (client_ != invalid && outputOffset_ < output_.size()) {
+            const size_t remaining = output_.size() - outputOffset_;
+#ifdef _WIN32
+            int n = send(client_, reinterpret_cast<const char*>(output_.data() + outputOffset_), int(remaining), 0);
+#else
+            ssize_t n = send(client_, output_.data() + outputOffset_, remaining, MSG_NOSIGNAL);
+#endif
+            if (n < 0 && wouldBlock()) return;
+            if (n <= 0) { drop(); return; }
+            outputOffset_ += size_t(n);
+        }
+        if (outputOffset_ == output_.size()) { output_.clear(); outputOffset_ = 0; }
+    }
+
+public:
+    ~Bridge() { stop(); }
+    bool start(uint16_t port, const std::string& token,
+               std::function<void(const Frame&)> receive,
+               std::function<void()> disconnect) {
+        stop();
+        if (!port || token.size() < 16 || token.size() > 256) return false;
+        token_ = token; receive_ = std::move(receive); disconnect_ = std::move(disconnect);
+        listener_ = socket(AF_INET, SOCK_STREAM, 0);
+        if (listener_ == invalid) return false;
+        int one = 1;
+        setsockopt(listener_, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&one), sizeof(one));
+        sockaddr_in addr{}; addr.sin_family = AF_INET;
+        addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK); addr.sin_port = htons(port);
+        if (bind(listener_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0 ||
+            listen(listener_, 1) != 0 || !nonblock(listener_)) {
+            closeSocket(listener_); listener_ = invalid; return false;
+        }
+        return true;
+    }
+    void stop() {
+        drop();
+        if (listener_ != invalid) closeSocket(listener_);
+        listener_ = invalid;
+    }
+    bool connected() const { return client_ != invalid && authorized_; }
+    void sendFrame(uint32_t type, uint32_t src, uint32_t dst, const void* data = nullptr, size_t n = 0) {
+        if (!connected() || n > maxFrame - 12) return;
+        if (output_.size() - outputOffset_ + n + 16 > maxQueued) { drop(); return; }
+        if (outputOffset_) {
+            output_.erase(output_.begin(), output_.begin() + outputOffset_); outputOffset_ = 0;
+        }
+        put32(output_, uint32_t(12 + n)); put32(output_, type);
+        put32(output_, src); put32(output_, dst);
+        if (n) {
+            const auto* bytes = static_cast<const uint8_t*>(data);
+            output_.insert(output_.end(), bytes, bytes + n);
+        }
+    }
+    void error(uint32_t request, uint32_t code, const char* text) {
+        sendFrame(199, request, code, text, strlen(text));
+    }
+    void poll() {
+        if (listener_ == invalid || polling_) return;
+        polling_ = true;
+        Socket accepted = accept(listener_, nullptr, nullptr);
+        if (accepted != invalid) {
+            if (client_ != invalid || !nonblock(accepted)) closeSocket(accepted);
+            else { client_ = accepted; accepted_ = std::chrono::steady_clock::now(); }
+        }
+        if (client_ == invalid) { polling_ = false; return; }
+        if (!authorized_ && std::chrono::steady_clock::now() - accepted_ > std::chrono::seconds(5)) {
+            drop(); polling_ = false; return;
+        }
+        flush();
+        for (int reads = 0; reads < 16 && client_ != invalid; ++reads) {
+            uint8_t buf[4096];
+#ifdef _WIN32
+            int n = recv(client_, reinterpret_cast<char*>(buf), sizeof(buf), 0);
+#else
+            ssize_t n = recv(client_, buf, sizeof(buf), 0);
+#endif
+            if (n < 0 && wouldBlock()) break;
+            if (n <= 0) { drop(); break; }
+            if (input_.size() + size_t(n) > maxFrame * 2 + 8) { drop(); break; }
+            input_.insert(input_.end(), buf, buf + n);
+            while (input_.size() >= 4 && client_ != invalid) {
+                const uint32_t size = read32(input_.data());
+                if (size < 12 || size > maxFrame) { drop(); break; }
+                if (input_.size() < size_t(size) + 4) break;
+                Frame frame{read32(input_.data()+4), read32(input_.data()+8), read32(input_.data()+12),
+                            std::vector<uint8_t>(input_.begin()+16, input_.begin()+size+4)};
+                input_.erase(input_.begin(), input_.begin() + size + 4);
+                if (!authorized_) {
+                    unsigned difference = unsigned(frame.data.size() ^ token_.size());
+                    if (frame.data.size() == token_.size())
+                        for (size_t i = 0; i < token_.size(); ++i) difference |= frame.data[i] ^ uint8_t(token_[i]);
+                    if (frame.type != 1 || difference) { drop(); break; }
+                    authorized_ = true;
+                    const uint8_t version[4] = {1, 0, 0, 0};
+                    sendFrame(101, 0, 0, version, sizeof(version));
+                } else if (frame.type == 1) error(1, 1, "already authenticated");
+                else if (receive_) receive_(frame);
+            }
+        }
+        flush();
+        polling_ = false;
+    }
+};
+}
