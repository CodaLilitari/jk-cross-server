@@ -0,0 +1,270 @@
+#include "Platform/Networking/GNS/TransportIdentities.h"
+#include <cassert>
+#include <iostream>
+#include <map>
+#include <queue>
+
+using jk_gateway::TransportIdentities;
+using Replacement = TransportIdentities::Replacement;
+
+static void pool_setup_and_claims()
+{
+    TransportIdentities ids;
+    assert(ids.issuedCount() == 1 && ids.wasIssued(1));
+    assert(!ids.setPool({}));
+    assert(!ids.setPool({64}));
+    assert(!ids.setPool({100, 100}));
+    assert(!ids.setPool({0xFFFFFFFEu}));
+    assert(!ids.setPool(std::vector<uint32_t>(16, 100)));
+    assert(ids.issuedCount() == 1);
+    assert(ids.setPool({100, 101}));
+    assert(ids.poolSize() == 2 && ids.issuedCount() == 3);
+    assert(ids.acquireNative() == 100);
+    assert(ids.acquireExternal(0, true) == 101);
+    assert(!ids.acquireNative() && !ids.acquireExternal(100, true));
+    assert(!ids.acquireExternal(1, false) && !ids.acquireExternal(64, false));
+    assert(!ids.retire(1) && !ids.retire(999));
+    assert(ids.setPool({100, 101}));
+    assert(!ids.freePoolId()); // Duplicate setup cannot free live identities.
+    assert(!ids.setPool({102, 103}));
+}
+
+static void retired_pool_ids_and_pending_loss()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({15163125, 15163126}));
+    const uint32_t old = ids.acquireExternal(0, true);
+    assert(old == 15163125 && ids.retire(old));
+    std::queue<uint32_t> pendingLoss;
+    pendingLoss.push(old);
+    assert(!ids.retire(old)); // One retirement notification per incarnation.
+    assert(!ids.acquireExternal(old, true));
+    assert(ids.acquireNative() == 15163126);
+    assert(!ids.acquireNative()); // Quarantine lasts until a fresh DP ID arrives.
+    assert(ids.replace(old, 15163127) == Replacement::Applied);
+    const uint32_t next = ids.acquireNative();
+    assert(next == 15163127 && next != pendingLoss.front());
+    assert(ids.isRetired(old) && ids.wasIssued(old));
+    assert(ids.isActive(next));
+    assert(!ids.acquireExternal(old, true));
+}
+
+static void replacement_validation_and_replay()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({100, 101}));
+    assert(!ids.retire(101)); // An unused reserved seat is not an incarnation end.
+    assert(ids.replace(101, 102) == Replacement::Rejected);
+    assert(ids.acquireNative() == 100);
+    assert(ids.replace(100, 102) == Replacement::Rejected);
+    assert(ids.commitNativeTraffic(100));
+    assert(ids.retire(100));
+    assert(ids.acquireExternal(900, false) == 900 && ids.retire(900));
+    for (uint32_t invalid : {0u, 1u, 64u, 100u, 101u, 900u, 0xFFFFFFFEu, 0xFFFFFFFFu})
+        assert(ids.replace(100, invalid) == Replacement::Rejected);
+    assert(ids.replace(900, 102) == Replacement::Rejected); // Not a pool member.
+    assert(ids.replace(999, 102) == Replacement::Rejected);
+    assert(ids.replace(100, 102) == Replacement::Applied);
+    assert(ids.replace(100, 102) == Replacement::Replayed);
+    assert(ids.replace(100, 103) == Replacement::Rejected);
+    assert(ids.acquireExternal(102, true) == 102);
+    assert(ids.replace(100, 102) == Replacement::Replayed); // ACK cannot reset active state.
+    assert(ids.isActive(102));
+    assert(ids.retire(102));
+    assert(ids.replace(102, 103) == Replacement::Applied);
+    assert(ids.replace(100, 102) == Replacement::Replayed); // Even after the next rotation.
+    assert(ids.isRetired(102) && !ids.acquireExternal(102, true));
+    assert(ids.acquireNative() == 103);
+    assert(ids.acquireNative() == 101);
+    assert(!ids.acquireNative());
+}
+
+struct NativeRecord {
+    uint32_t m_id;
+    unsigned m_slot;
+    bool reachedConnected;
+};
+
+static void assigned_connecting_terminal_cleanup()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({100, 101}));
+    const uint32_t assignedWhileConnecting = ids.acquireNative();
+    const uint32_t other = ids.acquireNative();
+    assert(ids.commitNativeTraffic(assignedWhileConnecting));
+    assert(ids.commitNativeTraffic(other));
+    std::map<unsigned, NativeRecord> clients;
+    clients.emplace(10, NativeRecord{assignedWhileConnecting, 3, false});
+    clients.emplace(11, NativeRecord{other, 5, true});
+    uint64_t occupied = 1 | (uint64_t(1) << 3) | (uint64_t(1) << 5);
+    jk_gateway::RetiredNativeIdentity retired;
+    assert(!clients.at(10).reachedConnected);
+    // This is the actual helper called for both native terminal callback states
+    // and administrative kicks. Its decision is the assigned record, not the
+    // callback's previous Connecting/Connected phase.
+    assert(jk_gateway::retireNativeIdentity(clients, 10u, occupied, ids, retired));
+    assert(retired.peer == assignedWhileConnecting && retired.notifyPool && retired.processPlayerLost);
+    assert(ids.isRetired(assignedWhileConnecting));
+    assert(clients.count(10) == 0 && clients.count(11) == 1);
+    assert(occupied == (1 | (uint64_t(1) << 5)));
+    assert(!jk_gateway::retireNativeIdentity(clients, 10u, occupied, ids, retired));
+    assert(!jk_gateway::retireNativeIdentity(clients, 99u, occupied, ids, retired));
+    assert(ids.isActive(other));
+    assert(ids.replace(assignedWhileConnecting, 102) == Replacement::Applied);
+    assert(ids.acquireNative() == 102);
+    clients.emplace(12, NativeRecord{102, 3, false});
+    occupied |= uint64_t(1) << 3;
+    assert(!jk_gateway::retireNativeIdentity(clients, 10u, occupied, ids, retired));
+    assert(clients.at(12).m_id == 102 && ids.isActive(102));
+    assert(ids.commitNativeTraffic(102));
+    assert(jk_gateway::retireNativeIdentity(clients, 12u, occupied, ids, retired));
+    assert(retired.peer == 102 && retired.notifyPool && retired.processPlayerLost);
+}
+
+static void pristine_pool_discovery_reservations()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({300, 301}));
+    assert(ids.acquireExternal(301, true) == 301);
+    std::map<unsigned, NativeRecord> clients;
+    std::queue<uint32_t> pendingLoss;
+    uint64_t occupied = 1;
+    for (unsigned handle = 1000; handle < 1512; ++handle) {
+        const uint32_t probe = ids.acquireNative();
+        assert(probe == 300 && ids.isPristineNative(probe));
+        assert(!ids.acquireNative() && !ids.acquireExternal(probe, true));
+        assert(!ids.retire(probe));
+        assert(ids.replace(probe, 302) == Replacement::Rejected);
+        clients.emplace(handle, NativeRecord{probe, 1, false});
+        occupied |= uint64_t(1) << 1;
+        jk_gateway::RetiredNativeIdentity ended;
+        assert(jk_gateway::retireNativeIdentity(clients, handle, occupied, ids, ended));
+        if (ended.processPlayerLost) pendingLoss.push(ended.peer);
+        assert(!ended.notifyPool && !ended.processPlayerLost);
+        assert(pendingLoss.empty() && clients.empty() && occupied == 1);
+        assert(ids.freePoolId() == probe && ids.issuedCount() == 3);
+        assert(!ids.isPristineNative(probe) && !ids.isRetired(probe));
+    }
+    // The same connection becomes irrevocable as soon as ordinary traffic is
+    // sent or received, even before a WELCOME or fully joined roster flag.
+    const uint32_t joining = ids.acquireNative();
+    assert(ids.commitNativeTraffic(joining));
+    assert(ids.commitNativeTraffic(joining) && !ids.isPristineNative(joining));
+    clients.emplace(2000, NativeRecord{joining, 1, false});
+    occupied |= uint64_t(1) << 1;
+    jk_gateway::RetiredNativeIdentity ended;
+    assert(jk_gateway::retireNativeIdentity(clients, 2000u, occupied, ids, ended));
+    assert(ended.notifyPool && ended.processPlayerLost && ids.isRetired(joining));
+    assert(!ids.acquireNative());
+    assert(ids.replace(joining, 302) == Replacement::Applied);
+    assert(ids.acquireNative() == 302 && ids.isPristineNative(302));
+}
+
+static void stale_handles_and_uncertain_records()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({600}));
+    std::map<unsigned, NativeRecord> clients;
+    uint64_t occupied = 3;
+    clients.emplace(17, NativeRecord{ids.acquireNative(), 1, false});
+    jk_gateway::RetiredNativeIdentity ended;
+    assert(jk_gateway::retireNativeIdentity(clients, 17u, occupied, ids, ended));
+    assert(!ended.processPlayerLost && !ended.notifyPool);
+    clients.emplace(18, NativeRecord{ids.acquireNative(), 1, false});
+    occupied |= 2;
+    assert(clients.at(18).m_id == 600 && ids.isPristineNative(600));
+    assert(!jk_gateway::retireNativeIdentity(clients, 17u, occupied, ids, ended));
+    assert(ids.isPristineNative(600) && occupied == 3);
+    assert(ids.commitNativeTraffic(600));
+    assert(!jk_gateway::retireNativeIdentity(clients, 17u, occupied, ids, ended));
+    assert(ids.isActive(600) && !ids.isRetired(600));
+    assert(jk_gateway::retireNativeIdentity(clients, 18u, occupied, ids, ended));
+    assert(ended.processPlayerLost && ended.notifyPool);
+    assert(ids.replace(600, 601) == Replacement::Applied);
+    // A map record without the explicit pristine lease state is uncertain:
+    // quarantine it instead of treating absence of game flags as discovery.
+    clients.emplace(19, NativeRecord{601, 1, false});
+    occupied |= 2;
+    assert(jk_gateway::retireNativeIdentity(clients, 19u, occupied, ids, ended));
+    assert(ended.processPlayerLost && ended.notifyPool && ids.isRetired(601));
+    assert(!ids.acquireNative() && !ids.commitNativeTraffic(601));
+}
+
+static void external_claims_are_immediately_committed()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({700, 701}));
+    assert(ids.acquireExternal(0, true) == 700);
+    assert(ids.acquireExternal(701, true) == 701);
+    assert(ids.acquireExternal(900, false) == 900);
+    for (uint32_t peer : {700u, 701u, 900u}) {
+        assert(!ids.isPristineNative(peer) && ids.isActive(peer));
+        assert(ids.retire(peer));
+        assert(!ids.acquireExternal(peer, true));
+    }
+    assert(!ids.freePoolId());
+    TransportIdentities nativeOnly;
+    const uint32_t noPool = nativeOnly.acquireNative();
+    assert(noPool == 2 && !nativeOnly.isPristineNative(noPool));
+    const auto ended = nativeOnly.finishNative(noPool);
+    assert(ended.processPlayerLost && !ended.notifyPool);
+    assert(nativeOnly.isRetired(noPool) && nativeOnly.acquireNative() == 3);
+}
+
+static void no_pool_fresh_native_and_external()
+{
+    TransportIdentities ids;
+    assert(!ids.acquireExternal(0, true));
+    const uint32_t a = ids.acquireNative(), b = ids.acquireNative();
+    assert(a == 2 && b == 3 && ids.retire(a));
+    assert(ids.acquireNative() == 4); // Freeing a native slot does not recycle ID2.
+    assert(ids.acquireExternal(65536, false) == 65536);
+    assert(ids.retire(65536));
+    assert(ids.acquireExternal(0, false) == 65537);
+    assert(!ids.acquireExternal(65536, false));
+    assert(ids.acquireExternal(500, false) == 500 && ids.retire(500));
+    uint32_t native = 0;
+    while (native < 501) native = ids.acquireNative();
+    assert(native == 501 && ids.isRetired(500));
+    // Only explicit creation of a new transport session resets the ledger.
+    ids.reset();
+    assert(ids.issuedCount() == 1 && ids.acquireNative() == 2);
+}
+
+static void bounded_lifetime_history_fails_closed()
+{
+    TransportIdentities ids;
+    assert(ids.setPool({100}));
+    assert(ids.acquireNative() == 100 && ids.commitNativeTraffic(100) && ids.retire(100));
+    assert(ids.replace(100, 101) == Replacement::Applied);
+    for (uint32_t peer = 100000; ids.issuedCount() < TransportIdentities::maxIssued; ++peer) {
+        assert(ids.acquireExternal(peer, false) == peer);
+        assert(ids.retire(peer));
+    }
+    assert(ids.issuedCount() == 65536);
+    assert(!ids.acquireExternal(900000, false));
+    assert(ids.acquireNative() == 101); // Already issued but unused identity is safe.
+    assert(ids.commitNativeTraffic(101));
+    assert(ids.retire(101));
+    assert(!ids.acquireNative());
+    assert(ids.replace(101, 102) == Replacement::Rejected);
+    assert(ids.replace(100, 101) == Replacement::Replayed);
+    assert(ids.isRetired(100) && ids.isRetired(101));
+    assert(ids.issuedCount() == 65536);
+}
+
+int main()
+{
+    pool_setup_and_claims();
+    retired_pool_ids_and_pending_loss();
+    replacement_validation_and_replay();
+    assigned_connecting_terminal_cleanup();
+    pristine_pool_discovery_reservations();
+    stale_handles_and_uncertain_records();
+    external_claims_are_immediately_committed();
+    no_pool_fresh_native_and_external();
+    bounded_lifetime_history_fails_closed();
+    std::cout << "PASS: 9 groups: pool claims; retired/pending-loss isolation; replacement replay/validation; "
+                 "used Connecting cleanup; 512 pristine discoveries; stale handles/uncertain records; "
+                 "committed external/no-pool claims; fresh no-pool identities; bounded lifetime history\n";
+}
