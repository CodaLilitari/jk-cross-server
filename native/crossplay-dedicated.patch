+int jkObserver_RenderFrame(void)
+{
+    /* jkGame_Update also advances this stamp while observation is off. Saber
+     * collision lazily refreshes joint matrices against it; the 5 fps observer
+     * must never become the simulation's animation clock. */
+    rdroid_frameTrue=rdroid_frameTrue==INT_MAX?1:rdroid_frameTrue+1;
+    jkObserver_Poll();
+#ifdef JK_OBSERVER_SUPPORTED
+    const uint32_t now=Observer_Now();
+    if (!observer.mode || !observer.worldReady || !observer.context || observer.fd<0 || observer.renderError ||
+        observer.pendingBytes || now-observer.lastAttemptMs<200 || !Video_pCanvas || !Video_pMenuBuffer) return 1;
+    observer.lastAttemptMs=now;
+    if (!observer.camera.rdCamera.pClipFrustum) {
+        if (!rdCamera_NewEntry(&observer.camera.rdCamera,90.0f,0,SITHCAMERA_ZNEAR,SITHCAMERA_ZFAR,0.5625f)) {
+            jkObserver_SetRenderError(); return 1;
+        }
+        observer.camera.type=0; observer.camera.fov=90.0f; observer.camera.aspectRatio=0.5625f;
+        rdCamera_SetAttenuation(&observer.camera.rdCamera,SITHCAMERA_ATTENUATION_MIN,SITHCAMERA_ATTENUATION_MAX);
+    }
+    observer.canvas=*Video_pCanvas;
+    observer.canvas.xStart=observer.canvas.yStart=0;
+    observer.canvas.widthMinusOne=OBS_WIDTH-1; observer.canvas.heightMinusOne=OBS_HEIGHT-1;
+    observer.canvas.half_screen_width=OBS_WIDTH/2; observer.canvas.half_screen_height=OBS_HEIGHT/2;
+    rdCamera_SetCanvas(&observer.camera.rdCamera,&observer.canvas);
+    rdMatrix_Build34(&observer.camera.orient,&observer.angles,&observer.position);
+    observer.camera.sector=sithSector_FindSectorAtPos(sithWorld_g_pCurrentWorld,&observer.position);
+    observer.camera.lookPos=observer.position;
+    observer.camera.lookPYR=observer.angles;
+    if (!jkObserver_BeginReadOnlyRender()) { jkObserver_SetRenderError(); return 1; }
+    ObserverGeometry_Begin(now);
+    sithCamera_g_pCurCamera=&observer.camera;
+    rdCamera_SetCurrent(&observer.camera.rdCamera);
+    rdroid_curAcceleration=1; sithMain_lastAspect=0.5625f;
