+
+void jkObserver_Poll(void)
+{
+    if (!observer.capable) return;
+    const uint32_t now=Observer_Now();
+    Observer_Flush(now);
+    if (geometry.enabled && now-geometry.leaseMs>=5000) ObserverGeometry_Stop();
+    ObserverGeometry_Flush(now);
+    uint32_t elapsed=now-observer.lastPollMs; observer.lastPollMs=now;
+    if (elapsed>100) elapsed=100;
