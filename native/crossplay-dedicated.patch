+    stdDisplay_VBufferFill(Video_pMenuBuffer,Video_fillColor,0);
+    rdAdvanceFrame();
+    int ok=!observer.renderError;
+    if (ok) {
+        sithAdvanceRenderTick();
+        sithCamera_RenderScene();
+        rdCache_Flush();
+        std3D_DrawMenu();
+        rdFinishFrame();
+        ok=std3D_ObserverReadback(observer.pending+OBS_HEADER,OBS_WIDTH,OBS_HEIGHT);
+    }
+    ObserverGeometry_End(now,observer.worldEpoch,observer.controlEpoch,Observer_Next(observer.frameSequence),ok);
+    jkObserver_EndReadOnlyRender();
+    if (!ok) { jkObserver_SetRenderError(); return 1; }
+    observer.frameSequence=Observer_Next(observer.frameSequence);
+    memcpy(observer.pending,"JKSV",4);
+    uint32_t header[8]={1,OBS_WIDTH,OBS_HEIGHT,observer.worldEpoch,observer.controlEpoch,observer.frameSequence,OBS_PIXELS,0};
+    for (int i=0;i<8;i++) Observer_Write32(observer.pending+4+i*4,header[i]);
+    observer.pendingCapturedMs=now;
+    observer.pendingBytes=OBS_HEADER+OBS_PIXELS; observer.pendingOffset=0;
+    Observer_Flush(now);
+    ObserverGeometry_Flush(Observer_Now());
+#endif
+    return 1;
+}
