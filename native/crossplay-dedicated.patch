+    void EnumeratePlayers()
+    {
+        DirectPlay_numPlayers = 0;
+        auto add = [](uint32_t peer) {
+            if (DirectPlay_numPlayers >= 32) return;
+            sithDplayPlayer& p = DirectPlay_aPlayers[DirectPlay_numPlayers++];
+            memset(&p, 0, sizeof(p));
+            p.dpId = peer;
+            jk_snwprintf(p.waName, 32, u"peer");
+        };
+        add(1);
+        for (const auto& peer : m_mapClients) add(peer.second.m_id);
+        for (uint32_t peer : m_externalPeers) add(peer);
+    }
+
+    void DropGatewayPeers()
+    {
+        for (uint32_t peer : m_externalPeers) m_DisconnectedPeers.push(int(peer));
+        m_externalPeers.clear();
+        std::queue<jk_gateway::Frame>().swap(m_gatewayIncoming);
+        m_gatewayIncomingBytes = 0;
+    }
+
+    void HandleGateway(const jk_gateway::Frame& frame)
+    {
