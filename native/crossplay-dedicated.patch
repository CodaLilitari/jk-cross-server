+/* Renderer caches share allocations with saber collision and COG visibility.
+ * Preserve their bytes, including nested joint/puppet arrays. Snapshot failure
+ * happens before any drawing, and disables only observation. */
+static int Observer_Save(void *address, size_t count, size_t size)
+{
+    if (!address || !count || !size) return 1;
+    if (count>OBS_SNAPSHOT_LIMIT/size) return 0;
+    size_t bytes=count*size;
+    for (size_t i=0;i<observer.rangeCount;i++) if (observer.ranges[i].address==address) return observer.ranges[i].size==bytes;
+    if (observer.rangeCount>=OBS_RANGE_LIMIT || bytes>OBS_SNAPSHOT_LIMIT-observer.snapshotBytes) return 0;
+    if (observer.rangeCount==observer.rangeCapacity) {
+        size_t capacity=observer.rangeCapacity?observer.rangeCapacity*2:64;
+        ObserverRange *ranges=(ObserverRange *)realloc(observer.ranges,capacity*sizeof(*ranges));
+        if (!ranges) return 0;
+        observer.ranges=ranges; observer.rangeCapacity=capacity;
+    }
+    if (observer.snapshotBytes+bytes>observer.snapshotCapacity) {
+        size_t capacity=observer.snapshotCapacity?observer.snapshotCapacity:65536;
+        while (capacity<observer.snapshotBytes+bytes) capacity*=2;
+        if (capacity>OBS_SNAPSHOT_LIMIT) capacity=OBS_SNAPSHOT_LIMIT;
+        uint8_t *snapshot=(uint8_t *)realloc(observer.snapshot,capacity);
+        if (!snapshot) return 0;
+        observer.snapshot=snapshot; observer.snapshotCapacity=capacity;
+    }
+    ObserverRange *range=&observer.ranges[observer.rangeCount++];
+    range->address=address; range->size=bytes; range->offset=observer.snapshotBytes;
+    memcpy(observer.snapshot+observer.snapshotBytes,address,bytes); observer.snapshotBytes+=bytes;
+    return 1;
+}
+
+static int Observer_SaveModel(rdModel3 *model)
+{
+    if (!model) return 1;
+    if (model->numGeos>4 || model->numHNodes>4096 || !Observer_Save(model,1,sizeof(*model))) return 0;
+    for (unsigned int g=0;g<model->numGeos;g++) {
+        rdGeoset *geo=&model->aGeos[g];
+        if (geo->numMeshes>4096 || !Observer_Save(geo->aMeshes,geo->numMeshes,sizeof(rdMesh))) return 0;
+        for (unsigned int m=0;geo->aMeshes && m<geo->numMeshes;m++) {
+            rdMesh *mesh=&geo->aMeshes[m];
+            if (!Observer_Save(mesh->faces,mesh->numFaces,sizeof(rdFace)) ||
+                !Observer_Save(mesh->vertices_unk,mesh->numVertices,sizeof(flex_t))) return 0;
+        }
+    }
+    return 1;
+}
+
+int jkObserver_BeginReadOnlyRender(void)
+{
+    SithWorld *world=sithWorld_g_pCurrentWorld;
+    if (observer.renderPass || !world || world->numThings<0 || world->numThings>65535 ||
+        world->numSectors<0 || world->numSurfaces<0 || world->numVertices<0 || world->numAdjoins<0) return 0;
+    observer.rangeCount=observer.snapshotBytes=0;
+#define SAVE(value) do { if (!Observer_Save(&(value),1,sizeof(value))) goto failed; } while (0)
+#define ARRAY(address,count) do { if (!Observer_Save((address),(size_t)(count),sizeof(*(address)))) goto failed; } while (0)
+    SAVE(*world); ARRAY(world->aThings,world->numThings+1); ARRAY(world->aSectors,world->numSectors);
+    ARRAY(world->surfaces,world->numSurfaces); ARRAY(world->adjoins,world->numAdjoins);
+    ARRAY(world->aTransformedVertices,world->numVertices); ARRAY(world->alloc_unk98,world->numVertices);
+    ARRAY(world->alloc_unk9c,world->numVertices); ARRAY(world->aVertDynamicLights,world->numVertices);
+    for (int i=0;world->aThings && i<=world->numThings;i++) {
+        rdThing *thing=&world->aThings[i].renderData;
+        if (thing->type==RD_THING_MODEL3 && thing->model3) {
+            if (!Observer_SaveModel(thing->model3)) goto failed;
+            ARRAY(thing->paJointMatrices,thing->model3->numHNodes);
+            ARRAY(thing->hierarchyNodes2,thing->model3->numHNodes);
+            ARRAY(thing->paJointAmputationFlags,thing->model3->numHNodes);
+            if (thing->puppet) SAVE(*thing->puppet);
+        } else if (thing->type==RD_THING_SPRITE3 && thing->sprite3) SAVE(*thing->sprite3);
+        else if (thing->type==RD_THING_PARTICLE && thing->particlecloud) SAVE(*thing->particlecloud);
+        else if (thing->type==RD_THING_POLYLINE && thing->polyline) SAVE(*thing->polyline);
+    }
+    SAVE(rdroid_frameTrue); SAVE(sithRender_lastRenderTick); SAVE(sithPlayer_bNoClippingRend);
+    SAVE(sithCamera_g_pCurCamera); SAVE(rdCamera_g_pCurCamera); SAVE(rdCamera_g_camMatrix);
+    SAVE(rdroid_curColorEffects); SAVE(sithMain_lastAspect);
+    SAVE(rdroid_g_curRenderOptions); SAVE(rdroid_g_curGeometryMode); SAVE(rdroid_g_curLightingMode);
+    SAVE(rdroid_curTextureMode); SAVE(rdroid_curAcceleration); SAVE(rdroid_curCullFlags);
+    SAVE(rdroid_curSortingMethod); SAVE(rdroid_curOcclusionMethod); SAVE(rdroid_curZBufferMethod);
+    SAVE(rdroid_curProcFaceUserData); SAVE(rdroid_curVertexColorMode); SAVE(sithRender_renderflags);
+    SAVE(sithRender_bResetCameraAspect);
+#undef ARRAY
+#undef SAVE
+    observer.renderPass=1; return 1;
+failed:
+    observer.rangeCount=observer.snapshotBytes=0; return 0;
+}
+
+void jkObserver_EndReadOnlyRender(void)
+{
+    if (!observer.renderPass) return;
+    while (observer.rangeCount) {
+        ObserverRange *range=&observer.ranges[--observer.rangeCount];
+        memcpy(range->address,observer.snapshot+range->offset,range->size);
+    }
+    observer.snapshotBytes=0; observer.renderPass=0;
+}
