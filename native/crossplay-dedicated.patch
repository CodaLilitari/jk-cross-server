diff --git a/src/Tests/gateway_bridge_test.cpp b/src/Tests/gateway_bridge_test.cpp
new file mode 100644
index 0000000..bb81266
--- /dev/null
+++ b/src/Tests/gateway_bridge_test.cpp
@@ -0,0 +1,61 @@
+#include "Platform/Networking/GNS/GatewayBridge.h"
+#include <cassert>
+#include <iostream>
+#include <thread>
+
+static std::vector<uint8_t> frame(uint32_t type, const std::string& data) {
+    std::vector<uint8_t> out;
+    jk_gateway::put32(out, uint32_t(12 + data.size()));
+    jk_gateway::put32(out, type); jk_gateway::put32(out, 13); jk_gateway::put32(out, 17);
+    out.insert(out.end(), data.begin(), data.end()); return out;
+}
+int main() {
+    int probe = socket(AF_INET, SOCK_STREAM, 0);
+    assert(probe >= 0);
+    sockaddr_in address{}; address.sin_family = AF_INET; address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    assert(bind(probe, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0);
+    socklen_t addressSize = sizeof(address);
+    assert(getsockname(probe, reinterpret_cast<sockaddr*>(&address), &addressSize) == 0);
+    close(probe);
+    jk_gateway::Bridge bridge;
+    unsigned received = 0, lost = 0;
+    assert(bridge.start(ntohs(address.sin_port), "test-token-at-least-sixteen",
+        [&](const jk_gateway::Frame& f) {
+            assert(f.type == 7 && f.src == 13 && f.dst == 17 && f.data.size() == 3);
+            ++received; bridge.sendFrame(107, f.src, f.dst, f.data.data(), f.data.size());
+        }, [&]() { ++lost; }));
+    int client = socket(AF_INET, SOCK_STREAM, 0);
+    assert(connect(client, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0);
+    auto hello = frame(1, "test-token-at-least-sixteen");
+    assert(send(client, hello.data(), 2, 0) == 2);
+    bridge.poll(); assert(!bridge.connected());
+    assert(send(client, hello.data()+2, hello.size()-2, 0) == ssize_t(hello.size()-2));
+    bridge.poll(); assert(bridge.connected());
+    uint8_t buffer[8192];
+    assert(recv(client, buffer, sizeof(buffer), 0) == 20);
+    assert(jk_gateway::read32(buffer+4) == 101 && jk_gateway::read32(buffer+16) == 1);
+    std::vector<uint8_t> batch;
+    auto ping = frame(7, "abc");
+    for (unsigned i = 0; i < 200; ++i) batch.insert(batch.end(), ping.begin(), ping.end());
+    assert(send(client, batch.data(), batch.size(), 0) == ssize_t(batch.size()));
+    for (unsigned i = 0; i < 20 && received < 200; ++i) {
+        bridge.poll(); std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    assert(received == 200);
+    size_t count = 0;
+    while (count < 200*19) {
+        ssize_t n = recv(client, buffer, sizeof(buffer), 0); assert(n > 0); count += size_t(n);
+    }
+    assert(count == 200*19);
+    const uint8_t badLength[4] = {0xff, 0xff, 0xff, 0x7f};
+    assert(send(client, badLength, 4, 0) == 4);
+    bridge.poll(); assert(!bridge.connected() && lost == 1);
+    close(client);
+    client = socket(AF_INET, SOCK_STREAM, 0);
+    assert(connect(client, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0);
+    auto badToken = frame(1, "wrong-token-at-least-sixteen");
+    assert(send(client, badToken.data(), badToken.size(), 0) == ssize_t(badToken.size()));
+    bridge.poll(); assert(!bridge.connected() && lost == 1);
+    close(client); bridge.stop();
+    std::cout << "PASS: fragmented authentication, 200 coalesced frames, replies, oversized rejection, bad token, disconnect callback\n";
+}
