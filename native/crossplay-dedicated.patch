diff --git a/src/Platform/Networking/GNS/TransportIdentities.h b/src/Platform/Networking/GNS/TransportIdentities.h
new file mode 100644
index 00000000..780eb549
--- /dev/null
+++ b/src/Platform/Networking/GNS/TransportIdentities.h
@@ -0,0 +1,193 @@
+#ifndef OPENJKDF2_TRANSPORT_IDENTITIES_H
+#define OPENJKDF2_TRANSPORT_IDENTITIES_H
+// Server transport identities are session incarnations, not reusable seats.
+// Ordinary clients retain reliable (sender, sequence) pairs after a departure.
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <vector>
+
+namespace jk_gateway {
+
+struct RetiredNativeIdentity {
+    uint32_t peer = 0;
+    bool notifyPool = false;
+    bool processPlayerLost = true;
+};
+
+class TransportIdentities {
+public:
+    static constexpr std::size_t maxIssued = 65536;
+    enum class Replacement { Rejected, Applied, Replayed };
+
+    TransportIdentities() { reset(); }
+
+    // Only a new server transport session may forget previous identities.
+    void reset() {
+        issued_.clear(); pool_.clear(); replacements_.clear();
+        issued_.emplace(1, State::Active);
+        nextNative_ = 2; nextExternal_ = 65536;
+    }
+
+    static bool validPoolId(uint32_t peer) { return peer >= 65 && peer < 0xFFFFFFFEu; }
+    bool hasPool() const { return !pool_.empty(); }
+    std::size_t poolSize() const { return pool_.size(); }
+    std::size_t issuedCount() const { return issued_.size(); }
+    bool isPoolId(uint32_t peer) const {
+        return std::find(pool_.begin(), pool_.end(), peer) != pool_.end();
+    }
+    bool wasIssued(uint32_t peer) const { return issued_.count(peer) != 0; }
+    bool isActive(uint32_t peer) const {
+        return hasState(peer, State::Active) || hasState(peer, State::NativeReservation);
+    }
+    bool isPristineNative(uint32_t peer) const { return hasState(peer, State::NativeReservation); }
+    bool isRetired(uint32_t peer) const { return hasState(peer, State::Retired); }
+
+    bool setPool(const std::vector<uint32_t>& ids) {
+        // Repeating the same setup never resets a retired/active entry. A new
+        // pool after setup must use the explicit replacement operation.
+        if (!pool_.empty()) return pool_ == ids;
+        if (ids.empty() || ids.size() > 15 || ids.size() > maxIssued - issued_.size()) return false;
+        std::set<uint32_t> unique;
+        for (uint32_t peer : ids)
+            if (!validPoolId(peer) || wasIssued(peer) || !unique.insert(peer).second) return false;
+        pool_ = ids;
+        for (uint32_t peer : pool_) issued_.emplace(peer, State::Reserved);
+        return true;
+    }
+
+    uint32_t freePoolId() const {
+        for (uint32_t peer : pool_) if (hasState(peer, State::Reserved)) return peer;
+        return 0;
+    }
+
+    uint32_t acquireNative() {
+        if (hasPool()) {
+            const uint32_t peer = freePoolId();
+            // GetServerInfo uses a real GNS connection, reads only the initial
+            // transport descriptor, and closes. Until any game traffic, this
+            // is a reservation of an unused DP surrogate, not a game identity.
+            if (peer) issued_.find(peer)->second = State::NativeReservation;
+            return peer;
+        }
+        return fresh(nextNative_);
+    }
+
+    // Call before any received payload is validated/delivered/forwarded and
+    // before any ordinary Sith packet is sent to this native connection.
+    bool commitNativeTraffic(uint32_t peer) {
+        auto found = issued_.find(peer);
+        if (found == issued_.end()) return false;
+        if (found->second == State::NativeReservation) found->second = State::Active;
+        return found->second == State::Active;
+    }
+
+    uint32_t acquireExternal(uint32_t desired, bool requirePool) {
+        if (desired) return validPoolId(desired) && claim(desired) ? desired : 0;
+        if (hasPool() || requirePool) {
+            const uint32_t peer = freePoolId();
+            return claim(peer) ? peer : 0;
+        }
+        return fresh(nextExternal_);
+    }
+
+    // True exactly once for a claimed incarnation. Retiring a reserved seat,
+    // the host, an unknown ID, or an already retired ID changes nothing.
+    bool retire(uint32_t peer) {
+        auto found = issued_.find(peer);
+        if (peer <= 1 || found == issued_.end() || found->second != State::Active) return false;
+        found->second = State::Retired;
+        return true;
+    }
+
+    RetiredNativeIdentity finishNative(uint32_t peer) {
+        RetiredNativeIdentity result;
+        result.peer = peer;
+        if (peer <= 1 || peer >= 0xFFFFFFFEu) {
+            result.processPlayerLost = false;
+            return result;
+        }
+        auto found = issued_.find(peer);
+        if (found != issued_.end() && found->second == State::NativeReservation && isPoolId(peer)) {
+            found->second = State::Reserved;
+            result.processPlayerLost = false;
+            return result;
+        }
+        // Every used or uncertain assigned record is quarantined. A pristine
+        // reservation is the sole exception; callback phase/roster/WELCOME
+        // state are not evidence that a game identity was unused.
+        if (found != issued_.end()) {
+            result.notifyPool = found->second != State::Retired && isPoolId(peer);
+            found->second = State::Retired;
+        } else if (issued_.size() < maxIssued) {
+            issued_.emplace(peer, State::Retired);
+        }
+        return result;
+    }
+
+    Replacement replace(uint32_t oldPeer, uint32_t newPeer) {
+        const auto completed = replacements_.find(oldPeer);
+        if (completed != replacements_.end())
+            return completed->second == newPeer ? Replacement::Replayed : Replacement::Rejected;
+        auto slot = std::find(pool_.begin(), pool_.end(), oldPeer);
+        if (slot == pool_.end() || !isRetired(oldPeer) || !validPoolId(newPeer) ||
+            wasIssued(newPeer) || issued_.size() >= maxIssued) return Replacement::Rejected;
+        issued_.emplace(newPeer, State::Reserved);
+        replacements_.emplace(oldPeer, newPeer);
+        *slot = newPeer;
+        return Replacement::Applied;
+    }
+
+private:
+    enum class State { Reserved, NativeReservation, Active, Retired };
+    std::map<uint32_t, State> issued_;
+    std::vector<uint32_t> pool_;
+    std::map<uint32_t, uint32_t> replacements_;
+    uint32_t nextNative_ = 2, nextExternal_ = 65536;
+
+    bool hasState(uint32_t peer, State state) const {
+        const auto found = issued_.find(peer);
+        return found != issued_.end() && found->second == state;
+    }
+    bool claim(uint32_t peer) {
+        if (peer <= 1 || peer >= 0xFFFFFFFEu) return false;
+        auto found = issued_.find(peer);
+        if (found != issued_.end()) {
+            if (found->second != State::Reserved) return false;
+            found->second = State::Active;
+            return true;
+        }
+        if (issued_.size() >= maxIssued) return false;
+        issued_.emplace(peer, State::Active);
+        return true;
+    }
+    uint32_t fresh(uint32_t& next) {
+        if (issued_.size() >= maxIssued) return 0;
+        while (next < 0xFFFFFFFEu) {
+            const uint32_t peer = next++;
+            if (!wasIssued(peer)) return claim(peer) ? peer : 0;
+        }
+        return 0;
+    }
+};
+
+// A connection receives its record during the Connecting callback. Once that
+// record exists, a terminal callback must finish it regardless of its previous
+// transport state. Only a pristine native pool reservation skips player loss.
+template <class ClientMap>
+bool retireNativeIdentity(ClientMap& clients, typename ClientMap::key_type connection,
+                          uint64_t& occupiedSlots, TransportIdentities& identities,
+                          RetiredNativeIdentity& retired) {
+    auto found = clients.find(connection);
+    if (found == clients.end()) return false;
+    retired = identities.finishNative(found->second.m_id);
+    const unsigned slot = found->second.m_slot;
+    if (slot < 64) occupiedSlots &= ~(uint64_t(1) << slot);
+    clients.erase(found);
+    return true;
+}
+
+}
+#endif
