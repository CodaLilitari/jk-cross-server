+static void Observer_Flush(uint32_t now)
+{
+#ifdef JK_OBSERVER_SUPPORTED
+    for (int attempts=0;observer.fd>=0 && observer.pendingOffset<observer.pendingBytes && attempts<8;attempts++) {
+        ssize_t result=send(observer.fd,observer.pending+observer.pendingOffset,
+                            observer.pendingBytes-observer.pendingOffset,MSG_DONTWAIT|MSG_NOSIGNAL);
