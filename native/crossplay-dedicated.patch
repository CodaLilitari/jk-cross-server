+static SithPlayer *Observer_Player(uint32_t peer, uint32_t generation)
+{
+    if (!observer.worldReady || !sithWorld_g_pCurrentWorld || peer<=1 || !generation || Observer_Generation(peer)!=generation) return NULL;
+    for (int i=1;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        SithPlayer *player=&jkPlayer_playerInfos[i];
