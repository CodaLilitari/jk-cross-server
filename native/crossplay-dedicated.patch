+void jkObserver_Startup(int argc, char **argv)
+{
+#ifdef JK_OBSERVER_SUPPORTED
+    int dedicated=0, headless=0;
+    for (int i=1;i<argc;i++) {
+        dedicated |= !strcasecmp(argv[i],"-dedicatedServer") || !strcasecmp(argv[i],"/dedicatedServer");
+        headless |= !strcasecmp(argv[i],"-headless") || !strcasecmp(argv[i],"/headless");
+    }
+    const char *value=getenv("OPENJKDF2_SPECTATOR_FD");
+    if (!dedicated || !headless || !value || !*value) return;
+    char *end=NULL; errno=0;
+    long fd=strtol(value,&end,10);
+    if (errno || !end || *end || fd<3 || fd>INT_MAX) return;
