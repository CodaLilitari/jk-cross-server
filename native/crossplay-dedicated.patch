+                frame.data.size() % 4 || frame.data.size() > 15 * 4) {
+                m_gateway.error(8, 7, "ID pool requires 1..15 IDs before clients join"); return;
+            }
+            std::vector<uint32_t> ids;
+            std::set<uint32_t> seen;
+            for (size_t offset = 0; offset < frame.data.size(); offset += 4) {
