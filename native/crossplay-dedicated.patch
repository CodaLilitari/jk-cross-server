+static uint32_t Observer_Roster(uint8_t *output, size_t capacity)
+{
+    uint32_t count=0;
+    if (!observer.worldReady || !sithWorld_g_pCurrentWorld) return 0;
+    for (int i=1;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS && count<31;i++) {
+        SithPlayer *player=&jkPlayer_playerInfos[i];
+        uint32_t generation=Observer_Generation(player->playerNetId);
+        if (!(player->flags&1) || player->playerNetId<=1 || !generation) continue;
+        if ((size_t)(count+1)*OBS_RECORD>capacity) break;
