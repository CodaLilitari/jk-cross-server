--- /dev/null
+++ b/src/Main/jkObserver.c
@@ -0,0 +1,651 @@
+/* A local dedicated-host camera. It owns no game identity or world thing.
+ * The only inputs are typed commands on the authenticated supervisor bridge.
+ * Frames use a separate inherited socket, never a client game transport. */
+#include "Main/jkObserver.h"
+#include "Main/jkObserverGeometry.h"
+#include "Main/Main.h"
+#include "Main/sithMain.h"
+#include "Engine/sithCamera.h"
+#include "Engine/sithRender.h"
+#include "Engine/rdroid.h"
+#include "Raster/rdCache.h"
+#include "World/sithWorld.h"
+#include "World/sithSector.h"
+#include "World/jkPlayer.h"
+#include "Primitives/rdMatrix.h"
+#include "Primitives/rdModel3.h"
+#include "General/stdPalEffects.h"
+#include "Platform/Networking/GNS/stdComm_GNS.h"
+#include "Platform/std3D.h"
+#include "Win95/Video.h"
+#include "Win95/stdDisplay.h"
+#include "stdPlatform.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include <limits.h>
+
+#if defined(PLATFORM_POSIX) && defined(SDL2_RENDER) && !defined(RENDER_GL11) && !defined(ARCH_WASM) && !defined(TARGET_ANDROID)
+#define JK_OBSERVER_SUPPORTED 1
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <strings.h>
+#endif
+
+#define OBS_WIDTH 640u
+#define OBS_HEIGHT 360u
+#define OBS_PIXELS (OBS_WIDTH * OBS_HEIGHT * 4u)
+#define OBS_HEADER 36u
+#define OBS_REPLY 92u
+#define OBS_RECORD 76u
+#define OBS_PI 3.14159265358979323846
+#define OBS_SNAPSHOT_LIMIT (32u * 1024u * 1024u)
+#define OBS_RANGE_LIMIT 16384u
+
+typedef struct ObserverRange { void *address; size_t size, offset; } ObserverRange;
+static struct {
+    int capable, context, renderPass, worldReady, renderError, targetLost;
+    int fd;
+    uint32_t worldEpoch, controlEpoch, mode, targetPeer, targetGeneration;
+    uint32_t sequence, lastInputMs, lastPollMs, lastAttemptMs, frameSequence;
+    uint32_t sentWorld, sentControl, sentSequence, sentMs, pendingCapturedMs, reason;
+    float forward, right, up;
+    rdVector3 position, angles; /* Engine angles are degrees; wire angles are radians. */
+    SithCamera camera;
+    rdCanvas canvas;
+    uint8_t *pending;
+    size_t pendingBytes, pendingOffset;
+    ObserverRange *ranges;
+    uint8_t *snapshot;
+    size_t rangeCount, rangeCapacity, snapshotBytes, snapshotCapacity;
+} observer = {.fd = -1, .worldEpoch = 1, .controlEpoch = 1, .reason = 7};
+
+static uint32_t Observer_Next(uint32_t value) { return value == UINT32_MAX ? 1u : value + 1u; }
+static uint32_t Observer_Now(void) { return (uint32_t)stdPlatform_GetTimeMsec(); }
+static uint32_t Observer_Read32(const uint8_t *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
+static void Observer_Write32(uint8_t *p, uint32_t value)
+{ p[0]=value; p[1]=value>>8; p[2]=value>>16; p[3]=value>>24; }
+static float Observer_ReadFloat(const uint8_t *p)
+{ uint32_t bits=Observer_Read32(p); float value; memcpy(&value,&bits,4); return value; }
+static void Observer_WriteFloat(uint8_t *p, float value)
+{ uint32_t bits; memcpy(&bits,&value,4); Observer_Write32(p,bits); }
+
+/* Independent bounded JKSG stream. No geometry failure mutates image state. */
+#define GEOM_VERTICES 65536u
+#define GEOM_INDICES 196608u
+#define GEOM_PAYLOAD 2097152u
+enum { GEOM_VALID, GEOM_SIZE_LIMIT, GEOM_MISSING_DATA, GEOM_NONFINITE_PROJECTION, GEOM_INVALID_INDEX, GEOM_REASONS };
+static struct {
+    int fd, enabled, capturing, invalid;
+    uint32_t leaseMs, capturedMs, vertices, indices;
+    uint32_t diagnosticMs[GEOM_REASONS], diagnosticMask;
+    uint8_t *pending, *indexData;
+    size_t pendingBytes, pendingOffset;
+} geometry = {.fd=-1};
+
+/* At most one line per reason per five seconds (four fixed reasons). Keep
+ * this state across captures/lease changes so capture cadence cannot flood logs. */
+static void ObserverGeometry_LogRejection(uint32_t now)
+{
+    static const char *const reasons[GEOM_REASONS]={
+        "", "size-limit", "missing-data", "nonfinite-projection", "invalid-index"
+    };
+    unsigned reason=(unsigned)geometry.invalid;
+    if (!reason || reason>=GEOM_REASONS) return;
+    uint32_t bit=1u<<reason;
+    if ((geometry.diagnosticMask&bit) && now-geometry.diagnosticMs[reason]<5000u) return;
+    geometry.diagnosticMask|=bit;geometry.diagnosticMs[reason]=now;
+    fprintf(stderr,"[spectator geometry] rejected capture: %s\n",reasons[reason]);
+}
+
+static void ObserverGeometry_Stop(void)
+{
+    geometry.enabled=geometry.capturing=0;
+    if (!geometry.pendingOffset) geometry.pendingBytes=0;
+}
+static void ObserverGeometry_Close(void)
+{
+#ifdef JK_OBSERVER_SUPPORTED
+    if (geometry.fd>=0) close(geometry.fd);
+#endif
+    geometry.fd=-1; geometry.pendingBytes=geometry.pendingOffset=0;
+    ObserverGeometry_Stop();
+}
+static void ObserverGeometry_Shutdown(void)
+{
+    ObserverGeometry_Close();
+    free(geometry.pending); free(geometry.indexData);
+    geometry.pending=geometry.indexData=NULL;
+}
+static void ObserverGeometry_Startup(int imageFd)
+{
+#ifdef JK_OBSERVER_SUPPORTED
+    const char *value=getenv("OPENJKDF2_SPECTATOR_GEOMETRY_FD");
+    if (!value || !*value) return;
+    char *end=NULL; errno=0; long fd=strtol(value,&end,10);
+    if (errno || !end || *end || fd<3 || fd>INT_MAX || fd==imageFd) return;
+    int type=0; socklen_t length=sizeof(type);
+    struct sockaddr_un local, peer; socklen_t localLength=sizeof(local), peerLength=sizeof(peer);
+    if (getsockopt(fd,SOL_SOCKET,SO_TYPE,&type,&length) || type!=SOCK_STREAM ||
+        getsockname(fd,(struct sockaddr *)&local,&localLength) || local.sun_family!=AF_UNIX ||
+        getpeername(fd,(struct sockaddr *)&peer,&peerLength) || peer.sun_family!=AF_UNIX) return;
+    int flags=fcntl(fd,F_GETFL), descriptorFlags=fcntl(fd,F_GETFD);
+    if (flags<0 || descriptorFlags<0 || fcntl(fd,F_SETFL,flags|O_NONBLOCK)<0 ||
+        fcntl(fd,F_SETFD,descriptorFlags|FD_CLOEXEC)<0) return;
+    geometry.pending=malloc(64u+GEOM_PAYLOAD);
+    geometry.indexData=malloc(4u*GEOM_INDICES);
+    if (!geometry.pending || !geometry.indexData) {
+        free(geometry.pending);free(geometry.indexData);geometry.pending=geometry.indexData=NULL;return;
+    }
+    geometry.fd=(int)fd;
+#else
+    (void)imageFd;
+#endif
+}
+static void ObserverGeometry_Flush(uint32_t now)
+{
+#ifdef JK_OBSERVER_SUPPORTED
+    if (geometry.pendingBytes && !geometry.pendingOffset)
+        Observer_Write32(geometry.pending+36,now-geometry.capturedMs);
+    for (int attempt=0;geometry.fd>=0 && geometry.pendingOffset<geometry.pendingBytes && attempt<8;attempt++) {
+        ssize_t sent=send(geometry.fd,geometry.pending+geometry.pendingOffset,
+            geometry.pendingBytes-geometry.pendingOffset,MSG_DONTWAIT|MSG_NOSIGNAL);
+        if (sent>0) geometry.pendingOffset+=(size_t)sent;
+        else if (sent<0 && errno==EINTR) continue;
+        else if (sent<0 && (errno==EAGAIN || errno==EWOULDBLOCK)) return;
+        else { ObserverGeometry_Close();return; }
+    }
+    if (geometry.pendingOffset==geometry.pendingBytes) geometry.pendingOffset=geometry.pendingBytes=0;
+#else
+    (void)now;
+#endif
+}
+static void ObserverGeometry_Begin(uint32_t now)
+{
+    geometry.capturing=0;
+    if (!geometry.enabled || geometry.fd<0 || geometry.pendingBytes) return;
+    if (now-geometry.leaseMs>=5000) { ObserverGeometry_Stop();return; }
+    geometry.vertices=geometry.indices=0;geometry.invalid=0;geometry.capturedMs=now;geometry.capturing=1;
+}
+void jkObserver_CaptureGeometry(const D3DVERTEX *vertices, uint32_t vertexCount,
+    const rdTri *solid, uint32_t solidCount, const rdTri *normal, uint32_t normalCount)
+{
+#ifdef JK_OBSERVER_SUPPORTED
+    if (!observer.renderPass || !geometry.capturing || geometry.invalid) return;
+    int rejection=GEOM_SIZE_LIMIT;
+    if (vertexCount>GEOM_VERTICES-geometry.vertices || solidCount>GEOM_INDICES/3 || normalCount>GEOM_INDICES/3 ||
+        solidCount+normalCount>(GEOM_INDICES-geometry.indices)/3) goto invalid;
+    if ((vertexCount && !vertices) || (solidCount && !solid) || (normalCount && !normal)) {
+        rejection=GEOM_MISSING_DATA;goto invalid;
+    }
+    uint32_t addedIndices=3*(solidCount+normalCount);
+    if (20u*(geometry.vertices+vertexCount)+4u*(geometry.indices+addedIndices)>GEOM_PAYLOAD) goto invalid;
+    /* Line-only batches have no triangles in this fixed profile. */
+    if (!addedIndices) return;
+    rejection=GEOM_NONFINITE_PROJECTION;
+    for (uint32_t i=0;i<vertexCount;i++) {
+        float z=(float)vertices[i].z, w=1.0f/(1.0f-z);
+        float clip[4]={((2.0f*(float)vertices[i].x/OBS_WIDTH)-1.0f)*w,
+            (1.0f-2.0f*(float)vertices[i].y/OBS_HEIGHT)*w,(z-1.0f)*w,w};
+        uint8_t *out=geometry.pending+64+20u*(geometry.vertices+i);
+        for (int c=0;c<4;c++) { if (!isfinite(clip[c])) goto invalid;Observer_WriteFloat(out+4*c,clip[c]); }
+        uint32_t colour=vertices[i].color;
+        out[16]=colour>>16;out[17]=colour>>8;out[18]=colour;out[19]=255;
+    }
+    rejection=GEOM_INVALID_INDEX;
+    uint32_t offset=geometry.indices;
+    for (int batch=0;batch<2;batch++) {
+        const rdTri *triangles=batch?normal:solid;uint32_t count=batch?normalCount:solidCount;
+        for (uint32_t i=0;i<count;i++) {
+            int32_t indices[3]={triangles[i].v1,triangles[i].v2,triangles[i].v3};
+            for (int j=0;j<3;j++) {
+                if (indices[j]<0 || (uint32_t)indices[j]>=vertexCount) goto invalid;
+                Observer_Write32(geometry.indexData+4u*offset++,geometry.vertices+(uint32_t)indices[j]);
+            }
+        }
+    }
+    geometry.vertices+=vertexCount;geometry.indices+=addedIndices;return;
+invalid:
+    geometry.invalid=rejection;
+#else
+    (void)vertices;(void)vertexCount;(void)solid;(void)solidCount;(void)normal;(void)normalCount;
