diff --git a/src/Platform/Networking/GNS/AdminConnections.h b/src/Platform/Networking/GNS/AdminConnections.h
new file mode 100644
index 0000000..fcecd70
--- /dev/null
+++ b/src/Platform/Networking/GNS/AdminConnections.h
@@ -0,0 +1,57 @@
+#ifndef JK_GNS_ADMIN_CONNECTIONS_H
+#define JK_GNS_ADMIN_CONNECTIONS_H
+
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <map>
+#include <utility>
+
+namespace jk_gateway {
+
+/* Engine-owned incarnations: a transport reconnect, map transition or IPC
+ * disconnect invalidates every old actor binding. No name or chat field can
+ * choose a generation. Exhaustion fails closed instead of reusing a value. */
+class AdminConnections {
+    struct Connection {
+        uint32_t generation = 0;
+        std::deque<uint32_t> recentRequests;
+    };
+    uint32_t serial_ = 0;
+    std::map<uint32_t, Connection> connections_;
+    uint32_t next() {
+        return serial_ == std::numeric_limits<uint32_t>::max() ? 0 : ++serial_;
+    }
+public:
+    void add(uint32_t peer) {
+        if (peer <= 1 || (!connections_.count(peer) && connections_.size() >= 31)) return;
+        Connection connection;
+        connection.generation = next();
+        connections_[peer] = std::move(connection);
+    }
+    void remove(uint32_t peer) { connections_.erase(peer); }
+    void clear() { connections_.clear(); }
+    void renew() {
+        for (auto &entry : connections_) {
+            entry.second.generation = next();
+            entry.second.recentRequests.clear();
+        }
+    }
+    uint32_t generation(uint32_t peer) const {
+        const auto found = connections_.find(peer);
+        return found == connections_.end() ? 0 : found->second.generation;
+    }
+    bool matches(uint32_t peer, uint32_t generation) const {
+        return generation && this->generation(peer) == generation;
+    }
+    bool consume(uint32_t peer, uint32_t generation, uint32_t request) {
+        if (!request || !matches(peer, generation)) return false;
+        auto &recent = connections_.find(peer)->second.recentRequests;
+        for (uint32_t previous : recent) if (previous == request) return false;
+        if (recent.size() >= 64) recent.pop_front();
+        recent.push_back(request);
+        return true;
+    }
+};
+}
+#endif
