+                AdminReply(frame, generation, 1, "Invalid typed admin operation."); return;
+            }
+            if (m_adminIncoming.size() >= 64) {
+                AdminReply(frame, generation, 1, "Admin request queue is full."); return;
+            }
+            m_adminIncoming.push(frame);
+        } else if (frame.type == 7 && frame.data.size() <= 256) {
+            m_gateway.sendFrame(107, frame.src, frame.dst, frame.data.data(), frame.data.size());
+        } else m_gateway.error(frame.type, 6, "unknown request");
+    }
