+            }
+            m_idPool = std::move(ids);
+            std::vector<uint8_t> result;
+            jk_gateway::put32(result, uint32_t(m_idPool.size()));
+            m_gateway.sendFrame(108, 1, frame.dst, result.data(), result.size());
+            stdPlatform_Printf("GATEWAY_ID_POOL_READY %u\n", unsigned(m_idPool.size()));
+        } else if (frame.type == 9) {
+            if (frame.src <= 1 || !frame.dst || frame.data.size() < 8 || frame.data.size() > 135) {
+                m_gateway.error(9, 9, "invalid admin request envelope"); return;
+            }
+            const uint32_t generation = jk_gateway::read32(frame.data.data());
+            const uint32_t operation = jk_gateway::read32(frame.data.data() + 4);
