+#ifndef _SITH_ADMIN_H
+#define _SITH_ADMIN_H
+
+#include "types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SITH_ADMIN_TEXT_MAX 127
+
+enum sithAdminOperation {
+    SITH_ADMIN_MESSAGE = 1,
+    SITH_ADMIN_PLAYERS = 2,
+    SITH_ADMIN_KICK = 3,
+    SITH_ADMIN_NEXT_LEVEL = 4
+};
+
+/* These are typed operations from the authenticated local manager. No game
+ * packet, player name, console string or COG grants administrative authority. */
+int sithAdmin_DecodeChat(const SithMessage *message,
+                         char text[SITH_ADMIN_TEXT_MAX + 1], int32_t *speaker);
+int sithAdmin_IsCommand(const char *text);
+int sithAdmin_Printable(const char *text, size_t length);
+int sithAdmin_JoinedSlot(uint32_t peer);
+int sithAdmin_Execute(uint32_t actor, uint32_t operation, const char *argument,
+                      uint32_t *kickedPeer, char summary[SITH_ADMIN_TEXT_MAX + 1]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
