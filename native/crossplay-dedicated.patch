+        const size_t length = strlen(text);
+        const uint32_t generation = m_adminConnections.generation(actualPeer);
+        if (!m_gateway.connected() || !generation || !PeerUsed(actualPeer) ||
+            sithAdmin_JoinedSlot(actualPeer) < 0 || !length ||
+            !sithAdmin_Printable(text, length) || !sithAdmin_IsCommand(text)) return;
+        m_gateway.sendFrame(109, actualPeer, generation, text, length);
+    }
+
+    void ProcessAdminRequests()
+    {
+        if (m_adminExecuting) return;
+        m_adminExecuting = true;
+        for (unsigned handled = 0; handled < 8 && !m_adminIncoming.empty(); ++handled) {
+            const jk_gateway::Frame request = std::move(m_adminIncoming.front());
+            m_adminIncoming.pop();
+            const uint32_t generation = jk_gateway::read32(request.data.data());
+            const uint32_t operation = jk_gateway::read32(request.data.data() + 4);
+            if (!m_gateway.connected() || !PeerUsed(request.src) ||
+                !m_adminConnections.matches(request.src, generation) ||
+                sithAdmin_JoinedSlot(request.src) < 0) {
+                AdminReply(request, generation, 2, "Your connection changed. Authenticate again after joining.");
+                continue;
+            }
+            if (!m_adminConnections.consume(request.src, generation, request.dst)) {
+                AdminReply(request, generation, 1, "Duplicate admin request.");
+                continue;
+            }
+            const std::string argument(request.data.begin() + 8, request.data.end());
+            char summary[128];
+            uint32_t kickedPeer = 0;
+            const int status = sithAdmin_Execute(request.src, operation, argument.c_str(), &kickedPeer, summary);
+            if (!status && kickedPeer) KickTransport(kickedPeer);
+            AdminReply(request, generation, uint32_t(status), summary);
+        }
+        m_adminExecuting = false;
+    }
+
+    void KickTransport(uint32_t peer)
+    {
+        // The ordinary DSS_QUIT was queued first. Retire membership immediately
+        // so an uncooperative client cannot keep sending after a successful kick.
+        if (m_externalPeers.erase(peer)) {
+            m_adminConnections.remove(peer);
+            PurgeGatewayPeer(peer);
+            m_DisconnectedPeers.push(int(peer));
+            m_gateway.sendFrame(104, peer, 0);
+        } else {
+            for (auto it = m_mapClients.begin(); it != m_mapClients.end(); ++it) {
+                if (it->second.m_id != peer) continue;
+                const HSteamNetConnection connection = it->first;
+                availableIds &= ~(1ULL << it->second.m_slot);
+                m_mapClients.erase(it);
+                m_adminConnections.remove(peer);
+                m_DisconnectedPeers.push(int(peer));
+                m_pInterface->CloseConnection(connection, 0, "Kicked by server administrator", true);
+                break;
+            }
+        }
+        EnumeratePlayers();
+    }
+
+    void PublishSessionInfo(uint32_t request = 0)
+    {
+        static_assert(sizeof(jkMultiEntry) == 240, "IPC session ABI");
+        std::vector<uint8_t> info;
+        jk_gateway::put32(info, Main_bMotsCompat ? 1 : 0);
+        jkMultiEntry entry = sithDplayGNS_storedEntry;
+        entry.numPlayers = RealConnectedPlayers();
+        entry.multiModeFlags = sithMulti_multiModeFlags;
+        const auto* p = reinterpret_cast<const uint8_t*>(&entry);
+        info.insert(info.end(), p, p + sizeof(entry));
+        m_gateway.sendFrame(102, 1, request, info.data(), info.size());
+    }
+
+    void HandleGateway(const jk_gateway::Frame& frame)
+    {
+        if (frame.type == 2) {
+            PublishSessionInfo(frame.dst);
+        } else if (frame.type == 3) {
+            if (m_externalPeers.size() + m_mapClients.size() >= 31) {
+                m_gateway.error(3, 2, "transport peer capacity reached"); return;
+            }
+            uint32_t peer = frame.src;
+            if (!peer) {
+                if (!m_idPool.empty() || m_requireIdPool) peer = FreePoolId();
+                else {
+                    while (PeerUsed(m_nextGatewayId)) ++m_nextGatewayId;
+                    peer = m_nextGatewayId++;
+                }
+            }
+            if (peer < 65 || peer >= 0xFFFFFFFEu || PeerUsed(peer)) {
+                m_gateway.error(3, 3, "invalid or duplicate peer ID"); return;
+            }
+            m_externalPeers.insert(peer);
+            m_adminConnections.add(peer);
+            EnumeratePlayers();
+            const uint8_t status[4] = {0, 0, 0, 0};
+            m_gateway.sendFrame(103, peer, frame.dst, status, sizeof(status));
+            stdPlatform_Printf("GATEWAY_PEER_ADDED %u\n", peer);
+        } else if (frame.type == 4) {
+            if (m_externalPeers.erase(frame.src)) {
+                m_adminConnections.remove(frame.src);
+                PurgeGatewayPeer(frame.src);
+                m_DisconnectedPeers.push(int(frame.src));
+            }
+            m_gateway.sendFrame(104, frame.src, frame.dst);
+        } else if (frame.type == 5) {
+            if (!m_externalPeers.count(frame.src) || frame.data.size() < 4 || frame.data.size() > 2052) {
+                m_gateway.error(5, 4, "unregistered peer or invalid game packet length"); return;
+            }
+            if (frame.dst && frame.dst != 1) {
+                Send(frame.src, frame.dst, const_cast<uint8_t*>(frame.data.data()), uint32_t(frame.data.size()));
+            } else if (m_gatewayIncomingBytes + frame.data.size() <= 256 * 1024) {
+                m_gatewayIncoming.push(frame);
