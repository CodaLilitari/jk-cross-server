+    bool RetireExternalPeer(uint32_t peer)
+    {
+        if (!m_externalPeers.count(peer)) return false;
+        // Quarantine before releasing membership. Old queued loss events and
+        // reliable-message caches must never name a later incarnation.
+        const bool notify = m_identities.retire(peer) && m_identities.isPoolId(peer);
