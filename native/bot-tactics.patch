+/* water_fight: swim along a direction while the view stays on a fight. The
+   stock swim pushes forward along the view (head pitch tilts it, except on
+   the surface), strafes at 0.7 along the body's right, and rises or sinks at
+   half thrust on jump or crouch. Solve those keys for the wanted direction. */
+static void Bot_SwimThrust(SithThing *self,rdVector3 want)
+{
+    flex_t length=Bot_Len(want);
+    if (length<0.025f) { bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0; return; }
+    want.x/=length; want.y/=length; want.z/=length;
+    int surface=(self->physicsParams.flags&SITH_PF_ONWATERSURFACE)!=0;
+    flex_t pitch=surface ? 0 : self->actorParams.headPYR.x/BOT_DEG, c=cosf(pitch), s=sinf(pitch);
+    if (c<0.35f) return; /* looking steeply up or down: keep the route's own keys */
+    flex_t forward=Bot_Dot(want,self->orient.lvec)/c, slide=Bot_Dot(want,self->orient.rvec)/0.7f;
+    flex_t scale=Bot_Max(1.0f,Bot_Max(fabsf(forward),fabsf(slide)));
+    forward/=scale; slide/=scale;
+    flex_t rise=want.z/scale-forward*s; /* what the jump and crouch keys must add */
+    bot.axes[INPUT_FUNC_FORWARD]=Bot_Clamp(forward,-1,1);
+    bot.axes[INPUT_FUNC_SLIDE]=Bot_Clamp(slide,-1,1);
+    bot.keys[INPUT_FUNC_JUMP]=!surface && rise>0.25f;
+    bot.keys[INPUT_FUNC_DUCK]=rise<-0.25f;
+}
