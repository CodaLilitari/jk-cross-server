+/* Allow the run or the diagonal only with a continuous, drop-free,
+   full-body-clear floor for the whole runway. */
+static int Bot_RunClear(SithThing *self,rdVector3 desired,int run,int diagonal)
+{
+    rdVector3 blocked;
+    flex_t runway=Bot_Runway(self,run,diagonal);
+    return runway>0 && Bot_GroundCorridor(self,desired,0,runway,1,&blocked);
+}
+
+/* always_run: the run doubles ground thrust and so the coast after it. Look
+   one running stop ahead for what a running bot could not stop short of: no
+   floor, a drop off a ledge of more than a step or two, water, or a floor
+   that hurts. A wall, a step up or a crowd simply ends the look, since
+   running into them costs nothing; a ramp down is a floor, not a drop. */
+static int Bot_RunSafe(SithThing *self,rdVector3 desired,int diagonal)
+{
+    flex_t runway=Bot_Runway(self,1,diagonal), length=Bot_Horizontal(desired);
+    bot.tele.runWhy=0;
+    if (!(runway>0) || length<0.001f) return 0;
+    rdVector3 direction={desired.x/length,desired.y/length,0}, previous=self->position;
+    int steps=(int)ceilf(runway/0.075f);
+    flex_t step=runway/steps, slope=step*1.55f+0.01f, supportedZ=self->position.z, ledges=0;
+    SithSector *hint=self->sector;
+    for (int i=1;i<=steps;i++) {
+        rdVector3 p=self->position, floor; SithSector *sector;
+        p.x+=direction.x*step*i; p.y+=direction.y*step*i; p.z=previous.z+0.02f;
+        /* A wall or a step up first: there is nothing to fall from. */
+        if (!Bot_Clear(self,hint,previous,p,self->collideSize*0.85f,0)) return 1;
+        /* No floor within a short drop: a pit, a ledge, water or a hurtful floor. */
+        if (!Bot_Floor(p,hint,0.43f,&floor,&sector)) { bot.tele.runWhy=1; return 0; }
+        if (sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY)) { bot.tele.runWhy=2; return 0; }
+        if (floor.z-supportedZ>Bot_Min(BOT_STEP_UP,slope)) return 1;
+        if (supportedZ-floor.z>slope) {
+            ledges+=supportedZ-floor.z;
+            if (ledges>0.28f) { bot.tele.runWhy=3; return 0; }
+        }
+        supportedZ=floor.z; previous=floor; hint=sector;
+    }
+    return 1;
+}
+
+/* Whether a run is allowed along this direction now. */
+static int Bot_RunAllowed(SithThing *self,rdVector3 desired,int diagonal)
+{
+    return BT_ON(ALWAYS_RUN) ? Bot_RunSafe(self,desired,diagonal) : Bot_RunClear(self,desired,1,diagonal);
+}
