+/* water_fight: the climb out needs full thrust along the line to the bank,
+   not a particular facing. Forward and strafe together give it with the
+   body turned up to 43 degrees off that line, facing either way along it,
+   and on the surface or in the air the head pitch tilts nothing. Look as
+   near the shot as that allows. Under the surface the pitch tilts the
+   stroke, so the swimmer stays level and faces the bank. */
+static void Bot_ExitAim(SithThing *self,rdVector3 bank,rdVector3 line)
+{
+    int submerged=(self->sector->flags&SITH_SECTOR_UNDERWATER) && !(self->physicsParams.flags&SITH_PF_ONWATERSURFACE);
+    rdVector3 d=Bot_Sub(nav.exitLook,self->position);
+    flex_t h=Bot_Horizontal(d);
+    if (!nav.exitLookValid || submerged || h<0.01f || Bot_Horizontal(line)<0.5f) { Bot_Aim(self,bank,0); return; }
+    const flex_t limit=0.75f, pi=3.14159265f;
+    flex_t want=atan2f(d.y,d.x), along=atan2f(line.y,line.x), off=want-along, chosen=want;
+    while (off>pi) off-=2*pi;
+    while (off<=-pi) off+=2*pi;
+    if (fabsf(off)>limit && fabsf(off)<pi-limit) {
+        flex_t sign=off>0 ? 1.0f : -1.0f;
+        chosen=fabsf(off)<pi/2 ? along+sign*limit : along+sign*(pi-limit);
+    }
+    rdVector3 at={self->position.x+cosf(chosen)*h,self->position.y+sinf(chosen)*h,nav.exitLook.z};
+    Bot_Aim(self,at,0);
+}
