+/* lift_hop: from a ledge halfway up the shaft onto the deck. Wait at the
+   lip facing the shaft; go when the deck stands below within a drop the
+   bot can take, or is about to pass just under the ledge, and call the
+   lift with the ledge's own button when it stands still out of reach.
+   Bespin's railgun and concussion rifle sit on such ledges, and two of its
+   spawns: the graph had no way off them. */
+static int Bot_LiftHop(SithThing *self,const BotLift *lift,int id,SithThing *thing,int from,int to,flex_t still)
+{
+    const BotNode *ledge=&bot.nodes[from], *deck=&bot.nodes[to];
+    rdVector3 over={deck->pos.x,deck->pos.y,self->position.z}, toward=Bot_Sub(over,ledge->pos);
+    flex_t span=Bot_Horizontal(toward);
+    if (span<0.01f) return 0;
+    flex_t floor=self->position.z-BOT_FOOT_HEIGHT, below=floor-(thing->position.z+lift->top);
+    /* Where the deck will be by the time the bot is over it. */
+    flex_t soon=below-nav.liftRate*0.15f;
+    int moving=still<0.2f, onLedge=(self->attach_flags&SITH_ATTACH_SURFACE)!=0;
+    int go=moving ? soon>=0.02f && soon<=0.35f :
+        still>=0.3f && below>=0.02f && below<=1.6f && (below<=1.0f || self->actorParams.health>=50);
+    Bot_Aim(self,over,0);
+    if (nav.hopUntil>bot.now) {
+        /* Committed; but not into the empty shaft once the deck has risen past. */
+        if (onLedge && below<0.0f) { nav.hopUntil=0; bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0; return 1; }
+        if (!Bot_NavDirectMove(self,over,0)) Bot_Move(self,Bot_Sub(over,self->position),1);
+        return 1;
+    }
+    if (go && onLedge) {
+        nav.hopUntil=bot.now+0.8f; bot.tele.liftHops++;
+        fprintf(stderr,"BOT_LIFT name=%s t=%.2f event=hop lift=%d below=%.2f rate=%.2f\n",bot.name,(double)bot.now,id-1,(double)below,(double)nav.liftRate);
+        fflush(stderr);
+        if (!Bot_NavDirectMove(self,over,0)) Bot_Move(self,Bot_Sub(over,self->position),1);
+        return 1;
+    }
+    nav.waitUntil=bot.now+0.4f;
+    /* Call it where it stands still out of reach; otherwise wait at the lip. */
+    if (!moving && still>=0.8f && !go && Bot_LiftPress(self,lift,id,0)) return 1;
+    flex_t lip=Bot_Max(0.0f,span-0.148f-self->collideSize-0.01f);
+    rdVector3 at={ledge->pos.x+toward.x/span*lip,ledge->pos.y+toward.y/span*lip,self->position.z};
+    if (Bot_Horizontal(Bot_Sub(at,self->position))>0.02f) Bot_NavDirectMove(self,at,0);
+    else bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+    Bot_Aim(self,over,0);
+    return 1;
+}
