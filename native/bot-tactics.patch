+/* pack_hunt: the contact kept for this pack, or NULL when it offers none. A
+   pack that moved (a blast, a shove, a slide) starts over. */
+static BotPackRoute *Bot_PackRoute(SithThing *self,SithThing *pack)
+{
+    BotPackRoute *r=NULL, *spare=&nav.packRoutes[0];
+    for (int i=0;i<BOT_PACK_ROUTES;i++) {
+        BotPackRoute *e=&nav.packRoutes[i];
+        if (e->used>0 && e->guid==pack->guid) { r=e; break; }
+        if (e->used<spare->used) spare=e;
+    }
+    if (r && Bot_Distance(r->pos,pack->position)>0.035f) r->used=0;
+    if (!r || !(r->used>0)) {
+        if (!r) r=spare;
+        memset(r,0,sizeof(*r));
+        if (!Bot_PackContact(self,pack,&r->end)) return NULL;
+        r->guid=pack->guid; r->pos=pack->position;
+    }
+    r->used=Bot_Max(bot.now,0.001f);
+    return r;
+}
