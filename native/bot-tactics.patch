+static void Bot_TrapBindLog(const BotTrap *t,int index)
+{
+    const BotNode *beside=t->standNode>=0 ? &bot.nodes[t->standNode] : NULL;
+    fprintf(stderr,"BOT_TRAP name=%s event=bind map=%s trap=%d kind=%s cog=%d switch=%d cel=%d stand=%.3f,%.3f,%.3f stand_sector=%d node=%d node_pos=%.3f,%.3f,%.3f node_sector=%d usable=%d zone_nodes=%d points=%d",
+        bot.name,bot.world->map_jkl_fname,index,botTrapKinds[t->kind],t->cog,t->button,t->cel,
+        (double)t->stand.pos.x,(double)t->stand.pos.y,(double)t->stand.pos.z,t->stand.sector ? (int)t->stand.sector->id : -1,
+        t->standNode,beside ? (double)beside->pos.x : 0.0,beside ? (double)beside->pos.y : 0.0,beside ? (double)beside->pos.z : 0.0,
+        beside ? (int)beside->sector->id : -1,t->usable,t->zoneNodes,t->points);
+    for (int k=0;k<t->points;k++) fprintf(stderr," p%d=%.2f,%.2f,%.2f",k,(double)t->point[k].x,(double)t->point[k].y,(double)t->point[k].z);
+    if (t->kind==BOT_TRAP_FIELD) fprintf(stderr," field=%d side=%d",t->field,t->side);
+    fprintf(stderr,"\n");
+}
+
+/* One side of a gate leg, walked on its own side of the face. */
+static int Bot_GateHalf(BotNode *a,BotNode *b)
+{
+    int drop=0;
+    if (Bot_Horizontal(Bot_Sub(b->pos,a->pos))<0.03f) return fabsf(b->pos.z-a->pos.z)<0.1f;
+    return Bot_WalkableSpan(a,b,&drop,0.001f) && !drop;
+}
+
+/* Whether a straight leg from node i to node j could be walked through a
+   field's face if it were off: the body clears the face's edges where the
+   leg meets it, there is floor just short of the face on either side, and
+   each half is an ordinary walk that stops short of the face. */
+static int Bot_GateWalk(BotField *f,int i,int j,flex_t r,int *forward,int *backward)
+{
+    BotNode *a=&bot.nodes[i], *b=&bot.nodes[j], near[2];
+    rdVector3 at; flex_t inside;
+    *forward=*backward=0;
+    if (!Bot_FieldCross(f,a->pos,b->pos,&at,&inside) || inside<r+0.01f) return 0;
+    for (int k=0;k<2;k++) {
+        flex_t off=k ? -(r+0.02f) : r+0.02f;
+        rdVector3 p={at.x+f->normal.x*off,at.y+f->normal.y*off,at.z+0.04f};
+        SithSector *sector=NULL;
+        memset(&near[k],0,sizeof(near[k]));
+        if (!Bot_Floor(p,(k ? b : a)->sector,0.6f,&near[k].pos,&sector)) return 0;
+        near[k].sector=sector; near[k].item=-1;
+    }
+    if (fabsf(near[0].pos.z-near[1].pos.z)>BOT_STEP_UP) return 0;
+    *forward=Bot_GateHalf(a,&near[0]) && Bot_GateHalf(&near[1],b);
+    *backward=Bot_GateHalf(b,&near[1]) && Bot_GateHalf(&near[0],a);
+    return *forward || *backward;
+}
+
+static void Bot_GateAdd(int field,int from,int to,int side)
+{
+    BotNode *node=&bot.nodes[from];
+    int before=node->nEdges;
+    if (traps.nGates>=BOT_GATES) return;
+    Bot_AddEdge(from,to,BOT_ROUTE_GATE);
+    if (node->nEdges==before) return;
+    traps.gates[traps.nGates++]=(BotGate){.from=from,.to=to,.field=field,.side=side,.detour=1e20f};
+    traps.gateNode[from]=1; traps.fields[field].gates++;
+}
+
+typedef struct { int i, j; flex_t length; } BotGatePair;
+static int Bot_GatePairOrder(const void *a,const void *b)
+{
+    flex_t x=((const BotGatePair*)a)->length, y=((const BotGatePair*)b)->length;
+    return x<y ? -1 : x>y;
+}
+
+/* The graph learns the field once. No ordinary leg goes through its face,
+   none ends against it (a body there touches the field while it is on),
+   and a few gate legs cross it, spread along it, shortest first. */
+static void Bot_BuildGates(SithThing *self,int field)
+{
+    BotField *f=&traps.fields[field];
+    SithSurface *face=&bot.world->surfaces[f->surface[0]];
+    flex_t r=self->moveSize>=0.02f && self->moveSize<=0.25f ? self->moveSize : 0.065f, clear=r+0.03f;
+    static flex_t side[BOT_NODES];
+    static unsigned char hugs[BOT_NODES];
+    static BotGatePair pairs[BOT_GATE_PAIRS];
+    for (int i=0;i<bot.nNodes;i++) {
+        rdVector3 p=bot.nodes[i].pos;
+        side[i]=Bot_FieldSide(f,p);
+        rdVector3 onto={p.x-f->normal.x*side[i],p.y-f->normal.y*side[i],p.z-f->normal.z*side[i]};
+        hugs[i]=fabsf(side[i])<clear && Bot_FaceInside(face,onto)>-r;
+        f->hugging+=hugs[i];
+    }
+    for (int i=0;i<bot.nNodes;i++) {
+        BotNode *a=&bot.nodes[i];
+        for (int k=0;k<a->nEdges;k++) {
+            int j=a->edges[k].to; rdVector3 at; flex_t inside;
+            if (j<0 || j>=bot.nNodes) continue;
+            int through=Bot_FieldCross(f,a->pos,bot.nodes[j].pos,&at,&inside) && inside>-r;
+            if (!through && !hugs[j]) continue;
+            memmove(&a->edges[k],&a->edges[k+1],(size_t)(a->nEdges-k-1)*sizeof(a->edges[0]));
+            a->nEdges--; k--;
+            if (through) f->through++; else f->against++;
+        }
+    }
+    int count=0;
+    for (int i=0;i<bot.nNodes && count<BOT_GATE_PAIRS;i++) {
+        if (side[i]<clear || side[i]>1.5f || nav.liftForNode[i] || (bot.nodes[i].sector->flags&SITH_SECTOR_UNDERWATER)) continue;
+        for (int j=0;j<bot.nNodes && count<BOT_GATE_PAIRS;j++) {
+            if (side[j]>-clear || side[j]<-1.5f || nav.liftForNode[j] || (bot.nodes[j].sector->flags&SITH_SECTOR_UNDERWATER)) continue;
+            rdVector3 d=Bot_Sub(bot.nodes[j].pos,bot.nodes[i].pos);
+            if (Bot_Horizontal(d)>2.0f || fabsf(d.z)>BOT_STEP_UP) continue;
+            pairs[count++]=(BotGatePair){i,j,Bot_Len(d)};
+        }
+    }
+    qsort(pairs,(size_t)count,sizeof(pairs[0]),Bot_GatePairOrder);
+    rdVector3 crossed[16]; int used=0;
+    for (int p=0;p<count && used<16 && traps.nGates+2<=BOT_GATES;p++) {
+        int i=pairs[p].i, j=pairs[p].j, forward, backward, near=0;
+        rdVector3 at; flex_t inside;
+        if (!Bot_FieldCross(f,bot.nodes[i].pos,bot.nodes[j].pos,&at,&inside)) continue;
+        for (int k=0;k<used && !near;k++) near=Bot_Distance(crossed[k],at)<0.4f;
+        if (near || !Bot_GateWalk(f,i,j,r,&forward,&backward)) continue;
+        crossed[used++]=at;
+        if (forward) Bot_GateAdd(field,i,j,1);
+        if (backward) Bot_GateAdd(field,j,i,-1);
+    }
+}
+
+/* Recognise a force field's COG: two switches and the field's two faces. */
+static int Bot_BindField(SithThing *self,int index)
+{
+    sithCog *cog=&bot.world->aCogs[index];
+    if (!Bot_CogSymbol(cog,"damsurf") || !Bot_CogSymbol(cog,"damsurf2") || !Bot_CogSymbol(cog,"switch") ||
+        traps.nFields>=BOT_FIELDS) return 0;
+    BotField *f=&traps.fields[traps.nFields];
+    memset(f,0,sizeof(*f));
+    f->surface[0]=Bot_CogSurface(cog,"damsurf"); f->surface[1]=Bot_CogSurface(cog,"damsurf2");
+    if (f->surface[0]<0 || f->surface[1]<0) return 0;
+    SithSurface *s=&bot.world->surfaces[f->surface[0]];
+    if (!s->pAdjoin || !bot.world->surfaces[f->surface[1]].pAdjoin || !Bot_FaceCenter(s,&f->center)) return 0;
+    f->normal=s->surfaceInfo.face.normal;
+    if (fabsf(f->normal.z)>0.5f) return 0; /* a wall of light, not a floor */
+    int field=traps.nFields++;
+    Bot_BuildGates(self,field);
+    static const char *switches[]={"switch","switch1"};
+    for (int k=0;k<2 && traps.count<BOT_TRAPS;k++) {
+        BotTrap *t=&traps.list[traps.count];
+        memset(t,0,sizeof(*t));
+        t->kind=BOT_TRAP_FIELD; t->cog=index; t->field=field; t->button2=-1;
+        t->sector[0]=t->sector[1]=-1; t->standNode=-1;
+        if ((t->button=Bot_CogSurface(cog,switches[k]))<0) continue;
+        if (Bot_TrapStand(self,t)) t->side=Bot_FieldSide(f,t->stand.pos)>0 ? 1 : -1;
+        t->cel=Bot_TrapCel(t); t->celSince=bot.now;
+        Bot_TrapBindLog(t,traps.count);
+        traps.count++;
+    }
+    fprintf(stderr,"BOT_FIELD name=%s event=bind map=%s field=%d cog=%d faces=%d,%d open=%d center=%.3f,%.3f,%.3f normal=%.2f,%.2f,%.2f legs_through=%d legs_against=%d hugging_nodes=%d gates=%d\n",
+        bot.name,bot.world->map_jkl_fname,field,index,f->surface[0],f->surface[1],Bot_FieldOpen(f),
+        (double)f->center.x,(double)f->center.y,(double)f->center.z,
+        (double)f->normal.x,(double)f->normal.y,(double)f->normal.z,f->through,f->against,f->hugging,f->gates);
+    return 1;
+}
+
+/* What crossing a field that is on costs from each gate's side: there and
+   back to that side's nearest switch, and a moment to press it. Kept up to
+   date every few seconds: a struck jump leg or the Force to make one can
+   change the way to a switch a floor up. */
+static void Bot_GateDetours(SithThing *self,int log)
+{
+    static flex_t back[BOT_NODES], there[BOT_NODES];
+    static int parent[BOT_NODES];
+    for (int g=0;g<traps.nGates;g++) traps.gates[g].detour=1e20f;
+    traps.blockGates=2;
+    for (int i=0;i<traps.count;i++) {
+        const BotTrap *t=&traps.list[i];
+        if (t->kind!=BOT_TRAP_FIELD || !t->usable) continue;
+        /* The way up to a switch a floor up is not the way back down:
+           price both, each start once. */
+        flex_t step=Bot_Distance(bot.nodes[t->standNode].pos,t->stand.pos);
+        Bot_PathDistances(self,t->standNode,back,parent);
+        for (int g=0;g<traps.nGates;g++) {
+            const BotGate *gate=&traps.gates[g];
+            int seen=0;
+            if (gate->field!=t->field || gate->side!=t->side || back[gate->from]>=1e19f) continue;
+            for (int h=0;h<g && !seen;h++) seen=traps.gates[h].from==gate->from && traps.gates[h].field==gate->field;
+            if (seen) continue;
+            Bot_PathDistances(self,gate->from,there,parent);
+            /* A switch too far to be worth the walk leaves the field a wall. */
+            if (there[t->standNode]>=1e19f || there[t->standNode]+step>BOT_FIELD_REACH) continue;
+            flex_t detour=there[t->standNode]+back[gate->from]+2.0f*step+1.0f;
+            for (int h=g;h<traps.nGates;h++) {
+                BotGate *same=&traps.gates[h];
+                if (same->from==gate->from && same->field==gate->field && detour<same->detour) same->detour=detour;
+            }
+        }
+    }
+    traps.blockGates=0;
+    traps.nextDetours=bot.now+5.0f;
+    for (int g=0;g<traps.nGates && log;g++) {
+        const BotGate *gate=&traps.gates[g];
+        const BotNode *a=&bot.nodes[gate->from], *b=&bot.nodes[gate->to];
+        fprintf(stderr,"BOT_FIELD name=%s event=gate field=%d from=%d to=%d side=%d from_pos=%.3f,%.3f,%.3f to_pos=%.3f,%.3f,%.3f detour=%.2f\n",
+            bot.name,gate->field,gate->from,gate->to,gate->side,(double)a->pos.x,(double)a->pos.y,(double)a->pos.z,
+            (double)b->pos.x,(double)b->pos.y,(double)b->pos.z,(double)(gate->detour<1e19f ? gate->detour : -1.0f));
+    }
+}
+
+/* lift_call: a lift's level COG, found by the thing it names as its
+   elevator: the buttons that send the lift and the adjoins whose crossing
+   does (00_elev_switch.cog, 00_elev_switch2.cog and their kin). */
+static void Bot_BindLifts(void)
+{
+    static const char *buttons[]={"button","call0","call1","call2","call3"};
+    static const char *thresholds[]={"lower_adjoin0","lower_adjoin1","lower_adjoin2"};
+    for (int c=0;c<bot.world->numCogs;c++) {
+        sithCog *cog=&bot.world->aCogs[c];
+        int thing=Bot_CogReference(cog,"elevator");
+        if (thing<0) continue;
+        for (int k=0;k<nav.liftCount;k++) {
+            BotLift *lift=&nav.lifts[k];
+            if (lift->thing!=thing) continue;
+            lift->buttons=lift->thresholds=0;
+            for (unsigned b=0;b<sizeof(buttons)/sizeof(buttons[0]);b++) {
+                int s=Bot_CogSurface(cog,buttons[b]);
+                if (s>=0) lift->button[lift->buttons++]=s;
+            }
+            for (unsigned t=0;t<sizeof(thresholds)/sizeof(thresholds[0]);t++) {
+                int s=Bot_CogSurface(cog,thresholds[t]);
+                if (s>=0 && bot.world->surfaces[s].pAdjoin) lift->threshold[lift->thresholds++]=s;
+            }
+            /* lift_hop: the legs off ledges partway up the shaft. */
+            int hops=0;
+            for (int i=0;i<bot.nNodes;i++) {
+                if (nav.liftForNode[i]) continue;
+                for (int e=0;e<bot.nodes[i].nEdges;e++) {
+                    int to=bot.nodes[i].edges[e].to;
+                    if ((to==lift->node[0] || to==lift->node[1]) && fabsf(bot.nodes[to].pos.z-bot.nodes[i].pos.z)>0.25f) hops++;
+                }
+            }
+            fprintf(stderr,"BOT_LIFT name=%s event=bind lift=%d thing=%d cog=%d buttons=%d thresholds=%d hop_legs=%d\n",
+                bot.name,k,thing,c,lift->buttons,lift->thresholds,hops);
+        }
+    }
+}
+
+static void Bot_BindTraps(SithThing *self)
+{
+    traps.bound=1; traps.count=0; traps.exitNode=-1; traps.nFields=traps.nGates=0;
+    memset(traps.zone,0,sizeof(traps.zone)); memset(traps.gateNode,0,sizeof(traps.gateNode));
+    Bot_BindLifts();
+    for (int i=0;i<bot.world->numCogs && traps.count<BOT_TRAPS;i++) {
+        if (Bot_BindField(self,i)) continue;
+        BotTrap *t=&traps.list[traps.count];
+        if (!Bot_BindTrap(self,i,t)) continue;
+        int bit=1<<traps.count;
+        for (int n=0;n<bot.nNodes;n++)
+            if (Bot_TrapHolds(self,t,bot.nodes[n].pos,bot.nodes[n].sector)) { traps.zone[n]|=(uint16_t)bit; t->zoneNodes++; }
+        if (t->kind!=BOT_TRAP_FAN && Bot_TrapStand(self,t) && Bot_TrapHolds(self,t,t->stand.pos,t->stand.sector))
+            t->usable=0;
+        t->cel=Bot_TrapCel(t); t->celSince=bot.now;
+        Bot_TrapBindLog(t,traps.count);
+        traps.count++;
+    }
+    if (traps.nGates) Bot_GateDetours(self,1);
+    fflush(stderr);
+}
+
+static int Bot_TrapZoneLive(int node)
+{
+    for (int i=0;i<traps.count;i++) if (traps.list[i].live && (traps.zone[node]&(1<<i))) return 1;
+    return 0;
+}
+
+/* Read the switches, keep out of live zones. */
+static void Bot_TrapScan(SithThing *self)
+{
+    if (!traps.bound) {
+        if (!bot.graphDone) return;
+        Bot_BindTraps(self);
+    }
+    if (bot.now<traps.nextScan) return;
+    traps.nextScan=bot.now+0.2f;
+    if (traps.nGates && bot.now>=traps.nextDetours && !traps.use) Bot_GateDetours(self,0);
+    for (int i=0;i<traps.count;i++) {
+        BotTrap *t=&traps.list[i];
+        int cel=Bot_TrapCel(t);
+        if (cel!=t->cel) {
+            t->cel=cel; t->celSince=bot.now; t->changed=1;
+            fprintf(stderr,"BOT_TRAP name=%s event=state trap=%d kind=%s cel=%d\n",bot.name,i,botTrapKinds[t->kind],cel);
+            fflush(stderr);
+        }
+        /* The fan is safe only while it is seen stopped, with time to spare.
+           A field is live (dangerous to touch) while it is on. */
+        t->live=t->kind==BOT_TRAP_FAN ? !(cel==1 && t->changed && bot.now-t->celSince<t->offTime-2.5f) :
+            t->kind==BOT_TRAP_FIELD ? !cel : cel==1;
+        if (!t->live || !BT_ON(TRAP_AVOID)) continue;
+        for (int n=0;n<bot.nNodes;n++)
+            if ((traps.zone[n]&(1<<i)) && bot.nodes[n].avoidUntil<bot.now+0.5f) Bot_AvoidNode(&bot.nodes[n],0.5f);
+    }
+}
+
+/* Opponents a trap would catch: in its zone, or for the lightning within
+   2.5 of the ramp and likely onto it soon. A teammate there rules it out. */
+static int Bot_TrapCatches(SithThing *self,const BotTrap *t,int index,int *friendly)
+{
+    int caught=0;
+    *friendly=0;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        SithPlayer *p=&jkPlayer_playerInfos[i]; SithThing *other=p->pLocalPlayer;
+        if (!(p->flags&1) || !p->playerNetId || !other || other==self || other->type!=SITH_THING_PLAYER || !other->sector ||
+            (other->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED)) || other->actorParams.health<=0) continue;
+        int inside=Bot_TrapHolds(self,t,other->position,other->sector) ||
+            (t->kind==BOT_TRAP_LIGHTNING && Bot_TrapNear(t,1<<index,other->position,2.5f));
+        if (!inside) continue;
+        if (Bot_EnemyAllowed(self,(int)i)) caught++;
+        else if (!Bot_EnemyBase(self,(int)i)) *friendly=1;
+    }
+    return caught;
+}
+
+/* After a field is opened, the bot goes on to where it was headed; the
+   planner keeps that goal while it is still worth it. */
+static void Bot_TrapResume(void)
+{
+    bot.goal=traps.resumeGoal; bot.goalSetAt=traps.resumeSetAt;
+    bot.routeCount=bot.routePos=0; bot.nextPlan=bot.armNext=0;
+}
+
+/* A field whose switch could not be worked from a side is a wall from it
+   for 15 seconds, twice as long each time in a row, up to two minutes. */
+static void Bot_FieldFailed(BotField *f,int side)
+{
+    int k=side>0 ? 0 : 1;
+    if (f->fails[k]<4) f->fails[k]++;
+    f->failedUntil[k]=bot.now+Bot_Min(120.0f,15.0f*(flex_t)(1<<(f->fails[k]-1)));
+}
+
+/* End a run to a switch. A failed run rests that switch; a field whose
+   switch failed is a wall from that side for a while. */
+static void Bot_TrapEnd(const char *why,int failed)
+{
+    if (traps.use && why) {
+        BotTrap *t=&traps.list[traps.use-1];
+        SithThing *self=sithPlayer_g_pLocalPlayerThing;
+        if (failed) {
+            t->nextTry=bot.now+12.0f;
+            if (t->kind==BOT_TRAP_FIELD) Bot_FieldFailed(&traps.fields[t->field],t->side);
+        } else if (t->kind==BOT_TRAP_FIELD) traps.fields[t->field].fails[t->side>0 ? 0 : 1]=0;
+        fprintf(stderr,"BOT_TRAP name=%s event=abandon trap=%d kind=%s purpose=%s why=%s presses=%d phase=%d left=%.2f\n",
+            bot.name,traps.use-1,botTrapKinds[t->kind],botTrapPurposes[traps.purpose],why,traps.presses,traps.phase,
+            self ? (double)Bot_Distance(self->position,t->stand.pos) : -1.0);
+        fflush(stderr);
+    }
+    if (traps.use && traps.purpose==BOT_TRAP_OPEN && !failed) Bot_TrapResume();
+    else if (traps.use) { bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0; }
+    traps.use=traps.phase=traps.presses=0;
+}
+
+/* A committed traversal finishes first; a Force cast or a pull does not
+   stop the bot choosing where to go next. */
+static int Bot_TrapBusy(SithThing *self)
+{
+    return !(self->attach_flags&SITH_ATTACH_SURFACE) || (self->sector->flags&SITH_SECTOR_UNDERWATER) ||
+        nav.runPhase || nav.forceJumpPending || nav.jumpUntil>bot.now || nav.waterExitUntil>0 ||
+        nav.seekingSurface || nav.combatJumpUntil>bot.now || bot.nextRecovery>0 || bot.armDirect || nav.liftWaitAt;
+}
+
+/* Commit to a run: the route to the switch is set. */
+static void Bot_TrapBegin(int chosen,int purpose,flex_t dist,int victims)
+{
+    BotTrap *t=&traps.list[chosen];
+    traps.use=chosen+1; traps.phase=traps.presses=0; traps.purpose=purpose; traps.startCel=Bot_TrapCel(t); traps.dist=dist;
+    /* Paths price a Force Jump leg at its flight, and fights slow the way. */
+    traps.until=bot.now+4.0f+dist*2.0f; traps.routeAt=bot.now+1.0f;
+    bot.nextPlan=bot.now+1.0f; bot.armNext=traps.until;
+    if (bot.armItem) Bot_ClearEquipment("trap");
+    fprintf(stderr,"BOT_TRAP name=%s event=go trap=%d kind=%s purpose=%s dist=%.2f victims=%d\n",
+        bot.name,chosen,botTrapKinds[t->kind],botTrapPurposes[purpose],(double)dist,victims);
+    fflush(stderr);
+}
+
+static void Bot_TrapConsider(SithThing *self)
+{
+    if (!(BT(TRAP_USE)>0) || traps.use || bot.now<traps.nextConsider || !traps.count) return;
+    traps.nextConsider=bot.now+0.5f;
+    if (Bot_TrapBusy(self)) { bot.tele.trapBusy++; return; }
+    static flex_t distance[BOT_NODES];
+    static int parent[BOT_NODES];
+    int start=-1, chosen=-1, victims=0, purpose=BOT_TRAP_SPRING;
+    flex_t best=1e20f;
+    for (int i=0;i<traps.count;i++) {
+        BotTrap *t=&traps.list[i];
+        int friendly, caught, disarm=0;
+        if (!t->usable || t->kind==BOT_TRAP_FIELD || bot.now<t->nextTry) continue;
+        if (t->kind==BOT_TRAP_LIGHTNING && t->cel==1) {
+            if (!BT_ON(TRAP_DISARM)) continue;
+            disarm=1;
+        } else if (t->live || t->cel!=0) continue;
+        caught=Bot_TrapCatches(self,t,i,&friendly);
+        flex_t reach;
+        if (disarm) {
+            /* Armed and waiting: an opponent near the ramp keeps it that way.
+               Left a while, it is taken down by whoever passes, from farther
+               the longer it stands (twice trap_use at most, after about two
+               minutes); a teammate by the ramp wants it off now. */
+            flex_t armed=bot.now-t->celSince;
+            if (caught || (!friendly && armed<BOT_TRAP_SETTLE)) continue;
+            reach=friendly ? BT(TRAP_USE) : Bot_Min(2.0f*BT(TRAP_USE),1.5f+armed/10.0f);
+        } else {
+            /* The lightning is an ambush: armed in passing, it waits for the
+               next opponent onto the ramp. */
+            int passing=!caught && t->kind==BOT_TRAP_LIGHTNING &&
+                Bot_Distance(self->position,t->stand.pos)<1.5f;
+            if ((!caught && !passing) || friendly) continue;
+            reach=passing ? Bot_Min(BT(TRAP_USE),1.5f) : BT(TRAP_USE);
+        }
+        if (Bot_TrapHolds(self,t,self->position,self->sector)) continue;
+        if (start<0) {
+            if ((start=Bot_Nearest(self))<0) return;
+            traps.blockGates=1; Bot_PathDistances(self,start,distance,parent); traps.blockGates=0;
+            bot.tele.trapOpen++;
+        }
+        flex_t d=distance[t->standNode]+Bot_Distance(bot.nodes[t->standNode].pos,t->stand.pos);
+        if (d<bot.tele.trapNearest) bot.tele.trapNearest=d;
+        if (bot.now>=t->nextOpenLog) {
+            t->nextOpenLog=bot.now+10.0f;
+            fprintf(stderr,"BOT_TRAP name=%s event=open trap=%d kind=%s purpose=%s victims=%d dist=%.2f reach=%.2f start=%d stand_node=%d\n",
+                bot.name,i,botTrapKinds[t->kind],botTrapPurposes[disarm ? BOT_TRAP_DISARM : BOT_TRAP_SPRING],caught,
+                (double)(d<1e19f ? d : -1.0f),(double)reach,start,t->standNode);
+            fflush(stderr);
+        }
+        if (d>reach || d>=best) continue;
+        best=d; chosen=i; victims=caught; purpose=disarm ? BOT_TRAP_DISARM : BOT_TRAP_SPRING;
+    }
+    if (chosen<0) return;
+    BotTrap *t=&traps.list[chosen];
+    /* trap_chance: an opening is taken now and then, not every time; an
+       ambush laid in passing half as often. Taking one down is not left
+       to chance: how long it has stood armed already decides. */
+    if (purpose==BOT_TRAP_SPRING && Bot_Unit()>BT(TRAP_CHANCE)*(victims ? 1.0f : 0.5f)) {
+        t->nextTry=bot.now+(victims ? 4.0f : 20.0f); return;
+    }
+    if (!Bot_SetRoute(start,t->standNode,parent)) return;
+    Bot_TrapBegin(chosen,purpose,best,victims);
+}
+
+/* The first force-field gate on the route ahead that is shut, if any. */
+static int Bot_RouteGate(SithThing *self)
+{
+    if (bot.goal<0 || bot.routePos>=bot.routeCount) return -1;
+    for (int k=bot.routePos-1;k+1<bot.routeCount;k++) {
+        int from=k>=0 ? bot.route[k] : -1, to=bot.route[k+1];
+        if (k<0) {
+            /* The first leg starts at the node nearest the bot, as the
+               route follower reads it. */
+            int gated=0;
+            for (int g=0;g<traps.nGates && !gated;g++) gated=traps.gates[g].to==to;
+            if (gated) from=Bot_Nearest(self);
+        }
+        if (from<0 || !traps.gateNode[from]) continue;
+        for (int g=0;g<traps.nGates;g++) {
+            const BotGate *gate=&traps.gates[g];
+            if (gate->from==from && gate->to==to && !Bot_FieldOpen(&traps.fields[gate->field])) return g;
+        }
+    }
+    return -1;
+}
+
+/* field_switch: a route through a field that is on goes by the switch on
+   this side of it first. */
+static void Bot_FieldConsider(SithThing *self)
+{
+    if (!BT_ON(FIELD_SWITCH) || !traps.nGates || traps.use || bot.now<traps.nextGateCheck) return;
+    traps.nextGateCheck=bot.now+0.25f;
+    int g=Bot_RouteGate(self);
+    if (g<0 || Bot_TrapBusy(self)) return;
+    const BotGate *gate=&traps.gates[g];
+    BotField *f=&traps.fields[gate->field];
+    static flex_t distance[BOT_NODES];
+    static int parent[BOT_NODES];
+    int start=Bot_Nearest(self), chosen=-1, goal=bot.goal;
+    flex_t best=1e20f, goalSetAt=bot.goalSetAt;
+    if (start<0) return; /* no anchor this moment: look again shortly */
+    traps.blockGates=1; Bot_PathDistances(self,start,distance,parent); traps.blockGates=0;
+    for (int i=0;i<traps.count;i++) {
+        const BotTrap *t=&traps.list[i];
+        if (t->kind!=BOT_TRAP_FIELD || t->field!=gate->field || t->side!=gate->side ||
+            !t->usable || bot.now<t->nextTry) continue;
+        flex_t d=distance[t->standNode]+Bot_Distance(bot.nodes[t->standNode].pos,t->stand.pos);
+        if (d<best) { best=d; chosen=i; }
+    }
+    if (chosen<0 || best>=1e19f || best>BOT_FIELD_REACH || !Bot_SetRoute(start,traps.list[chosen].standNode,parent)) {
+        /* No switch within a fair walk from here: the field is a wall a while. */
+        Bot_FieldFailed(f,gate->side);
+        bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+        fprintf(stderr,"BOT_FIELD name=%s event=no-switch field=%d side=%d start=%d\n",bot.name,gate->field,gate->side,start);
+        fflush(stderr);
+        return;
+    }
+    traps.resumeGoal=goal; traps.resumeSetAt=goalSetAt;
+    Bot_TrapBegin(chosen,BOT_TRAP_OPEN,best,0);
+}
+
+/* The legs of a run to a switch: follow the route to the node beside it. */
+static void Bot_TrapLegs(SithThing *self)
+{
+    if (!traps.use || traps.phase) return;
+    BotTrap *t=&traps.list[traps.use-1];
+    /* A jump, a Force Jump's charge or flight, or a water exit on the way
+       finishes before the way is looked at again: in the air the nearest
+       node can be anywhere. */
+    int committed=nav.forceJumpPending || nav.jumpUntil>bot.now || nav.runPhase || nav.waterExitUntil>0 ||
+        !(self->attach_flags&SITH_ATTACH_SURFACE);
+    if (!committed && (bot.goal!=t->standNode || bot.routePos>=bot.routeCount || bot.now>=traps.routeAt)) {
+        static flex_t distance[BOT_NODES];
+        static int parent[BOT_NODES];
+        int start=Bot_Nearest(self);
+        if (start>=0) { traps.blockGates=1; Bot_PathDistances(self,start,distance,parent); traps.blockGates=0; }
+        if (start<0 || distance[t->standNode]>=1e19f || !Bot_SetRoute(start,t->standNode,parent)) {
+            Bot_TrapEnd("no-route",1); return;
+        }
+        /* The way there grew well past the walk the run was taken on: a
+           jump leg struck, no Force left for one, or a fight carried the
+           bot off. Not worth the trek. */
+        if (distance[t->standNode]>traps.dist+3.0f && distance[t->standNode]>1.5f*traps.dist) {
+            Bot_TrapEnd("too-far",1); return;
+        }
+        traps.routeAt=bot.now+1.0f;
+    }
+    bot.nextPlan=bot.now+0.5f;
+    Bot_Navigate(self);
+}
+
+/* 0: no trap run. 1: on the way to a switch; the run owns the legs and a
+   fight keeps the view. 2: at the switch; the run owns legs and view. */
+static int Bot_TrapTick(SithThing *self)
+{
+    Bot_TrapScan(self);
+    if (!traps.use) Bot_FieldConsider(self);
+    if (!traps.use) Bot_TrapConsider(self);
+    if (!traps.use) return 0;
+    BotTrap *t=&traps.list[traps.use-1];
+    int cel=Bot_TrapCel(t);
+    /* Someone else got there first. A field someone opened is good news. */
+    if (traps.phase<2 && cel!=traps.startCel) { Bot_TrapEnd("taken",traps.purpose!=BOT_TRAP_OPEN); return 0; }
+    if (bot.now>traps.until) { Bot_TrapEnd("timeout",1); return 0; }
+    if (traps.phase==2) {
+        if (cel!=traps.startCel) {
+            t->nextTry=bot.now+(traps.purpose==BOT_TRAP_OPEN ? 4.0f : BOT_TRAP_REST);
+            if (traps.purpose==BOT_TRAP_DISARM) bot.tele.trapsDisarmed++;
+            else if (traps.purpose==BOT_TRAP_OPEN) bot.tele.fieldsOpened++;
+            else bot.tele.trapsSprung++;
+            fprintf(stderr,"BOT_TRAP name=%s event=%s trap=%d kind=%s presses=%d\n",
+                bot.name,botTrapDone[traps.purpose],traps.use-1,botTrapKinds[t->kind],traps.presses);
+            fflush(stderr);
+            if (traps.purpose==BOT_TRAP_OPEN) {
+                traps.fields[t->field].fails[t->side>0 ? 0 : 1]=0;
+                Bot_TrapResume();
+            } else { bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0; }
+            traps.use=traps.phase=traps.presses=0;
+            return 0;
+        }
+        if (bot.now-traps.pressedAt>1.2f) {
+            if (traps.presses>=2) { Bot_TrapEnd("no-response",1); return 0; }
+            traps.phase=1;
+        }
+    }
+    rdVector3 delta=Bot_Sub(t->stand.pos,self->position);
+    flex_t h=Bot_Horizontal(delta);
+    if (!traps.phase) {
+        int beside=h<0.5f || Bot_Distance(self->position,bot.nodes[t->standNode].pos)<0.2f;
+        if (!beside || fabsf(delta.z)>0.3f || !(self->attach_flags&SITH_ATTACH_SURFACE) ||
+            !Bot_Clear(self,self->sector,self->position,t->stand.pos,self->collideSize*0.8f,0)) return 1;
+        traps.phase=1;
+    }
+    /* Look at the switch from the eye and step onto the spot. */
+    rdVector3 aim=Bot_Sub(t->aim,self->actorParams.eyeOffset);
+    flex_t error=Bot_Aim(self,aim,0);
+    if (h>0.03f && !Bot_NavDirectMove(self,t->stand.pos,0)) Bot_Move(self,delta,0);
+    if (traps.phase==1 && error<8.0f && !bot.previous[INPUT_FUNC_ACTIVATE] &&
+        Bot_UseTarget(self) && botUseSurface==&bot.world->surfaces[t->button]) {
+        bot.keys[INPUT_FUNC_ACTIVATE]=1; bot.tele.uses++;
+        traps.phase=2; traps.pressedAt=bot.now; traps.presses++;
+        fprintf(stderr,"BOT_TRAP name=%s event=press trap=%d kind=%s purpose=%s\n",
+            bot.name,traps.use-1,botTrapKinds[t->kind],botTrapPurposes[traps.purpose]);
+        fflush(stderr);
+    }
+    return 2;
+}
+
+/* Caught in a live zone: take the cheapest way to the nearest node outside
+   every live zone. Committed jumps and water exits finish first. */
+static void Bot_TrapEscape(SithThing *self)
+{
+    if (!BT_ON(TRAP_AVOID) || traps.phase || !traps.count) return;
+    const BotTrap *caught=NULL;
+    for (int i=0;i<traps.count && !caught;i++)
+        if (traps.list[i].live && Bot_TrapHolds(self,&traps.list[i],self->position,self->sector)) caught=&traps.list[i];
+    flex_t health=self->actorParams.health, lost=traps.health-health;
+    traps.health=health;
+    if (caught && lost>0.5f) {
+        fprintf(stderr,"BOT_TRAP name=%s event=hurt trap=%d kind=%s lost=%.1f health=%.1f\n",bot.name,
+            (int)(caught-traps.list),botTrapKinds[caught->kind],(double)lost,(double)health);
+        fflush(stderr);
+    }
+    if (!caught) { traps.exitNode=-1; return; }
+    if (!(self->attach_flags&SITH_ATTACH_SURFACE) || nav.runPhase || nav.forceJumpPending ||
+        nav.jumpUntil>bot.now || nav.waterExitUntil>0) return;
+    if (traps.exitNode<0 || bot.goal!=traps.exitNode || bot.now>=traps.nextEscape) {
+        static flex_t distance[BOT_NODES];
+        static int parent[BOT_NODES];
+        traps.nextEscape=bot.now+0.6f;
+        int start=Bot_Nearest(self), best=-1;
+        if (start<0) return;
+        traps.blockGates=1; Bot_PathDistances(self,start,distance,parent); traps.blockGates=0;
+        for (int n=0;n<bot.nNodes;n++)
+            if (distance[n]<1e19f && !Bot_TrapZoneLive(n) && (best<0 || distance[n]<distance[best])) best=n;
+        if (best<0 || !Bot_SetRoute(start,best,parent)) return;
+        if (traps.exitNode<0) {
+            bot.tele.trapEscapes++;
+            fprintf(stderr,"BOT_TRAP name=%s event=escape trap=%d kind=%s cost=%.2f\n",bot.name,
+                (int)(caught-traps.list),botTrapKinds[caught->kind],(double)distance[best]);
+            fflush(stderr);
+        }
+        traps.exitNode=best;
+    }
+    bot.nextPlan=bot.now+0.5f;
+    Bot_Navigate(self);
+}
