+/* Bot_Recovery handles a bot that cannot move. This handles one that moves
+   and still goes nowhere: failed water exits, a jump that keeps missing, two
+   goals that undo each other. Positions are sampled across the window; if
+   every sample lies within the radius of their centre while the bot is not
+   waiting for something or fighting on dry ground, the bot is confined.
+   Each escape gives up the current goal and avoids the places being tried.
+   Repeats within 45 seconds double the avoid time and widen it to nearby
+   places, so the next plan must lead somewhere else. In water the bot also
+   takes the existing air-and-bank escape and remembers the dive as failed.
+   A hold shorter than two seconds only pauses the sampling, so a bot bobbing
+   between a bank and the water, or glimpsing an opponent, is still caught. */
+static int Bot_HoldingPosition(SithThing *self)
+{
+    if (!bot.graphDone || bot.nNodes<1 || (self->actorParams.flags&SITH_AF_IMMOBILE)) return 1;
+    if (nav.waitUntil>bot.now || nav.liftWaitAt>0 || nav.crossingEntry) return 1;
+    if (nav.objectiveValid && (nav.objective==BOT_OBJECTIVE_DEFEND || nav.objective==BOT_OBJECTIVE_ESCORT)) return 1;
+    if (self->sector->flags&SITH_SECTOR_UNDERWATER) return 0;
+    /* On dry ground a fight may stay put, and a bot the planner gave no
+       destination has nothing to escape from. This runs after the planner. */
+    return bot.targetSlot>=0 || (bot.goal<0 && !bot.armItem && !nav.diveEscape);
+}
