+/* leg_square: whether the whole body can set off along a heading. The
+   engine stops a body moving toward a wall wherever the point where it
+   would touch the wall's plane lies within the body's radius of a solid
+   face, its corners included, and a body stopped at a jamb's corner slides
+   no further. The steering probe is slimmer than the body, so at a narrow
+   opening it passes moves the body cannot make. A short sweep a little
+   above the feet's level, so that a walkable ramp ahead does not count. */
+static int Bot_BodyClear(SithThing *self,rdVector3 toward)
+{
+    flex_t length=Bot_Horizontal(toward);
+    if (!BT_ON(LEG_SQUARE) || length<0.001f) return 1;
+    rdVector3 from=self->position;
+    from.z+=0.03f;
+    rdVector3 to={from.x+toward.x/length*0.04f,from.y+toward.y/length*0.04f,from.z};
+    return Bot_Clear(self,self->sector,from,to,self->moveSize,0);
+}
