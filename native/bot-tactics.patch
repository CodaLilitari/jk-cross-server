+/* Turning back for air before reaching the destination means that way into
+   the water did not pay. Remember the entry so the planner prices it out,
+   and set the destination aside, for dive_retry seconds. A bot that already
+   has what it came for is on its way out and is left alone. */
+static void Bot_CheckAirReturn(SithThing *self)
+{
+    if (!(self->sector->flags&SITH_SECTOR_UNDERWATER)) {
+        if (bot.tele.wasWet) bot.entryFrom=bot.entryTo=bot.crossing=0; /* out again: that entry is spent */
+        if (bot.crossing && bot.now-bot.crossingAt>2.0f) bot.crossing=0; /* never went in */
+        bot.airReturn=0;
+        return;
+    }
