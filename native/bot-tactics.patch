+    if (kind==BOT_ITEM_UNKNOWN || kind==BOT_ITEM_KEY || kind==BOT_ITEM_FLAG || kind==BOT_ITEM_TOOL) return 0;
+    flex_t distance=Bot_Distance(self->position,item->position);
+    /* A choice keeps a margin for the slide to a stop and the turn.
+       pull_on_move: a pull under way may close right in, running onto the
+       item; the stock power has no least distance. */
+    flex_t nearest=BT_ON(PULL_ON_MOVE) && bot.pullItem ? 0 : 0.45f+margin;
+    return distance>=nearest && distance<=range-0.05f-margin && Bot_Len(item->physicsParams.vel)<0.2f &&
+        sithCollision_HasLOS(self,item,0);
+}
+static SithThing *Bot_PulledItem(void)
+{
+    if (bot.pullItem<=0 || bot.pullItem>Bot_ThingCount()) return NULL;
+    SithThing *item=&bot.world->aThings[bot.pullItem-1];
+    return item->type==SITH_THING_ITEM && item->guid==bot.pullItemGuid &&
+        !(item->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED)) ? item : NULL;
+}
+static void Bot_PullStill(SithThing *self)
+{
+    (void)self;
+    bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+    bot.keys[INPUT_FUNC_JUMP]=bot.keys[INPUT_FUNC_DUCK]=0;
+    bot.moveRun=bot.moveBoost=0;
+}
+/* pull_on_move: the stock pull needs the item in view and in reach at the
+   last pulse and in sight at release; it then throws the item at wherever
+   the puller stands at that moment, gravity off for 1.5 s. Nothing needs
+   the puller to stand still. Before the throw, run at the item where that
+   way is safe: it stays in view and in reach and comes in sooner. Elsewhere
+   keep the route's own movement. After the throw, run onto the item as it
+   flies in; where that way is not safe, wait for it, since it is coming to
+   the spot of the release. */
+static int Bot_PullRunAt(SithThing *self,SithThing *item)
+{
+    rdVector3 toward=Bot_Sub(item->position,self->position), blocked;
+    flex_t horizontal=Bot_Horizontal(toward);
+    bot.keys[INPUT_FUNC_JUMP]=bot.keys[INPUT_FUNC_DUCK]=0;
+    if (horizontal<0.03f || !Bot_SafeDirection(self,toward,0,horizontal,&blocked)) return 0;
+    bot.moveRun=1; bot.moveBoost=0;
+    Bot_Move(self,toward,0);
+    return 1;
+}
+static void Bot_PullMove(SithThing *self,SithThing *item,int thrown)
+{
+    if (!BT_ON(PULL_ON_MOVE)) { Bot_PullStill(self); return; }
+    if (!Bot_PullRunAt(self,item) && thrown) {
+        bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+        bot.moveRun=bot.moveBoost=0;
+    }
+}
+static void Bot_EndItemPull(SithThing *self, const char *event)
+{
+    SithThing *item=bot.pullItem>0 && bot.pullItem<=Bot_ThingCount() ? &bot.world->aThings[bot.pullItem-1] : NULL;
+    fprintf(stderr,"BOT_PULL name=%s item=%s dist=%.2f phase=%d event=%s\n",bot.name,item ? Bot_ItemName(item) : "",
+        (double)Bot_Distance(self->position,bot.pullItemPos),bot.pullPhase,event);
+    fflush(stderr);
+    if (strcmp(event,"caught")) { bot.pullItemLast=bot.pullItem; bot.pullItemLastUntil=bot.now+10.0f; }
+    bot.pullItem=bot.pullPhase=0; bot.nextItemPull=bot.now+1.5f;
+}
+static int Bot_ItemPullBusy(SithThing *self)
+{
+    /* pull_on_move: once under way, a pull runs on through the bounce of a
+       run over uneven ground; the stock power does not need footing. */
+    int footing=(self->attach_flags&SITH_ATTACH_SURFACE) || (BT_ON(PULL_ON_MOVE) && bot.pullItem);
+    return !footing || (self->sector->flags&SITH_SECTOR_UNDERWATER) ||
+        bot.routeAim || nav.runPhase || nav.combatJumpUntil>bot.now || nav.forceJumpPending ||
+        nav.jumpUntil>bot.now || nav.waterExitUntil>0 || nav.seekingSurface || bot.nextRecovery>0;
+}
+static void Bot_TryItemPull(SithThing *self)
+{
+    flex_t least=BT(ITEM_PULL), cost=Bot_ForceCost(self,SITHBIN_F_PULL)+Bot_ForceCost(self,SITHBIN_F_JUMP);
+    if (!(least>0) || bot.pullItem || bot.now<bot.nextItemPull || bot.forceBin>=0 || bot.now<bot.nextForce ||
+        bot.forceCancel || Bot_ActiveCompetitiveGrip(self) || Bot_ItemPullBusy(self) ||
+        !Bot_ForceReady(self,SITHBIN_F_PULL,cost)) return;
+    bot.nextItemPull=bot.now+0.25f;
+    flex_t range=Bot_ForceRange(self,SITHBIN_F_PULL);
+    int count=Bot_ThingCount(), found=0;
+    for (int i=0;i<count;i++) {
+        SithThing *item=&bot.world->aThings[i];
+        if (item->type!=SITH_THING_ITEM || (item->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED)) ||
+            (i+1==bot.pullItemLast && bot.now<bot.pullItemLastUntil)) continue;
+        flex_t distance=Bot_Distance(self->position,item->position);
+        if (distance<0.75f || distance>range-0.35f) continue;
+        flex_t value=Bot_ItemValue(self,i);
+        if (value<least || !Bot_ItemPullable(self,item,range,0.3f)) continue;
+        least=value; found=i+1;
+    }
+    if (!found) return;
+    SithThing *item=&bot.world->aThings[found-1];
+    bot.pullItem=found; bot.pullItemGuid=item->guid; bot.pullItemPos=item->position;
+    bot.pullPhase=1; bot.pullPhaseUntil=bot.now+1.2f;
+}
