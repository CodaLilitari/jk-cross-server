+/* lift_call: a threshold adjoin at this level with the bot on the shaft
+   side, and the landing node beyond it. Crossing one onto the platform is
+   what sets the stock elevators going (00_elev_switch2.cog); a rider that
+   boarded while the lift was still moving never crossed it. */
+static int Bot_LiftThreshold(SithThing *self,const BotLift *lift,rdVector3 *at,rdVector3 *normal,int *landing)
+{
+    for (int i=0;i<lift->thresholds;i++) {
+        SithSurface *s=&bot.world->surfaces[lift->threshold[i]];
+        rdVector3 c, n=s->surfaceInfo.face.normal;
+        flex_t nh=Bot_Horizontal(n);
+        if (!Bot_FaceCenter(s,&c) || nh<0.7f || fabsf(c.z-self->position.z)>0.5f) continue;
+        n.x/=nh; n.y/=nh; n.z=0;
+        /* The face looks into its own sector, the landing. */
+        if ((self->position.x-c.x)*n.x+(self->position.y-c.y)*n.y>0) continue;
+        int best=-1;
+        flex_t nearest=1.5f;
+        for (int j=0;j<bot.nNodes;j++) {
+            const BotNode *node=&bot.nodes[j];
+            flex_t side=(node->pos.x-c.x)*n.x+(node->pos.y-c.y)*n.y, d=Bot_Distance(node->pos,c);
