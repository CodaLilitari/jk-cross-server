+/* water_fight: a heavy gun kicks its shooter back 80 force units. Hold it
+   through the run-up and the jump, and while the swimmer has all but
+   settled on the launch spot; any other gun, or any other moment, fires. */
+static int Bot_ExitHoldsFire(SithThing *self,int weapon)
+{
+    if (!Bot_CombatJumpRecoilGun(weapon) || nav.waterExitUntil<=0) return 0;
+    rdVector3 off=Bot_Sub(nav.waterExitStart,self->position);
+    int settling=!nav.waterExitPhase && (self->physicsParams.flags&SITH_PF_ONWATERSURFACE) &&
+        Bot_Horizontal(off)<0.06f && Bot_Horizontal(self->physicsParams.vel)<0.15f;
+    return nav.waterExitPhase==1 || nav.waterExitPhase==2 || settling;
+}
 
