+/* leg_axis: walk to a point along the line from another, first getting
+   back onto that line where the straight way is not clear: Bespin's lift
+   decks and door alcoves are reached through openings 0.2 wide. */
+static int Bot_AxisMove(SithThing *self,rdVector3 from,rdVector3 to)
+{
+    rdVector3 leg=Bot_Sub(to,from), toward=Bot_Sub(to,self->position);
+    flex_t length=Bot_Horizontal(leg);
+    flex_t ux=length>=0.05f ? leg.x/length : 0, uy=length>=0.05f ? leg.y/length : 0;
+    flex_t along=(self->position.x-from.x)*ux+(self->position.y-from.y)*uy;
+    flex_t off=(self->position.y-from.y)*ux-(self->position.x-from.x)*uy;
+    /* leg_square: off the line, the straight way must suit the whole body. */
+    int offLine=BT_ON(LEG_AXIS) && length>=0.05f && fabsf(off)>0.015f && Bot_Horizontal(toward)>0.05f;
+    if ((!offLine || Bot_BodyClear(self,toward)) && Bot_NavDirectMove(self,to,0)) return 1;
+    if (!BT_ON(LEG_AXIS) || length<0.05f) return 0;
+    flex_t ahead=Bot_Clamp(along,0,length)+0.04f;
+    rdVector3 onto={from.x+ux*ahead,from.y+uy*ahead,self->position.z};
+    if (Bot_Horizontal(Bot_Sub(onto,self->position))<0.01f) return 0;
+    if (!Bot_BodyClear(self,Bot_Sub(onto,self->position)) || !Bot_NavDirectMove(self,onto,0)) {
+        /* leg_square: a body against the wall beside the opening meets its
+           jamb on that slant too. Step square onto the line, along the
+           wall, at least far enough for the move to register; the straight
+           way opens once the body is clear of the jamb. Bespin's lift 2: a
+           rider stood 25 s in the corner of the shaft beside the opening. */
+        if (!BT_ON(LEG_SQUARE) || fabsf(off)<=0.015f) return 0;
+        flex_t back=Bot_Max(fabsf(off),0.036f)*(off>0 ? 1.0f : -1.0f);
+        rdVector3 foot={self->position.x+uy*back,self->position.y-ux*back,self->position.z};
+        if (!Bot_NavDirectMove(self,foot,0)) return 0;
+        bot.tele.legSquare+=bot.frameDt;
+    }
+    bot.tele.legAxis+=bot.frameDt;
+    return 1;
+}
