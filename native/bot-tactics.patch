+    if (bot.armItem && !bot.armDirect) Bot_Avoid(bot.armNode-1,until);
+    for (int i=0;reach>0 && i<bot.nNodes;i++)
+        if (Bot_Distance(bot.nodes[i].pos,self->position)<=reach) Bot_Avoid(i,until);
+    fprintf(stderr,"BOT_CONFINED name=%s t=%.2f sector=%u pos=%.3f,%.3f,%.3f wet=%d strikes=%d tabu=%.1f reach=%.2f node=%d goal=%d\n",
+        bot.name,(double)bot.now,self->sector->id,(double)self->position.x,(double)self->position.y,
+        (double)self->position.z,wet,strikes,(double)tabu,(double)reach,node,goal);
