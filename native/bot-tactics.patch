+/* The stock ground controls add forward thrust (halved backward) and 0.7
+   strafe thrust without normalizing the sum. Choose the two ordinary axes
+   whose sum points exactly along the wanted direction with the largest
+   magnitude the axes allow. Without the diagonal the magnitude is held to one
+   forward key's worth. Air and water controls do not halve backward thrust. */
+static void Bot_ThrustAxes(SithThing *self,rdVector3 desired,int diagonal)
+{
+    flex_t c=Bot_Dot(desired,self->orient.lvec), s=Bot_Dot(desired,self->orient.rvec);
+    flex_t n=sqrtf(c*c+s*s);
+    if (n<0.001f) return;
+    c/=n; s/=n;
+    flex_t gain=c<0 && self->attach_flags ? 0.5f : 1.0f, k=diagonal ? BOT_DIAGONAL_GAIN : 1.0f;
+    if (fabsf(c)>0.0001f) k=Bot_Min(k,gain/fabsf(c));
+    if (fabsf(s)>0.0001f) k=Bot_Min(k,BOT_STRAFE_GAIN/fabsf(s));
+    bot.axes[INPUT_FUNC_FORWARD]=Bot_Clamp(k*c/gain,-1.0f,1.0f);
+    bot.axes[INPUT_FUNC_SLIDE]=Bot_Clamp(k*s/BOT_STRAFE_GAIN,-1.0f,1.0f);
+}
+
+/* The run key doubles ground thrust and the diagonal adds a fifth more, so
+   stopping takes proportionally more room. Ground speed settles at thrust
+   over surface drag, and a coasting actor travels its speed over that drag.
+   Returns the floor to check ahead: that coasting distance at the speed the
+   bot is about to reach plus a quarter unit, or 0 on footing that is not
+   ordinary dry ground. */
+static flex_t Bot_Runway(SithThing *self,int run,int diagonal)
+{
+    flex_t drag=self->physicsParams.surfDrag;
+    flex_t thrust=self->actorParams.maxThrust+self->actorParams.extraSpeed;
+    if (!(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE)) || !(drag>=1.0f) || !(thrust>0) ||
+        (self->physicsParams.flags&(SITH_PF_CROUCHING|SITH_PF_ONWATERSURFACE|SITH_PF_200000)) ||
+        (self->actorParams.flags&SITH_AF_IMMOBILE) ||
+        (self->sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY)) ||
+        ((self->attach_flags&SITH_ATTACH_SURFACE) && self->attachedSurface &&
+         (self->attachedSurface->flags&(SITH_SURFACE_WATER|SITH_SURFACE_VERYDEEPWATER|
+                                        SITH_SURFACE_ICY|SITH_SURFACE_VERYICY)))) return 0;
+    flex_t top=thrust*(run ? 2.0f : 1.0f)*(diagonal ? BOT_DIAGONAL_GAIN : 1.0f)/drag;
+    flex_t speed=Bot_Max(top,Bot_Horizontal(self->physicsParams.vel));
+    return Bot_Clamp(0.25f+speed/drag,0.45f,2.0f);
+}
