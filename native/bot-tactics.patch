+        fprintf(stderr,"BOT_LIFT name=%s t=%.2f event=press lift=%d button=%d riding=%d\n",bot.name,(double)bot.now,id-1,lift->button[best],riding);
+        fflush(stderr);
+    }
+    return 1;
