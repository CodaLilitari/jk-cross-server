+/* dead_end: the bot has had no goal for two seconds and the node nearest it
+   reaches almost nothing: a pit it fell into, with no leg out. Bespin's,
+   under the main floor, ends on a pair of floor doors (00_door.cog) that
+   open on use and drop a player into the room below; recovery only pressed
+   use at what lay ahead. Stood on such a door, the bot looks straight down
+   and presses use. 1: the escape owns the view and the use key. */
+/* dead_end: where the pieces of the door the bot stands on part, from the
+   door COG that moves them together (door0 to door3). 0: no such COG. */
+static int Bot_DoorSeam(const SithThing *floor,rdVector3 *seam)
+{
+    static const char *pieces[]={"door0","door1","door2","door3"};
+    int index=(int)(floor-bot.world->aThings);
+    for (int c=0;c<bot.world->numCogs;c++) {
+        sithCog *cog=&bot.world->aCogs[c];
+        int ids[4], count=0, mine=0;
+        for (int k=0;k<4;k++) {
+            int id=Bot_CogReference(cog,pieces[k]);
+            if (id<0 || id>=Bot_ThingCount()) continue;
+            ids[count++]=id; mine|=id==index;
+        }
+        if (!mine || count<2) continue;
+        *seam=(rdVector3){0,0,0};
+        for (int k=0;k<count;k++) {
+            seam->x+=bot.world->aThings[ids[k]].position.x; seam->y+=bot.world->aThings[ids[k]].position.y;
+        }
+        seam->x/=count; seam->y/=count; seam->z=0;
+        return count;
+    }
+    return 0;
+}
