+/* The surface or thing the last Bot_UseTarget met, if it met one. */
+static SithSurface *botUseSurface;
+static SithThing *botUseThing;
+static int Bot_TrapButton(const SithSurface *surface);
+
+/* The stock activate test, without its side effects: from the eye, along
+   the view, moveSize+0.1 ahead, a COG-linked surface or a captured thing
+   that is not an item or a weapon. */
+static int Bot_UseTarget(SithThing *self)
+{
+    rdVector3 eye=self->position, look=self->orient.lvec;
+    if (self->type==SITH_THING_ACTOR || self->type==SITH_THING_PLAYER) {
+        /* Head pitch tilts the view about the body's right axis. */
+        flex_t pitch=self->actorParams.headPYR.x/BOT_DEG, c=cosf(pitch), s=sinf(pitch);
+        look.x=self->orient.lvec.x*c+self->orient.uvec.x*s;
+        look.y=self->orient.lvec.y*c+self->orient.uvec.y*s;
+        look.z=self->orient.lvec.z*c+self->orient.uvec.z*s;
+        eye.x+=self->actorParams.eyeOffset.x; eye.y+=self->actorParams.eyeOffset.y; eye.z+=self->actorParams.eyeOffset.z;
+    }
+    SithSector *sector=Bot_SectorAt(&eye,self->sector);
+    botUseSurface=NULL; botUseThing=NULL;
+    if (!sector) return 0;
+    int found=0;
+    sithCollision_SearchForCollisions(sector,self,&eye,&look,self->moveSize+0.1f,0.025f,RAYCAST_2);
+    SithCollision *hit;
+    while ((hit=sithCollision_PopStack())) {
+        if ((hit->type&SITHCOLLISION_WORLD) && hit->surface && (hit->surface->flags&SITH_SURFACE_COG_LINKED)) {
+            botUseSurface=hit->surface; found=1; break;
+        }
+        if ((hit->type&SITHCOLLISION_THING) && hit->pThingCollided && hit->pThingCollided->type!=SITH_THING_ITEM &&
+            hit->pThingCollided->type!=SITH_THING_WEAPON && (hit->pThingCollided->flags&SITH_TF_CAPTURED)) {
+            botUseThing=hit->pThingCollided; found=1; break;
+        }
+    }
+    sithCollision_DecreaseStackLevel();
+    return found;
+}
