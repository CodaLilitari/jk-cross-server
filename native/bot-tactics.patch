+/* pack_hunt: try a few more graph nodes for a walk onto the pack's contact,
+   nearest the pack first. The rotating probe this replaces tried nodes
+   nearest the bot, which next to a ledge are the ones below it. */
+static void Bot_GrowPackRoute(SithThing *self,BotPackRoute *r)
+{
+    if (r->exhausted || r->count>=BOT_PACK_APPROACHES) return;
+    int list[BOT_PACK_CANDIDATES], n=0;
+    flex_t tail[BOT_PACK_CANDIDATES];
+    for (int i=0;i<bot.nNodes;i++) {
+        flex_t d=Bot_Distance(bot.nodes[i].pos,r->end.pos);
+        if (d>2.0f) continue;
+        int k;
+        if (n<BOT_PACK_CANDIDATES) k=n++;
+        else if (d<tail[n-1]) k=n-1;
+        else continue;
+        while (k>0 && tail[k-1]>d) { list[k]=list[k-1]; tail[k]=tail[k-1]; k--; }
+        list[k]=i; tail[k]=d;
+    }
+    for (int tests=0;r->tested<n && tests<BOT_PACK_TESTS && r->count<BOT_PACK_APPROACHES;tests++) {
+        int candidate=list[r->tested++];
+        if (Bot_EquipmentSpan(self,&bot.nodes[candidate],&r->end)) r->approach[r->count++]=candidate;
+    }
+    if (r->tested>=n) r->exhausted=1;
+}
