@@ -0,0 +1,368 @@
+/* Ordnance on the ground and the bot's own: sequencer charges and resting
+   grenades to keep clear of, and proximity mines to lay. */
+
+#define BOT_HAZARDS 24
+#define BOT_OWN_MINES 4
+
+/* A weapon thing at rest with an explosion of its own: a laid sequencer
+   charge (a proximity mine once armed, 60 s), a bouncing thermal on its
+   fuse, a stuck rail charge. Shots in flight are the dodge's business. */
+static int Bot_HazardOf(SithThing *t, BotHazard *out)
+{
+    if (t->type!=SITH_THING_WEAPON || (t->flags&(SITH_TF_DESTROYED|SITH_TF_DISABLED|SITH_TF_DEAD)) || !t->sector) return 0;
+    SithThing *blast=t->weaponParams.pExplosionTemplate;
+    if (!blast || blast->type!=SITH_THING_EXPLOSION || !(blast->explosionParams.range>0) ||
+        !isfinite(blast->explosionParams.range)) return 0;
+    if (!t->attach_flags && Bot_Len(t->physicsParams.vel)>0.6f) return 0;
+    int proximity=(t->weaponParams.flags&SITH_WF_PROXIMITY) || t->msecLifeLeft>10000;
+    out->pos=t->position; out->sector=t->sector;
+    out->blast=blast->explosionParams.range;
+    out->trigger=proximity ? Bot_Max(t->collideSize,0.30f) : 0;
+    out->fuse=proximity ? 0 : t->msecLifeLeft/1000.0f;
+    out->mine=proximity; out->own=t->pParent==sithPlayer_g_pLocalPlayerThing;
+    return 1;
+}
+
+/* How close the bot may come: inside a mine's trigger sphere it goes off,
+   inside a fused grenade's blast it hurts when the fuse runs out. */
+static flex_t Bot_HazardReach(const BotHazard *h)
+{
+    return h->mine ? h->trigger+0.25f : h->blast+0.20f;
+}
+
+static void Bot_ScanHazards(SithThing *self)
+{
+    if (bot.now<nav.nextHazardScan) return;
+    nav.nextHazardScan=bot.now+0.2f; nav.nHazards=0;
+    if (!BT_ON(HAZARD_AVOID)) return;
+    int count=Bot_ThingCount();
+    for (int i=0;i<count && nav.nHazards<BOT_HAZARDS;i++) {
+        BotHazard h;
+        if (!Bot_HazardOf(&bot.world->aThings[i],&h)) continue;
+        nav.hazards[nav.nHazards++]=h;
+        flex_t reach=Bot_HazardReach(&h);
+        for (int n=0;n<bot.nNodes;n++)
+            if (Bot_Distance(bot.nodes[n].pos,h.pos)<reach) {
+                if (bot.nodes[n].avoidUntil<bot.now+0.5f) bot.tele.hazardNodes++;
+                Bot_AvoidNode(&bot.nodes[n],h.mine ? 1.0f : Bot_Max(0.5f,h.fuse+0.3f));
+            }
+    }
+    (void)self;
+}
+
+/* Planned legs that pass a hazard cost as much as an avoided node. */
+static int Bot_EdgeHazard(rdVector3 from, rdVector3 to)
+{
+    for (int i=0;i<nav.nHazards;i++) {
+        const BotHazard *h=&nav.hazards[i];
+        rdVector3 d=Bot_Sub(to,from);
+        flex_t len2=Bot_Dot(d,d), t=len2>1e-6f ? Bot_Dot(Bot_Sub(h->pos,from),d)/len2 : 0;
+        t=Bot_Clamp(t,0,1);
+        rdVector3 p={from.x+d.x*t,from.y+d.y*t,from.z+d.z*t};
+        if (Bot_Distance(p,h->pos)<Bot_HazardReach(h)) return 1;
+    }
+    return 0;
+}
+
+/* Inside a fused grenade's blast, or about to brush a mine: step away now. */
+static int Bot_EscapeHazard(SithThing *self)
+{
+    const BotHazard *worst=NULL; flex_t margin=0;
+    for (int i=0;i<nav.nHazards;i++) {
+        const BotHazard *h=&nav.hazards[i];
+        flex_t limit=h->mine ? h->trigger+self->collideSize+0.12f : h->blast+self->collideSize+0.15f;
+        flex_t inside=limit-Bot_Distance(self->position,h->pos);
+        if (inside>margin) { margin=inside; worst=h; }
+    }
+    if (!worst) return 0;
+    rdVector3 away=Bot_Sub(self->position,worst->pos); away.z=0;
+    if (Bot_Horizontal(away)<0.01f) away=(rdVector3){-self->orient.lvec.x,-self->orient.lvec.y,0};
+    if (bot.now>=nav.nextHazardLog) {
+        nav.nextHazardLog=bot.now+1.0f;
+        fprintf(stderr,"BOT_HAZARD name=%s kind=%s own=%d dist=%.2f fuse=%.1f event=escape\n",bot.name,
+            worst->mine ? "mine" : "fused",worst->own,(double)Bot_Distance(self->position,worst->pos),(double)worst->fuse);
+        fflush(stderr);
+    }
+    bot.moveRun=1; Bot_Move(self,away,0);
+    return 1;
+}
+
+/* Laying a proximity mine (the stock secondary of the sequencer charge,
+   armed two seconds after it lands) on an item spot just taken, so the
+   next player who comes for that item's respawn finds it. */
+static int Bot_OwnMines(void)
+{
+    int live=0;
+    for (int i=0;i<BOT_OWN_MINES;i++) if (nav.ownMines[i]>bot.now) live++;
+    return live;
+}
+static int Bot_OrdnanceBusy(SithThing *self)
+{
+    return !(self->attach_flags&SITH_ATTACH_SURFACE) || (self->sector->flags&SITH_SECTOR_UNDERWATER) ||
+        bot.routeAim || nav.runPhase || nav.combatJumpUntil>bot.now || nav.forceJumpPending ||
+        nav.jumpUntil>bot.now || nav.waterExitUntil>0 || nav.seekingSurface || bot.nextRecovery>0 ||
+        bot.pullPhase>0 || bot.forceBin>=0;
+}
+static int Bot_MinePeaceful(SithThing *self)
+{
+    if (sithNet_MultiModeFlags&MULTIMODEFLAG_TEAMS) return 1;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        SithThing *t=jkPlayer_playerInfos[i].pLocalPlayer;
+        if (t && t!=self && (jkPlayer_playerInfos[i].flags&1) && Bot_IsPeaceful(self,(int)i)) return 1;
+    }
+    return 0;
+}
+/* Items worth guarding for anyone: the heavy guns, armour and health. */
+static int Bot_GuardedItem(SithThing *item)
+{
+    BotPickupKind kind=Bot_PickupType(item);
+    switch (kind.kind) {
+        case BOT_ITEM_WEAPON:
+            return kind.bin==SITHBIN_CONCUSSION_RIFLE || kind.bin==SITHBIN_RAIL_DETONATOR || kind.bin==SITHBIN_REPEATER;
+        case BOT_ITEM_SHIELD: case BOT_ITEM_SUPERSHIELD: case BOT_ITEM_HEALTH: case BOT_ITEM_REVIVE:
+        case BOT_ITEM_DAMAGE: return 1;
+        default: return 0;
+    }
+}
+static void Bot_WatchPickup(SithThing *self)
+{
+    if (nav.watchItem>0 && nav.watchItem<=Bot_ThingCount()) {
+        SithThing *item=&bot.world->aThings[nav.watchItem-1];
+        if (item->guid==nav.watchGuid && (item->flags&SITH_TF_DISABLED) &&
+            Bot_Distance(self->position,nav.watchPos)<0.6f) {
+            nav.mineSpot=nav.watchPos; nav.mineSpotUntil=bot.now+1.5f;
+            nav.watchItem=0; return;
+        }
+        if (item->guid!=nav.watchGuid || (item->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED)) ||
+            Bot_Distance(self->position,item->position)>0.8f) nav.watchItem=0;
+    }
+    if (nav.watchItem) return;
+    int count=Bot_ThingCount();
+    for (int i=0;i<count;i++) {
+        SithThing *item=&bot.world->aThings[i];
+        if (item->type!=SITH_THING_ITEM || (item->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED)) ||
+            item->itemParams.secRespawnInterval<=0 || Bot_Distance(self->position,item->position)>0.5f ||
+            !Bot_GuardedItem(item)) continue;
+        nav.watchItem=i+1; nav.watchGuid=item->guid; nav.watchPos=item->position;
+        return;
+    }
+}
+static void Bot_EndMine(const char *event)
+{
+    fprintf(stderr,"BOT_MINE name=%s phase=%d event=%s live=%d\n",bot.name,nav.minePhase,event,Bot_OwnMines());
+    fflush(stderr);
+    nav.minePhase=0; nav.mineSpotUntil=0;
+}
+/* Returns 1 while laying owns the weapon keys this tick. */
+static int Bot_MineTick(SithThing *self, SithThing *target)
+{
+    int seq=SITHBIN_SEQUENCER_CHARGE, current=sithInventory_GetCurrentWeapon(self);
+    if (!BT_ON(MINES)) { nav.minePhase=0; return 0; }
+    if (!nav.minePhase) {
+        Bot_WatchPickup(self);
+        if (bot.now>=nav.mineSpotUntil || (target && sithCollision_HasLOS(self,target,0)) || Bot_OrdnanceBusy(self) ||
+            !sithInventory_IsInventoryAvailable(self,seq) || sithInventory_GetInventory(self,seq)<1 ||
+            Bot_OwnMines()>=3 || Bot_MinePeaceful(self) || Bot_ProtectedNear(self,self->position,1.5f)) return 0;
+        for (int i=0;i<nav.nHazards;i++) if (Bot_Distance(nav.hazards[i].pos,self->position)<1.0f) return 0;
+        nav.minePhase=1; nav.minePhaseAt=bot.now; nav.mineCount=sithInventory_GetInventory(self,seq);
+    }
+    if (target && sithCollision_HasLOS(self,target,0) && nav.minePhase<3) { Bot_EndMine("fight"); return 0; }
+    if (nav.minePhase==1) {              /* select the charge */
+        if (current==seq) { nav.minePhase=2; nav.minePhaseAt=bot.now; }
+        else if (bot.now-nav.minePhaseAt>1.5f || Bot_OrdnanceBusy(self)) { Bot_EndMine("select"); return 0; }
+        else { if (!bot.previous[INPUT_FUNC_SELECT1+seq-1]) bot.keys[INPUT_FUNC_SELECT1+seq-1]=1; return 1; }
+    }
+    if (nav.minePhase==2) {              /* raise it, then drop the mine at the feet */
+        if (current!=seq) { Bot_EndMine("lost"); return 0; }
+        if (bot.now-nav.minePhaseAt<0.45f) return 1;
+        bot.keys[INPUT_FUNC_FIRE1]=0; bot.keys[INPUT_FUNC_FIRE2]=1;
+        nav.minePhase=3; nav.minePhaseAt=bot.now; nav.minePos=self->position;
+        return 1;
+    }
+    if (nav.minePhase==3) {              /* the cog spends one charge per mine */
+        bot.keys[INPUT_FUNC_FIRE1]=bot.keys[INPUT_FUNC_FIRE2]=0;
+        if (sithInventory_GetInventory(self,seq)<nav.mineCount) {
+            for (int i=0;i<BOT_OWN_MINES;i++) if (nav.ownMines[i]<=bot.now) { nav.ownMines[i]=bot.now+60.0f; break; }
+            bot.tele.mines++;
+            Bot_EndMine("laid"); bot.nextSelect=0; return 0;
+        }
+        if (bot.now-nav.minePhaseAt>0.8f) { Bot_EndMine("misfire"); return 0; }
+        return 1;
+    }
+    return 0;
+}
+
+/* Thermal detonators. The stock COG throws on release, scaling the
+   template's launch velocity (2 forward, 1.5 up in the view frame) by the
+   seconds held: 0.7 to 2 for the primary, which bursts on whatever it
+   touches. Range on flat ground runs from 0.7 units at the shortest hold
+   to 3.2 at the longest, with a second or more of flight, so the bot
+   throws at targets that guns serve badly: out of sight below or behind a
+   lip, in the water, or standing still. */
+static SithThing *Bot_ThermalTemplate(void)
+{
+    SithThing *g=sithTemplate_GetTemplate("+grenade1");
+    if (!g || g->type!=SITH_THING_WEAPON || !(g->weaponParams.flags&SITH_WF_FACEHITEXPLODE) ||
+        !g->weaponParams.pExplosionTemplate || g->weaponParams.pExplosionTemplate->type!=SITH_THING_EXPLOSION ||
+        !(g->physicsParams.vel.y>0) || !isfinite(g->physicsParams.airDrag)) return NULL;
+    return g;
+}
+
+/* Fly the grenade as the engine does, a little at a time, and report where
+   it first touches level geometry. */
+static int Bot_FlyGrenade(SithThing *self, SithThing *g, rdVector3 from, rdVector3 dir, flex_t pitch,
+                          flex_t scale, flex_t horizon, BotArc *arc)
+{
+    flex_t c=cosf(pitch/BOT_DEG), s=sinf(pitch/BOT_DEG), k=g->physicsParams.airDrag;
+    flex_t gravity=(g->physicsParams.flags&SITH_PF_USEGRAVITY) && bot.world ? bot.world->gravity : 0;
+    flex_t fwd=g->physicsParams.vel.y*scale, up=g->physicsParams.vel.z*scale;
+    rdVector3 v={dir.x*(fwd*c-up*s),dir.y*(fwd*c-up*s),fwd*s+up*c}, p=from;
+    SithSector *sector=Bot_SectorAt(&p,self->sector);
+    const flex_t dt=0.02f;
+    for (flex_t t=0;t<horizon && sector;t+=dt) {
+        flex_t drag=Bot_Min(1.0f,k*dt);
+        v.x-=v.x*drag; v.y-=v.y*drag; v.z-=v.z*drag; v.z-=gravity*dt;
+        rdVector3 next={p.x+v.x*dt,p.y+v.y*dt,p.z+v.z*dt};
+        if (((int)(t/dt))%3==2 || t+dt>=horizon) {
+            if (!Bot_Clear(NULL,sector,arc->impact,next,g->moveSize,1)) {
+                /* Narrow the touch down to a couple of centimetres. */
+                rdVector3 lo=arc->impact, hi=next;
+                for (int i=0;i<4;i++) {
+                    rdVector3 mid=Bot_Mix(lo,hi,0.5f);
+                    if (Bot_Clear(NULL,sector,arc->impact,mid,g->moveSize,1)) lo=mid; else hi=mid;
+                }
+                arc->impact=lo; arc->flight=t; return 1;
+            }
+            arc->impact=next;
+            sector=Bot_SectorAt(&next,sector);
+        }
+        p=next;
+    }
+    arc->flight=horizon; arc->impact=p;
+    return 0;
+}
+
+/* The pitch whose grenade lands nearest the aim point; ok when its burst reaches. */
+static BotArc Bot_ThermalArc(SithThing *self, rdVector3 at, flex_t scale)
+{
+    BotArc best={0};
+    SithThing *g=Bot_ThermalTemplate();
+    if (!g) return best;
+    rdVector3 from=self->position, d=Bot_Sub(at,from); d.z=0;
+    flex_t h=Bot_Horizontal(d);
+    if (h<0.3f) return best;
+    d.x/=h; d.y/=h;
+    flex_t blast=g->weaponParams.pExplosionTemplate->explosionParams.range;
+    best.miss=1e9f;
+    for (int deg=-40;deg<=60;deg+=2) {
+        BotArc arc={.pitch=(flex_t)deg,.impact=from};
+        if (!Bot_FlyGrenade(self,g,from,d,(flex_t)deg,scale,3.0f,&arc)) continue;
+        arc.miss=Bot_Distance(arc.impact,at);
+        if (Bot_Distance(arc.impact,from)<blast+self->collideSize+0.5f) continue;
+        if (arc.miss<best.miss) { best=arc; best.ok=arc.miss<=blast*0.6f; }
+        if (best.ok && arc.miss<0.08f) break;
+    }
+    return best;
+}
+
+/* Where the target will be: its velocity holds for a while, then fades. */
+static rdVector3 Bot_ThermalAim(SithThing *target, flex_t after)
+{
+    rdVector3 p=Bot_PredictedPosition(target,Bot_Min(after,0.8f));
+    p.z-=BOT_FOOT_HEIGHT-0.02f; /* its feet: a near miss on the floor still bursts by them */
+    return p;
+}
+
+static int Bot_ThermalWorth(SithThing *self, SithThing *target)
+{
+    int slot=Bot_PlayerSlot(target);
+    if (slot<0 || !Bot_KineticEnemyAllowed(self,slot) || Bot_ProtectedNear(self,target->position,1.2f)) return 0;
+    flex_t d=Bot_Distance(self->position,target->position);
+    if (d<1.4f || d>3.2f) return 0;
+    int wet=(target->sector && (target->sector->flags&SITH_SECTOR_UNDERWATER)) ||
+        (target->physicsParams.flags&SITH_PF_ONWATERSURFACE);
+    flex_t speed=Bot_Horizontal(target->physicsParams.vel);
+    return !sithCollision_HasLOS(self,target,0) || wet || speed<0.3f;
+}
+
+static void Bot_EndThermal(SithThing *self, const char *event)
+{
+    fprintf(stderr,"BOT_THERMAL name=%s phase=%d hold=%.2f pitch=%.0f miss=%.2f dist=%.2f event=%s\n",bot.name,
+        nav.thermalPhase,(double)nav.thermalHold,(double)nav.thermalArc.pitch,(double)nav.thermalArc.miss,
+        (double)Bot_Distance(self->position,nav.thermalArc.impact),event);
+    fflush(stderr);
+    nav.thermalPhase=0; nav.nextThermal=bot.now+5.0f; bot.nextSelect=0;
+}
+
+/* Returns 1 while the throw owns the weapon keys and the view. */
+static int Bot_ThermalTick(SithThing *self, SithThing *target)
+{
+    int det=SITHBIN_THERMAL_DETONATOR, current=sithInventory_GetCurrentWeapon(self);
+    if (!BT_ON(THERMALS)) { nav.thermalPhase=0; return 0; }
+    if (!nav.thermalPhase) {
+        if (!target || bot.now<nav.nextThermal || bot.sabersOnly || nav.minePhase ||
+            !sithInventory_IsInventoryAvailable(self,det) || sithInventory_GetInventory(self,det)<1) return 0;
+        bot.tele.thermalHeld+=bot.frameDt;
+        if (Bot_OrdnanceBusy(self) || !Bot_ThermalWorth(self,target)) return 0;
+        /* The shortest hold that reaches, so the target has least time to move. */
+        flex_t d=Bot_Horizontal(Bot_Sub(target->position,self->position));
+        flex_t hold=Bot_Clamp(0.7f+(d-0.6f)*0.52f,0.7f,2.0f);
+        BotArc arc=Bot_ThermalArc(self,Bot_ThermalAim(target,hold+0.5f+1.0f),hold);
+        if (!arc.ok) { nav.nextThermal=bot.now+0.5f; bot.tele.thermalNoArc++; return 0; }
+        nav.thermalPhase=1; nav.thermalAt=bot.now; nav.thermalHold=hold; nav.thermalArc=arc;
+        nav.thermalCount=sithInventory_GetInventory(self,det); nav.thermalSlot=Bot_PlayerSlot(target);
+    }
+    SithThing *mark=nav.thermalSlot>=0 && nav.thermalSlot<JKPLAYER_NUM_INFOS ? jkPlayer_playerInfos[nav.thermalSlot].pLocalPlayer : NULL;
+    if (nav.thermalPhase==1) {           /* select and raise the detonator */
+        if (!mark || !target || target!=mark || Bot_OrdnanceBusy(self)) { Bot_EndThermal(self,"select"); return 0; }
+        if (current!=det) {
+            if (bot.now-nav.thermalAt>1.5f) { Bot_EndThermal(self,"select"); return 0; }
+            if (!bot.previous[INPUT_FUNC_SELECT1+det-1]) bot.keys[INPUT_FUNC_SELECT1+det-1]=1;
+            nav.thermalRaised=bot.now; return 1;
+        }
+        if (bot.now-nav.thermalRaised<0.5f) return 1;
+        nav.thermalPhase=2; nav.thermalAt=bot.now;
+    }
+    if (nav.thermalPhase==2) {           /* hold, aim, release */
+        if (current!=det) { Bot_EndThermal(self,"lost"); return 0; }
+        flex_t held=bot.now-nav.thermalAt, scale=Bot_Clamp(held,0.7f,2.0f);
+        flex_t release=Bot_Max(nav.thermalHold,0.7f);
+        if (mark && !(mark->flags&(SITH_TF_DEAD|SITH_TF_DESTROYED))) {
+            BotArc arc=Bot_ThermalArc(self,Bot_ThermalAim(mark,Bot_Max(0,release-held)+nav.thermalArc.flight),
+                                      Bot_Max(scale,release));
+            if (arc.ok) nav.thermalArc=arc;
+        }
+        rdVector3 to=Bot_Sub(nav.thermalArc.impact,self->position); to.z=0;
+        flex_t h=Bot_Horizontal(to);
+        if (h>0.01f) {
+            flex_t c=cosf(nav.thermalArc.pitch/BOT_DEG);
+            rdVector3 look={self->position.x+to.x/h*c,self->position.y+to.y/h*c,
+                            self->position.z+sinf(nav.thermalArc.pitch/BOT_DEG)};
+            flex_t error=Bot_Aim(self,look,0);
+            bot.keys[INPUT_FUNC_FIRE2]=0;
+            if (held<release || (error>2.5f && held<2.0f)) { bot.keys[INPUT_FUNC_FIRE1]=1; return 1; }
+        }
+        bot.keys[INPUT_FUNC_FIRE1]=bot.keys[INPUT_FUNC_FIRE2]=0;   /* the COG throws on release */
+        nav.thermalHold=Bot_Clamp(held,0.7f,2.0f); nav.thermalPhase=3; nav.thermalAt=bot.now;
+        return 1;
+    }
+    if (nav.thermalPhase==3) {           /* the COG spends one detonator per throw */
+        bot.keys[INPUT_FUNC_FIRE1]=bot.keys[INPUT_FUNC_FIRE2]=0;
+        if (sithInventory_GetInventory(self,det)<nav.thermalCount) {
+            bot.tele.thermals++; Bot_EndThermal(self,"thrown"); return 0;
+        }
+        if (bot.now-nav.thermalAt>0.8f) { Bot_EndThermal(self,"misfire"); return 0; }
+        return 1;
+    }
+    return 0;
+}
+
+static void Bot_OrdnanceTick(SithThing *self, SithThing *target)
+{
+    if (Bot_ThermalTick(self,target)) return;
+    /* Stepping clear yields only to flight, swimming and committed traversals. */
+    if (BT_ON(HAZARD_AVOID) && (self->attach_flags&SITH_ATTACH_SURFACE) &&
+        !(self->sector->flags&SITH_SECTOR_UNDERWATER) && !nav.runPhase && !nav.forceJumpPending &&
+        nav.waterExitUntil<=0 && nav.combatJumpUntil<=bot.now) Bot_EscapeHazard(self);
+    Bot_MineTick(self,target);
+}
diff --git a/src/AI/jkBotRunJump.inc b/src/AI/jkBotRunJump.inc
new file mode 100644
index 0000000..42b456c
--- /dev/null
+++ b/src/AI/jkBotRunJump.inc
@@ -0,0 +1,735 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT */
+/* Running jumps: a jump released at running speed keeps that speed through
+   the air (the stock Force Jump script adds its upward velocity to the
+   player's own). With Force Speed this crosses gaps no standing jump can.
+   Ordinary inputs only: the run key, the movement axes, the jump key and the
+   two stock Force keys. */
+
+static flex_t Bot_ForceCost(SithThing *self,int bin);
+static int Bot_NavDirectMove(SithThing *self, rdVector3 target, int swim);
+
+/* Why candidates were dropped, for the ready line: detour too short, no
+   launch that lands, no runway, flight blocked. */
+static int runJumpDropped[4];
+
+static flex_t RunJump_Drag(SithThing *self)
+{ return self->physicsParams.surfDrag>0.5f ? self->physicsParams.surfDrag : 3.0f; }
+
+static flex_t RunJump_Boost(int rank) { return rank>0 ? 0.5f+0.5f*rank : 0.0f; }
+
+/* Free flight from ground speed v and upward speed vz, forward held: where
+   and how fast the body comes back down to height dz. */
+static int RunJump_Flight(SithThing *self,flex_t v,flex_t vz,flex_t thrust,flex_t dz,
+                          flex_t *reach,flex_t *sink,flex_t *seconds)
+{
+    const flex_t dt=bot.physicsStep>0 && bot.physicsStep<=0.067f ? bot.physicsStep : 1.0f/150.0f;
+    const flex_t control=Bot_Max(dt,bot.frameDt>0 && bot.frameDt<=0.10f ? bot.frameDt : 1.0f/30.0f);
+    const flex_t decay=1.0f-dt*self->physicsParams.airDrag, gravity=bot.world->gravity;
+    flex_t x=0,z=0,push=0,next=0,peak=0;
+    for (int i=0;i*dt<3.0f;i++) {
+        if (i*dt+0.5f*dt>=next) { push=thrust; next+=control; }
+        push*=0.3f; v=v*decay+push*dt; vz=vz*decay-gravity*dt;
+        x+=v*dt; z+=vz*dt; if (z>peak) peak=z;
+        if (vz<0 && z<=dz) {
+            /* A higher landing must first have been cleared. */
+            if (dz>0 && peak<dz+0.02f) return 0;
+            *reach=x; *sink=-vz; *seconds=(i+1)*dt; return 1;
+        }
+    }
+    return 0;
+}
+
+/* The upward speed that lands a launch at speed v on the far node. A plain
+   jump has one; a Force Jump is held between .15 s and the rank's limit. */
+static int RunJump_Lift(SithThing *self,flex_t v,flex_t thrust,flex_t distance,flex_t dz,int jumpRank,
+                        int *force,flex_t *hold,flex_t *seconds)
+{
+    /* A landing faster than 2.5 hurts; up to 2.95 costs under ten health. */
+    const flex_t tolerance=0.22f,hurts=2.95f;
+    flex_t reach,sink,plain=self->actorParams.jumpSpeed;
+    if (plain>0.5f && RunJump_Flight(self,v,plain,thrust,dz,&reach,&sink,seconds) &&
+        fabsf(reach-distance)<=tolerance && sink<=hurts) { *force=0; *hold=0; return 1; }
+    if (jumpRank<1) return 0;
+    /* A hold too short to clear a higher ledge counts as falling short. */
+    flex_t low=0.15f,high=Bot_Min(0.35f*jumpRank,1.35f),best=low;
+    if (!RunJump_Flight(self,v,2.5f+low,thrust,dz,&reach,&sink,seconds)) reach=-1;
+    if (reach>distance+tolerance) return 0;
+    if (reach<distance) {
+        flex_t far;
+        if (!RunJump_Flight(self,v,2.5f+high,thrust,dz,&far,&sink,seconds) || far<distance-tolerance) return 0;
+        best=high;
+        if (far>distance) {
+            for (int i=0;i<14;i++) {
+                flex_t mid=0.5f*(low+high);
+                if (!RunJump_Flight(self,v,2.5f+mid,thrust,dz,&reach,&sink,seconds) || reach<distance) low=mid; else high=mid;
+            }
+            best=high;
+        }
+    }
+    if (!RunJump_Flight(self,v,2.5f+best,thrust,dz,&reach,&sink,seconds) || sink>hurts ||
+        fabsf(reach-distance)>tolerance) return 0;
+    *force=1; *hold=best; return 1;
+}
+
+/* One swept flight with level geometry: clear air, a foothold at the far
+   node's height within walking reach of it, and room to stop that ends in
+   floor or a wall, not in another edge. */
+/* Set while a jump from a water surface is swept: the first samples are
+   still in the launch water. */
+static int runJumpSurf;
+
+static int RunJump_Sweep(SithThing *self,const BotNode *a,BotNode *b,flex_t v,flex_t vz,flex_t thrust)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta),radius=self->moveSize;
+    rdVector3 direction={delta.x/length,delta.y/length,0};
+    const int unsafe=SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    const flex_t dt=bot.physicsStep>0 && bot.physicsStep<=0.067f ? bot.physicsStep : 1.0f/150.0f;
+    const flex_t control=Bot_Max(dt,bot.frameDt>0 && bot.frameDt<=0.10f ? bot.frameDt : 1.0f/30.0f);
+    const flex_t decay=1.0f-dt*self->physicsParams.airDrag;
+    flex_t contact=b->pos.z-BOT_FOOT_HEIGHT+radius+0.002f,along=0,push=0,next=0;
+    rdVector3 pos=a->pos,swept=pos; SithSector *sector=a->sector;
+    for (int i=0;i*dt<3.0f;i++) {
+        if (i*dt+0.5f*dt>=next) { push=thrust; next+=control; }
+        push*=0.3f; v=v*decay+push*dt; vz=vz*decay-bot.world->gravity*dt;
+        int lands=vz<0 && pos.z+dt*vz<=contact;
+        if (lands && pos.z<=contact && along<0.5f*length) return 0;
+        flex_t step=lands && vz<0 ? Bot_Clamp((contact-pos.z)/vz,0.0f,dt) : dt;
+        along+=v*step;
+        pos.x=a->pos.x+along*direction.x; pos.y=a->pos.y+along*direction.y; pos.z+=vz*step;
+        if (!lands && i%3!=2) continue;
+        if (!Bot_WaterClear(sector,swept,pos,radius)) return 0;
+        swept=pos; sector=Bot_SectorAt(&pos,sector);
+        int leaving=runJumpSurf && vz>0 && sector==a->sector && pos.z<=a->pos.z+radius+0.05f;
+        if (!Bot_SectorSafe(sector) || ((sector->flags&unsafe) && !leaving)) return 0;
+        if (!lands) continue;
+        rdVector3 standing; SithSector *floor=NULL;
+        if (!Bot_Floor(pos,sector,BOT_FOOT_HEIGHT+0.04f,&standing,&floor) ||
+            fabsf(standing.z-b->pos.z)>0.05f || fabsf(length-along)>0.5f) return 0;
+        BotNode foothold={.pos=standing,.sector=floor}; int drop=0;
+        if (Bot_Horizontal(Bot_Sub(b->pos,standing))>0.02f &&
+            (!Bot_WalkableSpan(&foothold,b,&drop,0.001f) || drop)) return 0;
+        /* Coasting to rest after the landing. */
+        flex_t coast=v/RunJump_Drag(self)+0.15f;
+        rdVector3 at=standing; SithSector *under=floor;
+        for (flex_t done=0;done<coast;done+=0.08f) {
+            rdVector3 ahead=at; ahead.x+=0.08f*direction.x; ahead.y+=0.08f*direction.y;
+            if (!Bot_Clear(NULL,under,at,ahead,radius,1)) break;
+            rdVector3 rest; SithSector *support=NULL;
+            under=Bot_SectorAt(&ahead,under);
+            if (!Bot_SectorSafe(under) || (under->flags&unsafe) ||
+                !Bot_Floor(ahead,under,BOT_FOOT_HEIGHT+0.06f,&rest,&support)) return 0;
+            at=rest;
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/* The run-up: level, walkable, straight behind the launch node. */
+static int RunJump_Runway(const BotNode *a,rdVector3 direction,flex_t length)
+{
+    rdVector3 start=a->pos,floor; SithSector *support=NULL;
+    start.x-=length*direction.x; start.y-=length*direction.y;
+    SithSector *sector=Bot_SectorAt(&start,a->sector);
+    if (!Bot_SectorSafe(sector) || (sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST)) ||
+        !Bot_Floor(start,sector,BOT_FOOT_HEIGHT+0.05f,&floor,&support) || fabsf(floor.z-a->pos.z)>0.05f) return 0;
+    BotNode from={.pos=floor,.sector=support}; int drop=0;
+    return Bot_WalkableSpan(&from,(BotNode *)a,&drop,0.001f) && !drop;
+}
+
+/* Sprinting from rest with the run key: the speed reached after a given
+   distance, and how long that takes. Ground speed follows thrust over drag. */
+static void RunJump_Sprint(SithThing *self,flex_t thrust,flex_t length,flex_t *speed,flex_t *seconds)
+{
+    flex_t drag=RunJump_Drag(self),top=2.0f*thrust/drag,low=0,high=6.0f;
+    for (int i=0;i<24;i++) {
+        flex_t mid=0.5f*(low+high);
+        if (top*(mid-(1.0f-expf(-drag*mid))/drag)<length) low=mid; else high=mid;
+    }
+    *seconds=high; *speed=top*(1.0f-expf(-drag*high));
+}
+
+static int Bot_RunJumpSolve(SithThing *self,const BotNode *a,BotNode *b,int speedRank,int jumpRank,BotRunJump *plan)
+{
+    if (!self || !(self->moveSize>=0.02f && self->moveSize<=0.25f) || !(bot.world->gravity>0) ||
+        !(self->physicsParams.airDrag>=0 && self->physicsParams.airDrag<10) || !(self->actorParams.maxThrust>0)) return 0;
+    const int unsafe=SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    if (!Bot_SectorSafe(a->sector) || !Bot_SectorSafe(b->sector) || ((a->sector->flags|b->sector->flags)&unsafe)) return 0;
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t distance=Bot_Horizontal(delta);
+    if (!(distance>=1.3f && distance<=4.6f) || fabsf(delta.z)>1.2f) return 0;
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    /* The run-up is whatever straight level floor lies behind the launch
+       node, up to the length that reaches full speed. */
+    flex_t room=0;
+    for (flex_t length=0.30f;length<=3.3f;length+=0.15f) { if (!RunJump_Runway(a,direction,length)) break; room=length; }
+    int stage=room>0 ? 1 : 0;
+    for (int sped=0;room>0 && sped<=(speedRank>0);sped++) for (int boost=0;boost<2;boost++) {
+        flex_t thrust=(self->actorParams.maxThrust+(sped ? RunJump_Boost(speedRank) : 0))*(boost ? BOT_DIAGONAL_GAIN : 1.0f);
+        flex_t runway=Bot_Min(room,0.85f*2.0f*thrust/RunJump_Drag(self)),speed,sprint,hold,seconds; int force;
+        RunJump_Sprint(self,thrust,runway,&speed,&sprint);
+        if (!RunJump_Lift(self,speed,thrust,distance,delta.z,jumpRank,&force,&hold,&seconds)) continue;
+        if (stage<2) stage=2;
+        /* Live launches came out between 5 percent slow and 9 percent fast of
+           the sprint model, and one 9 percent slow fell short: a launch a
+           tenth slow or fast must still find the foothold. */
+        flex_t vz=force ? 2.5f+hold : self->actorParams.jumpSpeed;
+        if (!RunJump_Sweep(self,a,b,speed,vz,thrust) || !RunJump_Sweep(self,a,b,0.90f*speed,vz,thrust) ||
+            !RunJump_Sweep(self,a,b,1.09f*speed,vz,thrust)) continue;
+        /* jump_margin: on Canyon Oasis's ledge jumps the live launches that
+           fell came out 7 to 11 percent slow, where this sweep still landed
+           at 10 percent, and a Force Jump's lift is its key's hold, which
+           the engine times from one frame to another. A launch 15 percent
+           slow, or 7 percent slow with a tenth less lift, must still land. */
+        if (BT_ON(JUMP_MARGIN) && (!RunJump_Sweep(self,a,b,0.85f*speed,vz,thrust) ||
+            (force && !RunJump_Sweep(self,a,b,0.93f*speed,vz-0.1f,thrust)))) continue;
+        plan->speed=speed; plan->hold=hold; plan->runway=runway; plan->sprint=sprint; plan->seconds=seconds;
+        plan->boost=boost; plan->sped=sped; plan->force=force;
+        return 1;
+    }
+    runJumpDropped[1+stage]++;
+    return 0;
+}
+
+/* Running off a ledge into water below: the engine quarters the vertical
+   speed at the surface, so the landing costs nothing. From the launch node
+   the body keeps running to the lip, falls, and must be in water before it
+   can touch any floor. */
+static int RunJump_Dive(SithThing *self,const BotNode *a,const BotNode *b,flex_t speed,flex_t thrust,flex_t lip)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta),radius=self->moveSize;
+    rdVector3 direction={delta.x/length,delta.y/length,0};
+    const int unsafe=SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    const flex_t dt=bot.physicsStep>0 && bot.physicsStep<=0.067f ? bot.physicsStep : 1.0f/150.0f;
+    const flex_t control=Bot_Max(dt,bot.frameDt>0 && bot.frameDt<=0.10f ? bot.frameDt : 1.0f/30.0f);
+    const flex_t decay=1.0f-dt*self->physicsParams.airDrag;
+    /* The sphere is clear of the corner a little past the last foothold. */
+    flex_t along=lip+radius+0.04f,push=0,next=0,vz=0;
+    rdVector3 pos=a->pos; pos.x+=along*direction.x; pos.y+=along*direction.y;
+    SithSector *sector=Bot_SectorAt(&pos,a->sector);
+    rdVector3 swept=pos; flex_t top=pos.z;
+    for (int i=0;i*dt<3.0f;i++) {
+        if (i*dt+0.5f*dt>=next) { push=thrust; next+=control; }
+        push*=0.3f; speed=speed*decay+push*dt; vz=vz*decay-bot.world->gravity*dt;
+        along+=speed*dt;
+        pos.x=a->pos.x+along*direction.x; pos.y=a->pos.y+along*direction.y; pos.z+=vz*dt;
+        if (i%3!=2) continue;
+        if (!Bot_WaterClear(sector,swept,pos,radius)) return 0;
+        swept=pos; sector=Bot_SectorAt(&pos,sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&unsafe)) return 0;
+        if (!(sector->flags&SITH_SECTOR_UNDERWATER)) continue;
+        rdVector3 deeper=pos; deeper.z-=0.2f;
+        return top-pos.z>=0.8f && Bot_WaterClear(sector,pos,deeper,radius) &&
+               Bot_Distance(pos,b->pos)<=2.5f && Bot_WaterClear(sector,pos,b->pos,radius);
+    }
+    return 0;
+}
+
+static int Bot_RunDiveSolve(SithThing *self,const BotNode *a,BotNode *b,int speedRank,int sped,BotRunJump *plan)
+{
+    if (!self || !(self->moveSize>=0.02f && self->moveSize<=0.25f) || !(bot.world->gravity>0) ||
+        !(self->physicsParams.airDrag>=0 && self->physicsParams.airDrag<10) || !(self->actorParams.maxThrust>0) ||
+        !Bot_SectorSafe(a->sector) || !Bot_SectorSafe(b->sector) ||
+        (a->sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t distance=Bot_Horizontal(delta);
+    if (!(distance>=0.3f && distance<=3.6f) || delta.z>-0.9f || delta.z<-9.0f) return 0;
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    /* Level floor from the node to the lip, and the run-up behind the node. */
+    rdVector3 pos=a->pos,floor; SithSector *sector=a->sector,*support=NULL; flex_t lip=0;
+    for (;;) {
+        rdVector3 ahead=pos; ahead.x+=0.04f*direction.x; ahead.y+=0.04f*direction.y;
+        if (!Bot_Clear(NULL,sector,pos,ahead,self->moveSize,1)) { runJumpDropped[2]++; return 0; }
+        pos=ahead; lip+=0.04f; sector=Bot_SectorAt(&pos,sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+        if (!Bot_Floor(pos,sector,BOT_FOOT_HEIGHT+0.05f,&floor,&support)) break;
+        if (fabsf(floor.z-a->pos.z)>0.05f || lip>0.9f || lip>=distance) { runJumpDropped[2]++; return 0; }
+    }
+    flex_t room=0;
+    for (flex_t length=0.30f;length<=3.3f;length+=0.15f) { if (!RunJump_Runway(a,direction,length)) break; room=length; }
+    if (room<=0) { runJumpDropped[2]++; return 0; }
+    /* Slowest first: a walk, a run, a strafing run. Force Speed changes all
+       three, so each state of it is solved on its own. */
+    for (int pace=0;pace<3;pace++) {
+        flex_t thrust=(self->actorParams.maxThrust+(sped ? RunJump_Boost(speedRank) : 0))*(pace==2 ? BOT_DIAGONAL_GAIN : 1.0f);
+        flex_t ground=pace ? thrust : 0.5f*thrust;
+        flex_t runway=Bot_Min(room,0.85f*2.0f*ground/RunJump_Drag(self)),speed,sprint;
+        RunJump_Sprint(self,ground,runway+lip,&speed,&sprint);
+        if (!RunJump_Dive(self,a,b,speed,thrust,lip) || !RunJump_Dive(self,a,b,0.92f*speed,thrust,lip) ||
+            !RunJump_Dive(self,a,b,1.06f*speed,thrust,lip)) continue;
+        plan->speed=speed; plan->hold=0; plan->runway=runway; plan->sprint=sprint; plan->seconds=0;
+        plan->boost=pace==2; plan->sped=sped; plan->force=0; plan->dive=1; plan->walk=pace==0;
+        return 1;
+    }
+    runJumpDropped[3]++;
+    return 0;
+}
+
+/* A plan is solved for one speed. With Force Speed already running only a
+   plan solved with it fits; without it, either kind does (the bot can bring
+   Speed up), and the one that needs no mana is preferred. */
+static BotRunJump *Bot_RunJumpPlan(SithThing *self,int from,int to)
+{
+    int active=self->actorParams.extraSpeed>0.01f;
+    BotRunJump *found=NULL;
+    for (int i=0;i<nav.runCount;i++) {
+        BotRunJump *plan=&nav.runEdges[i];
+        if (plan->from!=from || plan->to!=to || (active && !plan->sped && !plan->surf)) continue;
+        if (!found || (!active && found->sped && !plan->sped)) found=plan;
+    }
+    return found;
+}
+
+static int Bot_RunJumpRank(SithThing *self,int bin)
+{ return bot.forceEnabled ? (int)Bot_Clamp(sithInventory_GetInventory(self,bin),0,4) : 0; }
+
+/* Planner gate: the powers the plan was solved with, and the mana for them. */
+static int Bot_RunJumpUsable(SithThing *self,int from,int to)
+{
+    BotRunJump *plan=Bot_RunJumpPlan(self,from,to);
+    if (!plan || !BT_ON(RUN_JUMP) || self->actorParams.health<40 || plan->failedUntil>bot.now) return 0;
+    if (plan->sped && Bot_RunJumpRank(self,SITHBIN_F_SPEED)!=plan->speedRank) return 0;
+    if (plan->force && Bot_RunJumpRank(self,SITHBIN_F_JUMP)<plan->jumpRank) return 0;
+    flex_t need=(plan->force ? Bot_ForceCost(self,SITHBIN_F_JUMP) : 0)+
+                (plan->sped && self->actorParams.extraSpeed<=0.01f ? Bot_ForceCost(self,SITHBIN_F_SPEED) : 0);
+    return need<=0 || sithInventory_GetInventory(self,SITHBIN_FORCEMANA)>=need+5.0f;
+}
+
+/* Out of the water with a Force Jump: the stock script also fires from the
+   water surface, and its 2.5 + hold clears banks the surface hop (0.7 up,
+   0.6 across) cannot. Launch from the surface above a wet node, drifting
+   toward the bank; slow, nominal and fast drifts must all find the foothold. */
+/* Where water exits were turned down: no wall met, no room to swim up to
+   it, no hold that fits the rank, flight blocked or no foothold. */
+static int runSurfDropped[6];
+
+/* Swimming along the surface from rest, as measured in a live match: 0.30
+   units and 0.43 units a second after 1.1 seconds. Force Speed adds thrust. */
+static void RunJump_Swim(SithThing *self,flex_t length,flex_t *speed,flex_t *seconds)
+{
+    flex_t drag=Bot_Max(0.2f,4.4f*self->physicsParams.airDrag),top=0.52f*(self->actorParams.maxThrust+self->actorParams.extraSpeed)/drag,low=0,high=8.0f;
+    for (int i=0;i<24;i++) {
+        flex_t mid=0.5f*(low+high);
+        if (top*(mid-(1.0f-expf(-drag*mid))/drag)<length) low=mid; else high=mid;
+    }
+    *seconds=high; *speed=top*(1.0f-expf(-drag*high));
+}
+
+/* A bank is a wall. The swimmer comes at it along the surface and jumps a
+   little short of it, so that the body is above the lip by the time it gets
+   there and its swimming speed carries it over. */
+static int Bot_RunSurfSolve(SithThing *self,const BotNode *a,BotNode *b,rdVector3 surface,int jumpRank,BotRunJump *plan)
+{
+    if (!self || !(self->moveSize>=0.02f && self->moveSize<=0.25f) || !(bot.world->gravity>0) ||
+        !(self->physicsParams.airDrag>=0 && self->physicsParams.airDrag<10) || !(self->actorParams.maxThrust>0) ||
+        !Bot_SectorSafe(b->sector) || (b->sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+    rdVector3 delta=Bot_Sub(b->pos,surface);
+    flex_t distance=Bot_Horizontal(delta),radius=self->moveSize,thrust=self->actorParams.maxThrust;
+    if (distance<0.10f) return 0;
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    rdVector3 wall=surface; flex_t pushed=0;
+    for (;pushed<distance;pushed+=0.04f) {
+        rdVector3 next=wall; next.x+=0.04f*direction.x; next.y+=0.04f*direction.y;
+        SithSector *in=Bot_SectorAt(&next,a->sector);
+        if (!in || !(in->flags&SITH_SECTOR_UNDERWATER) || !Bot_WaterClear(a->sector,wall,next,radius)) break;
+        wall=next;
+    }
+    if (pushed>=distance) { runSurfDropped[0]++; return 0; }
+    /* The key goes down as the swim starts and comes up at the launch
+       point, so the jump is as strong as the swim is long: timed to 1.33 s at
+       rank four, the rank's full jump below that. Slow and fast swims,
+       weak and strong jumps must all find the foothold. */
+    const flex_t runway=0.30f;
+    flex_t full=2.5f+Bot_Min(0.35f*jumpRank,1.35f),weak=jumpRank>=4 ? 3.72f : full;
+    int stage=1;
+    for (int k=0;k<3;k++) {
+        flex_t back=0.22f+0.08f*k;
+        rdVector3 launch={wall.x-back*direction.x,wall.y-back*direction.y,wall.z};
+        rdVector3 start={launch.x-runway*direction.x,launch.y-runway*direction.y,wall.z};
+        SithSector *in=Bot_SectorAt(&start,a->sector);
+        if (!in || !(in->flags&SITH_SECTOR_UNDERWATER) || !Bot_SectorSafe(in) || !Bot_WaterClear(in,start,wall,radius)) continue;
+        if (stage<2) stage=2;
+        SithSector *from=Bot_SectorAt(&launch,a->sector);
+        if (!from || !(from->flags&SITH_SECTOR_UNDERWATER)) continue;
+        BotNode leap={.pos=launch,.sector=from};
+        runJumpSurf=1;
+        int clear=RunJump_Sweep(self,&leap,b,0.36f,weak,thrust) && RunJump_Sweep(self,&leap,b,0.60f,weak,thrust) &&
+                  RunJump_Sweep(self,&leap,b,0.36f,full,thrust) && RunJump_Sweep(self,&leap,b,0.60f,full,thrust);
+        runJumpSurf=0;
+        if (!clear) continue;
+        plan->speed=0.45f; plan->hold=full-2.5f; plan->runway=runway; plan->seconds=0;
+        plan->sprint=jumpRank>=4 ? 1.33f : 0.35f*jumpRank+0.10f; /* how long the key is to stay down */
+        plan->force=1; plan->surf=1; plan->launch=launch;
+        return 1;
+    }
+    runSurfDropped[stage]++;
+    return 0;
+}
+
+static void Bot_RunSurfBuild(SithThing *self,int i,int jumpRank)
+{
+    static flex_t distance[BOT_NODES]; static int parent[BOT_NODES];
+    BotNode *a=&bot.nodes[i]; rdVector3 surface;
+    if (jumpRank<1 || nav.runCount>=BOT_RUNJUMPS || a->nEdges>=BOT_EDGES || nav.liftForNode[i] ||
+        !Bot_SectorSafe(a->sector) || !Bot_WaterSurface(a,self->moveSize,&surface)) return;
+    int best[3]={-1,-1,-1},ready=0; flex_t near[3]={1e20f,1e20f,1e20f},worth[3]={0,0,0};
+    for (int j=0;j<bot.nNodes;j++) {
+        BotNode *b=&bot.nodes[j];
+        if ((b->sector->flags&SITH_SECTOR_UNDERWATER) || nav.liftForNode[j]) continue;
+        rdVector3 d=Bot_Sub(b->pos,surface);
+        flex_t horizontal=Bot_Horizontal(d);
+        if (horizontal<0.10f || horizontal>1.2f || d.z<0.25f || d.z>1.3f) continue;
+        int linked=0;
+        for (int e=0;e<a->nEdges;e++) if (a->edges[e].to==j) linked=1;
+        if (linked) continue;
+        if (!ready) { Bot_PathDistances(self,i,distance,parent); ready=1; }
+        /* A bank with no other way to it from here is the best reason of all. */
+        if (distance[j]<1e19f && distance[j]<3.0f*horizontal+4.0f) { runJumpDropped[0]++; continue; }
+        for (int k=0;k<3;k++) if (horizontal<near[k]) {
+            for (int m=2;m>k;m--) { best[m]=best[m-1]; near[m]=near[m-1]; worth[m]=worth[m-1]; }
+            best[k]=j; near[k]=horizontal; worth[k]=distance[j]<1e19f ? distance[j]-horizontal : -1.0f; break;
+        }
+    }
+    for (int k=0;k<3 && best[k]>=0;k++) {
+        BotRunJump plan={0};
+        if (!Bot_RunSurfSolve(self,a,&bot.nodes[best[k]],surface,jumpRank,&plan)) { runJumpDropped[3]++; continue; }
+        plan.from=i; plan.to=best[k]; plan.jumpRank=jumpRank;
+        nav.runEdges[nav.runCount++]=plan;
+        Bot_AddEdge(i,best[k],BOT_ROUTE_RUNJUMP);
+        fprintf(stderr,"BOT_RUNJUMP name=%s event=edge from=%d to=%d at=%.2f,%.2f,%.2f land=%.2f,%.2f,%.2f distance=%.2f rise=%.2f "
+            "hold=%.2f flight=%.2f saved=%.1f surface=1\n",bot.name,i,best[k],(double)surface.x,(double)surface.y,(double)surface.z,
+            (double)bot.nodes[best[k]].pos.x,(double)bot.nodes[best[k]].pos.y,(double)bot.nodes[best[k]].pos.z,
+            (double)near[k],(double)(bot.nodes[best[k]].pos.z-surface.z),(double)plan.hold,(double)plan.seconds,(double)worth[k]);
+        return;
+    }
+}
+
+/* After the ordinary graph: one node a tick, a few far landings each, kept
+   only where the jump saves a long way round. */
+static void Bot_RunJumpBuildStep(SithThing *self)
+{
+    static flex_t distance[BOT_NODES]; static int parent[BOT_NODES];
+    if (!bot.graphDone || !self || nav.runCursor>=bot.nNodes || nav.runCount>=BOT_RUNJUMPS ||
+        (self->flags&SITH_TF_DEAD) || self->actorParams.health<=0) return;
+    int i=nav.runCursor++, speedRank=Bot_RunJumpRank(self,SITHBIN_F_SPEED), jumpRank=Bot_RunJumpRank(self,SITHBIN_F_JUMP);
+    BotNode *a=&bot.nodes[i];
+    if (a->sector->flags&SITH_SECTOR_UNDERWATER) { Bot_RunSurfBuild(self,i,jumpRank); goto done; }
+    if (nav.liftForNode[i] || !Bot_SectorSafe(a->sector)) goto done;
+    /* Landings worth a jump: a long way round by the ordinary graph, and a
+       real gap in between. The three that save the most are tried. */
+    /* Dry landings are ranked by the detour they save. Water below is all
+       one pool to swim in: the nearest places are tried first, until one
+       can be reached. */
+    int best[3]={-1,-1,-1},pool[8]; flex_t saved[3]={-1,-1,-1},near[8],poolSaved[8];
+    for (int k=0;k<8;k++) { pool[k]=-1; near[k]=1e20f; poolSaved[k]=0; }
+    Bot_PathDistances(self,i,distance,parent);
+    for (int j=0;j<bot.nNodes;j++) {
+        BotNode *b=&bot.nodes[j];
+        if (j==i || nav.liftForNode[j]) continue;
+        int wet=(b->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+        rdVector3 d=Bot_Sub(b->pos,a->pos);
+        flex_t horizontal=Bot_Horizontal(d);
+        if (wet ? (horizontal<0.3f || horizontal>3.6f || d.z>-0.9f || d.z<-9.0f)
+                : (horizontal<1.3f || horizontal>4.6f || fabsf(d.z)>1.2f)) continue;
+        /* A place the ordinary graph cannot reach has no known way back. */
+        if (distance[j]>=1e19f) continue;
+        if (distance[j]<3.0f*horizontal+4.0f) { runJumpDropped[0]++; continue; }
+        flex_t saving=distance[j]-horizontal;
+        if (wet) {
+            for (int k=0;k<8;k++) if (horizontal<near[k]) {
+                for (int m=7;m>k;m--) { pool[m]=pool[m-1]; near[m]=near[m-1]; poolSaved[m]=poolSaved[m-1]; }
+                pool[k]=j; near[k]=horizontal; poolSaved[k]=saving; break;
+            }
+            continue;
+        }
+        if (saving<=saved[2]) continue;
+        rdVector3 middle=Bot_Mix(a->pos,b->pos,0.5f),floor; SithSector *support=NULL;
+        middle.z=Bot_Max(a->pos.z,b->pos.z);
+        SithSector *over=Bot_SectorAt(&middle,a->sector);
+        if (!over || Bot_Floor(middle,over,BOT_FOOT_HEIGHT+0.9f,&floor,&support)) continue;
+        for (int k=0;k<3;k++) if (saving>saved[k]) {
+            for (int m=2;m>k;m--) { best[m]=best[m-1]; saved[m]=saved[m-1]; }
+            best[k]=j; saved[k]=saving; break;
+        }
+    }
+    for (int order=0,added=0,dives=0;order<11 && added<2 && nav.runCount<BOT_RUNJUMPS;order++) {
+        int j=order<8 ? pool[order] : best[order-8];
+        flex_t worth=order<8 ? poolSaved[order] : saved[order-8];
+        if (j<0 || (order<8 && dives)) continue;
+        BotRunJump plan={0};
+        BotRunJump other={0}; int both=0;
+        if (bot.nodes[j].sector->flags&SITH_SECTOR_UNDERWATER) {
+            int plain=Bot_RunDiveSolve(self,a,&bot.nodes[j],speedRank,0,&plan);
+            int fast=speedRank>0 && Bot_RunDiveSolve(self,a,&bot.nodes[j],speedRank,1,plain ? &other : &plan);
+            if (!plain && !fast) continue;
+            both=plain && fast;
+        } else if (!Bot_RunJumpSolve(self,a,&bot.nodes[j],speedRank,jumpRank,&plan)) continue;
+        plan.from=i; plan.to=j; plan.speedRank=speedRank; plan.jumpRank=jumpRank;
+        if (a->nEdges>=BOT_EDGES || nav.runCount+both>=BOT_RUNJUMPS) continue;
+        nav.runEdges[nav.runCount++]=plan;
+        if (both) { other.from=i; other.to=j; other.speedRank=speedRank; other.jumpRank=jumpRank; nav.runEdges[nav.runCount++]=other; }
+        Bot_AddEdge(i,j,BOT_ROUTE_RUNJUMP); added++; dives+=plan.dive;
+        rdVector3 gap=Bot_Sub(bot.nodes[j].pos,a->pos);
+        fprintf(stderr,"BOT_RUNJUMP name=%s event=edge from=%d to=%d at=%.2f,%.2f,%.2f land=%.2f,%.2f,%.2f distance=%.2f rise=%.2f "
+            "speed=%.2f force_speed=%d strafe=%d force_jump=%d hold=%.2f runway=%.2f sprint=%.2f flight=%.2f saved=%.1f dive=%d walk=%d speed_states=%d\n",
+            bot.name,i,j,(double)a->pos.x,(double)a->pos.y,(double)a->pos.z,
+            (double)bot.nodes[j].pos.x,(double)bot.nodes[j].pos.y,(double)bot.nodes[j].pos.z,
+            (double)Bot_Horizontal(gap),(double)gap.z,(double)plan.speed,plan.sped,plan.boost,plan.force,
+            (double)plan.hold,(double)plan.runway,(double)plan.sprint,(double)plan.seconds,(double)worth,plan.dive,plan.walk,1+both);
+    }
+done:
+    if (nav.runCursor>=bot.nNodes) {
+        fprintf(stderr,"BOT_RUNJUMP name=%s event=ready edges=%d speed_rank=%d jump_rank=%d short_detour=%d no_launch=%d no_runway=%d blocked=%d\n",
+            bot.name,nav.runCount,speedRank,jumpRank,runJumpDropped[0],runJumpDropped[1],runJumpDropped[2],runJumpDropped[3]);
+        memset(runJumpDropped,0,sizeof(runJumpDropped));
+        fflush(stderr);
+    }
+}
+
+/* Set the edge aside: briefly when the moment was wrong, for a minute after
+   a miss, for the map when the run-up itself cannot be walked. */
+static void RunJump_Fail(SithThing *self,BotRunJump *plan,const char *why,flex_t seconds)
+{
+    plan->failedUntil=bot.now+seconds;
+    if (bot.forceBin==SITHBIN_F_JUMP) bot.forceUntil=bot.now;
+    fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=fail why=%s from=%d to=%d phase=%d pos=%.2f,%.2f,%.2f health=%.0f\n",
+        bot.name,(double)bot.now,why,plan->from,plan->to,nav.runPhase,
+        (double)self->position.x,(double)self->position.y,(double)self->position.z,(double)self->actorParams.health);
+    nav.runPhase=0; nav.runFrom=nav.runTo=nav.runActive=nav.runSalvage=0;
+    bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+}
+
+/* The route follower may move on to the next leg before the feet touch.
+   Every flight is followed to its end here, for the log and for the edge's
+   record: a landing anywhere but the foothold sets the edge aside. */
+static void Bot_RunJumpWatch(SithThing *self)
+{
+    /* Force Speed lasts 5 + 2.5 a rank from the moment it comes up. */
+    if (self->actorParams.extraSpeed<=0.01f) nav.runSpedAt=0;
+    else if (nav.runSpedAt<=0) nav.runSpedAt=bot.now;
+    if (nav.runFlight<1 || nav.runFlight>nav.runCount) { nav.runFlight=0; return; }
+    BotRunJump *plan=&nav.runEdges[nav.runFlight-1];
+    BotNode *b=&bot.nodes[plan->to];
+    int dead=(self->flags&SITH_TF_DEAD)!=0 || self->actorParams.health<=0;
+    int wet=(self->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+    if (!dead && !wet && !(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE))) return;
+    flex_t miss=Bot_Horizontal(Bot_Sub(b->pos,self->position)),dz=self->position.z-b->pos.z;
+    int ok=plan->dive ? (!dead && wet) : (!dead && !wet && fabsf(dz)<=0.25f && miss<=0.9f);
+    fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=land from=%d to=%d ok=%d miss=%.2f dz=%.2f lost=%.0f health=%.0f dead=%d wet=%d\n",
+        bot.name,(double)bot.now,plan->from,plan->to,ok,(double)miss,(double)dz,
+        (double)(nav.runHealth-self->actorParams.health),(double)self->actorParams.health,dead,wet);
+    if (!ok) plan->failedUntil=bot.now+60.0f;
+    nav.runFlight=0; nav.runLogged=0;
+}
+
+static void RunJump_Fail(SithThing *self,BotRunJump *plan,const char *why,flex_t seconds);
+
+/* Out of the water: float at the start of a short swim toward the bank,
+   face it, then time the Force Jump key and the swim back from one release,
+   as on land, so the key comes up a little short of the wall. */
+static int RunJump_SurfMove(SithThing *self,BotRunJump *plan,BotNode *a,BotNode *b)
+{
+    (void)a;
+    nav.runSeen=bot.now; nav.waitUntil=bot.now+0.3f;
+    bot.routeMode=BOT_ROUTE_RUNJUMP; bot.routeAim=1; bot.moveRun=bot.moveBoost=0;
+    if (bot.nextPlan<bot.now+1.0f) bot.nextPlan=bot.now+1.0f;
+    if (nav.runPhase==0) { nav.runPhase=1; nav.runUntil=bot.now+12.0f; nav.runAir=nav.runHeld=0; }
+    if (bot.now>nav.runUntil) { RunJump_Fail(self,plan,"timeout",60.0f); return 1; }
+    int wet=(self->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+    int grounded=(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE))!=0;
+    int floating=(self->physicsParams.flags&SITH_PF_ONWATERSURFACE)!=0;
+    rdVector3 gap=Bot_Sub(b->pos,plan->launch); gap.z=0;
+    flex_t span=Bot_Horizontal(gap);
+    if (span<0.01f) { RunJump_Fail(self,plan,"no-line",900.0f); return 1; }
+    rdVector3 direction={gap.x/span,gap.y/span,0};
+    rdVector3 toBank=Bot_Sub(b->pos,self->position); toBank.z=0;
+    flex_t reach=Bot_Horizontal(toBank);
+    rdVector3 level={self->position.x+direction.x,self->position.y+direction.y,self->position.z};
+    Bot_Aim(self,level,0);
+    if (nav.runPhase==1) {
+        if (!wet) { RunJump_Fail(self,plan,"not-in-water",15.0f); return 1; }
+        rdVector3 start={plan->launch.x-plan->runway*direction.x,plan->launch.y-plan->runway*direction.y,plan->launch.z};
+        rdVector3 offset=Bot_Sub(start,self->position); offset.z=0;
+        if (Bot_Horizontal(offset)>0.07f || !floating) {
+            if (floating) start.z=self->position.z;
+            if (!Bot_NavDirectMove(self,start,1)) RunJump_Fail(self,plan,"blocked",60.0f);
+            return 1;
+        }
+        if (Bot_Dot(direction,self->orient.lvec)<0.985f || Bot_Horizontal(self->physicsParams.vel)>0.08f ||
+            bot.forceBin>=0 || bot.now<bot.nextForce) return 1;
+        /* The key stays down for the whole swim. With Force Speed the swim
+           is shorter, so it starts later and the hold is the same. */
+        flex_t speed,swim; RunJump_Swim(self,plan->runway,&speed,&swim);
+        if (!Bot_ForceReady(self,SITHBIN_F_JUMP,Bot_ForceCost(self,SITHBIN_F_JUMP)) ||
+            !Bot_RequestForce(self,SITHBIN_F_JUMP,1.40f,-1)) { RunJump_Fail(self,plan,"no-jump",15.0f); return 1; }
+        nav.runPhase=2; nav.runHeld=1; nav.runAir=0; nav.runActive=(int)(plan-nav.runEdges)+1;
+        nav.runRelease=bot.now; nav.runSwim=bot.now+Bot_Max(0.0f,plan->sprint-swim);
+        fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=start from=%d to=%d swim=%.2f boost=%.1f surface=1 pos=%.2f,%.2f,%.2f\n",
+            bot.name,(double)bot.now,plan->from,plan->to,(double)swim,(double)self->actorParams.extraSpeed,
+            (double)self->position.x,(double)self->position.y,(double)self->position.z);
+    }
+    if (nav.runPhase==2) {
+        if (!wet && !grounded) {
+            nav.runPhase=3; nav.runAir=1; nav.runFlight=(int)(plan-nav.runEdges)+1; nav.runHealth=self->actorParams.health;
+            fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=launch from=%d to=%d pace=%.2f up=%.2f held=%.2f pos=%.2f,%.2f surface=1\n",
+                bot.name,(double)bot.now,plan->from,plan->to,(double)Bot_Dot(self->physicsParams.vel,direction),
+                (double)self->physicsParams.vel.z,(double)(bot.now-nav.runRelease),(double)self->position.x,(double)self->position.y);
+        } else {
+            rdVector3 left=Bot_Sub(plan->launch,self->position); left.z=0;
+            flex_t remaining=Bot_Dot(left,direction),pace=Bot_Dot(self->physicsParams.vel,direction);
+            if (bot.now>=nav.runSwim) Bot_ThrustAxes(self,direction,0);
+            /* At the launch point: let the key up. */
+            if (bot.forceBin==SITHBIN_F_JUMP && bot.now-nav.runRelease>=plan->sprint-0.06f && remaining<=0.5f*Bot_Max(pace,0.0f)*bot.frameDt+0.01f)
+                bot.forceUntil=bot.now;
+            if (bot.now>nav.runRelease+2.2f) { RunJump_Fail(self,plan,"no-takeoff",60.0f); return 1; }
+            return 1;
+        }
+    }
+    if (nav.runPhase==3) {
+        if (!wet && !grounded) { if (reach>0.03f) Bot_ThrustAxes(self,toBank,0); return 1; }
+        if (wet) { RunJump_Fail(self,plan,"fell-back",60.0f); return 1; }
+        if (fabsf(self->position.z-b->pos.z)>0.25f || reach>0.9f) { RunJump_Fail(self,plan,"missed",60.0f); return 1; }
+        nav.runPhase=4;
+    }
+    if (reach>0.03f) Bot_Move(self,toBank,0);
+    return 1;
+}
+
+/* Phases: 0 walk to the start of the run-up, bring up Force Speed, stand
+   and face the line; 1 timed launch, with the Force Jump key held so that it
+   comes up as the sprint reaches the launch node; 2 flight; 4 landed. There
+   is no stopping once the sprint starts: the run-up is too short for that. */
+static int Bot_RunJumpMove(SithThing *self,int from,int nodeIndex)
+{
+    if (nav.runFrom!=from+1 || nav.runTo!=nodeIndex+1 || bot.now-nav.runSeen>0.6f) {
+        nav.runFrom=from+1; nav.runTo=nodeIndex+1; nav.runPhase=0; nav.runActive=0; nav.runSalvage=0;
+        nav.runUntil=bot.now+7.0f; nav.runAir=nav.runLogged=0;
+    }
+    BotRunJump *plan=nav.runPhase>0 && nav.runActive>0 && nav.runActive<=nav.runCount ? &nav.runEdges[nav.runActive-1]
+                                                                                   : Bot_RunJumpPlan(self,from,nodeIndex);
+    if (plan && plan->dive && (self->sector->flags&SITH_SECTOR_UNDERWATER)) return 0; /* in the water: the swim takes over */
+    if (!plan) {
+        /* Nothing solved for the speed the bot has right now. */
+        nav.runPhase=0; nav.runFrom=nav.runTo=nav.runActive=nav.runSalvage=0;
+        bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+        return 1;
+    }
+    BotNode *a=&bot.nodes[from],*b=&bot.nodes[nodeIndex];
+    if (plan->surf) return RunJump_SurfMove(self,plan,a,b);
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t distance=Bot_Horizontal(delta);
+    rdVector3 direction={delta.x/distance,delta.y/distance,0};
+    nav.runSeen=bot.now; nav.waitUntil=bot.now+0.3f;
+    bot.routeMode=BOT_ROUTE_RUNJUMP; bot.routeAim=1; bot.moveRun=bot.moveBoost=0;
+    if (bot.nextPlan<bot.now+1.0f) bot.nextPlan=bot.now+1.0f;
+    if ((self->sector->flags&SITH_SECTOR_UNDERWATER) || bot.now>nav.runUntil) { RunJump_Fail(self,plan,"timeout",60.0f); return 1; }
+    int grounded=(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE))!=0;
+    flex_t turn=plan->boost ? ((from&1) ? BOT_DIAGONAL_ANGLE : -BOT_DIAGONAL_ANGLE) : 0;
+    rdVector3 look={direction.x*cosf(turn)-direction.y*sinf(turn),direction.x*sinf(turn)+direction.y*cosf(turn),0};
+    rdVector3 lookAt={self->position.x+look.x,self->position.y+look.y,self->position.z};
+    flex_t extra=plan->sped ? RunJump_Boost(plan->speedRank) : 0;
+    if (nav.runPhase==0) {
+        if (!grounded) return 1;
+        /* The leg may have been planned from the nearest node, not from where
+           the bot stands: the run-up must be level ground it can walk. */
+        BotNode actual={.pos=self->position,.sector=self->sector}; int drop=0;
+        if (fabsf(self->position.z-a->pos.z)>0.08f ||
+            (Bot_Horizontal(Bot_Sub(a->pos,self->position))>0.05f && (!Bot_WalkableSpan(&actual,a,&drop,0.001f) || drop))) {
+            RunJump_Fail(self,plan,"not-at-launch",15.0f); return 1;
+        }
+        rdVector3 start=a->pos; start.x-=plan->runway*direction.x; start.y-=plan->runway*direction.y;
+        rdVector3 toStart=Bot_Sub(start,self->position); toStart.z=0;
+        if (Bot_Horizontal(toStart)>0.045f) {
+            start.z=self->position.z; Bot_Aim(self,start,0);
+            if (!Bot_NavDirectMove(self,start,0)) RunJump_Fail(self,plan,"runway-blocked",900.0f);
+            return 1;
+        }
+        Bot_Aim(self,lookAt,0);
+        if (plan->sped && self->actorParams.extraSpeed<=0.01f) {
+            if (bot.forceBin<0 && bot.now>=bot.nextForce) {
+                flex_t cost=Bot_ForceCost(self,SITHBIN_F_SPEED)+(plan->force ? Bot_ForceCost(self,SITHBIN_F_JUMP) : 0);
+                if (!Bot_ForceReady(self,SITHBIN_F_SPEED,cost) || !Bot_RequestForce(self,SITHBIN_F_SPEED,0.10f,-1))
+                    RunJump_Fail(self,plan,"no-speed",15.0f);
+            }
+            return 1;
+        }
+        if (plan->sped && fabsf(self->actorParams.extraSpeed-extra)>0.05f) { RunJump_Fail(self,plan,"speed-rank",60.0f); return 1; }
+        /* Speed that would run out before the launch is left to run out, and
+           brought up fresh. */
+        if (plan->sped && nav.runSpedAt>0 &&
+            nav.runSpedAt+5.0f+2.5f*plan->speedRank-bot.now<Bot_Max(plan->hold,plan->sprint)+0.8f) { nav.runUntil=Bot_Max(nav.runUntil,bot.now+3.0f); return 1; }
+        if (!plan->sped && self->actorParams.extraSpeed>0.01f) return 1; /* the lookup picks the other plan next tick */
+        if (bot.forceBin>=0 || (plan->force && bot.now<bot.nextForce) ||
+            Bot_Dot(look,self->orient.lvec)<0.995f || Bot_Horizontal(self->physicsParams.vel)>0.05f) return 1;
+        if (plan->force && !Bot_ForceReady(self,SITHBIN_F_JUMP,Bot_ForceCost(self,SITHBIN_F_JUMP))) { RunJump_Fail(self,plan,"no-mana",15.0f); return 1; }
+        /* Both the key and the sprint are timed back from one release. */
+        nav.runPhase=1; nav.runAir=0; nav.runHeld=0; nav.runActive=(int)(plan-nav.runEdges)+1;
+        nav.runRelease=bot.now+Bot_Max(plan->hold,plan->sprint)+2.0f*bot.frameDt;
+        fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=start from=%d to=%d runway=%.2f speed=%.2f hold=%.2f sprint=%.2f boost=%.1f\n",
+            bot.name,(double)bot.now,from,nodeIndex,(double)plan->runway,(double)plan->speed,(double)plan->hold,
+            (double)plan->sprint,(double)self->actorParams.extraSpeed);
+    }
+    if (nav.runPhase==1) {
+        Bot_Aim(self,lookAt,0);
+        /* A plan solved without Force Speed must not get it half way. Before
+           the sprint that sends the bot back to pick the other plan; once
+           the bot's own key is down, or none is needed, nothing else may
+           cast until it is over. */
+        if (!plan->sped && self->actorParams.extraSpeed>0.01f && grounded && bot.now<nav.runRelease-plan->sprint) {
+            if (bot.forceBin==SITHBIN_F_JUMP) bot.forceUntil=bot.now;
+            nav.runPhase=0; nav.runActive=0;
+            return 1;
+        }
+        if (!plan->sped && (plan->dive || !plan->force || nav.runHeld)) bot.nextForce=Bot_Max(bot.nextForce,bot.now+0.25f);
+        if (!grounded && !plan->dive && bot.now<nav.runRelease-0.08f) { RunJump_Fail(self,plan,"knocked-off",15.0f); return 1; }
+        if (!grounded) { nav.runPhase=2; nav.runAir=1; }
+        else {
+            if (plan->force && !nav.runHeld && bot.now>=nav.runRelease-plan->hold) {
+                if (!Bot_RequestForce(self,SITHBIN_F_JUMP,Bot_Max(0.15f,nav.runRelease-bot.now),-1)) { RunJump_Fail(self,plan,"no-jump",15.0f); return 1; }
+                nav.runHeld=1;
+            }
+            if (bot.now>=nav.runRelease-plan->sprint) {
+                rdVector3 offset=Bot_Sub(self->position,a->pos); offset.z=0;
+                flex_t along=Bot_Dot(offset,direction);
+                rdVector3 desired={direction.x-2.0f*(offset.x-along*direction.x),direction.y-2.0f*(offset.y-along*direction.y),0};
+                Bot_ThrustAxes(self,desired,plan->boost); bot.keys[INPUT_FUNC_FAST]=!plan->walk;
+            }
+            if (!plan->force && !plan->dive && bot.now>=nav.runRelease) { bot.keys[INPUT_FUNC_JUMP]=1; }
+            if (bot.now>nav.runRelease+(plan->dive ? 0.8f : 0.30f)) { RunJump_Fail(self,plan,"no-takeoff",60.0f); return 1; }
+            return 1;
+        }
+    }
+    if (nav.runPhase==2) {
+        Bot_Aim(self,lookAt,0);
+        if (!grounded) {
+            if (!nav.runLogged) {
+                nav.runLogged=1; nav.runFlight=(int)(plan-nav.runEdges)+1; nav.runHealth=self->actorParams.health;
+                flex_t pace=Bot_Dot(self->physicsParams.vel,direction);
+                fprintf(stderr,"BOT_RUNJUMP name=%s t=%.2f event=launch from=%d to=%d pace=%.2f wanted=%.2f up=%.2f pos=%.2f,%.2f late=%.2f\n",
+                    bot.name,(double)bot.now,from,nodeIndex,(double)pace,(double)plan->speed,
+                    (double)self->physicsParams.vel.z,(double)self->position.x,(double)self->position.y,(double)(bot.now-nav.runRelease));
+                /* jump_margin: gripped, blocked or knocked during the run-up,
+                   the held Force Jump still goes off when its key is let go.
+                   Far too slow to reach, come back down where it took off
+                   instead of drifting off the edge toward the far side. */
+                nav.runSalvage=BT_ON(JUMP_MARGIN) && !plan->dive && pace<0.7f*plan->speed;
+            }
+            if (nav.runSalvage) {
+                rdVector3 back=Bot_Sub(a->pos,self->position); back.z=0;
+                if (Bot_Horizontal(back)>0.04f) Bot_ThrustAxes(self,back,0);
+                return 1;
+            }
+            Bot_ThrustAxes(self,direction,plan->boost); return 1;
+        }
+        nav.runLogged=0;
+        if (nav.runSalvage) { nav.runSalvage=0; RunJump_Fail(self,plan,"slow-launch",15.0f); return 1; }
+        if (fabsf(self->position.z-b->pos.z)>0.25f || Bot_Horizontal(Bot_Sub(b->pos,self->position))>0.9f) { RunJump_Fail(self,plan,"missed",60.0f); return 1; }
+        nav.runPhase=4;
+    }
+    /* Landed: an ordinary walk to the node. */
+    rdVector3 toNode=Bot_Sub(b->pos,self->position);
+    if (Bot_Horizontal(toNode)>0.03f) Bot_Move(self,toNode,0);
+    return 1;
+}
diff --git a/src/AI/jkBotTactics.inc b/src/AI/jkBotTactics.inc
new file mode 100644
index 0000000..77d40b0
--- /dev/null
+++ b/src/AI/jkBotTactics.inc
@@ -0,0 +1,349 @@
+/* Named, bounded tactic values for the ordinary-input bot; see jkBot.c for license.
+ *
+ * A tactic is a number the planner or the movement code reads on every
+ * decision. Nothing here writes game state: a tactic only changes which
+ * ordinary inputs the bot chooses. Values come from three places, in order:
+ *
+ *   1. the compiled defaults below;
+ *   2. JK_BOT_TACTICS_FILE, a complete "name=value" revision that replaces
+ *      the defaults whenever its content changes (the operator's baseline);
+ *   3. the companion TACTICS command, which merges a few values into the
+ *      current table (the coach's live adjustment).
+ *
+ * A live adjustment is refused for BOT_TACTICS_COMMIT_SECONDS after the
+ * previous one, so no controller can flip the bot between plans faster than
+ * a plan can show whether it works.
+ *
+ * The wire identifies a tactic by its position in this table. Append new
+ * rows at the end; never reorder or delete a row. bots/tactics.py mirrors
+ * the table and tests/test_bot_tactics.py checks the two against each other.
+ *
+ * Columns: identifier, file name, default, legacy, lowest, highest.
+ * "legacy" is the value that reproduces the behaviour before this table
+ * existed, so a trial can compare the two without a rebuild.
+ */
+#define BOT_TACTIC_TABLE(X) \
+    /* Planner: what a missing gun is worth while healthy (elite bots). */ \
+    X(VALUE_CONC,       "value_conc",       18.0f, 18.0f, 0.0f,  40.0f) \
+    X(VALUE_RAIL,       "value_rail",       12.0f, 12.0f, 0.0f,  40.0f) \
+    X(VALUE_REPEATER,   "value_repeater",   10.0f, 10.0f, 0.0f,  40.0f) \
+    X(VALUE_WEAPON,     "value_weapon",      8.0f,  8.0f, 0.0f,  40.0f) \
+    /* Planner: weight of unvisited places, and the share of it that an \
+       underwater place keeps. 0 means the bot never dives just to look. */ \
+    X(EXPLORE,          "explore",           2.4f,  2.4f, 0.0f,  10.0f) \
+    X(EXPLORE_WET,      "explore_wet",       0.0f,  1.0f, 0.0f,   1.0f) \
+    /* Planner: how fast a goal loses appeal with path length, the appeal \
+       of hunting a living opponent, and seconds a chosen goal is kept. */ \
+    X(TRAVEL_COST,      "travel_cost",      0.42f, 0.42f, 0.05f,  2.0f) \
+    X(PURSUIT,          "pursuit",           9.0f,  9.0f, 0.0f,  40.0f) \
+    X(GOAL_HOLD,        "goal_hold",        14.0f, 14.0f, 2.0f,  60.0f) \
+    /* Water: extra path cost of stepping into water, the least a submerged \
+       pickup must be worth to dive for, and seconds underwater before the \
+       bot heads for air regardless of breath. */ \
+    X(WATER_ENTRY_COST, "water_entry_cost",  4.0f,  0.0f, 0.0f,  40.0f) \
+    X(DIVE_MIN_VALUE,   "dive_min_value",    6.0f,  0.0f, 0.0f,  40.0f) \
+    X(DIVE_SECONDS,     "dive_seconds",      8.0f,  8.0f, 2.0f,  30.0f) \
+    /* Movement: hold the ordinary run key on checked open ground; stop \
+       running this far before a jump, drop, lift, water edge or corner. */ \
+    X(RUN,              "run",               1.0f,  0.0f, 0.0f,   1.0f) \
+    X(RUN_BRAKE,        "run_brake",         0.8f,  0.8f, 0.2f,   3.0f) \
+    /* Movement: aim the thrust exactly along the wanted direction, and use \
+       the forward-plus-strafe diagonal on straight runs at least this long. */ \
+    X(EXACT_THRUST,     "exact_thrust",      1.0f,  0.0f, 0.0f,   1.0f) \
+    X(STRAFE_RUN,       "strafe_run",        1.0f,  0.0f, 0.0f,   1.0f) \
+    X(STRAFE_MIN_LEG,   "strafe_min_leg",    1.0f,  1.0f, 0.3f,  10.0f) \
+    /* Recovery: staying inside this radius for this long, while not \
+       waiting or fighting on dry ground, counts as confined (0 seconds \
+       turns the check off). The first escape avoids the failing places \
+       for tabu_seconds; each repeat doubles it and widens the area. */ \
+    X(CONFINE_RADIUS,   "confine_radius",   0.35f, 0.35f, 0.1f,   2.0f) \
+    X(CONFINE_SECONDS,  "confine_seconds",   6.0f,  0.0f, 0.0f,  60.0f) \
+    X(TABU_SECONDS,     "tabu_seconds",     12.0f, 12.0f, 1.0f, 120.0f) \
+    /* Combat: sideways share of gunfight movement, and the band of range \
+       a gunner holds (advance beyond far, back off inside near). */ \
+    X(COMBAT_STRAFE,    "combat_strafe",    0.55f, 0.55f, 0.0f,   1.0f) \
+    X(GUN_FAR,          "gun_far",           2.5f,  2.5f, 0.3f,  20.0f) \
+    X(GUN_NEAR,         "gun_near",         0.75f, 0.75f, 0.0f,  10.0f) \
+    /* Water: after turning back for air, or judging a swim too long for one \
+       breath, the same way into that water is avoided this long (0 = off). */ \
+    X(DIVE_RETRY,       "dive_retry",       45.0f,  0.0f, 0.0f, 300.0f) \
+    /* A swim that comes out on another bank may take this long (the engine \
+       gives twenty seconds of air); 0 holds it to dive_seconds. */ \
+    X(CROSSING_SECONDS, "crossing_seconds", 17.0f,  0.0f, 0.0f,  19.0f) \
+    /* Swim steep legs by looking along them and pushing forward. */ \
+    X(SWIM_PITCH,       "swim_pitch",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Cross gaps with a jump released at running speed, with Force Speed \
+       and Force Jump where the bot has them. */ \
+    X(RUN_JUMP,         "run_jump",          1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Hop over an incoming rocket or charge with a short Force Jump. */ \
+    X(DODGE_JUMP,       "dodge_jump",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Press use whenever the way is blocked, in case it is a door (1), or \
+       only when a switch, door or usable thing is in reach in front (0). \
+       Every press plays the stock "use" animation for everyone to see. */ \
+    X(BLIND_USE,        "blind_use",         0.0f,  1.0f, 0.0f,   1.0f) \
+    /* In water on a leg meant for dry ground: replan instead of hopping at \
+       the surface toward a ledge no hop can reach. */ \
+    X(WATER_SLIP,       "water_slip",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Concussion rifle: inside this distance the beam (alt fire, no blast, \
+       full damage to 5 units); beyond it the shell, whose blast forgives a \
+       near miss and knocks back. 99 keeps the old beam-first rule. */ \
+    X(CONC_ALT_RANGE,   "conc_alt_range",    1.4f, 99.0f, 0.0f,  99.0f) \
+    /* Keep a heavy gun in hand through a moment without a safe shot: the \
+       conc's beam covers close range, and a target out of sight is no \
+       reason to change weapons. Firing is still checked shot by shot. */ \
+    X(HEAVY_HOLD,       "heavy_hold",        1.0f,  0.0f, 0.0f,   1.0f) \
+    X(ITEM_PULL,        "item_pull",         2.0f,  0.0f, 0.0f,  99.0f) \
+    X(HAZARD_AVOID,     "hazard_avoid",      1.0f,  0.0f, 0.0f,   1.0f) \
+    X(MINES,            "mines",             1.0f,  0.0f, 0.0f,   1.0f) \
+    X(THERMALS,         "thermals",          1.0f,  0.0f, 0.0f,   1.0f) \
+    X(ABSORB_RESERVE,   "absorb_reserve",    1.0f,  0.0f, 0.0f,   1.0f) \
+    X(TURN_RATE,        "turn_rate",      1800.0f,  0.0f, 0.0f, 7200.0f) \
+    X(JUMP_MEMORY,      "jump_memory",      30.0f,  0.0f, 0.0f,  600.0f) \
+    /* Respawn as soon as the engine accepts it, three seconds after death, \
+       instead of pressing use on a fixed cadence. */ \
+    X(QUICK_RESPAWN,    "quick_respawn",     1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Below this health an underwater bot turns back for air at once; 0 \
+       leaves it to breath alone. */ \
+    X(AIR_HEALTH,       "air_health",        0.0f, 30.0f, 0.0f, 100.0f) \
+    /* A swim leg costs this many times its length: swimming is about a \
+       third of running speed, and a swimmer fights badly. */ \
+    X(SWIM_COST,        "swim_cost",         3.0f,  1.0f, 1.0f,  10.0f) \
+    /* Keep Force Speed up whenever moving on dry ground, fighting \
+       included; it is left out of the Absorb reserve. */ \
+    X(SPEED_UPKEEP,     "speed_upkeep",      1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Keep aiming and shooting while swimming and while climbing out of \
+       water; an exit someone nearer is using is left to them. */ \
+    X(WATER_FIGHT,      "water_fight",       1.0f,  0.0f, 0.0f,   1.0f) \
+    /* With no gun left a few shots, stop hunting and fetch ammunition or a \
+       weapon; pick up guns pulled from opponents; aim first at an opponent \
+       left with bare hands. */ \
+    X(RESUPPLY,         "resupply",          1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Check a Force Jump leg with the flight the bot actually makes: from \
+       a standstill, drifting on air thrust. */ \
+    X(FJUMP_STANDSTILL, "fjump_standstill",  1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Run everywhere on dry ground, corners and item approaches included; \
+       walk only where a running bot could not stop short of a pit, a \
+       ledge, water or a damaging floor, and on precision steps. */ \
+    X(ALWAYS_RUN,       "always_run",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Pull an item without stopping: run at it through the pull, then \
+       run onto it as it flies in, still fighting if a fight starts. */ \
+    X(PULL_ON_MOVE,     "pull_on_move",      1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Find a way to a dropped pack from the graph nodes nearest it, kept \
+       while it lies still, and reach one on a pool floor. */ \
+    X(PACK_HUNT,        "pack_hunt",         1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Least worth of a dropped pack holding a concussion rifle, a rail \
+       detonator or a repeater with a shot for it, even with each of them \
+       in hand: its ammo, and keeping it from whoever comes for it next. */ \
+    X(PACK_DENY,        "pack_deny",         3.0f,  0.0f, 0.0f,  20.0f) \
+    /* Feet on a lip, centre over a drop: start routes from the floor \
+       underfoot, and with no safe heading near the wanted one take the \
+       nearest safe heading instead of standing frozen at the edge. */ \
+    X(LIP_ESCAPE,       "lip_escape",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Level traps (jkBotTraps.inc): keep out of an armed or firing trap's \
+       zone, walk out of one when caught in it, and never press a trap's \
+       switch just to get past. */ \
+    X(TRAP_AVOID,       "trap_avoid",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* The longest walk to a trap's switch, in units of path, for springing \
+       it on an opponent in its zone; 0 never springs one. */ \
+    X(TRAP_USE,         "trap_use",          6.0f,  0.0f, 0.0f,  10.0f) \
+    /* The chance an opening is taken: traps are used now and then. */ \
+    X(TRAP_CHANCE,      "trap_chance",       0.6f,  0.6f, 0.0f,   1.0f) \
+    /* Accept a running jump only if a launch 15 percent slow (or 7 percent \
+       slow with a tenth less Force Jump lift) would still land. */ \
+    X(JUMP_MARGIN,      "jump_margin",       1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Switch an armed lightning ramp back off once it has stood armed a \
+       while with no opponent near it. The longer it stands armed, the \
+       farther a bot walks to do it, up to twice trap_use. */ \
+    X(TRAP_DISARM,      "trap_disarm",       1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Work a level's force field: a way through it while it is on costs \
+       the walk to the switch on that side, the bot presses that switch \
+       before crossing, and it never walks into the field while it is on. */ \
+    X(FIELD_SWITCH,     "field_switch",      1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Work a lift that will not come or go: press its button on this \
+       level, or step off across its threshold and back on (the stock \
+       elevators start when a player crosses it), and make no blind use \
+       presses while waiting for it. */ \
+    X(LIFT_CALL,        "lift_call",         1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Build a Force Jump leg into the graph only if it still flies at 25 \
+       frames a second, and fly the check at the averaged frame time, so \
+       a leg the planner chose is not refused at the launch spot. */ \
+    X(FJUMP_MARGIN,     "fjump_margin",      1.0f,  0.0f, 0.0f,   1.0f) \
+    /* With no route out of where it stands and nothing to do, work the \
+       floor door it stands on: look down and press use, as a player opens \
+       the hatch at the bottom of Bespin's pit and drops through. */ \
+    X(DEAD_END,         "dead_end",          1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Off a walking leg's own line with the straight way to its node \
+       blocked (the jamb of a narrow opening), get back onto the line the \
+       graph checked before going on. */ \
+    X(LEG_AXIS,         "leg_axis",          1.0f,  0.0f, 0.0f,   1.0f) \
+    /* A ledge or alcove halfway up a lift shaft (Bespin's railgun and \
+       concussion rifle) is left by the lift: step onto its deck as it \
+       passes, or drop onto it where it stands below. */ \
+    X(LIFT_HOP,         "lift_hop",          1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Pressed against the wall beside a narrow opening, even the slanted \
+       way back onto a leg's line clips the opening's jamb: step square \
+       onto the line first, along the wall. */ \
+    X(LEG_SQUARE,       "leg_square",        1.0f,  0.0f, 0.0f,   1.0f) \
+    /* Swing the saber's heavy secondary (160 damage, the longest reach) \
+       from contact wherever the target will still be in reach as it \
+       lands; the quick primary only for a target pulling away, and no \
+       swing at all out of contact. 0: the primary, from farther out. */ \
+    X(SABER_HEAVY,      "saber_heavy",       1.0f,  0.0f, 0.0f,   1.0f)
+
+enum {
+#define X(id,name,initial,legacy,low,high) BT_##id,
+    BOT_TACTIC_TABLE(X)
+#undef X
+    BT_COUNT
+};
+enum { BOT_TACTICS_COMMIT_SECONDS = 8, BOT_TACTICS_WIRE_PAIRS = 21 };
+
+typedef struct BotTacticSpec { const char *name; float initial, legacy, low, high; } BotTacticSpec;
+static const BotTacticSpec botTacticSpecs[BT_COUNT]={
+#define X(id,name,initial,legacy,low,high) {name,initial,legacy,low,high},
+    BOT_TACTIC_TABLE(X)
+#undef X
+};
+
+/* Existing regression suites pin the behaviour they were written against. */
+#ifdef JKBOT_TACTICS_BASELINE_LEGACY
+#define BOT_TACTIC_BASELINE(initial,legacy) legacy
+#else
+#define BOT_TACTIC_BASELINE(initial,legacy) initial
+#endif
+
+static struct {
+    float value[BT_COUNT];
+    char file[4096];
+    flex_t nextFile, lockedUntil;
+    uint32_t fileHash, revision;
+    int fileSeen;
+} tactics={.value={
+#define X(id,name,initial,legacy,low,high) BOT_TACTIC_BASELINE(initial,legacy),
+    BOT_TACTIC_TABLE(X)
+#undef X
+}};
+#define BT(id) (tactics.value[BT_##id])
+#define BT_ON(id) (tactics.value[BT_##id]>=0.5f)
+
+static void Bot_TacticsBaseline(float *values,int legacy)
+{
+    for (int i=0;i<BT_COUNT;i++)
+        values[i]=legacy ? botTacticSpecs[i].legacy :
+            BOT_TACTIC_BASELINE(botTacticSpecs[i].initial,botTacticSpecs[i].legacy);
+}
+
+static int Bot_TacticValid(int id,float value)
+{
+    return id>=0 && id<BT_COUNT && isfinite(value) &&
+        value>=botTacticSpecs[id].low && value<=botTacticSpecs[id].high;
+}
+
+/* A new table takes effect at the next decision. The current goal is kept:
+   goal_hold and the route follower decide when to let go of it. */
+static void Bot_TacticsApply(const float *values,const char *source)
+{
+    int changed=0;
+    for (int i=0;i<BT_COUNT;i++) if (tactics.value[i]!=values[i]) changed++;
+    memcpy(tactics.value,values,sizeof(tactics.value));
+    tactics.revision++;
+    bot.nextPlan=bot.armNext=0;
+    fprintf(stderr,"BOT_TACTICS name=%s t=%.2f source=%s revision=%u changed=%d\n",
+        bot.name,(double)bot.now,source,tactics.revision,changed);
+    fflush(stderr);
+}
+
+/* The operator atomically replaces this complete file. Unknown names,
+   repeated names and out-of-range values reject the whole revision. */
+static int Bot_ReadTactics(const char *text,size_t length,float *values)
+{
+    unsigned char seen[BT_COUNT]={0};
+    int version=0,rows=0;
+    Bot_TacticsBaseline(values,0);
+    for (size_t at=0;at<length;) {
+        char row[96];
+        size_t end=at;
+        while (end<length && text[end]!='\n') end++;
+        size_t n=end-at;
+        if (n && text[at+n-1]=='\r') n--;
+        if (n>=sizeof(row) || ++rows>BT_COUNT+8) return 0;
+        memcpy(row,text+at,n); row[n]=0;
+        at=end<length ? end+1 : end;
+        if (!n || row[0]=='#') continue;
+        char *eq=strchr(row,'='),*stop;
+        if (!eq || eq==row || !eq[1]) return 0;
+        *eq++=0;
+        if (!strcmp(row,"version")) {
+            if (version || strcmp(eq,"1")) return 0;
+            version=1; continue;
+        }
+        int id=-1;
+        for (int i=0;i<BT_COUNT;i++) if (!strcmp(row,botTacticSpecs[i].name)) { id=i; break; }
+        if (id<0 || seen[id]) return 0;
+        for (const char *c=eq;*c;c++)
+            if (!((*c>='0' && *c<='9') || *c=='.' || *c=='-')) return 0;
+        float value=strtof(eq,&stop);
+        if (*stop || !Bot_TacticValid(id,value)) return 0;
+        values[id]=value; seen[id]=1;
+    }
+    return version;
+}
+
+static void Bot_ReloadTactics(void)
+{
+    tactics.nextFile=bot.now+1.0f;
+    if (!*tactics.file) return;
+    FILE *f=fopen(tactics.file,"rb"); if (!f) return;
+    char text[4097];
+    size_t length=fread(text,1,sizeof(text),f);
+    int failed=ferror(f); fclose(f);
+    if (failed || !length) return;
+    uint32_t hash=2166136261u;
+    for (size_t i=0;i<length;i++) hash=(hash^(unsigned char)text[i])*16777619u;
+    if (tactics.fileSeen && hash==tactics.fileHash) return;
+    tactics.fileSeen=1; tactics.fileHash=hash;
+    float values[BT_COUNT];
+    if (length>=sizeof(text) || !Bot_ReadTactics(text,length,values)) {
+        fprintf(stderr,"BOT_TACTICS name=%s t=%.2f source=file status=rejected\n",bot.name,(double)bot.now);
+        fflush(stderr);
+        return;
+    }
+    Bot_TacticsApply(values,"file");
+}
+
+static void Bot_ConfigureTactics(void)
+{
+    memset(&tactics,0,sizeof(tactics));
+    Bot_TacticsBaseline(tactics.value,0);
+    const char *path=getenv("JK_BOT_TACTICS_FILE");
+    if (path && strlen(path)<sizeof(tactics.file)) strcpy(tactics.file,path);
+}
+
+/* Companion payload after the 8-byte deadline: flags, count, then count
+   records of one identifier byte and one little-endian float. Flag bit 0
+   restores the compiled defaults before the records are merged, bit 1 the
+   legacy column (more values differ from it than one command carries).
+   Returns 0 when applied, 1 for a malformed or out-of-range request, 2
+   while the previous adjustment is still committed. Nothing is applied on
+   failure. */
+static int Bot_WireTactics(const unsigned char *p,int size)
+{
+    if (size<2 || (p[0]&~3) || (p[0]&3)==3 || p[1]>BOT_TACTICS_WIRE_PAIRS || size!=2+5*p[1] ||
+        (!p[1] && !(p[0]&3))) return 1;
+    float values[BT_COUNT];
+    unsigned char seen[BT_COUNT]={0};
+    if (p[0]&1) Bot_TacticsBaseline(values,0);
+    else if (p[0]&2) Bot_TacticsBaseline(values,1);
+    else memcpy(values,tactics.value,sizeof(values));
+    for (int i=0;i<p[1];i++) {
+        const unsigned char *record=p+2+5*i;
+        uint32_t bits=record[1]|((uint32_t)record[2]<<8)|((uint32_t)record[3]<<16)|((uint32_t)record[4]<<24);
+        float value; memcpy(&value,&bits,4);
+        if (!Bot_TacticValid(record[0],value) || seen[record[0]]) return 1;
+        seen[record[0]]=1; values[record[0]]=value;
+    }
+    if (bot.now<tactics.lockedUntil) return 2;
+    tactics.lockedUntil=bot.now+BOT_TACTICS_COMMIT_SECONDS;
+    Bot_TacticsApply(values,"companion");
+    return 0;
+}
diff --git a/src/AI/jkBotTraps.inc b/src/AI/jkBotTraps.inc
new file mode 100644
index 0000000..500c84e
--- /dev/null
+++ b/src/AI/jkBotTraps.inc
@@ -0,0 +1,1000 @@
+/* Level traps: the switch-sprung hazards of the stock multiplayer levels.
+ *
+ *   Canyon Oasis     00_lightning.cog: the switch arms the grated ramp. The
+ *                    next player to step onto it sets three emitters firing
+ *                    Force Lightning (13 a bolt, 1.5 units) every half
+ *                    second until someone steps off. Pressed again, it
+ *                    disarms.
+ *   Nar Shaddaa      m2_dettrap.cog: each of four switches throws eight
+ *                    thermal detonators (3 s fuse, 75 within 0.45) from four
+ *                    spots, then resets. m2_turrettrap.cog: four ceiling
+ *                    turrets fire five auto-aimed volleys.
+ *                    m2_ffieldswitch.cog: a force field across the passage
+ *                    by the turret room, on at the start. While it is on
+ *                    nothing passes it and touching it takes 5 to 10 a
+ *                    quarter second. A switch on either side turns it off
+ *                    or on again.
+ *   Bespin           m4_reactorthrust.cog: the reactor switch thrusts anyone
+ *                    in the reactor shaft straight up for a door cycle.
+ *   Blades of Death  m5_fandamage.cog: the fan takes 125 a half second from
+ *                    anyone in its pit unless a switch has stopped it, for
+ *                    11.5 s. Only kept clear of; it has nothing to spring.
+ *
+ * A trap is recognised by the symbol names of its COG, whose values the
+ * level gives every machine. On a client a level COG's messages run on the
+ * server, so the COG's own variables never change here. The switch frames
+ * the server sets do reach every machine (SetWallCel synchronises the
+ * surface), and they say whether a trap is ready (frame 0) or live (frame 1;
+ * the fan runs at frame 0). A force field's state arrives the same way: the
+ * surface update carries its adjoin's flags, and the field is open while
+ * they allow movement. trap_avoid keeps a bot out of a live trap's zone,
+ * walks it out of one it is caught in and stops it pressing a trap's switch
+ * by accident. trap_use lets it spring one now and then: an opponent in the
+ * zone, no teammate there, the bot clear of it and the switch a short walk
+ * away. trap_disarm has a bot switch an armed ramp back off once it has
+ * stood armed a while with no opponent near it. field_switch prices a way
+ * through a field that is on as the walk by the switch on that side, sends
+ * the bot to press it first, and keeps it from walking into the field.
+ * Pressing a switch is the stock use key, from where a player stands.
+ */
+
+#define BOT_TRAPS 12
+#define BOT_TRAP_POINTS 4
+#define BOT_TRAP_REST 25.0f
+/* An ambush gets this long before anyone takes it back down. */
+#define BOT_TRAP_SETTLE 10.0f
+#define BOT_FIELDS 4
+#define BOT_GATES 64
+#define BOT_GATE_PAIRS 2048
+/* field_switch: the longest walk to a field's switch worth making; past it
+   the field is a wall from that side. */
+#define BOT_FIELD_REACH 25.0f
+
+enum { BOT_TRAP_LIGHTNING=1, BOT_TRAP_DETONATORS, BOT_TRAP_TURRETS, BOT_TRAP_REACTOR, BOT_TRAP_FAN, BOT_TRAP_FIELD };
+static const char *const botTrapKinds[]={"none","lightning","detonators","turrets","reactor","fan","field"};
+/* What a run to a switch is for, and what it is called once done. */
+enum { BOT_TRAP_SPRING, BOT_TRAP_DISARM, BOT_TRAP_OPEN };
+static const char *const botTrapPurposes[]={"spring","disarm","open"};
+static const char *const botTrapDone[]={"sprung","disarmed","opened"};
+
+typedef struct BotTrap {
+    int kind, cog, button, button2, sector[2], points;
+    rdVector3 point[BOT_TRAP_POINTS], facing[BOT_TRAP_POINTS];
+    SithSector *pointSector[BOT_TRAP_POINTS];
+    flex_t reach, cone, offTime;
+    rdVector3 aim;          /* the switch's centre, for the activation ray */
+    BotNode stand;          /* where a player stands to press it */
+    int standNode, usable, zoneNodes;
+    int cel, changed, live; /* switch frame last read, whether a change was seen */
+    int field, side;        /* a field's switch: which field, and which side of it */
+    flex_t celSince, nextTry, nextOpenLog;
+} BotTrap;
+
+/* A force field: its two faces (one each way through the same opening),
+   the plane of the first, whose normal points to its own sector's side. */
+typedef struct BotField {
+    int surface[2], gates, hugging, through, against; /* graph changes, for the log */
+    rdVector3 center, normal;
+    flex_t failedUntil[2]; /* per side: no switch run from there until then */
+    int fails[2];          /* per side: runs failed in a row */
+} BotField;
+/* A gate leg through a field, the side of its start (1 along the normal)
+   and the walk by that side's switch while the field is on. */
+typedef struct BotGate { int from, to, field, side; flex_t detour; } BotGate;
+
+static struct {
+    BotTrap list[BOT_TRAPS];
+    uint16_t zone[BOT_NODES];
+    BotField fields[BOT_FIELDS];
+    BotGate gates[BOT_GATES];
+    unsigned char gateNode[BOT_NODES];
+    int count, bound, use, phase, presses, exitNode, purpose, startCel;
+    int nFields, nGates, blockGates; /* 1: closed gates are walls, 2: every gate is */
+    int resumeGoal;                  /* where a run to open a field was headed */
+    flex_t nextScan, nextConsider, nextEscape, until, pressedAt, routeAt, health, nextGateCheck, resumeSetAt;
+    flex_t dist, nextDetours;        /* the run's walk when it began; when gate prices are next brought up to date */
+} traps;
+
+static SithCogSymbol *Bot_CogSymbol(sithCog *cog,const char *name)
+{
+#ifndef COG_CRC32_SYMBOL_NAMES
+    if (!cog || !cog->pSymbolTable || !cog->pSymbolTable->aSymbols) return NULL;
+    SithCogSymbolTable *table=cog->pSymbolTable;
+    for (uint32_t i=0;i<table->numUsedSymbols && i<table->tableSize;i++) {
+        SithCogSymbol *symbol=&table->aSymbols[i];
+        if (symbol->pName && Bot_NameIs(symbol->pName,name)) return symbol;
+    }
+#else
+    (void)cog; (void)name;
+#endif
+    return NULL;
+}
+static flex_t Bot_CogFlex(sithCog *cog,const char *name,flex_t otherwise)
+{
+    SithCogSymbol *symbol=Bot_CogSymbol(cog,name);
+    if (symbol && symbol->val.type==SITHCOG_VALUE_FLOAT) return (flex_t)symbol->val.dataAsFloat[0];
+    if (symbol && symbol->val.type==SITHCOG_VALUE_INT) return (flex_t)symbol->val.data[0];
+    return otherwise;
+}
+static int Bot_CogSurface(sithCog *cog,const char *name)
+{
+    int i=Bot_CogReference(cog,name);
+    return i>=0 && i<bot.world->numSurfaces ? i : -1;
+}
+static int Bot_CogSector(sithCog *cog,const char *name)
+{
+    int i=Bot_CogReference(cog,name);
+    return i>=0 && i<bot.world->numSectors ? i : -1;
+}
+
+/* Open while both faces let a body through. */
+static int Bot_FieldOpen(const BotField *f)
+{
+    for (int k=0;k<2;k++) {
+        const SithSurface *s=&bot.world->surfaces[f->surface[k]];
+        if (!s->pAdjoin || !(s->pAdjoin->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT)) return 0;
+    }
+    return 1;
+}
+
+/* A trap's switch frame; a field's "frame" is 1 while it is open. */
+static int Bot_TrapCel(const BotTrap *t)
+{
+    if (t->kind==BOT_TRAP_FIELD) return Bot_FieldOpen(&traps.fields[t->field]);
+    if (t->button<0) return 0;
+    return bot.world->surfaces[t->button].surfaceInfo.face.wallCel==1 ? 1 : 0;
+}
+
+static int Bot_TrapButton(const SithSurface *surface)
+{
+    if (!surface || !bot.world) return 0;
+    for (int i=0;i<traps.count;i++) {
+        const BotTrap *t=&traps.list[i];
+        if ((t->button>=0 && surface==&bot.world->surfaces[t->button]) ||
+            (t->button2>=0 && surface==&bot.world->surfaces[t->button2])) return 1;
+    }
+    return 0;
+}
+
+/* How far a point on a face's plane lies inside all of its edges
+   (negative outside). Stock faces are convex. */
+static flex_t Bot_FaceInside(SithSurface *s,rdVector3 p)
+{
+    rdFace *face=&s->surfaceInfo.face;
+    rdVector3 n=face->normal, c;
+    if (face->numVertices<3 || !Bot_FaceCenter(s,&c)) return -1e20f;
+    flex_t least=1e20f;
+    for (unsigned int j=0;j<face->numVertices;j++) {
+        rdVector3 v0=bot.world->aVertices[face->vertexPosIdx[j]];
+        rdVector3 v1=bot.world->aVertices[face->vertexPosIdx[(j+1)%face->numVertices]];
+        rdVector3 e=Bot_Sub(v1,v0), m={n.y*e.z-n.z*e.y,n.z*e.x-n.x*e.z,n.x*e.y-n.y*e.x};
+        flex_t len=Bot_Len(m);
+        if (len<1e-6f) continue;
+        m.x/=len; m.y/=len; m.z/=len;
+        if (Bot_Dot(Bot_Sub(c,v0),m)<0) { m.x=-m.x; m.y=-m.y; m.z=-m.z; }
+        flex_t d=Bot_Dot(Bot_Sub(p,v0),m);
+        if (d<least) least=d;
+    }
+    return least;
+}
+
+static flex_t Bot_FieldSide(const BotField *f,rdVector3 p)
+{ return Bot_Dot(Bot_Sub(p,f->center),f->normal); }
+
+/* Where a straight leg meets a field's plane, and how far inside its face. */
+static int Bot_FieldCross(const BotField *f,rdVector3 a,rdVector3 b,rdVector3 *at,flex_t *inside)
+{
+    flex_t sa=Bot_FieldSide(f,a), sb=Bot_FieldSide(f,b);
+    if ((sa>0)==(sb>0) || fabsf(sa-sb)<1e-6f) return 0;
+    *at=Bot_Mix(a,b,sa/(sa-sb));
+    *inside=Bot_FaceInside(&bot.world->surfaces[f->surface[0]],*at);
+    return 1;
+}
+
+/* A leg goes through a field where it meets the face, or passes its edge
+   closer than a body's breadth. */
+static flex_t Bot_FieldReach(void)
+{
+    const SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    return self && self->moveSize>=0.02f && self->moveSize<=0.25f ? self->moveSize : 0.065f;
+}
+static int Bot_FieldBlocks(int from,int to)
+{
+    for (int i=0;i<traps.nFields;i++) {
+        rdVector3 at; flex_t inside;
+        if (Bot_FieldCross(&traps.fields[i],bot.nodes[from].pos,bot.nodes[to].pos,&at,&inside) && inside>-Bot_FieldReach()) return 1;
+    }
+    return 0;
+}
+
+static flex_t Bot_GateCost(int from,int to)
+{
+    for (int g=0;g<traps.nGates;g++) {
+        const BotGate *gate=&traps.gates[g];
+        if (gate->from!=from || gate->to!=to) continue;
+        const BotField *f=&traps.fields[gate->field];
+        if (traps.blockGates>1) return -1;
+        if (Bot_FieldOpen(f)) return 0;
+        /* On: a walk by this side's switch first, unless a run is already
+           under way or the switch could not be worked lately. */
+        if (traps.blockGates || traps.use || !BT_ON(FIELD_SWITCH) || gate->detour>=1e19f ||
+            bot.now<f->failedUntil[gate->side>0 ? 0 : 1]) return -1;
+        return gate->detour;
+    }
+    return -1;
+}
+
+/* Where a stock +grenade2 thrown from a spot first meets the level: its
+   template velocity turned by the spot's orientation, gravity and air drag,
+   in 20 ms steps. */
+static int Bot_TrapThrow(SithThing *self,SithThing *spot,const SithThing *grenade,rdVector3 *landing,SithSector **where)
+{
+    rdVector3 v0=grenade ? grenade->physicsParams.vel : (rdVector3){0,2.0f,1.5f};
+    flex_t drag=grenade && grenade->physicsParams.airDrag>0 ? grenade->physicsParams.airDrag : 0.8f;
+    rdVector3 v={spot->orient.rvec.x*v0.x+spot->orient.lvec.x*v0.y+spot->orient.uvec.x*v0.z,
+                 spot->orient.rvec.y*v0.x+spot->orient.lvec.y*v0.y+spot->orient.uvec.y*v0.z,
+                 spot->orient.rvec.z*v0.x+spot->orient.lvec.z*v0.y+spot->orient.uvec.z*v0.z};
+    rdVector3 p=spot->position;
+    SithSector *sector=spot->sector;
+    flex_t g=bot.world->gravity>0 ? bot.world->gravity : 4.0f, dt=0.02f;
+    for (int i=0;i<250 && sector;i++) {
+        rdVector3 next={p.x+v.x*dt,p.y+v.y*dt,p.z+v.z*dt};
+        if (!Bot_Clear(self,sector,p,next,0.015f,1)) { *landing=p; *where=sector; return 1; }
+        p=next; sector=Bot_SectorAt(&p,sector);
+        v.x-=v.x*drag*dt; v.y-=v.y*drag*dt; v.z-=v.z*drag*dt+g*dt;
+    }
+    return 0;
+}
+
+/* Inside a trap's zone: its sectors, and within reach of a point (a
+   detonator's landing, or an emitter's cone) with a clear line to it. */
+static int Bot_TrapHolds(SithThing *self,const BotTrap *t,rdVector3 pos,SithSector *sector)
+{
+    for (int k=0;k<2;k++) if (sector && t->sector[k]>=0 && sector==&bot.world->aSectors[t->sector[k]]) return 1;
+    for (int k=0;k<t->points;k++) {
+        rdVector3 d=Bot_Sub(pos,t->point[k]);
+        flex_t h=Bot_Horizontal(d), len=Bot_Len(d);
+        if (len>t->reach) continue;
+        if (t->kind==BOT_TRAP_DETONATORS) {
+            if (fabsf(d.z)>0.6f) continue;
+        } else {
+            /* An auto-aimed emitter takes what lies inside its view cone. */
+            rdVector3 f=t->facing[k];
+            flex_t fh=Bot_Horizontal(f);
+            if (len<0.02f || fh<0.01f || h<0.001f) continue;
+            if ((d.x*f.x+d.y*f.y)/(h*fh)<cosf(t->cone) || fabsf(atan2f(d.z,h))>t->cone) continue;
+        }
+        if (t->pointSector[k] && Bot_Clear(self,t->pointSector[k],t->point[k],pos,0,1)) return 1;
+    }
+    return 0;
+}
+
+static int Bot_TrapNear(const BotTrap *t,int bit,rdVector3 pos,flex_t range)
+{
+    (void)t;
+    for (int n=0;n<bot.nNodes;n++)
+        if ((traps.zone[n]&bit) && Bot_Distance(bot.nodes[n].pos,pos)<range) return 1;
+    return 0;
+}
+
+/* A spot in front of a wall switch with floor under it, from which the
+   stock activation ray (eye along the view, moveSize+0.1 long) meets the
+   switch, and the nearest graph node that walks onto it. */
+static int Bot_TrapStand(SithThing *self,BotTrap *t)
+{
+    SithSurface *s=&bot.world->surfaces[t->button];
+    rdVector3 n=s->surfaceInfo.face.normal, c;
+    flex_t nh=Bot_Horizontal(n);
+    if (!Bot_FaceCenter(s,&c) || nh<0.85f) return 0;
+    n.x/=nh; n.y/=nh; n.z=0;
+    t->aim=c;
+    flex_t reach=self->moveSize+0.1f-0.015f;
+    for (flex_t back=self->collideSize+0.02f;back<=reach && !t->usable;back+=0.02f) {
+        rdVector3 p={c.x+n.x*back,c.y+n.y*back,c.z+0.02f}, floor, out;
+        SithSector *sector;
+        if (!Bot_Floor(p,s->pSector,0.6f,&floor,&sector)) continue;
+        rdVector3 eye=floor; eye.z+=self->actorParams.eyeOffset.z;
+        if (Bot_Distance(eye,c)>reach) continue;
+        out=floor; out.x+=n.x*0.12f; out.y+=n.y*0.12f;
+        if (!Bot_Clear(self,sector,out,floor,self->collideSize*0.85f,1)) continue;
+        t->stand=(BotNode){.pos=floor,.sector=sector,.item=-1};
+        t->usable=1;
+    }
+    if (!t->usable) return 0;
+    int best=-1;
+    flex_t nearest=1.2f;
+    for (int i=0;i<bot.nNodes;i++) {
+        BotNode *node=&bot.nodes[i];
+        flex_t d=Bot_Distance(node->pos,t->stand.pos);
+        int drop=0;
+        if (d>=nearest || nav.liftForNode[i] || (node->sector->flags&SITH_SECTOR_UNDERWATER)) continue;
+        if (d>0.03f && (!Bot_Walkable(node,&t->stand,&drop) || drop)) continue;
+        best=i; nearest=d;
+    }
+    t->standNode=best;
+    t->usable=best>=0;
+    return t->usable;
+}
+
+/* Recognise one level COG as a trap by its symbol names. */
+static int Bot_BindTrap(SithThing *self,int index,BotTrap *t)
+{
+    sithCog *cog=&bot.world->aCogs[index];
+    memset(t,0,sizeof(*t));
+    t->cog=index; t->button=t->button2=-1; t->sector[0]=t->sector[1]=-1; t->standNode=-1; t->cel=-1;
+    if (Bot_CogSymbol(cog,"fan_sc") && Bot_CogSymbol(cog,"ghost_fan")) {
+        t->kind=BOT_TRAP_FAN; t->sector[0]=Bot_CogSector(cog,"fan_sc");
+        t->button=Bot_CogSurface(cog,"switch1"); t->button2=Bot_CogSurface(cog,"switch2");
+        t->offTime=Bot_CogFlex(cog,"fan_offtime",11.5f);
+        return t->sector[0]>=0 && t->button>=0;
+    }
+    if (Bot_CogSymbol(cog,"sector0") && Bot_CogSymbol(cog,"door0") && Bot_CogSymbol(cog,"thrustspeed")) {
+        t->kind=BOT_TRAP_REACTOR; t->sector[0]=Bot_CogSector(cog,"sector0"); t->sector[1]=Bot_CogSector(cog,"sector1");
+        t->button=Bot_CogSurface(cog,"switch");
+        return t->sector[0]>=0 && t->button>=0;
+    }
+    if (Bot_CogSymbol(cog,"turret1") && Bot_CogSymbol(cog,"ghost1")) {
+        static const char *ghosts[]={"ghost1","ghost2","ghost3","ghost4"};
+        t->kind=BOT_TRAP_TURRETS; t->button=Bot_CogSurface(cog,"switch");
+        /* Bolts fly far; the auto-aim takes only what its view cone holds. */
+        t->reach=6.0f; t->cone=Bot_CogFlex(cog,"autoaimxfov",90.0f)*0.5f/BOT_DEG;
+        for (int k=0;k<4;k++) {
+            SithThing *ghost=Bot_NavThing(Bot_CogReference(cog,ghosts[k]));
+            if (!ghost || !ghost->sector) continue;
+            t->pointSector[t->points]=ghost->sector;
+            t->point[t->points]=ghost->position; t->facing[t->points++]=ghost->orient.lvec;
+        }
+        return t->button>=0 && t->points>0;
+    }
+    if (Bot_CogSymbol(cog,"tdg1") && Bot_CogSymbol(cog,"switch")) {
+        static const char *spots[]={"tdg1","tdg2","tdg3","tdg4"};
+        t->kind=BOT_TRAP_DETONATORS; t->button=Bot_CogSurface(cog,"switch");
+        /* The blast reaches 0.45; a detonator thrown from a vent bounces
+           off its edges and rolls on after landing. */
+        t->reach=1.2f;
+        int tpl=Bot_CogReference(cog,"proj_tpl");
+        SithThing *grenade=tpl>=0 && tpl<bot.world->numThingTemplates ? &bot.world->aThingTemplates[tpl] : NULL;
+        if (grenade && grenade->type!=SITH_THING_WEAPON) grenade=NULL;
+        for (int k=0;k<4;k++) {
+            SithThing *spot=Bot_NavThing(Bot_CogReference(cog,spots[k]));
+            rdVector3 landing; SithSector *where;
+            if (!spot || !spot->sector || !Bot_TrapThrow(self,spot,grenade,&landing,&where)) continue;
+            t->pointSector[t->points]=where; t->point[t->points++]=landing;
+        }
+        return t->button>=0 && t->points>0;
+    }
+    if (Bot_CogSymbol(cog,"zapsector") && Bot_CogSymbol(cog,"switch0")) {
+        static const char *ghosts[]={"ghost0","ghost1","ghost2"};
+        t->kind=BOT_TRAP_LIGHTNING; t->sector[0]=Bot_CogSector(cog,"zapsector");
+        t->button=Bot_CogSurface(cog,"switch0");
+        /* +force_lightning reaches 1.5; the emitters auto-aim within 60. */
+        t->reach=1.5f; t->cone=Bot_CogFlex(cog,"autoaimxfov",60.0f)*0.5f/BOT_DEG;
+        for (int k=0;k<3;k++) {
+            SithThing *ghost=Bot_NavThing(Bot_CogReference(cog,ghosts[k]));
+            if (!ghost || !ghost->sector) continue;
+            t->pointSector[t->points]=ghost->sector;
+            t->point[t->points]=ghost->position; t->facing[t->points++]=ghost->orient.lvec;
+        }
+        return t->sector[0]>=0 && t->button>=0;
+    }
+    return 0;
+}
