+            if (bot.now<bot.forceUntil || (!matched && bot.now<bot.forceUntil+0.5f)) { bot.keys[key]=1; return 1; }
+            if (matched) { /* Release: the COG throws the item at the puller. */
+                bot.forceBin=bot.forceTarget=-1;
+                bot.pullItemPos=item->position; bot.pullPhase=3; bot.pullPhaseUntil=bot.now+1.5f;
+                bot.tele.itemPulls++;
+                return 1;
+            }
+        }
+        /* The stock deselected handler stops the power without a cast. */
+        if (self->actorParams.pPlayer->curPower==bin) {
+            if (!bot.forceCancel) bot.tele.pullCancels++;
+            bot.keys[key]=1;
+            bot.keys[INPUT_FUNC_NEXTSKILL]=!bot.previous[INPUT_FUNC_NEXTSKILL];
+            bot.forceCancel=1; return 1;
+        }
+        bot.forceBin=bot.forceTarget=-1; bot.forceCancel=0;
+        Bot_EndItemPull(self,"cancel"); return 0;
+    }
+    if (bot.pullPhase==3) {
+        if (!item) {
+            /* Gone: a flying item covers ground fast between frames, so the
+               catcher is whoever was nearest its last position. */
+            flex_t mine=Bot_Distance(self->position,bot.pullItemPos);
+            int caught=mine<1.5f;
+            for (unsigned i=0;caught && i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+                SithThing *peer=jkPlayer_playerInfos[i].pLocalPlayer;
+                if (peer && peer!=self && peer->type==SITH_THING_PLAYER &&
+                    Bot_Distance(peer->position,bot.pullItemPos)<mine) caught=0;
+            }
+            bot.tele.itemCaught+=caught;
+            Bot_EndItemPull(self,caught ? "caught" : "gone"); return 0;
+        }
+        bot.pullItemPos=item->position;
+        if ((target && !BT_ON(PULL_ON_MOVE)) || bot.now>=bot.pullPhaseUntil || Bot_ItemPullBusy(self)) {
+            Bot_EndItemPull(self,target && !BT_ON(PULL_ON_MOVE) ? "fight" : "missed"); return 0;
+        }
