+/* lift_call: how long the lift thing has stood still. */
+static flex_t Bot_LiftStill(const SithThing *thing,int id)
+{
+    if (nav.liftTrack!=id) { nav.liftLastAt=0; nav.liftRate=0; }
+    if (nav.liftTrack!=id || Bot_Distance(thing->position,nav.liftSeen)>0.002f) {
+        nav.liftTrack=id; nav.liftSeen=thing->position; nav.liftMovedAt=bot.now;
+    }
+    /* lift_hop: how fast the deck climbs (falls, if negative). */
+    if (nav.liftLastAt>0 && bot.now>nav.liftLastAt+0.001f)
+        nav.liftRate=(thing->position.z-nav.liftLastZ)/(bot.now-nav.liftLastAt);
+    if (bot.now>nav.liftLastAt+0.001f) { nav.liftLastZ=thing->position.z; nav.liftLastAt=bot.now; }
+    return bot.now-nav.liftMovedAt;
+}
