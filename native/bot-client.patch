+/* Equipment goals keep a stock thing identity and a verified contact, never
+   a permanent graph node for a dropped pack. The graph supplies approach legs. */
+enum { BOT_EQUIP_PROBES=4 };
+typedef struct BotEquipmentRank { int index; flex_t score; } BotEquipmentRank;
+
+static void Bot_RankEquipment(BotEquipmentRank *ranks,int index,flex_t score)
+{
+    for (int i=0;i<BOT_EQUIP_PROBES;i++) if (score>ranks[i].score) {
+        for (int j=BOT_EQUIP_PROBES-1;j>i;j--) ranks[j]=ranks[j-1];
+        ranks[i]=(BotEquipmentRank){index,score}; break;
+    }
+}
+
+/* Append one bounded geometry probe for a rotating candidate. Dense groups of
+   drops or anchors on the other side of a wall cannot monopolize every scan. */
+static void Bot_RankPackProbe(BotEquipmentRank *ranks,int index,flex_t score,int cursor)
+{
+    Bot_RankEquipment(ranks,index,score);
+    BotEquipmentRank *next=&ranks[BOT_EQUIP_PROBES];
+    if (!next->score || ((index>cursor)==(next->index>cursor) ? index<next->index : index>cursor))
+        *next=(BotEquipmentRank){index,score};
+}
+
+static void Bot_RotatePackProbe(BotEquipmentRank *ranks,int *cursor)
+{
+    BotEquipmentRank *extra=&ranks[BOT_EQUIP_PROBES];
+    if (!extra->score) return;
+    *cursor=extra->index;
+    for (int i=0;i<BOT_EQUIP_PROBES;i++)
+        if (ranks[i].score && ranks[i].index==extra->index) { extra->score=0; break; }
+}
+
+static int Bot_SupplyOrder(void)
+{ return companion.policy.mode==CP_RESOURCE || companion.policy.mode==CP_RECOVER; }
+
+static flex_t Bot_EquipmentValue(SithThing *self,int index)
+{
+    SithThing *item=Bot_NavThing(index);
+    if (!item || item->type!=SITH_THING_ITEM || !Bot_SectorSafe(item->sector) ||
+        (item->flags&(SITH_TF_DISABLED|SITH_TF_DEAD))) return 0;
+    if (Bot_LivePack(item)) return Bot_PackValue(self,item);
+    BotPickupKind k=Bot_PickupType(item);
+    if (k.kind==BOT_ITEM_WEAPON && (k.bin==SITHBIN_BRYARPISTOL || k.bin==SITHBIN_LIGHTSABER)) return 0;
+    if (k.kind==BOT_ITEM_AMMO && !Bot_UsesAmmo(self,k.bin)) return 0;
+    flex_t value=Bot_ItemValue(self,index);
+    if (value<=0) return 0;
+    /* A short supply of the heavy weapon's own ammunition is worth chasing
+       even after the first rail or concussion shot becomes available. */
+    int ammo=k.kind==BOT_ITEM_WEAPON ? k.ammo : k.kind==BOT_ITEM_AMMO ? k.bin : 0;
+    if ((ammo==SITHBIN_RAILCHARGES && sithInventory_GetInventory(self,SITHBIN_RAIL_DETONATOR)>0 &&
+         sithInventory_GetInventory(self,ammo)<4) ||
+        (ammo==SITHBIN_POWER && sithInventory_GetInventory(self,SITHBIN_CONCUSSION_RIFLE)>0 &&
+         sithInventory_GetInventory(self,ammo)<32)) value=Bot_Max(value,10.0f);
+    return value;
+}
+
+static int Bot_EquipmentSpan(SithThing *self,BotNode *from,BotNode *to)
+{
+    flex_t d=Bot_Distance(from->pos,to->pos);
+    if (d>2.0f || !Bot_SectorSafe(from->sector) || !Bot_SectorSafe(to->sector)) return 0;
+    if ((from->sector->flags^to->sector->flags)&SITH_SECTOR_UNDERWATER) return 0;
+    if (from->sector->flags&SITH_SECTOR_UNDERWATER)
+        return from->sector==to->sector && Bot_WaterClear(from->sector,from->pos,to->pos,self->moveSize);
+    if (d<0.001f) return from->sector==to->sector;
+    int drop=0;
+    return Bot_WalkableSpan(from,to,&drop,0.001f) && !drop;
+}
+
+static int Bot_AtEquipment(SithThing *self,SithThing *item)
+{
+    if (item->collide==SITH_COLLIDE_SPHERE && item->collideSize>0)
+        return Bot_Distance(self->position,item->position)<self->moveSize+item->collideSize &&
+               sithCollision_HasLOS(self,item,0);
+    return Bot_Distance(self->position,item->position)<0.025f;
+}
+
+static void Bot_ClearEquipment(const char *reason)
+{
+    if (bot.armItem && bot.traceForce)
+        fprintf(stderr,"BOT_GEAR name=%s t=%.2f event=clear item=%d guid=%u signature=%u reason=%s\n",
+            bot.name,(double)bot.now,bot.armItem-1,bot.armGuid,bot.armSignature,reason);
+    if (bot.armItem && !bot.armDirect && bot.goal==bot.armNode-1) {
+        bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+    }
+    bot.armItem=bot.armNode=bot.armDirect=0;
+}
+
+static int Bot_WetSupply(const SithThing *self,const SithThing *item)
+{
+    return self->sector && (self->sector->flags&SITH_SECTOR_UNDERWATER) &&
+        item && item->sector && (item->sector->flags&SITH_SECTOR_UNDERWATER);
+}
+
+static void Bot_ReturnFromDive(const char *reason)
+{
+    nav.supplyApproach.enteredForGear=0;
+    nav.diveEscape=BOT_DIVE_AIR;
+    Bot_ClearEquipment(reason);
+    bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+}
+
+/* Stock TOUCHED can synchronously destroy the thing or leave it active
+   pending a host ACK. Decide while the planned identity is still live. */
+void jkBot_ObserveItemTouch(SithThing *player,const SithThing *item)
+{
+    if (!bot.enabled || !bot.joined || !sithNet_isMulti || !bot.armItem || !Bot_EquipmentMode() ||
+        bot.world!=sithWorld_g_pCurrentWorld || !player || player!=sithPlayer_g_pLocalPlayerThing ||
+        bot.wasDead || (player->flags&SITH_TF_DEAD) || player->actorParams.health<=0 ||
+        player->actorParams.endurance<4000 || !Bot_WetSupply(player,item) ||
+        item!=Bot_NavThing(bot.armItem-1) || item->guid!=bot.armGuid || item->signature!=bot.armSignature) return;
+    Bot_ReturnFromDive("return-after-contact");
+}
+
+static void Bot_RememberFailedApproach(void)
+{
+    if (!nav.supplyApproach.enteredForGear || bot.now-nav.supplyApproach.enteredAt<BOT_COSTLY_DIVE_SECONDS) return;
+    BotFailedApproach *freeEntry=NULL;
+    for (int i=0;i<BOT_FAILED_APPROACHES;i++) {
+        BotFailedApproach *entry=&nav.supplyApproach.failed[i];
+        if (entry->bank==nav.supplyApproach.bank && entry->water==nav.supplyApproach.water) {
+            freeEntry=entry; break;
+        }
+        if (entry->until<=bot.now) freeEntry=entry;
+    }
+    if (!freeEntry) return;
+    nav.supplyApproach.latestRetry=bot.now+BOT_DIVE_RETRY_SECONDS;
+    *freeEntry=(BotFailedApproach){nav.supplyApproach.bank,nav.supplyApproach.water,nav.supplyApproach.latestRetry};
+    if (bot.traceForce)
+        fprintf(stderr,"BOT_GEAR name=%s t=%.2f event=failed-approach bank=%u water=%u retry=%.2f\n",
+            bot.name,(double)bot.now,freeEntry->bank->id,freeEntry->water->id,(double)freeEntry->until);
+}
+
+static void Bot_CheckGearDive(SithThing *self)
+{
+    int wet=(self->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+    int plannedAirBank=nav.hadBreathDebt && !self->attach_flags && nav.diveEscape==BOT_DIVE_NONE &&
+        nav.objective==BOT_OBJECTIVE_AIR && nav.objectiveRouteNode>=0 && nav.objectiveRouteNode==bot.goal;
+    nav.hadBreathDebt=self->actorParams.endurance>0;
+    if ((nav.diveEscape==BOT_DIVE_AIR || plannedAirBank) && !self->actorParams.endurance &&
+        (!wet || (self->physicsParams.flags&SITH_PF_ONWATERSURFACE))) {
+        nav.diveEscape=BOT_DIVE_BANK; nav.diveBank=bot.goal; nav.diveBankUntil=bot.now+6.0f;
+    }
+    if (nav.diveEscape==BOT_DIVE_BANK && ((!wet && self->attach_flags) || bot.now>=nav.diveBankUntil)) {
+        nav.diveEscape=0; bot.armNext=bot.nextPlan=0;
+    }
+    SithThing *item=Bot_NavThing(bot.armItem-1);
+    int wetSupply=Bot_WetSupply(self,item) && item->guid==bot.armGuid && item->signature==bot.armSignature;
+    if (!wet && (self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE))) {
+        nav.supplyApproach.bank=self->sector;
+        nav.supplyApproach.water=NULL; nav.supplyApproach.enteredForGear=0;
+    } else if (wet && nav.supplyApproach.bank && !nav.supplyApproach.water) {
+        /* Remember the physical crossing even on a dry transit so an
+           underwater gear rescan cannot divert the bot into its failed dive. */
+        nav.supplyApproach.water=self->sector; nav.supplyApproach.enteredAt=bot.now;
+        nav.supplyApproach.enteredForGear=wetSupply;
+    }
+    if (!wetSupply || !Bot_NeedsAir(self)) return;
+    Bot_RememberFailedApproach();
+    Bot_RememberFailedDive();
+    Bot_ReturnFromDive("air-return");
+}
+
+static void Bot_FindEquipment(SithThing *self)
+{
+    BotEquipmentRank racks[BOT_EQUIP_PROBES]={0},packs[BOT_EQUIP_PROBES+1]={0};
+    BotGoalPaths all,restricted;
+    const BotGoalPaths *safe=Bot_SearchGoalPaths(self,&all,&restricted);
+    int deferDirect=safe!=&all && Bot_OnDeferredCrossing();
+    BotNode here={.pos=self->position,.sector=self->sector}, contact={0};
+    int anchor=-1, index=-1, direct=0;
+    flex_t best=0;
+    bot.armNext=bot.now+0.75f;
+    for (int i=0;i<bot.nNodes;i++) {
+        BotNode *node=&bot.nodes[i]; SithThing *item=Bot_NavThing(node->item);
+        if (!item || !Bot_SectorSafe(item->sector) || Bot_LivePack(item) || node->avoidUntil>bot.now || Bot_AtEquipment(self,item)) continue;
+        if (item->collide==SITH_COLLIDE_SPHERE &&
+            Bot_Distance(node->pos,item->position)>=self->moveSize+item->collideSize) continue;
+        const BotGoalPaths *paths=safe!=&all && Bot_OptionalSupply(self,item) ? safe : &all;
+        if (deferDirect && paths==safe) continue;
+        int start=paths->start; const flex_t *distance=paths->distance;
+        flex_t value=Bot_EquipmentValue(self,node->item);
+        if (value<=0) continue;
+        flex_t range=Bot_Distance(here.pos,node->pos);
+        flex_t cost=(start>=0 && distance[i]<1e19f) ? distance[i]+Bot_Distance(here.pos,bot.nodes[start].pos) : 1e20f;
+        if (bot.armItem==node->item+1) value*=1.15f;
+        /* Keep a real graph route even when the nearest four apparent
+           shortcuts prove to be in disconnected rooms. */
+        if (cost<1e19f && i!=start) {
+            flex_t score=value/(1.0f+0.28f*cost);
+            if (score>best) { best=score; anchor=i; index=node->item; contact=*node; }
+        }
+        if (range<=2.0f) cost=Bot_Min(cost,range);
+        if (cost>=1e19f) continue;
+        Bot_RankEquipment(racks,i,value/(1.0f+0.28f*cost));
+    }
+    for (int i=0;i<Bot_ThingCount();i++) {
+        SithThing *item=&bot.world->aThings[i];
+        if (!Bot_LivePack(item) || !Bot_SectorSafe(item->sector)) continue;
+        if (deferDirect && Bot_OptionalSupply(self,item)) continue;
+        flex_t value=Bot_PackValue(self,item);
+        if (value<=0 || Bot_AtEquipment(self,item)) continue;
+        if (bot.armItem==i+1) value*=1.15f;
+        Bot_RankPackProbe(packs,i,value/(1.0f+0.28f*Bot_Distance(here.pos,item->position)),bot.armPackProbe);
+    }
+    Bot_RotatePackProbe(packs,&bot.armPackProbe);
+    for (int rank=0;rank<BOT_EQUIP_PROBES && racks[rank].score>0;rank++) {
+        int i=racks[rank].index;
+        BotNode *node=&bot.nodes[i];
+        const BotGoalPaths *paths=safe!=&all && Bot_OptionalSupply(self,Bot_NavThing(node->item)) ? safe : &all;
+        int start=paths->start; const flex_t *distance=paths->distance;
+        int walk=Bot_EquipmentSpan(self,&here,node);
+        if (!walk && (start<0 || start==i || distance[i]>=1e19f)) continue;
+        flex_t cost=walk ? Bot_Distance(here.pos,node->pos) : distance[i]+Bot_Distance(here.pos,bot.nodes[start].pos);
+        flex_t score=Bot_EquipmentValue(self,node->item)/(1.0f+0.28f*cost);
+        if (bot.armItem==node->item+1) score*=1.15f;
+        if (score>best || (walk && score==best)) { best=score; anchor=i; index=node->item; contact=*node; direct=walk; }
+    }
+    for (int rank=0;rank<=BOT_EQUIP_PROBES && packs[rank].score>0;rank++) {
+        int i=packs[rank].index; SithThing *pack=Bot_NavThing(i); BotNode end={0};
+        if (!Bot_PackContact(self,pack,&end)) continue;
+        const BotGoalPaths *paths=safe!=&all && Bot_OptionalSupply(self,pack) ? safe : &all;
+        int start=paths->start; const flex_t *distance=paths->distance;
+        int walk=Bot_EquipmentSpan(self,&here,&end), approach=-1;
+        flex_t cost=Bot_Distance(here.pos,end.pos);
+        if (!walk) {
+            BotEquipmentRank near[BOT_EQUIP_PROBES+1]={0};
+            if (start<0) continue;
+            for (int n=0;n<bot.nNodes;n++) {
+                flex_t tail=Bot_Distance(bot.nodes[n].pos,end.pos);
+                if (distance[n]<1e19f && bot.nodes[n].avoidUntil<=bot.now && tail<=2.0f)
+                    Bot_RankPackProbe(near,n,1.0f/(1.0f+distance[n]+tail),bot.armAnchorProbe);
+            }
+            Bot_RotatePackProbe(near,&bot.armAnchorProbe);
+            for (int n=0;n<=BOT_EQUIP_PROBES && near[n].score>0;n++) {
+                int candidate=near[n].index;
+                if (candidate==start && !Bot_EquipmentSpan(self,&here,&bot.nodes[start])) continue;
+                if (!Bot_EquipmentSpan(self,&bot.nodes[candidate],&end)) continue;
+                approach=candidate;
+                cost=Bot_Distance(here.pos,bot.nodes[start].pos)+distance[candidate]+Bot_Distance(bot.nodes[candidate].pos,end.pos);
+                break;
+            }
+            if (approach<0) continue;
+        }
+        flex_t score=Bot_PackValue(self,pack)/(1.0f+0.28f*cost);
+        if (bot.armItem==i+1) score*=1.15f;
+        if (score>best) { best=score; anchor=approach; index=i; contact=end; direct=walk; }
+    }
+    if (index<0) { Bot_ClearEquipment("no-route"); return; }
+    SithThing *item=Bot_NavThing(index);
+    const BotGoalPaths *chosen=safe!=&all && Bot_OptionalSupply(self,item) ? safe : &all;
+    if (!direct && !(chosen==&all && bot.armItem==index+1 && !bot.armDirect && bot.goal==anchor &&
+                     bot.routePos<bot.routeCount)) {
+        if (!Bot_SetRoute(chosen->start,anchor,chosen->parent)) { Bot_ClearEquipment("path-limit"); return; }
+    } else if (direct && bot.armItem && !bot.armDirect) Bot_ClearEquipment("final-leg");
+    if (bot.traceForce && (bot.armItem!=index+1 || bot.armNode!=anchor+1 || bot.armDirect!=direct))
+        fprintf(stderr,"BOT_GEAR name=%s t=%.2f event=plan item=%d guid=%u signature=%u pack=%d anchor=%d direct=%d\n",
+            bot.name,(double)bot.now,index,(unsigned)item->guid,(unsigned)item->signature,Bot_LivePack(item),anchor,direct);
+    if (!direct) bot.nextPlan=bot.now+1.5f;
+    bot.armNode=anchor+1; bot.armItem=index+1; bot.armDirect=direct;
+    bot.armGuid=item->guid; bot.armSignature=item->signature; bot.armPosition=item->position;
+    bot.armContact=contact; nav.pursuitNet=0;
+}
+
+static int Bot_ArmingMove(SithThing *self,flex_t enemyDistance)
+{
+    if (!Bot_EquipmentMode()) { Bot_ClearEquipment("mode"); return 0; }
+    if (Bot_ObjectiveUrgent(self) || Bot_NavigationWaiting(self) || nav.seekingSurface ||
+        nav.combatJumpUntil>bot.now || bot.nextRecovery>0 || enemyDistance<0.45f ||
+        (!self->attach_flags && !(self->sector->flags&SITH_SECTOR_UNDERWATER))) return 0;
+    SithThing *item=Bot_NavThing(bot.armItem-1);
+    if (bot.armItem && (!item || item->guid!=bot.armGuid || item->signature!=bot.armSignature ||
+        Bot_Distance(item->position,bot.armPosition)>0.035f || Bot_EquipmentValue(self,bot.armItem-1)<=0 ||
+        (Bot_DeferSupplyApproaches(self) && Bot_OnDeferredCrossing() && Bot_OptionalSupply(self,item))))
+        Bot_ClearEquipment("state-or-contact");
+    else if (item && Bot_AtEquipment(self,item)) {
+        /* Physics can dispatch TOUCHED after this control frame. */
+        if (Bot_WetSupply(self,item) && self->actorParams.endurance>=4000) return 0;
+        Bot_ClearEquipment("state-or-contact");
+    }
+    if (bot.now>=bot.armNext) Bot_FindEquipment(self);
+    if (!bot.armItem) return 0;
+    /* Reach the transient pack by its checked final span before the ordinary
+       graph follower retires the approach node at its arrival radius. */
+    if (!bot.armDirect && Bot_LivePack(Bot_NavThing(bot.armItem-1)) && bot.armNode>0 &&
+        Bot_Distance(self->position,bot.nodes[bot.armNode-1].pos)<0.22f) {
+        BotNode here={.pos=self->position,.sector=self->sector};
+        if (Bot_EquipmentSpan(self,&here,&bot.armContact)) {
+            bot.armDirect=1; bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+        }
+    }
+    if (!bot.armDirect) {
+        if (bot.armNode<1 || bot.goal!=bot.armNode-1 || bot.routePos>=bot.routeCount) {
+            Bot_ClearEquipment("route-ended"); return 0;
+        }
+        Bot_Navigate(self);
+        return 1;
+    }
+    rdVector3 to=bot.armContact.pos,delta=Bot_Sub(to,self->position),blocked;
+    flex_t remaining=Bot_Horizontal(delta);
+    int swim=(self->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+    if ((swim || (remaining>=0.001f && Bot_SafeDirection(self,delta,0,remaining,&blocked))) &&
+        Bot_NavDirectMove(self,to,swim)) {
+        if (!swim && remaining<=0.035f) {
+            rdVector3 direction={delta.x/remaining,delta.y/remaining,0};
+            bot.axes[INPUT_FUNC_FORWARD]=0.4f*Bot_Dot(direction,self->orient.lvec);
+            bot.axes[INPUT_FUNC_SLIDE]=0.4f*Bot_Dot(direction,self->orient.rvec);
+        }
+        bot.followingRoute=1; bot.routeMode=swim ? BOT_ROUTE_SWIM : BOT_ROUTE_WALK;
+        if (swim) { bot.routeAim=1; Bot_Aim(self,to,0); }
+        return 1;
+    }
+    Bot_ClearEquipment("blocked"); return 0;
+}
+
+static flex_t Bot_EngagementForward(int melee,flex_t distance)
+{
+    if (!companion.policy.mode)
+        return melee ? 1.0f : distance>2.5f ? 0.5f : distance<0.75f ? -0.5f : 0.0f;
+    flex_t range=companion.policy.range;
+    if (!range) {
+        if (companion.policy.mode==CP_RECOVER) range=4.0f;
+        else if (companion.policy.mode==CP_PRESSURE) range=melee ? 0.25f : 1.0f;
+        else range=melee ? 0.3f : 2.0f;
+    }
+    range*=1.15f-0.30f*companion.policy.risk;
+    if (distance>range*1.15f) return melee ? 1.0f : 0.5f+0.3f*companion.policy.risk;
+    if (distance<range*0.75f) return -0.65f;
+    return 0;
+}
+
+static void Bot_Combat(SithThing *self, SithThing *target)
+{
+    int urgent=bot.nextRecovery>0 || Bot_ObjectiveUrgent(self) || Bot_NavigationWaiting(self) ||
+        nav.combatJumpUntil>bot.now || nav.seekingSurface;
+    if (urgent) Bot_Navigate(self);
+    if (!sithCollision_HasLOS(self,target,0)) {
+        if (!urgent && !Bot_ArmingMove(self,1e20f)) Bot_Navigate(self);
+        Bot_SelectWeapon(self,2.0f);
+        Bot_ForceTick(self,NULL,180.0f); return;
+    }
+    bot.seenPos=target->position; bot.seenAt=bot.now;
+    rdVector3 d=Bot_Sub(target->position,self->position);
+    flex_t distance=Bot_Len(d);
+    int weapon=Bot_SelectWeapon(self,distance);
+    int melee=(weapon==SITHBIN_LIGHTSABER || weapon==SITHBIN_FISTS);
+    int routed=urgent;
+    if (!urgent) {
+        routed=Bot_ArmingMove(self,distance);
+        if (!routed && (Bot_SupplyOrder() || (Bot_EquipmentMode() && distance>=0.45f)) && bot.nNodes>0) {
+            Bot_Navigate(self);
+            routed=bot.goal>=0 || bot.routeAim;
+        }
+    }
+    if (bot.routeMode==BOT_ROUTE_SWIM || bot.routeMode==BOT_ROUTE_WATER_ENTRY) bot.routeAim=1;
+    BotGunShot shot=Bot_ChooseGunShot(self,target,weapon);
+    if (!shot.blast && !shot.beam) {
+        shot.aim.x+=sinf(bot.now*1.3f+(bot.random&255))*0.006f;
+        shot.aim.y+=cosf(bot.now*1.1f+(bot.random&255))*0.006f;
+    }
+    flex_t error=Bot_Aim(self,shot.aim,1);
+    Bot_TryCombatJump(self,target);
+    Bot_FireGunShot(self,target,weapon,&shot,error,distance);
+    Bot_ForceTick(self,target,error);
+    if (bot.forceAvoid || bot.forceCancel) return;
+    if (routed) return;
+    if (bot.now>=bot.strafeUntil) {
+        bot.strafeSide=(Bot_Random()&1u) ? 1 : -1;
+        bot.strafeUntil=bot.now+1.1f+Bot_Unit()*1.0f;
+    }
+    flex_t h=Bot_Horizontal(d);
+    if (h>0.001f) {
+        d.x/=h; d.y/=h; d.z=0;
+        flex_t forward=Bot_EngagementForward(melee,distance);
+        rdVector3 move={d.x*forward-d.y*0.55f*bot.strafeSide,
+                       d.y*forward+d.x*0.55f*bot.strafeSide,0};
+        if (melee && distance<0.16f) move=(rdVector3){0,0,0};
+        Bot_Move(self,move,0);
+    }
+}
+
+static void Bot_Recovery(SithThing *self)
+{
+    int recovering=bot.nextRecovery>0;
+    if (recovering && bot.now>=bot.nextRecovery) bot.nextRecovery=0;
+    int node=bot.followingRoute && bot.armDirect && bot.routeMode==BOT_ROUTE_WALK ? bot.armNode-1 :
+        bot.followingRoute && bot.routePos<bot.routeCount ? bot.route[bot.routePos] : -1;
+    /* Vertical jumps against a wall are not progress. A swimmer closing the
+       vertical distance to its current submerged waypoint is making progress. */
+    if (node!=bot.stalledNode) bot.progressPos.z=self->position.z;
+    int swimProgress=nav.seekingSurface && self->position.z-bot.progressPos.z>0.04f;
+    if (node>=0 && (self->sector->flags&SITH_SECTOR_UNDERWATER) &&
+        bot.nodes[node].sector && (bot.nodes[node].sector->flags&SITH_SECTOR_UNDERWATER) &&
+        (bot.keys[INPUT_FUNC_JUMP] || bot.keys[INPUT_FUNC_DUCK])) {
+        flex_t z=bot.nodes[node].pos.z;
+        swimProgress=fabsf(z-bot.progressPos.z)-fabsf(z-self->position.z)>0.04f;
+    }
+    if (Bot_NavigationWaiting(self) || nav.combatJumpUntil>bot.now || swimProgress ||
+        Bot_Horizontal(Bot_Sub(self->position,bot.progressPos))>0.13f) {
+        bot.progressPos=self->position; bot.stuckAt=bot.now; bot.routeStallTime=0;
+        bot.stalledNode=node; bot.stalledGoal=bot.goal;
+        return;
+    }
+    if (node<0 || node!=bot.stalledNode || bot.goal!=bot.stalledGoal) bot.routeStallTime=0;
+    bot.stalledNode=node; bot.stalledGoal=bot.goal;
+    if (node>=0) bot.routeStallTime+=bot.frameDt;
+    if (bot.now-bot.stuckAt<2.0f || bot.nextRecovery>0) return;
+    if (Bot_RecoveryForceJump(self,node)) {
+        bot.stuckAt=bot.now; bot.routeStallTime=0;
+        return;
+    }
+    /* Charge only the route actually driven across this failed interval.
+       Movement on the deadline frame still belongs to recovery. */
+    if (node>=0 && bot.routeStallTime+0.001f>=(recovering ? 1.5f : 2.0f)) {
+        bot.nodes[node].avoidUntil=bot.now+6.0f;
+        if (bot.goal>=0) bot.nodes[bot.goal].avoidUntil=bot.now+7.0f;
+    }
+    bot.routeStallTime=0;
+    bot.recoverySide=(Bot_Random()&1u) ? 1 : -1; bot.nextRecovery=bot.now+1.5f;
+    bot.goal=-1; bot.routeCount=0; bot.nextPlan=0;
+    bot.keys[INPUT_FUNC_ACTIVATE]=1;
+    if (self->attach_flags && bot.now>=bot.nextJump) {
+        bot.keys[INPUT_FUNC_JUMP]=1; bot.nextJump=bot.now+1.5f;
+    }
+}
+
+#include "AI/jkBotLily.inc"
+
+int jkBot_IsEnabled(void) { return bot.enabled; }
+
+/* Opt-in receipt from this client's own inventory. Bit zero denotes Jump (bin 21). */
+static void Bot_TraceForce(SithThing *self)
+{
+    if (!bot.traceForce || bot.now<bot.nextForceTrace) return;
+    bot.nextForceTrace=bot.now+0.5f;
+    char stars[256];
+    size_t used=0;
+    unsigned active=0;
+    for (int bin=SITHBIN_F_JUMP;bin<=SITHBIN_F_DEADLYSIGHT;bin++) {
+        if (sithInventory_IsInventoryActivated(self,bin)) active|=1u<<(bin-SITHBIN_F_JUMP);
+        int n=snprintf(stars+used,sizeof(stars)-used,"%s%.6g",used ? "," : "",
+            (double)sithInventory_GetInventory(self,bin));
+        if (n<0 || (size_t)n>=sizeof(stars)-used) return;
+        used+=(size_t)n;
+    }
+    fprintf(stderr,"BOT_FORCE_STATE name=%s t=%.2f thing=%u guid=%u health=%.2f shields=%.2f mana=%.2f "
+        "blind=%d immobile=%d stars=%s active=0x%x\n",
+        bot.name,(double)bot.now,self->idx,self->guid,(double)self->actorParams.health,
+        (double)sithInventory_GetInventory(self,SITHBIN_SHIELDS),
+        (double)sithInventory_GetInventory(self,SITHBIN_FORCEMANA),
+        !!(self->actorParams.flags&SITH_AF_BLIND),!!(self->actorParams.flags&SITH_AF_IMMOBILE),stars,active);
+    fflush(stderr);
+}
+
+void jkBot_Configure(const char *name, const char *skin)
+{
+    (void)skin;
+    memset(&bot,0,sizeof(bot)); memset(&nav,0,sizeof(nav)); bot.enabled=1;
+    Lily_Configure();
+    Companion_Configure();
+    bot.fistsPeace=bot.forceEnabled=1;
+    bot.competitiveForce=jkBotLoadout_Style(getenv("JK_BOT_FORCE_STYLE"))==JKBOT_STYLE_COMPETITIVE;
+    bot.forceBin=bot.forceTarget=bot.forceEffectBin=bot.forceEffectTarget=-1;
+    const char *elite=getenv("JK_BOT_ELITE");
+    bot.elite=elite && (!strcmp(elite,"1") || !strcmp(elite,"0")) ? *elite=='1' : bot.competitiveForce;
+    const char *trace=getenv("JK_BOT_TRACE_FORCE");
+    bot.traceForce=trace && !strcmp(trace,"1");
+    const char *settings=getenv("JK_BOT_BEHAVIOR_FILE");
+    if (settings && strlen(settings)<sizeof(bot.behaviorFile))
+        strcpy(bot.behaviorFile,settings);
+    snprintf(bot.name,sizeof(bot.name),"%s",name ? name : "Bot_Player");
+    bot.random=0x714a21fdu;
+    for (const unsigned char *p=(const unsigned char *)bot.name;*p;p++) bot.random=(bot.random^*p)*16777619u;
+    if (!bot.random) bot.random=1;
+    bot.goal=bot.targetSlot=-1;
+    Bot_ReloadBehavior();
+}
+
+void jkBot_OnJoined(void)
+{
+    Bot_ResetHearing();
+    companion.identified=0;
+    Companion_ResetPlan();
+    bot.joined=1; bot.world=NULL; bot.now=bot.nextForceTrace=bot.nextSpeedProbe=0;
+    bot.tracedFireMode=-1; bot.nextFireTrace=0; bot.nextLog=10.0f;
+    bot.targetSlot=-1; bot.goal=-1; bot.routeCount=bot.routePos=0;
+    bot.wasDead=0; bot.nextScan=bot.nextPlan=bot.nextSelect=0;
+    bot.forceBin=bot.forceTarget=bot.forceEffectBin=bot.forceEffectTarget=-1; bot.nextForce=bot.forceUntil=0;
+    memset(bot.peers,0,sizeof(bot.peers));
+    memset(bot.axes,0,sizeof(bot.axes)); memset(bot.keys,0,sizeof(bot.keys));
+    memset(bot.previous,0,sizeof(bot.previous)); memset(bot.presses,0,sizeof(bot.presses));
+}
+
+void jkBot_Tick(flex_t dt)
+{
+    memcpy(bot.previous,bot.keys,sizeof(bot.keys));
+    memset(bot.axes,0,sizeof(bot.axes)); memset(bot.keys,0,sizeof(bot.keys));
+    memset(bot.presses,0,sizeof(bot.presses));
+    if (!bot.enabled || !bot.joined || !sithNet_isMulti || (g_submodeFlags&8) ||
+        !sithWorld_g_pCurrentWorld || !sithPlayer_g_pLocalPlayerThing || !sithPlayer_g_pLocalPlayer) return;
+    if (!isfinite(dt) || dt<=0) return;
+    if (lily.enabled) lily.tickMs=(double)dt*1000.0;
+    bot.frameDt=Bot_Min(dt,0.25f); bot.now+=bot.frameDt;
+#ifdef FIXED_TIMESTEP_PHYS
+    bot.physicsStep=DELTA_PHYSTICK_FPS;
+#else
+    bot.physicsStep=bot.frameDt;
+#endif
+    if (bot.now>=bot.nextBehavior) Bot_ReloadBehavior();
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (self->type!=SITH_THING_PLAYER || !self->sector || !self->actorParams.pPlayer) return;
+    Bot_TraceForce(self);
+    if (bot.world!=sithWorld_g_pCurrentWorld) {
+        Bot_ResetHearing();
+        bot.world=sithWorld_g_pCurrentWorld;
+        Companion_NewWorld();
+        memset(bot.peers,0,sizeof(bot.peers));
+        bot.forceBin=bot.forceTarget=bot.forceEffectBin=bot.forceEffectTarget=-1;
+        bot.armNode=bot.armItem=bot.armDirect=0; bot.armNext=0;
+        nav.combatJumpUntil=nav.nextCombatJump=0; nav.combatJumpAirborne=0;
+        Bot_BuildNodes(self); bot.progressPos=self->position; bot.stuckAt=bot.now;
+        bot.nextRecovery=bot.routeStallTime=0;
+    }
+    if (!bot.graphDone) Bot_BuildGraphStep();
+    Bot_ObservePeers(self);
+    int dead=(self->flags&SITH_TF_DEAD)!=0 || self->actorParams.health<=0;
+    Companion_Tick(self,dead);
+    if (!dead && !bot.wasDead && bot.previousHealth>self->actorParams.health+0.5f) {
+        bot.hurtUntil=bot.now+2.5f;
+        bot.nextScan=0;
+    }
+    bot.previousHealth=self->actorParams.health;
+    if (dead) {
+        if (!bot.wasDead) { Bot_ResetHearing(); bot.deadAt=bot.now; bot.targetSlot=-1; bot.goal=-1; }
+        /* QOL respawn accepts a press followed by release. */
+        if (bot.now-bot.deadAt>1.5f && fmodf(bot.now-bot.deadAt,1.4f)<0.18f)
+            bot.keys[INPUT_FUNC_ACTIVATE]=1;
+    } else {
+        if (bot.wasDead) {
+            nav.waterExitUntil=0; nav.seekingSurface=0; bot.nextRecovery=0; bot.routeStallTime=0;
+            nav.forceJumpPending=0; nav.jumpUntil=0;
+            if (bot.forceBin==SITHBIN_F_JUMP) bot.forceBin=-1;
+            bot.armNode=bot.armItem=bot.armDirect=0; bot.armNext=0;
+            nav.combatJumpUntil=nav.nextCombatJump=0; nav.combatJumpAirborne=0;
+            nav.hadBreathDebt=nav.diveEscape=0; nav.diveOverflowUntil=0;
+            memset(nav.failedDives,0,sizeof(nav.failedDives));
+            memset(&nav.supplyApproach,0,sizeof(nav.supplyApproach));
+            bot.goal=-1; bot.routeCount=0; bot.nextPlan=0; bot.targetSlot=-1;
+            bot.progressPos=self->position; bot.stuckAt=bot.now;
+            fprintf(stderr,"BOT_RESPAWN name=%s health=%.1f\n",bot.name,(double)self->actorParams.health);
+            fflush(stderr);
+        }
+        /* Combat and sound investigation can own many consecutive ticks. */
+        if (self->sector->flags&SITH_SECTOR_UNDERWATER) {
+            if (!nav.waterSince || bot.wasDead) nav.waterSince=bot.now;
+        } else nav.waterSince=0;
+        bot.followingRoute=bot.routeAim=0; bot.routeMode=-1;
+        if (!Lily_Drive(self)) {
+            if (bot.armItem && !Bot_EquipmentMode()) Bot_ClearEquipment("mode");
+            Bot_CheckGearDive(self);
+            int releasingPower=bot.forceBin>=0;
+            Bot_CheckPursuit(self);
+            Bot_UpdateAudioLoops(self);
+            SithThing *target=Bot_UpdateTarget(self);
+            if (nav.waterExitUntil>0) Bot_ContinueWaterExit(self);
+            else if (target) Bot_Combat(self,target);
+            else {
+                Bot_SelectWeapon(self,2.0f);
+                if (bot.nextRecovery>0 || nav.combatJumpUntil>bot.now || Bot_ObjectiveUrgent(self) || Bot_SupplyOrder() ||
+                    Bot_NavigationWaiting(self) || nav.seekingSurface || (!Bot_ArmingMove(self,1e20f) && !Bot_InvestigateSound(self)))
+                    Bot_Navigate(self);
+                Bot_ForceTick(self,NULL,180.0f);
+            }
+            Bot_Recovery(self);
+            if (!releasingPower) Bot_TryMovementSpeed(self);
+        }
+    }
+    Companion_Publish(self,dead);
+    if (lily.enabled) Lily_EndFrame();
+    bot.wasDead=dead;
+    for (int i=0;i<INPUT_FUNC_MAX;i++) bot.presses[i]=bot.keys[i] && !bot.previous[i];
+    if (!dead) Bot_TraceFireInput(self);
+    if (bot.now>=bot.nextLog) {
+        bot.nextLog=bot.now+10.0f;
+        int next=bot.routePos<bot.routeCount ? bot.route[bot.routePos] : -1;
+        fprintf(stderr,"BOT_STATUS name=%s t=%.1f sector=%u pos=%.3f,%.3f,%.3f health=%.1f weapon=%d target=%d goal=%d path=%d/%d kills=%d deaths=%d vz=%.3f pitch=%.1f next=%d edge=%d following=%d recover=%.2f exit=%d,%d,%d keys=%d,%d pf=%x dt=%.3f breath_ms=%u\n",
+            bot.name,(double)bot.now,self->sector->id,(double)self->position.x,(double)self->position.y,
+            (double)self->position.z,(double)self->actorParams.health,sithInventory_GetCurrentWeapon(self),
+            bot.targetSlot,bot.goal,bot.routePos,bot.routeCount,sithPlayer_g_pLocalPlayer->numKills,
+            sithPlayer_g_pLocalPlayer->numKilled,(double)self->physicsParams.vel.z,
+            (double)self->actorParams.headPYR.x,next,bot.routeMode,bot.followingRoute,
+            (double)Bot_Max(0,bot.nextRecovery-bot.now),nav.waterExitUntil>0 ? nav.waterExitPhase : -1,
+            nav.waterExitFrom,nav.waterExitTo,bot.keys[INPUT_FUNC_JUMP],bot.keys[INPUT_FUNC_DUCK],
+            (unsigned)self->physicsParams.flags,(double)bot.frameDt,(unsigned)self->actorParams.endurance);
+        fflush(stderr);
+    }
+}
+
+flex_t jkBot_GetAxis(int functionId)
+{
+    return functionId>=0 && functionId<INPUT_FUNC_MAX ? bot.axes[functionId] : 0.0f;
+}
+
+int jkBot_GetKey(int functionId, int *presses)
+{
+    if (presses) *presses=0;
+    if (functionId<0 || functionId>=INPUT_FUNC_MAX) return 0;
+    if (presses) { *presses=bot.presses[functionId]; bot.presses[functionId]=0; }
+    return bot.keys[functionId];
+}
