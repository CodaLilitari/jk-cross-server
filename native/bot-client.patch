+    for (unsigned int i=0;i<sizeof(rows)/sizeof(rows[0]);i++)
+        if (Bot_NameIs(name,rows[i].name) || Bot_NameIs(name,rows[i].model)) return rows[i].pickup;
+    return (BotPickupKind){BOT_ITEM_UNKNOWN,0,0,0};
+}
+
+static BotPickupKind Bot_PickupType(SithThing *item)
+{
+    BotPickupKind kind=Bot_ClassifyPickup(Bot_ItemName(item));
+    if (!kind.kind && item->renderData.model3) kind=Bot_ClassifyPickup(item->renderData.model3->filename);
+    return kind;
+}
+
+static int Bot_AddRawNode(rdVector3 floor, SithSector *floorSector, int item)
+{
+    if (bot.nNodes==BOT_NODES) { nav.truncated++; return -1; }
+    if (!Bot_SectorSafe(floorSector) || !sithIntersect_IsSphereInSector(&floor,0.02f,floorSector)) return -1;
+    for (int i=0;i<bot.nNodes;i++) {
+        if (bot.nodes[i].sector==floorSector &&
+            (item<0 || bot.nodes[i].item<0 || bot.nodes[i].item==item) &&
+            Bot_Distance(bot.nodes[i].pos,floor)<(item>=0 ? 0.002f : 0.11f)) {
+            if (item>=0 && bot.nodes[i].item<0) bot.nodes[i].item=item;
+            return i;
+        }
+    }
+    int index=bot.nNodes++;
+    BotNode *n=&bot.nodes[index];
+    memset(n,0,sizeof(*n));
+    n->pos=floor; n->sector=floorSector; n->item=item; n->visited=-120.0f;
+    return index;
+}
+
+static int Bot_AddNode(rdVector3 p, SithSector *sector, int item, flex_t depth)
+{
+    rdVector3 floor; SithSector *floorSector;
+    if (!Bot_SectorSafe(sector)) return -1;
+    if (sector->flags&SITH_SECTOR_UNDERWATER) return Bot_AddRawNode(p,sector,item);
+    p.z+=0.04f;
+    if (!Bot_Floor(p,sector,depth,&floor,&floorSector)) return -1;
+    return Bot_AddRawNode(floor,floorSector,item);
+}
+
+/* Return a legal body center from which the stock item can be touched. */
+static int Bot_PickupContactAt(SithThing *self,SithThing *item,rdVector3 probe,
+                               flex_t reach,SithSector *covered,rdVector3 *position,SithSector **outSector)
+{
+    probe.z+=BOT_FOOT_HEIGHT+0.02f;
+    SithSector *sector=Bot_SectorAt(&probe,item->sector);
+    if (!Bot_SectorSafe(sector) || sector==covered) return 0;
+    rdVector3 pos;
+    if (sector->flags&SITH_SECTOR_UNDERWATER) {
+        pos=probe; pos.z=item->position.z+0.4f*reach;
+        if (Bot_SectorAt(&pos,sector)!=sector) return 0;
+    } else if (!Bot_Floor(probe,sector,0.45f,&pos,&sector)) return 0;
+    if (sector==covered || !sithIntersect_IsSphereInSector(&pos,self->moveSize,sector) ||
+        Bot_Distance(pos,item->position)>reach-0.003f) return 0;
+    if (sector!=item->sector) {
+        /* Ordinary collision searches neighboring thing lists only through
+           movement adjoins. Overlapping disconnected rooms do not count. */
+        SithSurfaceAdjoin *a=sector->adjoins;
+        while (a && (a->sector!=item->sector || !(a->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT) ||
+                     (a->flags&SITHSURF_ADJOIN_ALLOW_AI_ONLY))) a=a->next;
+        if (!a) return 0;
+    }
+    SithThing viewer={.sector=sector,.position=pos};
+    if (!sithCollision_HasLOS(&viewer,item,0) || !Bot_Clear(NULL,sector,pos,item->position,0,1)) return 0;
+    *position=pos; *outSector=sector;
+    return 1;
+}
+
+/* The engine picks up spherical items by body overlap and physical touch LOS.
+   A rack may fit the item but have no standing room for the player. */
+static int Bot_AddPickupContacts(SithThing *self,SithThing *item,int index,int exact)
+{
+    if (item->collide!=SITH_COLLIDE_SPHERE || !Bot_SectorSafe(item->sector) ||
+        !(self->moveSize>0 && item->collideSize>0)) return exact;
+    flex_t reach=self->moveSize+item->collideSize;
+    if (!isfinite(reach) || reach>0.5f) return exact;
+    struct { SithSector *sector; rdVector3 pos; flex_t separation; } choices[4];
+    int count=0;
+    SithSector *covered=NULL;
+    if (exact>=0) {
+        BotNode *n=&bot.nodes[exact];
+        if (n->item==index && Bot_Distance(n->pos,item->position)<reach &&
+            sithIntersect_IsSphereInSector(&n->pos,self->moveSize,n->sector)) covered=n->sector;
+    }
+    for (int ring=1;ring<=2;ring++) for (int i=0;i<12;i++) {
+        flex_t angle=i*0.52359878f, offset=reach*(ring==1 ? 0.55f : 0.84f);
+        rdVector3 probe=item->position;
+        probe.x+=cosf(angle)*offset; probe.y+=sinf(angle)*offset;
+        rdVector3 pos; SithSector *sector;
+        if (!Bot_PickupContactAt(self,item,probe,reach,covered,&pos,&sector)) continue;
+        flex_t separation=Bot_Distance(pos,item->position);
+        int k=0;
+        while (k<count && choices[k].sector!=sector) k++;
+        if (k==count) {
+            if (count==4) continue;
+            count++;
+        } else if (choices[k].separation<=separation) continue;
+        choices[k].sector=sector; choices[k].pos=pos; choices[k].separation=separation;
+    }
+    for (int i=0;i<count;i++) {
+        int n=Bot_AddRawNode(choices[i].pos,choices[i].sector,index);
+        if (n>=0 && exact<0) exact=n;
+    }
+    return exact;
+}
+
+/* A failed dive belongs to one replicated item incarnation. A reused slot
+   or another supply in the same water remains independently eligible. */
+static int Bot_FailedDive(const SithThing *item)
+{
+    if (!item) return 0;
+    if (bot.now<nav.diveOverflowUntil && item->sector && (item->sector->flags&SITH_SECTOR_UNDERWATER)) return 1;
+    for (int i=0;i<BOT_FAILED_DIVES;i++) {
+        const BotDiveFailure *failure=&nav.failedDives[i];
+        if (bot.now<failure->until && item->guid==failure->guid && item->signature==failure->signature &&
+            item==Bot_NavThing(failure->item-1)) return 1;
+    }
+    return 0;
+}
+
+static void Bot_RememberFailedDive(void)
+{
+    BotDiveFailure *entry=NULL;
+    for (int i=0;i<BOT_FAILED_DIVES;i++) {
+        BotDiveFailure *failure=&nav.failedDives[i];
+        if (failure->item==bot.armItem) { entry=failure; break; }
+        if (failure->until<=bot.now) entry=failure;
+    }
+    flex_t until=bot.now+BOT_DIVE_RETRY_SECONDS;
+    if (entry) *entry=(BotDiveFailure){bot.armItem,bot.armGuid,bot.armSignature,until};
+    /* Preserve all live entries. When a new failure cannot fit, defer
+       underwater supplies until that untracked failure has expired. */
+    else nav.diveOverflowUntil=until;
+}
+
+static int Bot_LivePack(const SithThing *item)
+{
+    return item && item->type==SITH_THING_ITEM && (item->itemParams.flags&SITH_ITEM_BACKPACK) &&
+           !(item->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED|SITH_TF_DEAD));
+}
+
+/* Dropped things have no permanent route node. Recompute a physical contact
+   from the pack's current position, including packs that settle underwater. */
+static int Bot_PackContact(SithThing *self,SithThing *pack,BotNode *contact)
+{
+    if (!Bot_LivePack(pack) || pack->collide!=SITH_COLLIDE_SPHERE || !Bot_SectorSafe(pack->sector) ||
+        !(self->moveSize>0 && pack->collideSize>0)) return 0;
+    flex_t reach=self->moveSize+pack->collideSize;
+    if (!(reach<=0.5f)) return 0;
+    flex_t best=1e20f;
+    for (int i=-1;i<8;i++) {
+        rdVector3 probe=pack->position;
+        if (i>=0) {
+            flex_t angle=i*0.78539816f;
+            probe.x+=cosf(angle)*0.78f*reach; probe.y+=sinf(angle)*0.78f*reach;
+        }
+        rdVector3 pos; SithSector *sector;
+        if (!Bot_PickupContactAt(self,pack,probe,reach,NULL,&pos,&sector)) continue;
+        flex_t distance=Bot_Distance(self->position,pos);
+        if (distance>=best) continue;
+        *contact=(BotNode){.pos=pos,.sector=sector,.item=(int)pack->idx};
+        if (i<0) return 1;
+        best=distance;
+    }
+    return best<1e20f;
+}
+
+static int Bot_PickupNeedsContact(SithThing *self,BotNode *node)
+{
+    SithThing *item=Bot_NavThing(node->item);
+    if (!item || item->type!=SITH_THING_ITEM || item->collide!=SITH_COLLIDE_SPHERE ||
+        (item->flags&SITH_TF_DISABLED) || (node->item<BOT_NODES && nav.itemGuid[node->item] &&
+         item->guid!=nav.itemGuid[node->item])) return 0;
+    flex_t reach=self->moveSize+item->collideSize;
+    if (Bot_Distance(node->pos,item->position)>reach-0.002f) return 0;
+    return Bot_Distance(self->position,item->position)>=reach || !sithCollision_HasLOS(self,item,0);
+}
+
+static int Bot_FaceCenter(SithSurface *surface, rdVector3 *center)
+{
+    rdFace *f=&surface->surfaceInfo.face;
+    if (!f->numVertices || !f->vertexPosIdx) return 0;
+    *center=(rdVector3){0,0,0};
+    for (unsigned int j=0;j<f->numVertices;j++) {
+        int vi=f->vertexPosIdx[j];
+        if (vi<0 || vi>=bot.world->numVertices) return 0;
+        rdVector3 v=bot.world->aVertices[vi];
+        center->x+=v.x; center->y+=v.y; center->z+=v.z;
+    }
+    center->x/=f->numVertices; center->y/=f->numVertices; center->z/=f->numVertices;
+    return 1;
+}
+
+static int Bot_AddPortalNode(SithSurface *surface)
+{
+    rdVector3 center;
+    if (!surface->pAdjoin || !(surface->pAdjoin->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT) ||
+        (surface->pAdjoin->flags&SITHSURF_ADJOIN_ALLOW_AI_ONLY) ||
+        !Bot_SectorSafe(surface->pAdjoin->sector) || !Bot_FaceCenter(surface,&center)) return -1;
+    /* A long normal offset can leave a narrow angled corridor entirely.
+       Retain the ordinary offset, then try one shorter supported anchor.
+       Every resulting edge still needs the normal body/floor collision tests. */
+    const flex_t offsets[]={0.14f,0.04f};
+    for (unsigned int attempt=0;attempt<sizeof(offsets)/sizeof(offsets[0]);attempt++) {
+        rdVector3 p=center, normal=surface->surfaceInfo.face.normal;
+        p.x+=normal.x*offsets[attempt];
+        p.y+=normal.y*offsets[attempt];
+        p.z+=normal.z*offsets[attempt];
+        int node=(surface->pSector->flags&SITH_SECTOR_UNDERWATER)
+            ? Bot_AddRawNode(p,surface->pSector,-1) : Bot_AddNode(p,surface->pSector,-1,5.0f);
+        if (node>=0) return node;
+    }
+    return -1;
+}
+
+static int Bot_CtfPortalPoints(SithSurface *surface, rdVector3 standing, rdVector3 *inside)
+{
+    rdVector3 center, normal=surface->surfaceInfo.face.normal;
+    flex_t horizontal=Bot_Horizontal(normal);
+    if (horizontal<0.3f || !Bot_FaceCenter(surface,&center)) return 0;
+    /* The stock mark sector is a deep teleport shaft, not a destination on
+       its bottom floor. Cross its top entrance at the supported approach
+       height. C2/C3 use an inclined portal; test both sides of its plane. */
+    if (Bot_Dot(Bot_Sub(standing,center),normal)>-0.035f) return 0;
+    *inside=center;
+    inside->x+=normal.x/horizontal*0.12f;
+    inside->y+=normal.y/horizontal*0.12f;
+    inside->z=standing.z;
+    return Bot_Dot(Bot_Sub(*inside,center),normal)>0.035f &&
+        Bot_Horizontal(Bot_Sub(*inside,standing))<=0.8f &&
+        sithIntersect_IsSphereInSector(inside,0.04f,surface->pSector);
+}
+
+static void Bot_AddTeamEntries(void)
+{
+    if (!nav.ctf) return;
+    for (int team=1;team<=2;team++) {
+        SithSector *mark=&bot.world->aSectors[nav.mark[team-1]];
+        for (int i=0;i<bot.world->numSurfaces && nav.entryCount<16;i++) {
+            SithSurface *surface=&bot.world->surfaces[i];
+            rdVector3 center, floor, inside; SithSector *floorSector;
+            if (surface->pSector!=mark || !surface->pAdjoin ||
+                !(surface->pAdjoin->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT) ||
+                (surface->pAdjoin->flags&SITHSURF_ADJOIN_ALLOW_AI_ONLY) ||
+                !Bot_SectorSafe(surface->pAdjoin->sector) || !Bot_FaceCenter(surface,&center)) continue;
+            rdVector3 normal=surface->surfaceInfo.face.normal;
+            flex_t horizontal=Bot_Horizontal(normal);
+            if (horizontal<0.3f) continue; /* Never choose the shaft's bottom. */
+            /* A fixed offset can land on another sector's clearance boundary:
+               C1's .42 approach does this at the lobby/corridor boundary.
+               Try a bounded set, retaining the complete support/clearance
+               checks. Objective selection still requires a graph route. */
+            const flex_t offsets[]={0.42f,0.24f,0.60f};
+            for (unsigned int attempt=0;attempt<sizeof(offsets)/sizeof(offsets[0]);attempt++) {
+                rdVector3 outside=center;
+                outside.x-=normal.x/horizontal*offsets[attempt];
+                outside.y-=normal.y/horizontal*offsets[attempt];
+                outside.z+=0.04f;
+                if (!Bot_Floor(outside,surface->pAdjoin->sector,1.0f,&floor,&floorSector) ||
+                    floorSector==mark || !Bot_CtfPortalPoints(surface,floor,&inside) ||
+                    !Bot_Clear(NULL,floorSector,floor,inside,0.058f,1)) continue;
+                int node=Bot_AddRawNode(floor,floorSector,-1);
+                if (node<0) continue;
+                BotTeamEntry *entry=&nav.entries[nav.entryCount++];
+                entry->team=team; entry->node=node; entry->inside=inside; entry->sector=mark;
+                fprintf(stderr,"BOT_CTF_ENTRY map=%s team=%d approach_sector=%u mark_sector=%u node=%d offset=%.2f\n",
+                    bot.world->map_jkl_fname,team,floorSector->id,mark->id,node,(double)offsets[attempt]);
+                break;
+            }
+        }
+    }
+}
+
+static void Bot_AddLiftNodes(void)
+{
+    for (int i=0;i<Bot_ThingCount() && nav.liftCount<64;i++) {
+        SithThing *thing=&bot.world->aThings[i];
+        const char *name=Bot_ItemName(thing);
+        if (thing->moveType!=SITH_MT_PATH || thing->trackParams.loadedFrames!=2 ||
+            !thing->trackParams.aFrames || !thing->renderData.model3 ||
+            (!strstr(name,"lift") && !strstr(name,"elev") && !strstr(name,"platform"))) continue;
+        SithPathFrame *frames=thing->trackParams.aFrames;
+        if (Bot_Distance(frames[0].rot,frames[1].rot)>0.1f) continue;
+        rdModel3 *model=thing->renderData.model3;
+        if (!model->numGeos || !model->aGeos[0].aMeshes) continue;
+        flex_t top=-1e20f;
+        for (uint32_t m=0;m<model->aGeos[0].numMeshes;m++) {
+            rdMesh *mesh=&model->aGeos[0].aMeshes[m];
+            for (int v=0;v<mesh->numVertices;v++) {
+                rdVector3 p=mesh->aVertices[v];
+                flex_t z=p.x*thing->orient.rvec.z+p.y*thing->orient.lvec.z+p.z*thing->orient.uvec.z;
+                top=Bot_Max(top,z);
+            }
+        }
+        if (!isfinite(top) || top < -1.0f || top>1.0f) continue;
+        rdVector3 deck[2]; SithSector *sector[2]; int valid=1;
+        for (int k=0;k<2;k++) {
+            deck[k]=frames[k].pos; deck[k].z+=top+BOT_FOOT_HEIGHT;
+            sector[k]=Bot_SectorAt(&deck[k],thing->sector);
+            if (!Bot_SectorSafe(sector[k]) || !sithIntersect_IsSphereInSector(&deck[k],0.04f,sector[k])) valid=0;
+        }
+        if (!valid || bot.nNodes+2>BOT_NODES) continue;
+        int liftIndex=nav.liftCount++;
+        BotLift *lift=&nav.lifts[liftIndex]; lift->thing=i; lift->top=top;
+        for (int k=0;k<2;k++) {
+            int node=bot.nNodes++; lift->node[k]=node;
+            memset(&bot.nodes[node],0,sizeof(bot.nodes[node]));
+            bot.nodes[node].pos=deck[k]; bot.nodes[node].sector=sector[k];
+            bot.nodes[node].item=-1; bot.nodes[node].visited=-120;
+            nav.liftForNode[node]=liftIndex+1;
+        }
+    }
+}
+
+static void Bot_BuildNodes(SithThing *self)
+{
+    memset(&nav,0,sizeof(nav)); nav.lastGoal=-1; nav.objectiveRouteNode=-1; nav.selectedEntry=-1;
+    const char *team=getenv("JK_BOT_TEAM");
+    nav.requestedTeam=(team && !strcmp(team,"2")) ? 2 : 1;
+    bot.nNodes=bot.buildNode=bot.graphDone=bot.graphEdges=0;
+    bot.goal=-1; bot.routeCount=bot.routePos=0;
+    nav.jumpVelocity=self->actorParams.jumpSpeed;
+    nav.maxRunSpeed=self->physicsParams.maxVelocity;
+    nav.forceJumpKnown=(int)Bot_Clamp(sithInventory_GetInventory(self,SITHBIN_F_JUMP),0,4);
+    Bot_ReadCtfBindings();
+    Bot_AddNode(self->position,self->sector,-1,0.65f);
+    /* Preserve authored spawn and pickup locations before generic geometry. */
+    for (int i=0;i<Bot_ThingCount();i++) {
+        SithThing *t=&bot.world->aThings[i];
+        if (t->type==SITH_THING_PLAYER || (t->type==SITH_THING_ITEM && !(t->itemParams.flags&SITH_ITEM_BACKPACK))) {
+            int node=Bot_AddNode(t->position,t->sector,t->type==SITH_THING_ITEM ? i : -1,1.1f);
+            if (t->type==SITH_THING_ITEM) {
+                node=Bot_AddPickupContacts(self,t,i,node);
+                if (node<0) nav.missingItemNodes++; else nav.itemNodes++;
+                if (i<BOT_NODES) nav.itemGuid[i]=t->guid;
+            }
+        }
+    }
+    if (nav.ctf) for (int i=0;i<2;i++) {
+        SithThing *base=Bot_NavThing(nav.base[i]);
+        if (base) Bot_AddNode(base->position,base->sector,-1,1.2f);
+        SithSector *mark=&bot.world->aSectors[nav.mark[i]];
+        Bot_AddNode(mark->center,mark,-1,5.0f);
+    }
+    Bot_AddTeamEntries();
+    Bot_AddLiftNodes();
+    /* Put a representative floor node in every safe sector before spending
+       capacity on detail. This avoids starving later sectors in c3/m5. */
+    for (int i=0;i<bot.world->numSectors;i++) {
+        SithSector *sector=&bot.world->aSectors[i];
+        if (!Bot_SectorSafe(sector)) continue;
+        Bot_AddNode(sector->center,sector,-1,8.0f);
+    }
+    /* Door things are absent from static graph construction. Live movement
+       still collides with them and presses ordinary ACTIVATE. */
+    for (int i=0;i<bot.world->numSurfaces && bot.nNodes<BOT_NODES;i++) {
+        SithSurface *s=&bot.world->surfaces[i];
+        Bot_AddPortalNode(s);
+    }
+    for (int i=0;i<bot.world->numSurfaces && bot.nNodes<BOT_NODES;i++) {
+        SithSurface *s=&bot.world->surfaces[i];
+        rdVector3 p;
+        if (s->pAdjoin || !(s->flags&SITH_SURFACE_HAS_COLLISION) ||
+            s->surfaceInfo.face.normal.z<0.55f || !Bot_FaceCenter(s,&p)) continue;
+        p.z+=BOT_FOOT_HEIGHT;
+        Bot_AddNode(p,s->pSector,-1,0.5f);
+        rdFace *f=&s->surfaceInfo.face;
+        if (f->numVertices>=3) for (unsigned int j=0;j<f->numVertices && j<12;j++) {
+            rdVector3 near=Bot_Mix(p,bot.world->aVertices[f->vertexPosIdx[j]],0.68f);
+            near.z+=BOT_FOOT_HEIGHT*0.68f;
+            Bot_AddNode(near,s->pSector,-1,0.5f);
+            flex_t span=Bot_Horizontal(Bot_Sub(near,p));
+            for (int part=1;part<=(int)(span/1.25f) && part<=6;part++)
+                Bot_AddNode(Bot_Mix(p,near,part*1.25f/span),s->pSector,-1,0.5f);
+        }
+    }
+    fprintf(stderr,"BOT_NAV nodes=%d map=%s name=%s item_nodes=%d missing_item_nodes=%d truncated=%d ctf=%d lifts=%d\n",
+        bot.nNodes,bot.world->map_jkl_fname,bot.name,nav.itemNodes,nav.missingItemNodes,nav.truncated,nav.ctf,nav.liftCount);
+    fflush(stderr);
+}
+
+static int Bot_PortalGroundClear(SithSector *sector,rdVector3 from,rdVector3 to)
+{
+    /* A short raised threshold can fall between the ordinary floor samples.
+       Split the accepted clearance chord at actual portal crossings, then
+       check the supported standing body within every intervening sector. */
+    rdVector3 direction=Bot_Sub(to,from);
+    flex_t length=Bot_Len(direction), crossing[66]={0};
+    if (length<0.001f) return 1;
+    direction.x/=length; direction.y/=length; direction.z/=length;
+    int count=1, valid=1;
+    sithCollision_SearchForCollisions(sector,NULL,&from,&direction,length,0,
+        RAYCAST_200|RAYCAST_2000);
+    SithCollision *hit;
+    while ((hit=sithCollision_PopStack())!=NULL) {
+        if (!(hit->type&SITHCOLLISION_ADJOINCROSS) || !hit->surface || !hit->surface->pAdjoin) continue;
+        SithSurfaceAdjoin *adjoin=hit->surface->pAdjoin;
+        if (!Bot_SectorSafe(adjoin->sector) || !(adjoin->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT) ||
+            (adjoin->flags&SITHSURF_ADJOIN_ALLOW_AI_ONLY)) { valid=0; break; }
+        flex_t at=hit->distance;
+        if (at<=0.0001f || at>=length-0.0001f) continue;
+        int position=count;
+        while (position>1 && crossing[position-1]>at) position--;
+        if (fabsf(crossing[position-1]-at)<0.0001f ||
+            (position<count && fabsf(crossing[position]-at)<0.0001f)) continue;
+        if (count>=65) { valid=0; break; }
+        for (int i=count;i>position;i--) crossing[i]=crossing[i-1];
+        crossing[position]=at; count++;
+    }
+    sithCollision_DecreaseStackLevel();
+    if (!valid) return 0;
+    if (count==1) return 1;
+    crossing[count++]=length;
+    flex_t radius=0.065f;
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (self && isfinite(self->moveSize) && self->moveSize>=0.02f && self->moveSize<=0.25f)
+        radius=self->moveSize;
+    SithSector *hint=sector;
+    for (int i=1;i<count;i++) {
+        rdVector3 sample=Bot_Mix(from,to,(crossing[i-1]+crossing[i])/(2.0f*length)),floor;
+        SithSector *support=NULL;
+        sample.z+=0.02f;
+        if (!Bot_Floor(sample,hint,BOT_MAX_DROP+0.3f,&floor,&support)) return 0;
+        rdVector3 above=floor; above.z+=0.010f;
+        /* Use the collision engine, not a sector-plane containment test:
+           a valid body can span an open portal into the adjoining sector. */
+        if (!Bot_Clear(NULL,support,floor,above,radius,1)) return 0;
+        hint=support;
+    }
+    return 1;
+}
+
+/* Sample supporting floors: no water/void crossing, bounded rises and
+   explicitly directed drops. Floors and clearance are checked separately. */
+static int Bot_WalkableSpan(BotNode *a, BotNode *b, int *isDrop, flex_t minLength)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta), previousZ=a->pos.z;
+    SithSector *hint=a->sector;
+    int dropping=(delta.z < -BOT_STEP_UP);
+    if (length>3.5f || length<minLength || delta.z>BOT_STEP_UP || delta.z < -BOT_MAX_DROP) return 0;
+    rdVector3 sweepA=a->pos, sweepB=b->pos;
+    if (dropping) sweepB.z=sweepA.z;
+    /* Test the actual body center first. Stock m2 sector110 is only0.20
+       units high: raising a0.058-radius sweep by0.065 invents a ceiling hit
+       even though the ordinary0.065-radius player fits there. */
+    if (!Bot_Clear(NULL,a->sector,sweepA,sweepB,0.058f,1)) {
+        rdVector3 raisedA=sweepA, raisedB=sweepB;
+        raisedA.z+=0.065f; raisedB.z+=0.065f;
+        /* Keep the previous small-step fallback only when both ends have
+           real vertical clearance. Ordinary jump input handles execution. */
+        if (!Bot_Clear(NULL,a->sector,a->pos,raisedA,0.058f,1) ||
+            !Bot_Clear(NULL,b->sector,b->pos,raisedB,0.058f,1) ||
+            !Bot_Clear(NULL,a->sector,raisedA,raisedB,0.058f,1)) return 0;
+        sweepA=raisedA; sweepB=raisedB;
+    }
+    int steps=(int)ceilf(length/0.22f);
+    for (int i=1;i<=steps;i++) {
+        rdVector3 p=Bot_Mix(a->pos,b->pos,(flex_t)i/(flex_t)steps), floor;
+        /* Keep the ray origin below low ceilings; body clearance is above. */
+        p.z=Bot_Max(previousZ,p.z)+0.02f;
+        SithSector *floorSector;
+        if (!Bot_Floor(p,hint,dropping ? BOT_MAX_DROP+0.3f : 0.52f,&floor,&floorSector)) return 0;
+        if (floor.z-previousZ>BOT_STEP_UP || previousZ-floor.z>BOT_MAX_DROP) return 0;
+        previousZ=floor.z; hint=floorSector;
+    }
+    if (fabsf(previousZ-b->pos.z)>0.2f) return 0;
+    if (!Bot_PortalGroundClear(a->sector,sweepA,sweepB)) return 0;
+    *isDrop=dropping;
+    return 1;
+}
+
+static int Bot_Walkable(BotNode *a, BotNode *b, int *isDrop)
+{
+    return Bot_WalkableSpan(a,b,isDrop,0.025f);
+}
+
+static int Bot_WaterClear(SithSector *sector,rdVector3 from,rdVector3 to,flex_t radius);
+
+static int Bot_ArcClear(BotNode *a, BotNode *b, flex_t velocity, flex_t maxDistance,
+                        flex_t maxRise, int force, flex_t *duration)
+{
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t horizontal=Bot_Horizontal(delta), gravity=bot.world->gravity;
+    if (horizontal<0.16f || horizontal>maxDistance || delta.z>maxRise || delta.z < -0.18f ||
+        gravity<0.1f || velocity<0.1f || nav.maxRunSpeed<0.1f ||
+        ((a->sector->flags|b->sector->flags)&SITH_SECTOR_UNDERWATER)) return 0;
+    flex_t discriminant=velocity*velocity-2.0f*gravity*delta.z;
+    if (discriminant<=0) return 0;
+    flex_t flight=(velocity+sqrtf(discriminant))/gravity;
+    if (horizontal>nav.maxRunSpeed*flight*0.78f) return 0;
+    rdVector3 previous=a->pos; SithSector *sector=a->sector;
+    for (int i=1;i<=10;i++) {
+        flex_t t=flight*i/10.0f;
+        rdVector3 next=Bot_Mix(a->pos,b->pos,(flex_t)i/10.0f);
+        next.z=a->pos.z+velocity*t-0.5f*gravity*t*t;
+        if (!force) {
+            if (!Bot_Clear(NULL,sector,previous,next,0.055f,1)) return 0;
+        } else {
+            SithThing *self=sithPlayer_g_pLocalPlayerThing;
+            flex_t radius=self && self->moveSize>=0.02f && self->moveSize<=0.25f ? self->moveSize : 0.065f;
+            if (!Bot_WaterClear(sector,previous,next,radius)) return 0;
+        }
+        sector=Bot_SectorAt(&next,sector);
+        if (!Bot_SectorSafe(sector)) return 0;
+        previous=next;
+    }
+    *duration=flight; return 1;
+}
+
+static int Bot_Jumpable(BotNode *a, BotNode *b, flex_t *duration)
+{ return Bot_ArcClear(a,b,nav.jumpVelocity,0.68f,0.21f,0,duration); }
+
+/* Dry Force jumps release from a standstill. At full charge, integrate the
+   stock free-air drag, gravity and repeatedly scaled forward thrust at the
+   observed control cadence. An early foothold may lead to the node on foot. */
+static int Bot_FullForceJump(BotNode *a,BotNode *b,flex_t charge,flex_t *seconds)
+{
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (!self || !(self->moveSize>=0.02f && self->moveSize<=0.25f) ||
+        !(self->physicsParams.airDrag>=0 && self->physicsParams.airDrag<10) ||
+        !(self->actorParams.maxThrust>0 && bot.world->gravity>0)) return 0;
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Horizontal(delta);
+    const int unsafe=SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY;
+    if (!(length>=0.16f && length<=1.2f && delta.z>0 && delta.z<=1.6f) ||
+        !Bot_SectorSafe(a->sector) || !Bot_SectorSafe(b->sector) ||
+        ((a->sector->flags|b->sector->flags)&unsafe)) return 0;
+    flex_t dt=bot.physicsStep,control=Bot_Max(dt,bot.frameDt);
+    if (!(dt>0 && dt<=0.067f && control<=0.10f)) return 0;
+    rdVector3 pos=a->pos, swept=pos;
+    SithSector *sector=a->sector;
+    flex_t directionX=delta.x/length,directionY=delta.y/length;
+    flex_t speed=0,along=0,vz=2.5f+charge,thrust=0,nextControl=control;
+    flex_t decay=1.0f-dt*self->physicsParams.airDrag;
+    flex_t contact=b->pos.z-BOT_FOOT_HEIGHT+self->moveSize+0.002f;
+    for (int i=0;i*dt<2.5f;i++) {
+        flex_t t=i*dt;
+        if (t+0.5f*dt>=nextControl) {
+            flex_t remaining=length-along;
+            thrust=remaining>0.13f ? self->actorParams.maxThrust :
+                   remaining>0.035f ? 0.4f*self->actorParams.maxThrust : 0;
+            nextControl+=control;
+        }
+        thrust*=0.3f; speed=speed*decay+thrust*dt;
+        vz=vz*decay-bot.world->gravity*dt;
+        int lands=vz<0 && pos.z+dt*vz<=contact;
+        if (lands && pos.z<=contact) return 0;
+        flex_t step=lands ? (contact-pos.z)/vz : dt;
+        along+=speed*step;
+        pos.x=a->pos.x+along*directionX; pos.y=a->pos.y+along*directionY; pos.z+=vz*step;
+        if (!lands && i%3!=2) continue;
+        if (!Bot_WaterClear(sector,swept,pos,self->moveSize)) return 0;
+        swept=pos; sector=Bot_SectorAt(&pos,sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&unsafe)) return 0;
+        if (lands) {
+            rdVector3 standing; SithSector *floor=NULL;
+            if (sector!=b->sector || !Bot_Floor(pos,sector,BOT_FOOT_HEIGHT+0.04f,&standing,&floor) ||
+                floor!=b->sector || fabsf(standing.z-b->pos.z)>0.035f) return 0;
+            BotNode foothold={.pos=standing,.sector=floor}; int drop=0;
+            if (fabsf(length-along)>0.45f || (fabsf(length-along)>0.001f &&
+                (!Bot_WalkableSpan(&foothold,b,&drop,0.001f) || drop))) return 0;
+            *seconds=t+step; return 1;
+        }
+    }
+    return 0;
+}
+
+static int Bot_ForceJumpProfile(BotNode *a, BotNode *b, int rank, flex_t *duration, flex_t *hold)
+{
+    /* Stock release adds 2.5+hold vertical velocity, with a rank*.35 cap.
+       Prefer the small jump; taller verified routes need a stronger rank
+       and a longer ordinary key hold. Avoid the <.15 tap-to-maximum rule. */
+    if (rank<1 || rank>4) return 0;
+    flex_t highDuration;
+    if (Bot_ArcClear(a,b,2.75f,0.95f,0.65f,1,duration) &&
+        Bot_ArcClear(a,b,2.85f,0.95f,0.65f,1,&highDuration)) {
+        *hold=0.25f; return 1;
+    }
+    if (rank<2) return 0;
+    flex_t charge=Bot_Min(0.75f,rank*0.35f-0.15f), velocity=2.5f+charge;
+    if (Bot_ArcClear(a,b,velocity,1.2f,1.2f,1,duration) &&
+        Bot_ArcClear(a,b,velocity+0.10f,1.2f,1.2f,1,&highDuration)) {
+        *hold=charge; return 1;
+    }
+    /* A full hold saturates at the learned rank, including a late release. */
+    charge=rank*0.35f;
+    if (!Bot_FullForceJump(a,b,charge,duration)) return 0;
+    *hold=charge; return 1;
+}
+
+static int Bot_ForceJumpable(BotNode *a, BotNode *b, flex_t *duration)
+{ flex_t hold; return Bot_ForceJumpProfile(a,b,nav.forceJumpKnown,duration,&hold); }
+
+
+/* A dry ledge can overhang a water shaft. Approach its opening level, then
+   descend vertically. A diagonal sweep would cut through the solid rim. */
+static int Bot_WaterEntry(const BotNode *a, const BotNode *b)
+{
+    if ((a->sector->flags&SITH_SECTOR_UNDERWATER) || !(b->sector->flags&SITH_SECTOR_UNDERWATER)) return 0;
+    rdVector3 above=b->pos; above.z=a->pos.z;
+    flex_t depth=above.z-b->pos.z, approach=Bot_Horizontal(Bot_Sub(above,a->pos));
+    if (depth<0.10f || depth>0.65f || approach>0.55f ||
+        !Bot_SectorSafe(a->sector) || !Bot_SectorSafe(b->sector) ||
+        Bot_SectorAt(&above,a->sector)!=a->sector) return 0;
+    const SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    flex_t radius=self && self->moveSize>=0.02f && self->moveSize<=0.25f ? self->moveSize : 0.065f;
+    if (!sithIntersect_IsSphereInSector(&b->pos,radius,b->sector) ||
+        !Bot_Clear(NULL,a->sector,a->pos,above,radius,1) ||
+        !Bot_Clear(NULL,a->sector,above,b->pos,radius,1)) return 0;
+    /* Gravity starts as soon as support ends. The approach must stay over
+       solid ground or the same open water, including the lip of the shaft. */
+    int steps=(int)ceilf(approach/0.08f);
+    for (int i=1;i<steps;i++) {
+        rdVector3 sample=Bot_Mix(a->pos,above,(flex_t)i/steps),floor;
+        SithSector *support;
+        if (Bot_Floor(sample,a->sector,BOT_FOOT_HEIGHT+0.05f,&floor,&support)) continue;
+        rdVector3 below=sample; below.z=b->pos.z;
+        if (Bot_SectorAt(&below,b->sector)!=b->sector ||
+            !Bot_Clear(NULL,a->sector,sample,below,0,1)) return 0;
+    }
+    return 1;
+}
+
+#include "AI/jkBotWaterExit.inc"
+
+static int Bot_EdgeMode(int from, int to)
+{
+    BotNode *a=&bot.nodes[from], *b=&bot.nodes[to];
+    rdVector3 delta=Bot_Sub(b->pos,a->pos);
+    flex_t length=Bot_Len(delta);
+    if ((a->sector->flags|b->sector->flags)&SITH_SECTOR_UNDERWATER) {
+        /* Evaluate the checked descent or bank jump before considering a
+           direct movement edge across a nearly level shoreline. */
+        if ((a->sector->flags & b->sector->flags & SITH_SECTOR_UNDERWATER)!=0) {
+            if (length>=2.5f || fabsf(delta.z)>=1.2f) return -1;
+            SithThing *self=sithPlayer_g_pLocalPlayerThing;
+            flex_t radius=self && self->moveSize>0 ? self->moveSize : 0.065f;
+            return Bot_WaterClear(a->sector,a->pos,b->pos,radius) ? BOT_ROUTE_SWIM : -1;
+        }
+        if (!(a->sector->flags&SITH_SECTOR_UNDERWATER))
+            return Bot_WaterEntry(a,b) ? BOT_ROUTE_WATER_ENTRY : -1;
+        rdVector3 launch; flex_t flight;
+        if (Bot_WaterExitArc(a,b,&launch,&flight)) return BOT_ROUTE_WATER_EXIT;
+        SithThing *self=sithPlayer_g_pLocalPlayerThing;
+        flex_t radius=self && self->moveSize>0 ? self->moveSize : 0.065f;
+        /* Longer nearly-level shores need another submerged waypoint. The
+           unsupported surface-stroke approach is bounded to 1.2 map units. */
+        if (Bot_Horizontal(delta)>1.2f || fabsf(delta.z)>=1.2f ||
+            !Bot_WaterClear(a->sector,a->pos,b->pos,radius)) return -1;
+        rdVector3 surface,floor; SithSector *support;
+        if (!Bot_WaterSurface(a,radius,&surface) ||
+            !Bot_Floor(b->pos,b->sector,BOT_FOOT_HEIGHT+0.04f,&floor,&support) ||
+            support!=b->sector || fabsf(floor.z-b->pos.z)>0.025f ||
+            fabsf(floor.z-BOT_FOOT_HEIGHT-surface.z)>0.051f) return -1;
+        surface.z+=radius;
+        if (Bot_SectorAt(&surface,a->sector)!=b->sector ||
+            !Bot_WaterClear(b->sector,surface,b->pos,radius)) return -1;
+        return BOT_ROUTE_SWIM;
+    }
+    if (nav.liftForNode[from] || nav.liftForNode[to]) {
+        if (nav.liftForNode[from] && nav.liftForNode[from]==nav.liftForNode[to]) return BOT_ROUTE_LIFT;
+        if (length<0.6f && fabsf(delta.z)<0.10f && Bot_Clear(NULL,a->sector,a->pos,b->pos,0.045f,1))
+            return BOT_ROUTE_LIFT;
+        return -1;
+    }
+    int drop=0;
+    if (Bot_Walkable(a,b,&drop)) return drop ? BOT_ROUTE_DROP : BOT_ROUTE_WALK;
+    flex_t duration;
+    if (Bot_Jumpable(a,b,&duration)) return BOT_ROUTE_JUMP;
+    if (Bot_ForceJumpable(a,b,&duration)) return BOT_ROUTE_FORCEJUMP;
+    return -1;
+}
+
+static void Bot_AddEdge(int from, int to, int mode)
+{
+    BotNode *node=&bot.nodes[from];
+    if (node->nEdges>=BOT_EDGES) return;
+    for (int i=0;i<node->nEdges;i++) if (node->edges[i].to==to) return;
+    BotEdge *edge=&node->edges[node->nEdges++];
+    edge->to=to; edge->drop=mode;
+    edge->cost=Bot_Distance(node->pos,bot.nodes[to].pos)+
+        (mode==BOT_ROUTE_DROP ? 1.8f : mode==BOT_ROUTE_JUMP ? 1.1f : (mode==BOT_ROUTE_SWIM || mode==BOT_ROUTE_WATER_ENTRY || mode==BOT_ROUTE_WATER_EXIT) ? 2.0f :
+         mode==BOT_ROUTE_LIFT ? 2.2f : mode==BOT_ROUTE_FORCEJUMP ? 3.0f : 0.0f);
+    bot.graphEdges++;
+}
+
+static void Bot_NavCoverage(SithThing *self);
+
+static void Bot_BuildGraphStep(void)
+{
+    /* Work is split across ticks so a large stock map continues networking.
+       Reserve candidate/edge space for other sectors: dense floor samples in
+       one room must not crowd out its portal connections. */
+    for (int work=0;work<8 && bot.buildNode<bot.nNodes;work++,bot.buildNode++) {
+        int i=bot.buildNode, candidates[BOT_CANDIDATES];
+        flex_t distances[BOT_CANDIDATES];
+        BotNode *a=&bot.nodes[i];
+        for (int k=0;k<BOT_CANDIDATES;k++) { candidates[k]=-1; distances[k]=1e20f; }
+        if (nav.liftForNode[i]) {
+            BotLift *lift=&nav.lifts[nav.liftForNode[i]-1];
+            Bot_AddEdge(i,lift->node[0]==i ? lift->node[1] : lift->node[0],BOT_ROUTE_LIFT);
+        }
+        for (int j=0;j<bot.nNodes;j++) {
+            if (i==j) continue;
+            rdVector3 d=Bot_Sub(bot.nodes[j].pos,a->pos);
+            flex_t distance=Bot_Len(d);
+            if (distance>3.8f) continue;
+            int first=a->sector==bot.nodes[j].sector ? 0 : BOT_CANDIDATES/2;
+            int last=first+BOT_CANDIDATES/2;
+            for (int k=first;k<last;k++) if (distance<distances[k]) {
+                for (int m=last-1;m>k;m--) { candidates[m]=candidates[m-1]; distances[m]=distances[m-1]; }
+                candidates[k]=j; distances[k]=distance; break;
+            }
+        }
+        for (int rank=0;rank<BOT_CANDIDATES/2 && a->nEdges<BOT_EDGES;rank++) {
+            for (int group=1;group>=0 && a->nEdges<BOT_EDGES;group--) {
+                int j=candidates[rank+group*BOT_CANDIDATES/2];
+                if (j<0) continue;
+                int mode=Bot_EdgeMode(i,j);
+                if (mode>=0) Bot_AddEdge(i,j,mode);
+            }
+        }
+    }
+    if (!bot.graphDone && bot.buildNode==bot.nNodes) {
+        bot.graphDone=1;
+        fprintf(stderr,"BOT_NAV_READY nodes=%d directed_edges=%d name=%s map=%s item_nodes=%d missing_item_nodes=%d truncated=%d\n",
+            bot.nNodes,bot.graphEdges,bot.name,bot.world->map_jkl_fname,nav.itemNodes,nav.missingItemNodes,nav.truncated);
+        if (sithPlayer_g_pLocalPlayerThing) Bot_NavCoverage(sithPlayer_g_pLocalPlayerThing);
+        fflush(stderr);
+    }
+}
+
+/* Read the replicated stock contents, never the fallen player's current bins.
+   The two engine layouts have different capacities. Refuse a partial snapshot. */
+static flex_t Bot_PackUtility(SithThing *self,SithThing *pack,int *restocksOwned)
+{
+    if (restocksOwned) *restocksOwned=0;
+    if (bot.sabersOnly || !self->actorParams.pPlayer || !Bot_LivePack(pack) || Bot_FailedDive(pack)) return 0;
+    int count=pack->itemParams.numBins;
+    if (count<1 || count>(int)(sizeof(pack->itemParams.contents)/sizeof(pack->itemParams.contents[0]))) return 0;
+    flex_t stock[SITHBIN_RAILCHARGES+1]={0};
+    for (int i=0;i<count;i++) {
+        int bin=pack->itemParams.contents[i].binIdx;
+        flex_t amount=pack->itemParams.contents[i].value;
+        if (bin>=SITHBIN_BRYARPISTOL && bin<=SITHBIN_RAILCHARGES && isfinite(amount) && amount>0)
+            stock[bin]=Bot_Min(500.0f,stock[bin]+amount);
+    }
+    static const struct { int gun,ammo,shot,cap; flex_t value; } guns[]={
+        {SITHBIN_BRYARPISTOL,SITHBIN_ENERGY,1,500,5},
+        {SITHBIN_STORMTROOPER_RIFLE,SITHBIN_ENERGY,1,500,8},
+        {SITHBIN_TUSKEN_PROD,SITHBIN_POWER,2,500,9},
+        {SITHBIN_REPEATER,SITHBIN_POWER,1,500,10},
+        {SITHBIN_RAIL_DETONATOR,SITHBIN_RAILCHARGES,1,30,12},
+        {SITHBIN_CONCUSSION_RIFLE,SITHBIN_POWER,8,500,18}
+    };
+    flex_t best=0;
+    for (unsigned i=0;i<sizeof(guns)/sizeof(guns[0]);i++) {
+        int gun=guns[i].gun,ammo=guns[i].ammo;
+        flex_t owned=sithInventory_GetInventory(self,gun);
+        if (!sithInventory_IsInventoryAvailable(self,gun) || (owned<=0 && stock[gun]<1)) continue;
+        flex_t have=sithInventory_GetInventory(self,ammo), after=Bot_Min(guns[i].cap,have+stock[ammo]);
+        if (after<guns[i].shot) continue;
+        if (restocksOwned && owned>0 && after>have && have<guns[i].cap*0.15f) *restocksOwned=1;
+        if (owned<=0 || have<guns[i].shot) best=Bot_Max(best,guns[i].value);
+        else if (after>have) {
+            flex_t usable=Bot_Min(1.0f,(after-have)/(4.0f*guns[i].shot));
+            best=Bot_Max(best,usable*(have<guns[i].cap*0.15f ? 5.0f : 1.0f));
+        }
+    }
+    return best;
+}
+
+static flex_t Bot_PackValue(SithThing *self,SithThing *pack)
+{ return Bot_PackUtility(self,pack,NULL); }
+
+static flex_t Bot_ItemValue(SithThing *self, int itemIndex)
+{
+    if (itemIndex<0 || itemIndex>=Bot_ThingCount()) return 0;
+    SithThing *item=&bot.world->aThings[itemIndex];
+    if (item->type!=SITH_THING_ITEM || (item->flags&SITH_TF_DESTROYED) || Bot_FailedDive(item)) return 0;
+    if (itemIndex<BOT_NODES && nav.itemGuid[itemIndex] && item->guid!=nav.itemGuid[itemIndex]) return 0;
+    flex_t availability=1.0f;
+    if (item->flags&SITH_TF_DISABLED) {
+        if (itemIndex>=BOT_NODES || item->itemParams.secRespawnInterval<=0) return 0;
+        if (!nav.unavailable[itemIndex]) {
+            nav.unavailable[itemIndex]=1; nav.unavailableAt[itemIndex]=bot.now;
+        }
+        /* Respawn is only an estimate from a locally observed disappearance.
+           Never camp on an absent item; a near-respawn waypoint gets a small
+           bonus, while active pickups always retain their full need score. */
+        flex_t remaining=item->itemParams.secRespawnInterval-(bot.now-nav.unavailableAt[itemIndex]);
+        if (remaining>4.0f || remaining < -3.0f) return 0;
+        availability=0.12f;
+    } else if (itemIndex<BOT_NODES) nav.unavailable[itemIndex]=0;
+    BotPickupKind pickup=Bot_PickupType(item);
+    flex_t value=0;
+    flex_t quantity=pickup.bin ? sithInventory_GetInventory(self,pickup.bin) : 0;
+    switch (pickup.kind) {
+        case BOT_ITEM_WEAPON:
+            if (bot.sabersOnly && pickup.bin!=SITHBIN_LIGHTSABER) break;
+            if (!sithInventory_IsInventoryAvailable(self,pickup.bin) || quantity<=0) {
+                value=8.0f;
+                /* Heuristic for active gun pickups while healthy. Critical health and
+                   predicted respawns retain the ordinary acquisition value. */
+                if (bot.elite && availability==1.0f && self->actorParams.health>=40) {
+                    if (pickup.bin==SITHBIN_CONCUSSION_RIFLE) value=18.0f;
+                    else if (pickup.bin==SITHBIN_RAIL_DETONATOR) value=12.0f;
+                    else if (pickup.bin==SITHBIN_REPEATER) value=10.0f;
+                }
+            } else if (pickup.ammo) {
+                flex_t ammo=sithInventory_GetInventory(self,pickup.ammo);
+                if (ammo<pickup.cap) value=ammo<pickup.cap*0.15f ? 4.0f : 0.8f;
+            }
+            break;
+        case BOT_ITEM_AMMO:
+            /* Hand-thrown charges and placed mines require trajectory/site
+               planning not implemented by the combat driver. Do not spend
+               routes collecting ammunition the bot will never select. */
+            if (pickup.bin==SITHBIN_THERMAL_DETONATOR || pickup.bin==SITHBIN_SEQUENCER_CHARGE) break;
+            if (!bot.sabersOnly && quantity<pickup.cap)
+                value=quantity<pickup.cap*0.15f ? 5.0f : quantity<pickup.cap*0.5f ? 2.2f : 0.4f;
+            break;
+        case BOT_ITEM_HEALTH:
+            if (self->actorParams.health<100) value=self->actorParams.health<40 ? 16.0f : 5.0f;
+            break;
+        case BOT_ITEM_BACTA:
+            if (quantity<5) value=self->actorParams.health<65 ? 10.0f : quantity<1 ? 4.0f : 1.2f;
+            break;
+        case BOT_ITEM_SHIELD:
+            if (quantity<200) value=quantity<40 ? 8.0f : quantity<100 ? 5.0f : 2.0f;
+            break;
+        case BOT_ITEM_MANA: {
+            flex_t maxMana=sithInventory_GetInventory(self,SITHBIN_JEDI_RANK)*50.0f;
+            if (bot.forceEnabled && maxMana>0 && quantity<maxMana)
+                value=quantity<maxMana*0.3f ? 6.0f : 2.0f;
+            break;
+        }
+        case BOT_ITEM_LIGHT:
+        case BOT_ITEM_DARK:
+            if (bot.forceEnabled && quantity<1 && sithInventory_GetInventory(self,SITHBIN_JEDI_RANK)>0 &&
+                ((sithInventory_GetInventory(self,SITHBIN_ALIGNMENT)>=0)==(pickup.kind==BOT_ITEM_LIGHT))) value=7.0f;
+            break;
+        case BOT_ITEM_DAMAGE:
+            if (quantity<2) value=6.5f;
+            break;
+        case BOT_ITEM_SUPERSHIELD:
+            if (!sithInventory_IsInventoryActivated(self,SITHBIN_SUPERSHIELDS)) value=9.0f;
+            break;
+        case BOT_ITEM_REVIVE:
+            if (self->actorParams.health<100 || sithInventory_GetInventory(self,SITHBIN_SHIELDS)<200)
+                value=self->actorParams.health<50 ? 18.0f : 9.0f;
+            break;
+        case BOT_ITEM_PACK:
+            value=Bot_PackValue(self,item);
+            break;
+        case BOT_ITEM_KEY:
+            if (nav.ctf && !sithInventory_IsInventoryAvailable(self,pickup.bin)) value=6.0f;
+            break;
+        default: break;
+    }
+    if (companion.policy.mode && value>0) {
+        if (pickup.kind==BOT_ITEM_WEAPON && pickup.bin==companion.policy.weapon &&
+            availability==1.0f && self->actorParams.health>=40) value*=2.5f;
+        if (companion.policy.mode==CP_RESOURCE) value*=1.7f;
+        if (companion.policy.mode==CP_RECOVER &&
+            (pickup.kind==BOT_ITEM_HEALTH || pickup.kind==BOT_ITEM_BACTA ||
+             pickup.kind==BOT_ITEM_SHIELD || pickup.kind==BOT_ITEM_REVIVE)) value*=2.5f;
+        if (companion.policy.resource && pickup.bin==companion.policy.resource) value*=2.0f;
+    }
+    return value*availability;
+}
+
+static int Bot_EquipmentMode(void)
+{ return bot.elite && !bot.sabersOnly && !nav.ctf && !companion.policy.mode; }
+
+static int Bot_HasWeapon(SithThing *self,int weapon);
+
+static int Bot_DeferSupplyApproaches(SithThing *self)
+{
+    if (bot.now>=nav.supplyApproach.latestRetry || !Bot_EquipmentMode() ||
+        self->actorParams.health<40 || nav.diveEscape || Bot_NeedsAir(self)) return 0;
+    return (Bot_HasWeapon(self,SITHBIN_CONCUSSION_RIFLE) && sithInventory_GetInventory(self,SITHBIN_POWER)>=32) ||
+        (Bot_HasWeapon(self,SITHBIN_RAIL_DETONATOR) && sithInventory_GetInventory(self,SITHBIN_RAILCHARGES)>=4);
+}
+
+static SithSector *Bot_ApproachBank(SithThing *self)
+{
+    return nav.supplyApproach.bank && !(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE)) ?
+        nav.supplyApproach.bank : self->sector;
+}
+
+static int Bot_ApproachDeferred(SithSector *bank,SithSector *water)
+{
+    for (int i=0;i<BOT_FAILED_APPROACHES;i++) {
+        const BotFailedApproach *entry=&nav.supplyApproach.failed[i];
+        if (entry->bank==bank && entry->water==water && bot.now<entry->until) return 1;
+    }
+    return 0;
+}
+
+static int Bot_OnDeferredCrossing(void)
+{
+    return nav.supplyApproach.water && Bot_ApproachDeferred(nav.supplyApproach.bank,nav.supplyApproach.water);
+}
+
+static int Bot_WetDestination(const BotNode *node)
+{
+    const SithThing *item=Bot_NavThing(node->item);
+    const SithSector *sector=item && item->type==SITH_THING_ITEM && item->sector ? item->sector : node->sector;
+    return (sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+}
+
+static int Bot_UsesAmmo(SithThing *self,int bin)
+{
+    if (bin==SITHBIN_ENERGY) return sithInventory_GetInventory(self,SITHBIN_BRYARPISTOL)>0 ||
+        sithInventory_GetInventory(self,SITHBIN_STORMTROOPER_RIFLE)>0;
+    if (bin==SITHBIN_POWER) return sithInventory_GetInventory(self,SITHBIN_CONCUSSION_RIFLE)>0 ||
+        sithInventory_GetInventory(self,SITHBIN_REPEATER)>0 || sithInventory_GetInventory(self,SITHBIN_TUSKEN_PROD)>0;
+    return bin==SITHBIN_RAILCHARGES && sithInventory_GetInventory(self,SITHBIN_RAIL_DETONATOR)>0;
+}
+
+/* Called only while the bot already has a stocked heavy and an active
+   failed approach. Keep useful ammunition for an owned gun eligible. */
+static int Bot_OptionalSupply(SithThing *self,SithThing *item)
+{
+    if (!item || item->type!=SITH_THING_ITEM || !item->sector) return 0;
+    if (item->sector->flags&SITH_SECTOR_UNDERWATER) return 1;
+    if (Bot_LivePack(item)) {
+        int restocksOwned;
+        Bot_PackUtility(self,item,&restocksOwned);
+        return !restocksOwned;
+    }
+    BotPickupKind kind=Bot_PickupType(item);
+    if (kind.kind==BOT_ITEM_AMMO)
+        return !Bot_UsesAmmo(self,kind.bin) || sithInventory_GetInventory(self,kind.bin)>=kind.cap*0.15f;
+    if (kind.kind!=BOT_ITEM_WEAPON) return 0;
+    /* A duplicate rack can refill the gun actually in use. */
+    return kind.bin!=sithInventory_GetCurrentWeapon(self) || !kind.ammo ||
+        sithInventory_GetInventory(self,kind.ammo)>=kind.cap*0.15f;
+}
+
+static int Bot_OptionalPatrolNode(SithThing *self,BotNode *node,flex_t pickupValue)
+{
+    return pickupValue<=0.05f || Bot_WetDestination(node) || Bot_OptionalSupply(self,Bot_NavThing(node->item));
+}
+
+static int Bot_NearestApproach(SithThing *self,int defer)
+{
+    int best=-1;
+    flex_t distance=1e20f;
+    for (int pass=0;pass<2 && best<0;pass++) for (int i=0;i<bot.nNodes;i++) {
+        BotNode *n=&bot.nodes[i];
+        if (!pass && n->sector!=self->sector) continue;
+        if (pass && defer && (n->sector->flags&SITH_SECTOR_UNDERWATER) &&
+            Bot_ApproachDeferred(Bot_ApproachBank(self),n->sector)) continue;
+        flex_t d=Bot_Distance(n->pos,self->position);
+        int water=((n->sector->flags|self->sector->flags)&SITH_SECTOR_UNDERWATER)!=0;
+        if (d>=distance || d>2.0f || (!water && fabsf(n->pos.z-self->position.z)>0.3f)) continue;
+        if (!Bot_Clear(self,self->sector,self->position,n->pos,0.04f,1)) continue;
+        best=i; distance=d;
+    }
+    return best;
+}
+
+static int Bot_Nearest(SithThing *self)
+{ return Bot_NearestApproach(self,0); }
+
+static void Bot_ObjectiveSet(int mode, SithThing *thing, rdVector3 position, SithSector *sector)
+{
+    nav.objective=mode; nav.objectiveThing=thing ? (int)thing->idx : -1;
+    nav.objectivePos=position; nav.objectiveSector=sector;
+    nav.objectiveValid=Bot_SectorSafe(sector);
+}
+
+static void Bot_UpdateObjective(SithThing *self)
+{
+    nav.objective=BOT_OBJECTIVE_NONE; nav.objectiveValid=0; nav.objectiveThing=-1;
+    if (nav.diveEscape || Bot_NeedsAir(self)) {
+        nav.objective=BOT_OBJECTIVE_AIR;
+        return;
+    }
+    if (!nav.ctf || !self->actorParams.pPlayer) return;
+    int team=self->actorParams.pPlayer->teamNum;
+    nav.objectiveTeam=team;
+    if (team<1 || team>2) {
+        SithSector *sector=&bot.world->aSectors[nav.mark[nav.requestedTeam-1]];
+        Bot_ObjectiveSet(BOT_OBJECTIVE_JOIN,NULL,sector->center,sector);
+        return;
+    }
+    SithThing *own=Bot_NavThing(nav.flag[team-1]), *enemy=Bot_NavThing(nav.flag[2-team]);
+    SithThing *base=Bot_NavThing(nav.base[team-1]);
+    if (!own || !enemy || !base || !own->sector || !enemy->sector) return;
+    SithThing *ownCarrier=Bot_FlagCarrier(team), *enemyCarrier=Bot_FlagCarrier(3-team);
+    int ownHome=!ownCarrier && Bot_Distance(own->position,base->position)<0.16f;
+    if (enemyCarrier==self) {
+        /* Taking our dropped flag returns it before we can score. If an
+           opponent carries it, hold near home rather than chasing with both
+           flags. Stock touching/scoring rules remain authoritative. */
+        if (!ownCarrier && !ownHome) Bot_ObjectiveSet(BOT_OBJECTIVE_RECOVER,own,own->position,own->sector);
+        else Bot_ObjectiveSet(BOT_OBJECTIVE_RETURN,ownHome ? own : base,
+            ownHome ? own->position : base->position,ownHome ? own->sector : base->sector);
+        return;
+    }
+    if (ownCarrier) {
+        Bot_ObjectiveSet(BOT_OBJECTIVE_INTERCEPT,ownCarrier,ownCarrier->position,ownCarrier->sector);
+        return;
+    }
+    if (!ownHome) {
+        Bot_ObjectiveSet(BOT_OBJECTIVE_RECOVER,own,own->position,own->sector);
+        return;
+    }
+    if (enemyCarrier) {
+        Bot_ObjectiveSet(BOT_OBJECTIVE_ESCORT,enemyCarrier,enemyCarrier->position,enemyCarrier->sector);
+        return;
+    }
+    /* One of multiple teammates may guard home; the lowest network identity
+       always keeps an attacking role, including a lone bot. */
+    unsigned int teammates=0; uint32_t first=UINT32_MAX;
+    for (unsigned int i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        SithPlayer *p=&jkPlayer_playerInfos[i];
+        if (!(p->flags&1) || !p->playerNetId || p->teamNum!=(uint32_t)team || !p->pLocalPlayer) continue;
+        teammates++; if ((uint32_t)p->playerNetId<first) first=(uint32_t)p->playerNetId;
+    }
+    if (teammates>1 && (uint32_t)self->actorParams.pPlayer->playerNetId!=first) {
+        Bot_ObjectiveSet(BOT_OBJECTIVE_DEFEND,own,base->position,base->sector);
+    } else Bot_ObjectiveSet(BOT_OBJECTIVE_CAPTURE,enemy,enemy->position,enemy->sector);
+}
+
+static void Bot_HeapUp(int *heap, int *positions, flex_t *distance, int at)
+{
+    int node=heap[at];
+    while (at>0) {
+        int parent=(at-1)/2;
+        if (distance[heap[parent]]<=distance[node]) break;
+        heap[at]=heap[parent]; positions[heap[at]]=at; at=parent;
+    }
+    heap[at]=node; positions[node]=at;
+}
+
+static void Bot_SearchPaths(SithThing *self,int start,flex_t *distance,int *parent,int defer)
+{
+    int heap[BOT_NODES], positions[BOT_NODES], count=1;
+    int forceJump=bot.forceEnabled && sithInventory_GetInventory(self,SITHBIN_F_JUMP)>0 &&
+        sithInventory_GetInventory(self,SITHBIN_FORCEMANA)>=20;
+    for (int i=0;i<bot.nNodes;i++) { distance[i]=1e20f; parent[i]=-1; positions[i]=-1; }
+    if (start<0) return;
+    heap[0]=start; positions[start]=0; distance[start]=0;
+    while (count) {
+        int v=heap[0], last=heap[--count]; positions[v]=-2;
+        if (count) {
+            int at=0;
+            while (at*2+1<count) {
+                int child=at*2+1;
+                if (child+1<count && distance[heap[child+1]]<distance[heap[child]]) child++;
+                if (distance[last]<=distance[heap[child]]) break;
+                heap[at]=heap[child]; positions[heap[at]]=at; at=child;
+            }
+            heap[at]=last; positions[last]=at;
+        }
+        BotNode *n=&bot.nodes[v];
+        for (int k=0;k<n->nEdges;k++) {
+            BotEdge *e=&n->edges[k];
+            if (e->to<0 || e->to>=bot.nNodes || positions[e->to]==-2) continue;
+            if (defer && e->drop==BOT_ROUTE_WATER_ENTRY && Bot_ApproachDeferred(n->sector,bot.nodes[e->to].sector)) continue;
+            if (e->drop==BOT_ROUTE_DROP && self->actorParams.health<30) continue;
+            if (e->drop==BOT_ROUTE_FORCEJUMP && !forceJump) continue;
+            flex_t d=distance[v]+e->cost;
+            if (bot.nodes[e->to].avoidUntil>bot.now) d+=50.0f;
+            if ((e->drop==BOT_ROUTE_SWIM || e->drop==BOT_ROUTE_WATER_ENTRY) && self->actorParams.health<40) d+=12.0f;
+            if (d<distance[e->to]) {
+                distance[e->to]=d; parent[e->to]=v;
+                if (positions[e->to]<0) { positions[e->to]=count; heap[count++]=e->to; }
+                Bot_HeapUp(heap,positions,distance,positions[e->to]);
+            }
+        }
+    }
+}
+
+static void Bot_PathDistances(SithThing *self,int start,flex_t *distance,int *parent)
+{ Bot_SearchPaths(self,start,distance,parent,0); }
+
+typedef struct BotGoalPaths {
+    int start, parent[BOT_NODES];
+    flex_t distance[BOT_NODES];
+} BotGoalPaths;
+
+/* Opponents, air and needed supplies use the complete graph. A second
+   path view prices optional supply and patrol goals during a costly retry. */
+static const BotGoalPaths *Bot_SearchGoalPaths(SithThing *self,BotGoalPaths *all,BotGoalPaths *wet)
+{
+    all->start=Bot_Nearest(self);
+    Bot_PathDistances(self,all->start,all->distance,all->parent);
+    if (!Bot_DeferSupplyApproaches(self)) return all;
+    wet->start=Bot_OnDeferredCrossing() ? -1 : Bot_NearestApproach(self,1);
+    Bot_SearchPaths(self,wet->start,wet->distance,wet->parent,1);
+    return wet;
+}
+
+static void Bot_NavCoverage(SithThing *self)
+{
+    int start=Bot_Nearest(self);
+    if (start<0) {
+        fprintf(stderr,"BOT_NAV_COVERAGE map=%s name=%s status=no_current_anchor\n",bot.world->map_jkl_fname,bot.name);
+        return;
+    }
+    flex_t distance[BOT_NODES]; int parent[BOT_NODES];
+    unsigned char anchored[BOT_NODES]={0}, reachable[BOT_NODES]={0};
+    int total=0, classified=0, anchoredCount=0, reachableCount=0, reachableNodes=0, logged=0;
+    Bot_PathDistances(self,start,distance,parent);
+    for (int i=0;i<bot.nNodes;i++) {
+        int item=bot.nodes[i].item;
+        if (distance[i]<1e19f) reachableNodes++;
+        if (item<0 || item>=BOT_NODES) continue;
+        anchored[item]=1;
+        if (distance[i]<1e19f) reachable[item]=1;
+    }
+    for (int i=0;i<Bot_ThingCount();i++) {
+        SithThing *thing=&bot.world->aThings[i];
+        if (thing->type!=SITH_THING_ITEM || (thing->itemParams.flags&SITH_ITEM_BACKPACK) ||
+            (thing->flags&SITH_TF_DESTROYED)) continue;
+        total++;
+        BotPickupKind kind=Bot_PickupType(thing);
+        if (kind.kind) classified++;
+        if (i<BOT_NODES && anchored[i]) anchoredCount++;
+        if (i<BOT_NODES && reachable[i]) reachableCount++;
+        else if (logged++<24) fprintf(stderr,"BOT_NAV_UNREACHABLE map=%s item=%d template=%s sector=%u anchored=%d\n",
+            bot.world->map_jkl_fname,i,Bot_ItemName(thing),thing->sector ? thing->sector->id : UINT32_MAX,
+            i<BOT_NODES && anchored[i]);
+    }
+    nav.coverageTeam=self->actorParams.pPlayer ? (int)self->actorParams.pPlayer->teamNum : 0;
+    fprintf(stderr,"BOT_NAV_COVERAGE map=%s name=%s team=%d origin_sector=%u nodes=%d reachable_nodes=%d items_total=%d classified_items=%d anchored_items=%d reachable_items=%d missing_nodes=%d truncated=%d\n",
+        bot.world->map_jkl_fname,bot.name,nav.coverageTeam,self->sector->id,bot.nNodes,reachableNodes,total,classified,
+        anchoredCount,reachableCount,total-anchoredCount,nav.truncated);
+}
+
+static int Bot_ObjectiveNode(SithThing *self, const flex_t *distance)
+{
+    int best=-1; flex_t bestDistance=1e20f;
+    nav.selectedEntry=-1;
+    if (nav.objective==BOT_OBJECTIVE_JOIN) {
+        for (int i=0;i<nav.entryCount;i++) {
+            BotTeamEntry *entry=&nav.entries[i];
+            if (entry->team!=nav.requestedTeam || entry->node<0 || entry->node>=bot.nNodes ||
+                bot.nodes[entry->node].avoidUntil>bot.now || distance[entry->node]>=1e19f ||
+                distance[entry->node]>=bestDistance) continue;
+            bestDistance=distance[entry->node]; best=entry->node; nav.selectedEntry=i;
+            nav.objectivePos=entry->inside; nav.objectiveSector=entry->sector;
+        }
+        return best;
+    }
+    for (int i=0;i<bot.nNodes;i++) {
+        BotNode *n=&bot.nodes[i];
+        if (distance[i]>=1e19f || n->avoidUntil>bot.now) continue;
+        if (nav.objective==BOT_OBJECTIVE_AIR) {
+            if (n->sector->flags&SITH_SECTOR_UNDERWATER) continue;
+            if (distance[i]<bestDistance) { bestDistance=distance[i]; best=i; }
+            continue;
+        }
+        flex_t remaining=Bot_Distance(n->pos,nav.objectivePos);
+        if (remaining>bestDistance) continue;
+        if (fabsf(n->pos.z-nav.objectivePos.z)>0.35f ||
+            !Bot_Clear(self,n->sector,n->pos,nav.objectivePos,0.025f,1)) continue;
+        bestDistance=remaining; best=i;
+    }
+    return best;
+}
+
+/* A route destination never becomes a combat target or companion sighting.
+   Select a reachable anchor inside a living opponent's sector. */
+static int Bot_ElitePursuit(SithThing *self,int start,const flex_t *distance,int *slot)
+{
+    if (!bot.elite || nav.objective!=BOT_OBJECTIVE_NONE || self->actorParams.health<40 ||
+        companion.policy.mode==CP_RESOURCE || companion.policy.mode==CP_RECOVER) return -1;
+    int best=-1;
+    flex_t lowest=1e20f;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        if (!Bot_EnemyBase(self,(int)i) || Bot_IsPeaceful(self,(int)i)) continue;
+        SithThing *t=jkPlayer_playerInfos[i].pLocalPlayer;
+        if (!t || t->actorParams.health<=0) continue;
+        for (int j=0;j<bot.nNodes;j++) {
+            BotNode *n=&bot.nodes[j];
+            if (j==start || n->sector!=t->sector || n->avoidUntil>bot.now ||
+                nav.liftForNode[j] || distance[j]>=1e19f) continue;
+            flex_t remaining=Bot_Distance(n->pos,t->position);
+            flex_t cost=distance[j]+remaining*2.0f;
+            if (companion.policy.net && companion.policy.net==jkPlayer_playerInfos[i].playerNetId &&
+                companion.policy.guid==t->guid && companion.policy.signature==t->signature) cost*=0.60f;
+            if (cost<lowest) { lowest=cost; best=j; *slot=(int)i; }
+        }
+    }
+    return best;
+}
+
+static void Bot_CheckPursuit(SithThing *self)
+{
+    if (!nav.pursuitNet) return;
+    if (Bot_EnemyBase(self,nav.pursuitSlot) && !Bot_IsPeaceful(self,nav.pursuitSlot)) {
+        SithPlayer *player=&jkPlayer_playerInfos[nav.pursuitSlot];
+        SithThing *t=player->pLocalPlayer;
+        if (player->playerNetId==nav.pursuitNet && t->guid==nav.pursuitGuid &&
+            t->signature==nav.pursuitSignature && t->actorParams.health>0 &&
+            self->actorParams.health>=40 && companion.policy.mode!=CP_RESOURCE &&
+            companion.policy.mode!=CP_RECOVER) return;
+    }
+    nav.pursuitNet=0; bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+}
+
+static int Bot_SetRoute(int start,int goal,const int *parent)
+{
+    if (goal!=bot.goal) bot.goalSetAt=bot.now;
+    bot.goal=goal; bot.routeCount=bot.routePos=0;
+    if (goal<0) return 0;
+    int reverse[BOT_PATH], n=0, v=goal;
+    while (v>=0 && v!=start && n<BOT_PATH) { reverse[n++]=v; v=parent[v]; }
+    if (v!=start) { bot.goal=-1; return 0; }
+    if (!n) bot.route[bot.routeCount++]=goal;
+    while (n>0) bot.route[bot.routeCount++]=reverse[--n];
+    return 1;
+}
+
+static void Bot_Plan(SithThing *self)
+{
+    BotGoalPaths all,restricted;
+    const BotGoalPaths *safe=Bot_SearchGoalPaths(self,&all,&restricted), *chosen=&all;
+    const flex_t *distance=all.distance;
+    int start=all.start,goal=-1;
+    nav.supplyApproach.lastResortGoal=0;
+    if (start<0) { bot.nextPlan=bot.now+0.4f; return; }
+    bot.nextPlan=bot.now+1.0f;
+    if (Bot_Distance(bot.nodes[start].pos,self->position)<0.22f) bot.nodes[start].visited=bot.now;
+    Bot_UpdateObjective(self);
+    if (nav.ctf && bot.graphDone && self->actorParams.pPlayer &&
+        nav.coverageTeam!=(int)self->actorParams.pPlayer->teamNum)
+        Bot_NavCoverage(self);
+    if (nav.objectiveValid || nav.objective==BOT_OBJECTIVE_AIR) goal=Bot_ObjectiveNode(self,distance);
+    nav.objectiveRouteNode=goal;
+    if (goal>=0 && self->actorParams.health<30 && !Bot_ObjectiveUrgent(self)) {
+        flex_t best=0;
+        for (int i=0;i<bot.nNodes;i++) if (distance[i]<2.0f && bot.nodes[i].avoidUntil<=bot.now) {
+            flex_t value=Bot_ItemValue(self,bot.nodes[i].item);
+            if (value>=10 && value/(0.6f+distance[i])>best) { best=value/(0.6f+distance[i]); goal=i; }
+        }
+    }
+    int oldPursuit=nav.pursuitNet!=0, pursuitSlot=-1;
+    nav.pursuitNet=0;
+    int pursuit=goal<0 ? Bot_ElitePursuit(self,start,distance,&pursuitSlot) : -1;
+    /* Keep an unreached goal even after it becomes the nearest start node. */
+    if (goal<0 && pursuit<0 && !oldPursuit && bot.goal>=0 && bot.goal<bot.nNodes) {
+        BotNode *prior=&bot.nodes[bot.goal];
+        flex_t value=Bot_ItemValue(self,prior->item);
+        const BotGoalPaths *paths=safe!=&all && Bot_OptionalPatrolNode(self,prior,value) ? safe : &all;
+        if (paths->distance[bot.goal]<1e19f && prior->avoidUntil<=bot.now && bot.now-bot.goalSetAt<14.0f &&
+            (Bot_Distance(self->position,prior->pos)>0.11f || Bot_PickupNeedsContact(self,prior)) &&
+            (prior->item<0 || value>0.05f)) {
+            goal=bot.goal; chosen=paths;
+        }
+    }
+    if (goal<0) {
+        /* Nearby high-value pickups can still outrank an opponent across
+           the map. A pursuit goal gets no bonus for an unreachable shortcut. */
+        flex_t best=-1e20f,backupScore=-1e20f;
+        int backup=-1;
+        if (pursuit>=0) {
+            goal=pursuit; best=9.0f/(0.8f+0.22f*distance[pursuit]);
+        }
+        for (int i=0;i<bot.nNodes;i++) {
+            BotNode *n=&bot.nodes[i];
+            if (distance[i]>=1e19f || n->avoidUntil>bot.now || nav.liftForNode[i] ||
+                (Bot_Distance(self->position,n->pos)<0.20f &&
+                 (!Bot_PickupNeedsContact(self,n) || Bot_ItemValue(self,n->item)<=0.05f))) continue;
+            flex_t unseen=Bot_Clamp((bot.now-n->visited)/30.0f,0.0f,1.0f);
+            flex_t pickup=Bot_ItemValue(self,n->item), exploration=2.4f*unseen+Bot_Unit()*0.4f;
+            const BotGoalPaths *paths=safe!=&all && Bot_OptionalPatrolNode(self,n,pickup) ? safe : &all;
+            if (paths->distance[i]>=1e19f) {
+                /* If this crossing is the only way to move, keep a dry
+                   exploration destination without rewarding the extra gun. */
+                if (!(n->sector->flags&SITH_SECTOR_UNDERWATER) && !Bot_WetDestination(n)) {
+                    flex_t score=exploration/(0.8f+0.42f*distance[i]);
+                    if (score>backupScore) { backupScore=score; backup=i; }
+                }
+                continue;
+            }
+            flex_t value=pickup+exploration;
+            if (companion.policy.mode==CP_PRESSURE && companion.hasPursuit &&
+                bot.now-companion.pursuitTime<=3.0f) {
+                flex_t separation=Bot_Distance(n->pos,companion.pursuitAt);
+                value+=(4.0f+3.0f*companion.policy.risk)/(0.5f+separation);
+            }
+            flex_t travelCost=companion.policy.mode ? 0.56f-0.28f*companion.policy.risk : 0.42f;
+            flex_t score=value/(0.8f+paths->distance[i]*travelCost);
+            if (score>best) { best=score; goal=i; chosen=paths; }
+        }
+        if (goal<0 && backup>=0) {
+            goal=backup; chosen=&all; nav.supplyApproach.lastResortGoal=backup+1;
+        }
+    }
+    if (goal>=0 && goal==pursuit) {
+        SithPlayer *player=&jkPlayer_playerInfos[pursuitSlot];
+        nav.pursuitSlot=pursuitSlot; nav.pursuitNet=player->playerNetId;
+        nav.pursuitGuid=player->pLocalPlayer->guid; nav.pursuitSignature=player->pLocalPlayer->signature;
+        bot.nextPlan=bot.now+0.4f; chosen=&all;
+    }
+    if (!Bot_SetRoute(chosen->start,goal,chosen->parent)) return;
+    if (nav.objective!=nav.loggedObjective || (nav.ctf && bot.now>=nav.nextObjectiveLog)) {
+        nav.loggedObjective=nav.objective; nav.nextObjectiveLog=bot.now+10;
+        fprintf(stderr,"BOT_OBJECTIVE name=%s mode=%d team=%d goal=%d distance=%.2f\n",
+            bot.name,nav.objective,nav.objectiveTeam,goal,(double)distance[goal]);
+        fflush(stderr);
+    }
+}
diff --git a/src/AI/jkBotPersona.c b/src/AI/jkBotPersona.c
new file mode 100644
index 0000000000000000000000000000000000000000..d94f22cb6ba755d3c3557880b8c5518f2238e1dd
--- /dev/null
+++ b/src/AI/jkBotPersona.c
@@ -0,0 +1,155 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT */
+#include "AI/jkBotPersona.h"
+#include "AI/jkBot.h"
+#include "Gameplay/sithPlayer.h"
+#include "Dss/sithMulti.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <time.h>
+#ifdef PLATFORM_POSIX
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+#endif
+
+#define BOT_LINES 16
+#define BOT_TEXT 111
+enum { CHAT_SPAWN, CHAT_KILL, CHAT_DEATH, CHAT_AMBIENT, CHAT_EVENTS };
+static const char *eventNames[CHAT_EVENTS] = {"spawn", "kill", "death", "ambient"};
+static char lines[CHAT_EVENTS][BOT_LINES][BOT_TEXT];
+static int counts[CHAT_EVENTS], lastLine[CHAT_EVENTS];
+static int enabled, joined, lastKills, lastDeaths, pending;
+static double nextChat, eventAt, phase;
+static uint32_t rng;
+static char gatePath[4096];
+
+static double Persona_Now(void)
+{
+#ifdef PLATFORM_POSIX
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0)
+        return (double)ts.tv_sec + ts.tv_nsec / 1000000000.0;
+#endif
+    return (double)clock() / CLOCKS_PER_SEC;
+}
+static uint32_t Persona_Random(void)
+{
+    rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5;
+    return rng;
+}
+/* Shared by exactly one roster invocation. Fail closed on a missing gate. */
+static int Persona_Gate(double now)
+{
+#ifdef PLATFORM_POSIX
+    double last = 0;
+    char buf[80];
+    int allowed = 0;
+    int fd = open(gatePath, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) return 0;
+    if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+        ssize_t n = read(fd, buf, sizeof(buf) - 1);
+        if (n >= 0) {
+            buf[n] = 0;
+            char *end = NULL;
+            if (n) last = strtod(buf, &end);
+            if ((!n || (end != buf && last >= 0 && last <= now)) &&
+                (!n || now - last >= 35.0)) {
+                int len = snprintf(buf, sizeof(buf), "%.6f\n", now);
+                if (lseek(fd, 0, SEEK_SET) == 0 && ftruncate(fd, 0) == 0 &&
+                    write(fd, buf, (size_t)len) == len) allowed = 1;
+            }
+        }
+        flock(fd, LOCK_UN);
+    }
+    close(fd);
+    return allowed;
+#else
+    (void)now;
+    return 0;
+#endif
+}
+void jkBotPersona_Configure(void)
+{
+    const char *path = getenv("JK_BOT_PERSONA_FILE");
+    const char *gate = getenv("JK_BOT_CHAT_LOCK");
+    const char *off = getenv("JK_BOT_TAUNTS");
+    const char *start = getenv("JK_BOT_CHAT_PHASE");
+    char row[256];
+    FILE *f;
+    enabled = joined = 0; pending = CHAT_SPAWN; phase = 15.0;
+    memset(counts, 0, sizeof(counts));
+    for (int i = 0; i < CHAT_EVENTS; ++i) lastLine[i] = -1;
+    if (!jkBot_IsEnabled() || (off && !strcmp(off, "0")) || !path || !gate ||
+        !*gate || strlen(gate) >= sizeof(gatePath)) return;
+    if (start) {
+        char *end;
+        double value = strtod(start, &end);
+        if (*end == 0 && value >= 15.0 && value <= 600.0) phase = value;
+    }
+    f = fopen(path, "r");
+    if (!f) return;
+    while (fgets(row, sizeof(row), f)) {
+        size_t len = strlen(row);
+        if (len && row[len - 1] != '\n' && !feof(f)) {
+            int c; while ((c = fgetc(f)) != '\n' && c != EOF) {}
+            continue;
+        }
+        while (len && (row[len - 1] == '\n' || row[len - 1] == '\r')) row[--len] = 0;
+        char *text = strchr(row, '\t');
+        if (!text) continue;
+        *text++ = 0;
+        len = strlen(text);
+        if (!len || len >= BOT_TEXT) continue;
+        int valid = 1;
+        for (size_t i = 0; i < len; ++i)
+            if ((unsigned char)text[i] < 32 || (unsigned char)text[i] > 126) valid = 0;
+        if (!valid) continue;
+        for (int i = 0; i < CHAT_EVENTS; ++i) {
+            if (!strcmp(row, eventNames[i]) && counts[i] < BOT_LINES) {
+                memcpy(lines[i][counts[i]++], text, len + 1);
+                break;
+            }
+        }
+    }
+    fclose(f);
+    if (!counts[CHAT_AMBIENT]) return;
+    strcpy(gatePath, gate);
+    rng = (uint32_t)(Persona_Now() * 1000000.0);
+#ifdef PLATFORM_POSIX
+    rng ^= (uint32_t)getpid();
+#endif
+    if (!rng) rng = 0x9e3779b9u;
+    enabled = 1;
+}
+void jkBotPersona_OnJoined(void)
+{
+    if (!enabled || !sithPlayer_g_pLocalPlayer) return;
+    lastKills = sithPlayer_g_pLocalPlayer->numKills;
+    lastDeaths = sithPlayer_g_pLocalPlayer->numKilled;
+    eventAt = Persona_Now(); nextChat = eventAt + phase;
+    pending = CHAT_SPAWN; joined = 1;
+}
+void jkBotPersona_Tick(float dt)
+{
+    (void)dt;
+    SithPlayer *player = sithPlayer_g_pLocalPlayer;
+    SithThing *thing = sithPlayer_g_pLocalPlayerThing;
+    if (!enabled || !joined || !player || !thing) return;
+    double now = Persona_Now();
+    if (player->numKilled > lastDeaths) { pending = CHAT_DEATH; eventAt = now; }
+    else if (player->numKills > lastKills) { pending = CHAT_KILL; eventAt = now; }
+    lastKills = player->numKills; lastDeaths = player->numKilled;
+    if (now < nextChat || (thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))) return;
+    int event = pending;
+    if (event < 0 || (event != CHAT_SPAWN && now - eventAt > 25.0) || !counts[event]) event = CHAT_AMBIENT;
+    if (!Persona_Gate(now)) { nextChat = now + 5.0 + (Persona_Random() % 8); return; }
+    int choice = (int)(Persona_Random() % (uint32_t)counts[event]);
+    if (counts[event] > 1 && choice == lastLine[event]) choice = (choice + 1) % counts[event];
+    lastLine[event] = choice;
+    sithMulti_SendChat(lines[event][choice], -1, playerThingIdx);
+    printf("BOT_CHAT event=%s text=%s\n", eventNames[event], lines[event][choice]); fflush(stdout);
+    pending = -1;
+    nextChat = now + 90.0 + (Persona_Random() % 61);
+}
diff --git a/src/AI/jkBotPersona.h b/src/AI/jkBotPersona.h
new file mode 100644
index 0000000000000000000000000000000000000000..ab6720149012f1e79331b2ffc7fb3b752dd61239
--- /dev/null
+++ b/src/AI/jkBotPersona.h
@@ -0,0 +1,6 @@
+#ifndef JK_BOT_PERSONA_H
+#define JK_BOT_PERSONA_H
+void jkBotPersona_Configure(void);
+void jkBotPersona_OnJoined(void);
+void jkBotPersona_Tick(float dt);
+#endif
diff --git a/src/AI/jkBotWaterExit.inc b/src/AI/jkBotWaterExit.inc
new file mode 100644
index 0000000000000000000000000000000000000000..f307ed4fcf610c5a6a2653ee999337b03000ebcd
--- /dev/null
+++ b/src/AI/jkBotWaterExit.inc
@@ -0,0 +1,228 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT */
+/* Arc segments are short enough that the ordinary steering probe's endpoint
+   tolerance could hide a rim hit. Check their complete swept volume. */
+static int Bot_WaterClear(SithSector *sector,rdVector3 from,rdVector3 to,flex_t radius)
+{
+    rdVector3 dir=Bot_Sub(to,from);
+    flex_t length=Bot_Len(dir);
+    if (length<0.00001f) return 1;
+    dir.x/=length; dir.y/=length; dir.z/=length;
+    sithCollision_SearchForCollisions(sector,NULL,&from,&dir,length,radius,RAYCAST_200|RAYCAST_2000);
+    int clear=1;
+    SithCollision *hit;
+    while ((hit=sithCollision_PopStack())) {
+        if (hit->distance>length) continue;
+        if ((hit->type&SITHCOLLISION_WORLD) ||
+            ((hit->type&SITHCOLLISION_THING) && Bot_StaticFixture(hit->pThingCollided))) { clear=0; break; }
+        if ((hit->type&SITHCOLLISION_ADJOINCROSS) && hit->surface && hit->surface->pAdjoin) {
+            SithSurfaceAdjoin *a=hit->surface->pAdjoin;
+            if (!Bot_SectorSafe(a->sector) || !(a->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT) ||
+                (a->flags&SITHSURF_ADJOIN_ALLOW_AI_ONLY)) { clear=0; break; }
+        }
+    }
+    sithCollision_DecreaseStackLevel();
+    return clear;
+}
+
+/* A surface jump uses ordinary JUMP at the real water/air boundary.
+   An underwater waypoint is not itself a jump launch point. */
+static int Bot_WaterSurface(const BotNode *wet, flex_t radius, rdVector3 *surface)
+{
+    rdVector3 up={0,0,1};
+    int found=0;
+    sithCollision_SearchForCollisions(wet->sector,NULL,&wet->pos,&up,0.42f,0,RAYCAST_1);
+    SithCollision *hit;
+    while ((hit=sithCollision_PopStack())) {
+        if (hit->type&SITHCOLLISION_WORLD) break;
+        if (!(hit->type&SITHCOLLISION_ADJOINCROSS) || !hit->surface || !hit->surface->pAdjoin) continue;
+        SithSurfaceAdjoin *adjoin=hit->surface->pAdjoin;
+        if (!(adjoin->flags&SITHSURF_ADJOIN_ALLOW_MOVEMENT) || (adjoin->flags&SITHSURF_ADJOIN_ALLOW_AI_ONLY) ||
+            !Bot_SectorSafe(adjoin->sector)) break;
+        if (adjoin->sector->flags&SITH_SECTOR_UNDERWATER) continue;
+        if (hit->surface->surfaceInfo.face.normal.z < -0.85f) {
+            *surface=wet->pos; surface->z+=hit->distance;
+            found=1;
+        }
+        break;
+    }
+    sithCollision_DecreaseStackLevel();
+    if (!found) return 0;
+    rdVector3 above=*surface; above.z+=radius;
+    return Bot_WaterClear(wet->sector,wet->pos,above,radius);
+}
+
+/* Stock unattached controls apply full forward thrust, scaled by 0.6 in
+   water or 0.3 in air. Sample both sides of the boundary in 20-ms steps. */
+static int Bot_WaterFlight(SithThing *self,const BotNode *wet,const BotNode *dry,
+                           rdVector3 start,flex_t surfaceZ,flex_t initialSpeed,flex_t sideSpeed,flex_t initialZ,flex_t *seconds)
+{
+    const flex_t dt=0.02f,drag=self->physicsParams.airDrag,radius=self->moveSize;
+    rdVector3 direction=Bot_Sub(dry->pos,start), previous=start, points[51];
+    flex_t distance=Bot_Horizontal(direction);
+    if (distance<0.04f) return 0;
+    direction.x/=distance; direction.y/=distance;
+    flex_t speed=initialSpeed, vz=nav.jumpVelocity+initialZ, along=0, lateral=0;
+    int last=0;
+    for (int i=1;i<=50;i++) {
+        int submerged=previous.z<surfaceZ;
+        flex_t decay=1.0f-dt*drag*(submerged ? 4.0f : 1.0f);
+        speed=speed*decay+dt*self->actorParams.maxThrust*(submerged ? 0.6f : 0.3f);
+        sideSpeed*=decay;
+        vz=vz*decay-dt*bot.world->gravity*(submerged ? self->physicsParams.buoyancy : 1.0f);
+        flex_t z=previous.z+dt*vz;
+        int lands=vz<0 && z<=dry->pos.z;
+        if (lands && previous.z<=dry->pos.z) return 0;
+        flex_t step=lands ? (dry->pos.z-previous.z)/vz : dt;
+        along+=speed*step; lateral+=sideSpeed*step;
+        points[i]=(rdVector3){start.x+along*direction.x-lateral*direction.y,
+            start.y+along*direction.y+lateral*direction.x,previous.z+step*vz};
+        if (lands) {
+            if (fabsf(along-distance)>0.040f) return 0;
+            *seconds=(i-1)*dt+step; last=i; break;
+        }
+        previous=points[i];
+    }
+    if (!last) return 0;
+    SithSector *sector=wet->sector;
+    previous=start;
+    for (int i=1;i<=last;i++) {
+        if (!Bot_WaterClear(sector,previous,points[i],radius)) return 0;
+        sector=Bot_SectorAt(&points[i],sector);
+        if (!Bot_SectorSafe(sector) || (sector->flags&(SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+        previous=points[i];
+    }
+    rdVector3 landing; SithSector *support;
+    return sector==dry->sector &&
+        sithIntersect_IsSphereInSector(&previous,radius,sector) &&
+        Bot_Floor(previous,sector,BOT_FOOT_HEIGHT+0.04f,&landing,&support) &&
+        support==sector && fabsf(landing.z-previous.z)<0.025f &&
+        Bot_WaterClear(sector,previous,dry->pos,radius);
+}
+
+/* FindFloor retries a missed center ray using the player radius. A bank rim
+   can support a landing before the center passes over its top face. */
+static int Bot_BankRimSupport(SithThing *self,rdVector3 pos,BotNode *dry,rdVector3 *standing)
+{
+    rdVector3 down={0,0,-1};
+    int flags=RAYCAST_10|RAYCAST_2000|RAYCAST_800|RAYCAST_2;
+    for (int pass=0;pass<2;pass++) {
+        flex_t radius=pass ? self->moveSize : 0.0f;
+        sithCollision_SearchForCollisions(dry->sector,NULL,&pos,&down,self->moveSize+0.005f,radius,flags);
+        SithCollision *hit;
+        while ((hit=sithCollision_PopStack())) {
+            /* This predictor only accepts the dry world face. A standable
+               thing can consume FindFloor's center or radius query first. */
+            if ((hit->type&SITHCOLLISION_THING) && hit->pThingCollided!=self) {
+                sithCollision_DecreaseStackLevel();
+                return 0;
+            }
+            if (!(hit->type&SITHCOLLISION_WORLD)) continue;
+            SithSurface *face=hit->surface;
+            sithCollision_DecreaseStackLevel();
+            if (!face || face->pSector!=dry->sector || face->surfaceInfo.face.normal.z<=0.85f ||
+                (face->flags&(SITH_SURFACE_WATER|SITH_SURFACE_VERYDEEPWATER))) return 0;
+            rdVector3 vertex=bot.world->aVertices[face->surfaceInfo.face.vertexPosIdx[0]];
+            rdVector3 normal=face->surfaceInfo.face.normal;
+            *standing=pos;
+            standing->z=vertex.z-((pos.x-vertex.x)*normal.x+(pos.y-vertex.y)*normal.y)/normal.z+BOT_FOOT_HEIGHT;
+            return 1;
+        }
+        sithCollision_DecreaseStackLevel();
+    }
+    return 0;
+}
+
+/* Verify the live jump against a dry floor contact and the short supported
+   walk from that contact to the graph anchor. Stock physics repeatedly scales
+   the same acceleration between control reads in stepped multiplayer. */
+static int Bot_WaterLanding(SithThing *self,const BotNode *wet,BotNode *dry,
+                            flex_t speed,flex_t lateral,flex_t *seconds)
+{
+    if (self->physicsParams.flags&SITH_PF_CROUCHING) return 0;
+    if (bot.physicsStep<=0 || bot.frameDt<=0) return 0;
+    flex_t dt=bot.physicsStep, control=Bot_Max(dt,bot.frameDt);
+    flex_t surface=self->position.z+self->field_48, contact=dry->pos.z-BOT_FOOT_HEIGHT+self->moveSize+0.001f;
+    rdVector3 direction=Bot_Sub(dry->pos,self->position);
+    flex_t distance=Bot_Horizontal(direction);
+    if (distance<0.04f) return 0;
+    direction.x/=distance; direction.y/=distance;
+    flex_t vz=self->physicsParams.vel.z+nav.jumpVelocity, nextControl=0, thrust=0;
+    rdVector3 pos=self->position, swept=pos;
+    SithSector *sector=wet->sector;
+    for (int i=0;i*dt<1.0f;i++) {
+        flex_t time=i*dt;
+        if (time+0.5f*dt>=nextControl) {
+            thrust=self->actorParams.maxThrust;
+            nextControl+=control;
+        }
+        int water=pos.z<surface;
+        flex_t decay=1.0f-dt*self->physicsParams.airDrag*(water ? 4.0f : 1.0f);
+        thrust*=water ? 0.6f : 0.3f;
+        speed=speed*decay+dt*thrust; lateral*=decay;
+        vz=vz*decay-dt*bot.world->gravity*(water ? self->physicsParams.buoyancy : 1.0f);
+        int landing=vz<0 && pos.z+dt*vz<=contact;
+        if (landing && pos.z<contact) return 0;
+        flex_t step=landing ? (contact-pos.z)/vz : dt;
+        pos.x+=step*(speed*direction.x-lateral*direction.y);
+        pos.y+=step*(speed*direction.y+lateral*direction.x); pos.z+=step*vz;
+        if (!landing && (i%3)!=2) continue;
+        if (!Bot_WaterClear(sector,swept,pos,self->moveSize)) return 0;
+        sector=Bot_SectorAt(&pos,sector); swept=pos;
+        if (!Bot_SectorSafe(sector) || (sector->flags&(SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY))) return 0;
+        if (landing) {
+            rdVector3 floor; SithSector *support;
+            if (sector!=dry->sector) return 0;
+            if (!Bot_Floor(pos,sector,BOT_FOOT_HEIGHT+0.04f,&floor,&support)) {
+                if (vz < -2.0f || !(self->physicsParams.flags&SITH_PF_FLOORSTICK) ||
+                    !Bot_BankRimSupport(self,pos,dry,&floor)) return 0;
+                support=dry->sector;
+            }
+            if (support!=dry->sector || fabsf(floor.z-dry->pos.z)>0.025f) return 0;
+            BotNode actual={.pos=floor,.sector=support}; int drop=0;
+            flex_t walk=Bot_Horizontal(Bot_Sub(dry->pos,floor));
+            if (walk>0.16f || (walk>=0.001f && (!Bot_WalkableSpan(&actual,dry,&drop,0.001f) || drop))) return 0;
+            *seconds=time+step; return 1;
+        }
+    }
+    return 0;
+}
+
+static int Bot_WaterExitArc(const BotNode *wet,const BotNode *dry,rdVector3 *launch,flex_t *duration)
+{
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (!self || !Bot_SectorSafe(wet->sector) || !Bot_SectorSafe(dry->sector) ||
+        !(wet->sector->flags&SITH_SECTOR_UNDERWATER) ||
+        ((wet->sector->flags|dry->sector->flags)&(SITH_SECTOR_NOGRAVITY|SITH_SECTOR_USETHRUST)) ||
+        (dry->sector->flags&SITH_SECTOR_UNDERWATER)) return 0;
+    flex_t radius=self->moveSize, drag=self->physicsParams.airDrag;
+    rdVector3 direction=Bot_Sub(dry->pos,wet->pos);
+    flex_t distance=Bot_Horizontal(direction);
+    if (!(radius>=0.02f && radius<=0.25f && distance>=0.08f && distance<=0.60f &&
+          direction.z>0 && direction.z<=0.70f && nav.jumpVelocity>0 && nav.maxRunSpeed>0 &&
+          self->actorParams.maxThrust>0 && drag>=0 && drag<10 && bot.world->gravity>0) ||
+        !Bot_WaterSurface(wet,radius,launch)) return 0;
+    direction.x/=distance; direction.y/=distance;
+    flex_t surfaceZ=launch->z;
+    launch->z=Bot_Max(wet->pos.z,surfaceZ-0.025f);
+    if (dry->pos.z<=launch->z || !sithIntersect_IsSphereInSector(&dry->pos,radius,dry->sector)) return 0;
+    rdVector3 floor; SithSector *support;
+    if (!Bot_Floor(dry->pos,dry->sector,BOT_FOOT_HEIGHT+0.04f,&floor,&support) ||
+        support!=dry->sector || fabsf(floor.z-dry->pos.z)>0.03f) return 0;
+    /* Build momentum along the surface before asking for a fresh jump. */
+    rdVector3 center=*launch;
+    for (int back=2;back>=0;back--) {
+        rdVector3 start={center.x-direction.x*.08f*back,center.y-direction.y*.08f*back,center.z};
+        if (Bot_SectorAt(&start,wet->sector)!=wet->sector || !Bot_WaterClear(wet->sector,center,start,radius)) continue;
+        *launch=start;
+        flex_t speed=0,along=0;
+        for (int i=0;i<45 && along<distance-0.04f;i++) {
+            if (Bot_WaterFlight(self,wet,dry,*launch,surfaceZ,speed,0,0,duration)) { *launch=start; return 1; }
+            speed=speed*(1.0f-0.02f*4.0f*drag)+0.02f*0.6f*self->actorParams.maxThrust;
+            along+=0.02f*speed;
+            rdVector3 next={start.x+direction.x*along,start.y+direction.y*along,start.z};
+            if (!Bot_WaterClear(wet->sector,*launch,next,radius) || Bot_SectorAt(&next,wet->sector)!=wet->sector) break;
+            *launch=next;
+        }
+    }
+    return 0;
+}
