+static void Bot_ContinueWaterExit(SithThing *self)
+{
+    /* Finish or cancel existing powers through the ordinary Force controls.
+       A required look-away or held key takes precedence over the jump. */
+    Bot_ForceTick(self,NULL,180.0f);
+    if (bot.forceAvoid || bot.forceCancel || bot.forceBin>=0) {
+        nav.waterExitUntil=0; bot.goal=-1; bot.nextPlan=0;
+        return;
+    }
+    Bot_Navigate(self);
+}
