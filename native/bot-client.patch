diff --git a/src/AI/jkBotPersona.c b/src/AI/jkBotPersona.c
new file mode 100644
index 0000000..d94f22c
--- /dev/null
+++ b/src/AI/jkBotPersona.c
@@ -0,0 +1,155 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT */
+#include "AI/jkBotPersona.h"
+#include "AI/jkBot.h"
+#include "Gameplay/sithPlayer.h"
+#include "Dss/sithMulti.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <time.h>
+#ifdef PLATFORM_POSIX
+#include <fcntl.h>
+#include <sys/file.h>
+#include <unistd.h>
+#endif
+
+#define BOT_LINES 16
+#define BOT_TEXT 111
+enum { CHAT_SPAWN, CHAT_KILL, CHAT_DEATH, CHAT_AMBIENT, CHAT_EVENTS };
+static const char *eventNames[CHAT_EVENTS] = {"spawn", "kill", "death", "ambient"};
+static char lines[CHAT_EVENTS][BOT_LINES][BOT_TEXT];
+static int counts[CHAT_EVENTS], lastLine[CHAT_EVENTS];
+static int enabled, joined, lastKills, lastDeaths, pending;
+static double nextChat, eventAt, phase;
+static uint32_t rng;
+static char gatePath[4096];
+
+static double Persona_Now(void)
+{
+#ifdef PLATFORM_POSIX
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0)
+        return (double)ts.tv_sec + ts.tv_nsec / 1000000000.0;
+#endif
+    return (double)clock() / CLOCKS_PER_SEC;
+}
+static uint32_t Persona_Random(void)
+{
+    rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5;
+    return rng;
+}
+/* Shared by exactly one roster invocation. Fail closed on a missing gate. */
+static int Persona_Gate(double now)
+{
+#ifdef PLATFORM_POSIX
+    double last = 0;
+    char buf[80];
+    int allowed = 0;
+    int fd = open(gatePath, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) return 0;
+    if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+        ssize_t n = read(fd, buf, sizeof(buf) - 1);
+        if (n >= 0) {
+            buf[n] = 0;
+            char *end = NULL;
+            if (n) last = strtod(buf, &end);
+            if ((!n || (end != buf && last >= 0 && last <= now)) &&
+                (!n || now - last >= 35.0)) {
+                int len = snprintf(buf, sizeof(buf), "%.6f\n", now);
+                if (lseek(fd, 0, SEEK_SET) == 0 && ftruncate(fd, 0) == 0 &&
+                    write(fd, buf, (size_t)len) == len) allowed = 1;
+            }
+        }
+        flock(fd, LOCK_UN);
+    }
+    close(fd);
+    return allowed;
+#else
+    (void)now;
+    return 0;
+#endif
+}
+void jkBotPersona_Configure(void)
+{
+    const char *path = getenv("JK_BOT_PERSONA_FILE");
+    const char *gate = getenv("JK_BOT_CHAT_LOCK");
+    const char *off = getenv("JK_BOT_TAUNTS");
+    const char *start = getenv("JK_BOT_CHAT_PHASE");
+    char row[256];
+    FILE *f;
+    enabled = joined = 0; pending = CHAT_SPAWN; phase = 15.0;
+    memset(counts, 0, sizeof(counts));
+    for (int i = 0; i < CHAT_EVENTS; ++i) lastLine[i] = -1;
+    if (!jkBot_IsEnabled() || (off && !strcmp(off, "0")) || !path || !gate ||
+        !*gate || strlen(gate) >= sizeof(gatePath)) return;
+    if (start) {
+        char *end;
+        double value = strtod(start, &end);
+        if (*end == 0 && value >= 15.0 && value <= 600.0) phase = value;
+    }
+    f = fopen(path, "r");
+    if (!f) return;
+    while (fgets(row, sizeof(row), f)) {
+        size_t len = strlen(row);
+        if (len && row[len - 1] != '\n' && !feof(f)) {
+            int c; while ((c = fgetc(f)) != '\n' && c != EOF) {}
+            continue;
+        }
+        while (len && (row[len - 1] == '\n' || row[len - 1] == '\r')) row[--len] = 0;
+        char *text = strchr(row, '\t');
+        if (!text) continue;
+        *text++ = 0;
+        len = strlen(text);
+        if (!len || len >= BOT_TEXT) continue;
+        int valid = 1;
+        for (size_t i = 0; i < len; ++i)
+            if ((unsigned char)text[i] < 32 || (unsigned char)text[i] > 126) valid = 0;
+        if (!valid) continue;
+        for (int i = 0; i < CHAT_EVENTS; ++i) {
+            if (!strcmp(row, eventNames[i]) && counts[i] < BOT_LINES) {
+                memcpy(lines[i][counts[i]++], text, len + 1);
+                break;
+            }
+        }
+    }
+    fclose(f);
+    if (!counts[CHAT_AMBIENT]) return;
+    strcpy(gatePath, gate);
+    rng = (uint32_t)(Persona_Now() * 1000000.0);
+#ifdef PLATFORM_POSIX
+    rng ^= (uint32_t)getpid();
+#endif
+    if (!rng) rng = 0x9e3779b9u;
+    enabled = 1;
+}
+void jkBotPersona_OnJoined(void)
+{
+    if (!enabled || !sithPlayer_g_pLocalPlayer) return;
+    lastKills = sithPlayer_g_pLocalPlayer->numKills;
+    lastDeaths = sithPlayer_g_pLocalPlayer->numKilled;
+    eventAt = Persona_Now(); nextChat = eventAt + phase;
+    pending = CHAT_SPAWN; joined = 1;
+}
+void jkBotPersona_Tick(float dt)
+{
+    (void)dt;
+    SithPlayer *player = sithPlayer_g_pLocalPlayer;
+    SithThing *thing = sithPlayer_g_pLocalPlayerThing;
+    if (!enabled || !joined || !player || !thing) return;
+    double now = Persona_Now();
+    if (player->numKilled > lastDeaths) { pending = CHAT_DEATH; eventAt = now; }
+    else if (player->numKills > lastKills) { pending = CHAT_KILL; eventAt = now; }
+    lastKills = player->numKills; lastDeaths = player->numKilled;
+    if (now < nextChat || (thing->flags & (SITH_TF_DEAD | SITH_TF_DISABLED | SITH_TF_DESTROYED))) return;
+    int event = pending;
+    if (event < 0 || (event != CHAT_SPAWN && now - eventAt > 25.0) || !counts[event]) event = CHAT_AMBIENT;
+    if (!Persona_Gate(now)) { nextChat = now + 5.0 + (Persona_Random() % 8); return; }
+    int choice = (int)(Persona_Random() % (uint32_t)counts[event]);
+    if (counts[event] > 1 && choice == lastLine[event]) choice = (choice + 1) % counts[event];
+    lastLine[event] = choice;
+    sithMulti_SendChat(lines[event][choice], -1, playerThingIdx);
+    printf("BOT_CHAT event=%s text=%s\n", eventNames[event], lines[event][choice]); fflush(stdout);
+    pending = -1;
+    nextChat = now + 90.0 + (Persona_Random() % 61);
+}
