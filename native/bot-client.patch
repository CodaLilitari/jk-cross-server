diff --git a/src/AI/jkBotBehavior.inc b/src/AI/jkBotBehavior.inc
new file mode 100644
index 0000000000000000000000000000000000000000..e09c9c993ae1e7d496e16f60f768150e2bd76882
--- /dev/null
+++ b/src/AI/jkBotBehavior.inc
@@ -0,0 +1,190 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT
+   Read-only observations of ordinary local game state. No game-rule writes. */
+static int Bot_EnemyBase(SithThing *self, int slot)
+{
+    if (slot<0 || slot>=(int)jkPlayer_maxPlayers || slot>=JKPLAYER_NUM_INFOS) return 0;
+    SithPlayer *p=&jkPlayer_playerInfos[slot]; SithThing *t=p->pLocalPlayer;
+    if (!(p->flags&1) || !p->playerNetId || !t || t==self ||
+        t->type!=SITH_THING_PLAYER || !t->sector ||
+        (t->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED))) return 0;
+    if (!Bot_CtfOpponent(self,slot)) return 0;
+    return !((sithNet_MultiModeFlags&MULTIMODEFLAG_TEAMS) && self->actorParams.pPlayer &&
+             p->teamNum==self->actorParams.pPlayer->teamNum);
+}
+static int Bot_PlayerSlot(SithThing *thing)
+{
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++)
+        if ((jkPlayer_playerInfos[i].flags&1) && jkPlayer_playerInfos[i].playerNetId &&
+            jkPlayer_playerInfos[i].pLocalPlayer==thing) return (int)i;
+    return -1;
+}
+static BotPeer *Bot_Peer(int slot)
+{
+    if (slot<0 || slot>=JKPLAYER_NUM_INFOS) return NULL;
+    SithPlayer *p=&jkPlayer_playerInfos[slot]; SithThing *t=p->pLocalPlayer;
+    BotPeer *peer=&bot.peers[slot];
+    if (!t || !p->playerNetId || !(p->flags&1)) { memset(peer,0,sizeof(*peer)); return NULL; }
+    if (peer->netId!=p->playerNetId || peer->guid!=t->guid || peer->signature!=t->signature) {
+        memset(peer,0,sizeof(*peer)); peer->netId=p->playerNetId;
+        peer->guid=t->guid; peer->signature=t->signature; peer->weapon=-1;
+    }
+    return peer;
+}
+static int Bot_NameEquals(const char *a, const char *b)
+{
+    if (!a || !b) return 0;
+    while (*a && *b && tolower((unsigned char)*a)==tolower((unsigned char)*b)) { a++; b++; }
+    return !*a && !*b;
+}
+/* curWeaponID is local inventory state. Only the normal synchronized weapon
+   mesh identifies a remote weapon. Armed mode 0 also includes explosives. */
+static int Bot_WeaponFromModel(const rdModel3 *model)
+{
+    static const char *models[]={"", "fistg.3do", "bryg.3do", "strg.3do", "detg.3do",
+        "bowg.3do", "rptg.3do", "rldg.3do", "seqg.3do", "cong.3do", "sabg.3do"};
+    if (!model) return -1;
+    for (int i=1;i<=10;i++) if (Bot_NameEquals(model->filename,models[i])) return i;
+    return -1;
+}
+static int Bot_IsPeaceful(SithThing *self, int slot)
+{
+    (void)self;
+    if (!bot.fistsPeace) return 0;
+    BotPeer *peer=Bot_Peer(slot);
+    if (!peer || peer->hostileUntil>bot.now) return 0;
+    SithThing *t=jkPlayer_playerInfos[slot].pLocalPlayer;
+    int weapon=t->playerInfo ? Bot_WeaponFromModel(t->playerInfo->rd_thing.model3) : -1;
+    return weapon==SITHBIN_FISTS || (weapon<0 && peer->seenWeapon && peer->weapon==SITHBIN_FISTS);
+}
+static void Bot_Provoke(SithThing *self, SithThing *source, const char *reason)
+{
+    int slot=Bot_PlayerSlot(source);
+    if (!bot.enabled || !bot.joined || !self || !Bot_EnemyBase(self,slot)) return;
+    BotPeer *p=Bot_Peer(slot); if (!p) return;
+    if (p->hostileUntil<=bot.now) {
+        fprintf(stderr,"BOT_PROVOKED name=%s net=%u reason=%s seconds=15\n",bot.name,p->netId,reason);
+        fflush(stderr);
+    }
+    p->hostileUntil=bot.now+15.0f; bot.nextScan=0; bot.hurtUntil=bot.now+2.5f;
+}
+void jkBot_ObserveDamage(SithThing *victim, SithThing *source, flex_t damage)
+{
+    if (!bot.enabled || !bot.joined || victim!=sithPlayer_g_pLocalPlayerThing ||
+        !isfinite(damage) || damage<=0) return;
+    /* Never blame the nearest player for a fall, self-hit, or recycled parent. */
+    for (int n=0;source && source->type!=SITH_THING_PLAYER && n<4;n++) {
+        if (!source->pParent || source->pParent==source ||
+            source->parentSignature!=source->pParent->signature) return;
+        source=source->pParent;
+    }
+    if (source && source->type==SITH_THING_PLAYER) Bot_Provoke(victim,source,"damage");
+}
+void jkBot_ObserveSkill(SithThing *victim, SithThing *source, int bin)
+{
+    if (!bot.enabled || !bot.joined || victim!=sithPlayer_g_pLocalPlayerThing) return;
+    if (bin==SITHBIN_F_PULL || bin==SITHBIN_F_BLINDING ||
+        (bin>=SITHBIN_F_THROW && bin<=SITHBIN_F_DEADLYSIGHT)) {
+        Bot_Provoke(victim,source,"force_target"); bot.forceThreatUntil=bot.now+5.0f;
+    }
+}
+void jkBot_ObserveProjectile(SithThing *shooter, const SithThing *projectile, const rdVector3 *direction)
+{
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (!bot.enabled || !bot.joined || !self || !shooter || !projectile || !direction ||
+        projectile->type!=SITH_THING_WEAPON || projectile->weaponParams.damage<=0 ||
+        !Bot_EnemyBase(self,Bot_PlayerSlot(shooter))) return;
+    rdVector3 delta=Bot_Sub(self->position,shooter->position);
+    flex_t distance=Bot_Len(delta), len=Bot_Len(*direction);
+    if (len<0.001f || distance>20.0f || !sithCollision_HasLOS(shooter,self,0)) return;
+    flex_t along=Bot_Dot(delta,*direction)/len;
+    flex_t miss2=Bot_Dot(delta,delta)-along*along;
+    flex_t margin=Bot_Max(0.16f,self->collideSize+0.08f);
+    if (along>0 && miss2<=margin*margin) {
+        int fist=0;
+#ifdef SITH_DEBUG_STRUCT_NAMES
+        fist=Bot_NameEquals(projectile->aName,"+punch");
+#else
+        /* The ordinary-client build retains template names. */
+        fist=projectile->weaponParams.damage>0 && Bot_Len(projectile->physicsParams.vel)<0.01f;
+#endif
+        if (!fist || distance<0.70f) Bot_Provoke(self,shooter,fist ? "punch_attempt" : "incoming_fire");
+    }
+}
+void jkBot_ObserveWeapon(SithThing *player, const rdModel3 *model)
+{
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (!bot.enabled || !bot.joined || !self || !player) return;
+    int slot=Bot_PlayerSlot(player), weapon=Bot_WeaponFromModel(model);
+    BotPeer *p=Bot_Peer(slot); if (!p || weapon<0) return;
+    if (p->pullPendingWeapon && weapon!=p->pullPendingWeapon) p->pullPendingWeapon=0;
+    if (p->pullWeapon && weapon!=p->pullWeapon) {
+        p->pullWeapon=0; p->pullRetryAt=p->pullRetryDelay=0;
+    }
+    if (p->seenWeapon && weapon!=p->weapon && Bot_EnemyBase(self,slot) &&
+        Bot_Distance(player->position,self->position)<3.0f && sithCollision_HasLOS(self,player,0)) {
+        if (bot.now-p->swapWindow>3.0f) { p->swapWindow=bot.now; p->swaps=0; }
+        if (++p->swaps>=4) Bot_Provoke(self,player,"rapid_weapon_swaps");
+    }
+    p->weapon=weapon; p->seenWeapon=1;
+}
+static void Bot_ObservePeers(SithThing *self)
+{
+    (void)self;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        BotPeer *p=Bot_Peer((int)i); if (!p) continue;
+        SithThing *t=jkPlayer_playerInfos[i].pLocalPlayer;
+        if (t->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED)) {
+            memset(p,0,sizeof(*p)); continue;
+        }
+        if (t->playerInfo) jkBot_ObserveWeapon(t,t->playerInfo->rd_thing.model3);
+        if (bot.now-p->lastBlock>0.25f) p->blockSince=0;
+    }
+}
+static void Bot_ObserveBlock(SithThing *self, rdVector3 wanted)
+{
+    if (!bot.fistsPeace || Bot_Horizontal(self->physicsParams.vel)>0.15f) return;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        if (!Bot_EnemyBase(self,(int)i) || !Bot_IsPeaceful(self,(int)i)) continue;
+        SithThing *t=jkPlayer_playerInfos[i].pLocalPlayer;
+        rdVector3 delta=Bot_Sub(t->position,self->position);
+        flex_t d=Bot_Horizontal(delta), limit=self->collideSize+t->collideSize+0.12f;
+        if (d<0.01f || d>limit || fabsf(delta.z)>0.20f ||
+            Bot_Dot(delta,wanted)/d<0.70f || !sithCollision_HasLOS(self,t,0)) continue;
+        BotPeer *p=Bot_Peer((int)i); if (!p) continue;
+        if (!p->blockSince || bot.now-p->lastBlock>0.25f) p->blockSince=bot.now;
+        p->lastBlock=bot.now;
+        if (bot.now-p->blockSince>=3.0f) Bot_Provoke(self,t,"persistent_body_block");
+    }
+}
+/* The manager atomically replaces this complete file. Bad edits keep old values. */
+static int Bot_ReadBehavior(FILE *file, int *sabers, int *peace, int *force)
+{
+    char row[128]; unsigned seen=0; int values[4]={0}, rows=0;
+    while (fgets(row,sizeof(row),file)) {
+        if (++rows>16) return 0;
+        size_t n=strlen(row); if (!n || (row[n-1]!='\n' && !feof(file))) return 0;
+        while (n && (row[n-1]=='\n' || row[n-1]=='\r')) row[--n]=0;
+        if (!n) continue;
+        char *eq=strchr(row,'='); if (!eq) return 0; *eq++=0;
+        int k=Bot_NameEquals(row,"version") ? 0 : Bot_NameEquals(row,"sabers_only") ? 1 :
+            Bot_NameEquals(row,"fists_peace") ? 2 : Bot_NameEquals(row,"force_enabled") ? 3 : -1;
+        if (k<0 || (seen&(1u<<k)) || (strcmp(eq,"0") && strcmp(eq,"1"))) return 0;
+        values[k]=*eq-'0'; seen|=1u<<k;
+    }
+    if (ferror(file) || seen!=15 || values[0]!=1) return 0;
+    *sabers=values[1]; *peace=values[2]; *force=values[3]; return 1;
+}
+static void Bot_ReloadBehavior(void)
+{
+    bot.nextBehavior=bot.now+1.0f;
+    if (!*bot.behaviorFile) return;
+    FILE *f=fopen(bot.behaviorFile,"r"); if (!f) return;
+    int saber,peace,force; int ok=Bot_ReadBehavior(f,&saber,&peace,&force); fclose(f);
+    if (!ok) return;
+    if (saber!=bot.sabersOnly || peace!=bot.fistsPeace || force!=bot.forceEnabled) {
+        bot.sabersOnly=saber; bot.fistsPeace=peace; bot.forceEnabled=force;
+        bot.nextSelect=bot.nextScan=bot.nextPlan=0; bot.goal=-1;
+        fprintf(stderr,"BOT_BEHAVIOR name=%s sabers_only=%d fists_peace=%d force_enabled=%d\n",bot.name,saber,peace,force);
+        fflush(stderr);
+    }
+}
diff --git a/src/AI/jkBotCombat.inc b/src/AI/jkBotCombat.inc
new file mode 100644
index 0000000000000000000000000000000000000000..0cac724a544d2c8e141c7810172ea98b0dffa493
--- /dev/null
+++ b/src/AI/jkBotCombat.inc
@@ -0,0 +1,348 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT */
+#include "Primitives/rdMatrix.h"
+
+static int Bot_CombatJumpRecoilGun(int weapon)
+{
+    return weapon==SITHBIN_CONCUSSION_RIFLE || weapon==SITHBIN_RAIL_DETONATOR;
+}
+
+static int Bot_HasWeapon(SithThing *self, int weapon)
+{
+    if (!sithInventory_IsInventoryAvailable(self,weapon) || sithInventory_GetInventory(self,weapon)<=0) return 0;
+    switch (weapon) {
+        case SITHBIN_BRYARPISTOL: case SITHBIN_STORMTROOPER_RIFLE:
+            return sithInventory_GetInventory(self,SITHBIN_ENERGY)>=1;
+        case SITHBIN_TUSKEN_PROD: return sithInventory_GetInventory(self,SITHBIN_POWER)>=2;
+        case SITHBIN_REPEATER: return sithInventory_GetInventory(self,SITHBIN_POWER)>=1;
+        case SITHBIN_CONCUSSION_RIFLE: return sithInventory_GetInventory(self,SITHBIN_POWER)>=8;
+        case SITHBIN_RAIL_DETONATOR: return sithInventory_GetInventory(self,SITHBIN_RAILCHARGES)>=1;
+        default: return 1;
+    }
+}
+static int Bot_ProtectedPlayer(SithThing *self, int slot)
+{
+    SithPlayer *p=&jkPlayer_playerInfos[slot]; SithThing *t=p->pLocalPlayer;
+    if (!(p->flags&1) || !p->playerNetId || !t || t==self || t->type!=SITH_THING_PLAYER ||
+        (t->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED))) return 0;
+    return !Bot_EnemyBase(self,slot) || Bot_IsPeaceful(self,slot);
+}
+static int Bot_ProtectedNear(SithThing *self, rdVector3 position, flex_t radius)
+{
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++)
+        if (Bot_ProtectedPlayer(self,(int)i) &&
+            Bot_Distance(position,jkPlayer_playerInfos[i].pLocalPlayer->position)<radius) return 1;
+    return 0;
+}
+static int Bot_SafeLine(SithThing *self, SithThing *target, rdVector3 aim, flex_t spread, flex_t radius)
+{
+    rdVector3 line=Bot_Sub(aim,self->position); flex_t length=Bot_Len(line);
+    if (!target || length<0.01f || !Bot_KineticEnemyAllowed(self,Bot_PlayerSlot(target))) return 0;
+    if (!Bot_Clear(self,self->sector,self->position,aim,radius,1)) return 0;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        if (!Bot_ProtectedPlayer(self,(int)i)) continue;
+        SithThing *peer=jkPlayer_playerInfos[i].pLocalPlayer;
+        rdVector3 delta=Bot_Sub(peer->position,self->position);
+        flex_t along=Bot_Dot(delta,line)/length;
+        flex_t width=peer->collideSize+0.12f+along*spread;
+        if (along>0 && along<length+0.2f &&
+            Bot_Dot(delta,delta)-along*along<width*width) return 0;
+    }
+    return 1;
+}
+static int Bot_SafeShot(SithThing *self, SithThing *target, rdVector3 aim, flex_t splash, flex_t spread)
+{
+    if (splash>0 && (!target || Bot_Distance(self->position,aim)<splash+0.4f ||
+        Bot_ProtectedNear(self,target->position,splash+0.3f))) return 0;
+    return Bot_SafeLine(self,target,aim,spread,0.015f);
+}
+
+typedef struct BotGunShot {
+    rdVector3 aim;
+    flex_t blast, radius, flight, muzzleRight;
+    SithThing *beam;
+    int floorAim;
+} BotGunShot;
+
+static rdVector3 Bot_PredictedPosition(const SithThing *thing, flex_t flight)
+{
+    rdVector3 p=thing->position;
+    p.x+=thing->physicsParams.vel.x*flight;
+    p.y+=thing->physicsParams.vel.y*flight;
+    p.z+=Bot_Clamp(thing->physicsParams.vel.z*flight,-0.12f,0.12f);
+    return isfinite(p.x) && isfinite(p.y) && isfinite(p.z) ? p : thing->position;
+}
+
+static BotGunShot Bot_PlanGunShot(SithThing *self, SithThing *target, int weapon)
+{
+    static const char *names[]={"", "", "+bryarbolt", "+stlaser", "", "+crossbowbolt3",
+        "+repeaterball", "+raildet", "", "+concbullet", ""};
+    BotGunShot shot={.aim=target->position,.radius=0.015f};
+    if (weapon<2 || weapon>9 || !*names[weapon]) return shot;
+    SithThing *projectile=sithTemplate_GetTemplate(names[weapon]);
+    int explosive=weapon==SITHBIN_CONCUSSION_RIFLE || weapon==SITHBIN_RAIL_DETONATOR;
+    if (explosive) {
+        shot.blast=-1; /* Unknown mod template: do not authorize the primary. */
+        if (!projectile) return shot;
+        SithThing *wall=projectile->weaponParams.pExplosionTemplate;
+        SithThing *body=projectile->weaponParams.fleshHitTemplate;
+        if (!wall || !body || wall->type!=SITH_THING_EXPLOSION || body->type!=SITH_THING_EXPLOSION ||
+            !isfinite(wall->explosionParams.range) || !isfinite(body->explosionParams.range)) return shot;
+        shot.blast=Bot_Max(wall->explosionParams.range,body->explosionParams.range);
+        if (shot.blast<=0) { shot.blast=-1; return shot; }
+        shot.radius=projectile->moveSize;
+        shot.muzzleRight=weapon==SITHBIN_CONCUSSION_RIFLE ? 0.0200f : 0.0214f;
+    }
+    flex_t speed=projectile ? Bot_Len(projectile->physicsParams.vel) : 0;
+    if (!(speed>0.1f) || !isfinite(speed) || !(shot.radius>=0) || !isfinite(shot.radius)) {
+        if (explosive) shot.blast=-1;
+        return shot;
+    }
+    /* WSRelay publishes synchronized pose and velocity together. Only the
+       projectile's future flight needs lead. Bound prediction on direction changes. */
+    flex_t horizon=explosive ? 0.65f : 0.35f;
+    shot.flight=Bot_Min(horizon,Bot_Distance(self->position,target->position)/speed);
+    rdVector3 lead=Bot_PredictedPosition(target,shot.flight);
+    if (explosive) {
+        shot.flight=Bot_Min(horizon,Bot_Distance(self->position,lead)/speed);
+        lead=Bot_PredictedPosition(target,shot.flight);
+        if (!Bot_Clear(NULL,target->sector,target->position,lead,target->moveSize,1))
+            lead=target->position; /* No prediction through solid terrain. */
+    }
+    if (Bot_Clear(self,self->sector,self->position,lead,shot.radius,1)) shot.aim=lead;
+    if (weapon==SITHBIN_CONCUSSION_RIFLE) {
+        rdVector3 probe=lead, floor; SithSector *sector;
+        probe.z+=0.025f;
+        if (Bot_Floor(probe,target->sector,shot.blast*0.45f+0.025f,&floor,&sector)) {
+            /* Bot_Floor returns a standing center. Aim at the shell's contact
+               height, including clearance on the walkable slopes it accepted. */
+            floor.z+=2*shot.radius+0.001f-BOT_FOOT_HEIGHT;
+            if (floor.z<self->position.z && Bot_Clear(self,self->sector,self->position,floor,shot.radius,1)) {
+                shot.aim=floor; shot.floorAim=1;
+            }
+        }
+    }
+    return shot;
+}
+
+/* With a low-angle floor shot, a small pitch error can carry the shell
+   well past the target even when the normal gun's angular tolerance passes. */
+static int Bot_FloorAimAligned(SithThing *self,const BotGunShot *shot)
+{
+    if (!shot->floorAim) return 1;
+    flex_t slope=tanf(self->actorParams.headPYR.x/BOT_DEG);
+    if (slope>=-0.0001f) return 0;
+    rdVector3 line=Bot_Sub(shot->aim,self->position);
+    return fabsf(line.z/slope-Bot_Horizontal(line))<=shot->blast*0.5f;
+}
+
+/* Mirror the first-impact query without spawning a projectile. The weapon
+   collision profile and its parent matter for actors, doors and moving lifts. */
+static int Bot_BeamHits(SithThing *self,SithThing *target,const SithThing *beam,rdVector3 direction)
+{
+    flex_t length=Bot_Len(direction);
+    if (!self->sector || !(length>0.001f)) return 0;
+    direction.x/=length; direction.y/=length; direction.z/=length;
+    SithThing probe=*beam;
+    probe.pParent=self; probe.parentSignature=self->signature;
+    probe.position=self->position; probe.sector=self->sector;
+    sithCollision_SearchForCollisions(self->sector,&probe,&self->position,&direction,
+        beam->weaponParams.range,beam->moveSize,0);
+    SithCollision *hit;
+    do { hit=sithCollision_PopStack(); } while (hit && (hit->type&SITHCOLLISION_ADJOINCROSS));
+    int reaches=hit && (hit->type&SITHCOLLISION_THING) && hit->pThingCollided==target;
+    sithCollision_DecreaseStackLevel();
+    return reaches;
+}
+
+static int Bot_GunSafe(SithThing *self, SithThing *target, const BotGunShot *shot, flex_t spread)
+{
+    if (shot->beam)
+        return Bot_KineticEnemyAllowed(self,Bot_PlayerSlot(target)) &&
+            Bot_BeamHits(self,target,shot->beam,Bot_Sub(shot->aim,self->position));
+    if (shot->blast<0) return 0;
+    if (!shot->blast) return Bot_SafeShot(self,target,shot->aim,0,spread);
+    rdVector3 line=Bot_Sub(shot->aim,self->position);
+    flex_t length=Bot_Len(line), horizontal=Bot_Horizontal(line);
+    if (length<=shot->blast+self->collideSize || horizontal<0.001f) return 0;
+    /* Stock primaries spawn 0.15 forward and slightly right. A thin piece
+       of level geometry may block this path even when the camera can see. */
+    rdVector3 end=shot->aim;
+    end.x+=shot->muzzleRight*line.y/horizontal;
+    end.y-=shot->muzzleRight*line.x/horizontal;
+    rdVector3 muzzle=Bot_Mix(self->position,shot->aim,0.15f/length);
+    muzzle.x+=end.x-shot->aim.x; muzzle.y+=end.y-shot->aim.y;
+    SithSector *sector=Bot_SectorAt(&muzzle,self->sector);
+    if (!sector || !Bot_Clear(self,self->sector,self->position,muzzle,shot->radius,1) ||
+        !Bot_Clear(self,sector,muzzle,end,shot->radius,1)) return 0;
+    for (int slot=-1;slot<(int)jkPlayer_maxPlayers && slot<JKPLAYER_NUM_INFOS;slot++) {
+        if (slot>=0 && !Bot_ProtectedPlayer(self,slot)) continue;
+        SithThing *p=slot<0 ? self : jkPlayer_playerInfos[slot].pLocalPlayer;
+        flex_t limit=shot->blast+p->collideSize+shot->radius;
+        if (Bot_Distance(p->position,end)<=limit || Bot_Distance(p->position,target->position)<=limit ||
+            Bot_Distance(Bot_PredictedPosition(p,shot->flight),end)<=limit) return 0;
+    }
+    return Bot_SafeLine(self,target,shot->aim,spread,shot->radius);
+}
+
+/* The stock concussion secondary starts at the shooter and stops at the
+   first hit. Its template supplies range and radius. It has no blast and
+   needs no projectile lead. The COG checks eight cells for either mode. */
+static BotGunShot Bot_ChooseGunShot(SithThing *self,SithThing *target,int weapon)
+{
+    BotGunShot primary=Bot_PlanGunShot(self,target,weapon);
+    if (!bot.elite || weapon!=SITHBIN_CONCUSSION_RIFLE) return primary;
+    SithThing *beam=sithTemplate_GetTemplate("+concblast2");
+    if (!beam || beam->type!=SITH_THING_WEAPON || !(beam->weaponParams.flags&SITH_WF_INSTANT_IMPACT) ||
+        beam->weaponParams.pExplosionTemplate || !(beam->weaponParams.damage>0) ||
+        !isfinite(beam->weaponParams.range) || !isfinite(beam->moveSize) || beam->moveSize<0 ||
+        Bot_Distance(self->position,target->position)>beam->weaponParams.range) return primary;
+    /* A safe floor blast remains useful against a grounded, predictable target.
+       Prefer the beam for a direct or crossing shot, unsafe splash, or a low cell reserve. */
+    if (primary.floorAim && sithInventory_GetInventory(self,SITHBIN_POWER)>=16 &&
+        Bot_Distance(Bot_PredictedPosition(target,primary.flight),target->position)<=target->collideSize &&
+        Bot_GunSafe(self,target,&primary,0.02f)) return primary;
+    BotGunShot direct={.aim=target->position,.radius=beam->moveSize,.beam=beam};
+    return beam->weaponParams.range>0 && Bot_GunSafe(self,target,&direct,0.02f) ? direct : primary;
+}
+
+/* In a gun match, draw a blade for contact that should still be there after
+   a short approach. Bolt defense is useful a little farther out when both
+   players face one another and the opponent actually holds a light blaster. */
+static int Bot_CloseSaberOpportunity(SithThing *self,SithThing *target,flex_t distance)
+{
+    if (!target || distance>0.45f || !self->sector || !target->sector ||
+        ((self->sector->flags|target->sector->flags)&SITH_SECTOR_UNDERWATER)) return 0;
+    rdVector3 delta=Bot_Sub(target->position,self->position);
+    flex_t body=Bot_Clamp(self->collideSize+target->collideSize,0.08f,0.20f);
+    if (fabsf(delta.z)>body || !sithCollision_HasLOS(self,target,0)) return 0;
+    flex_t reach=body+0.10f;
+    int enemyGun=target->playerInfo ? Bot_WeaponFromModel(target->playerInfo->rd_thing.model3) : -1;
+    /* Splash weapons give no bolt-defense reason to draw or pursue. */
+    if (enemyGun==SITHBIN_CONCUSSION_RIFLE || enemyGun==SITHBIN_RAIL_DETONATOR) return 0;
+    if ((enemyGun==SITHBIN_BRYARPISTOL || enemyGun==SITHBIN_STORMTROOPER_RIFLE) &&
+        Bot_Dot(target->orient.lvec,delta)<-0.75f*distance &&
+        Bot_Dot(self->orient.lvec,delta)>0.5f*distance) reach+=0.12f;
+    if (distance>reach) return 0;
+    rdVector3 relative=Bot_Sub(target->physicsParams.vel,self->physicsParams.vel);
+    rdVector3 future={delta.x+0.25f*relative.x,delta.y+0.25f*relative.y,delta.z+0.25f*relative.z};
+    return fabsf(future.z)<=body && Bot_Len(future)<=reach+0.025f;
+}
+
+static void Bot_FireGunShot(SithThing *self,SithThing *target,int weapon,
+                            const BotGunShot *shot,flex_t error,flex_t distance)
+{
+    if (weapon<SITHBIN_FISTS || weapon>SITHBIN_LIGHTSABER || weapon==SITHBIN_THERMAL_DETONATOR ||
+        weapon==SITHBIN_SEQUENCER_CHARGE || (bot.sabersOnly && weapon!=SITHBIN_LIGHTSABER) ||
+        (nav.combatJumpUntil>bot.now && Bot_CombatJumpRecoilGun(weapon)) ||
+        bot.now<bot.reactionUntil || !Bot_HasWeapon(self,weapon)) return;
+    int melee=weapon==SITHBIN_FISTS || weapon==SITHBIN_LIGHTSABER;
+    if (melee && distance>=0.60f) return;
+    if (weapon==SITHBIN_TUSKEN_PROD && Bot_ProtectedNear(self,self->position,8.0f)) return;
+    flex_t tolerance=melee ? 12.0f : distance>5.0f ? 3.5f : 6.0f;
+    if (shot->beam)
+        tolerance=Bot_Min(0.8f,atan2f(target->collideSize*0.5f,distance)*BOT_DEG);
+    if (shot->blast>0) tolerance=Bot_Min(tolerance,atan2f(shot->blast*0.22f,distance)*BOT_DEG);
+    if (error>=tolerance || !Bot_FloorAimAligned(self,shot) ||
+        !Bot_GunSafe(self,target,shot,weapon==SITHBIN_STORMTROOPER_RIFLE ? 0.06f : 0.02f)) return;
+    if (shot->beam) {
+        rdMatrix34 aim=self->orient;
+        rdMatrix_PreRotate34(&aim,&self->actorParams.headPYR);
+        if (!Bot_BeamHits(self,target,shot->beam,aim.lvec)) return;
+    }
+    if (weapon==SITHBIN_STORMTROOPER_RIFLE && distance>3.0f && fmodf(bot.now,1.1f)>=0.38f) return;
+    /* Bow primary releases a shot even on an ordinary key-up. Use its
+       immediate secondary throughout so a lost target cannot fire that release. */
+    int alternate=shot->beam!=NULL || weapon==SITHBIN_TUSKEN_PROD;
+    if (weapon==SITHBIN_REPEATER && distance<1.4f && sithInventory_GetInventory(self,SITHBIN_POWER)>=3) {
+        /* Three rounds instead of one land together only at close range. The
+           farthest bolt is four degrees off center, with a 0.0186 muzzle offset. */
+        flex_t spreadRadius=0.019f+distance*tanf((4.0f+1.415f*error)/BOT_DEG);
+        alternate=(!bot.elite || spreadRadius<=target->collideSize) &&
+            Bot_SafeShot(self,target,shot->aim,0,0.12f);
+    }
+    if (weapon==SITHBIN_LIGHTSABER && bot.elite && !bot.sabersOnly) {
+        /* Pressing either trigger disables stock autoblock. Hold guard when
+           outside ordinary contact, including while closing on a light blaster. */
+        flex_t contact=Bot_Clamp(self->collideSize+target->collideSize,0.08f,0.20f)+0.10f;
+        if (distance>contact) return;
+        alternate=(target->actorParams.flags&SITH_AF_IMMOBILE) && self->attach_flags &&
+            (!self->puppet || self->puppet->majorMode!=5) && !(self->physicsParams.flags&SITH_PF_ONWATERSURFACE) &&
+            Bot_CloseSaberOpportunity(self,target,distance) && !Bot_ProtectedNear(self,self->position,0.65f);
+    }
+    /* Release the old mode for one control frame. The stock handler checks
+       secondary before primary and may otherwise reactivate both on a swap. */
+    if (!bot.previous[alternate ? INPUT_FUNC_FIRE1 : INPUT_FUNC_FIRE2])
+        bot.keys[alternate ? INPUT_FUNC_FIRE2 : INPUT_FUNC_FIRE1]=1;
+}
+
+/* Log only changes in the final attack input, after Force and navigation
+   have had their say. This records a requested mode, not a shot or a hit. */
+static void Bot_TraceFireInput(SithThing *self)
+{
+    if (!bot.traceForce || bot.now<bot.nextFireTrace ||
+        (!bot.keys[INPUT_FUNC_FIRE1] && !bot.keys[INPUT_FUNC_FIRE2])) return;
+    int weapon=sithInventory_GetCurrentWeapon(self), alternate=!!bot.keys[INPUT_FUNC_FIRE2];
+    int mode=weapon*2+alternate;
+    if (mode==bot.tracedFireMode) return;
+    bot.tracedFireMode=mode; bot.nextFireTrace=bot.now+0.50f;
+    fprintf(stderr,"BOT_FIRE_INPUT name=%s t=%.2f weapon=%d alternate=%d\n",
+            bot.name,(double)bot.now,weapon,alternate);
+    fflush(stderr);
+}
+
+static int Bot_SelectWeapon(SithThing *self, flex_t distance)
+{
+    int chosen=0, current=sithInventory_GetCurrentWeapon(self);
+    flex_t best=-1e9f;
+    SithThing *target=Bot_KineticEnemyAllowed(self,bot.targetSlot) ? jkPlayer_playerInfos[bot.targetSlot].pLocalPlayer : NULL;
+    int guns=bot.elite && !bot.sabersOnly && !(companion.policy.mode && companion.policy.weapon);
+    int readyHeavy=guns && !target && (Bot_HasWeapon(self,SITHBIN_CONCUSSION_RIFLE) ||
+                                       Bot_HasWeapon(self,SITHBIN_RAIL_DETONATOR));
+    if (!target && !readyHeavy && !(nav.combatJumpUntil>bot.now && Bot_CombatJumpRecoilGun(current)) &&
+        !bot.sabersOnly && current>=SITHBIN_BRYARPISTOL && current<=SITHBIN_CONCUSSION_RIFLE &&
+        !(guns && current==SITHBIN_BRYARPISTOL) && current!=SITHBIN_THERMAL_DETONATOR && current!=SITHBIN_SEQUENCER_CHARGE &&
+        (!companion.policy.mode || !companion.policy.weapon || companion.policy.weapon==current) &&
+        Bot_HasWeapon(self,current)) return current;
+    for (int weapon=1;weapon<=10;weapon++) {
+        if ((nav.combatJumpUntil>bot.now && Bot_CombatJumpRecoilGun(weapon)) ||
+            !Bot_HasWeapon(self,weapon) || (bot.sabersOnly && weapon!=SITHBIN_LIGHTSABER)) continue;
+        /* Mines/hand grenades need authored traps and ballistic arcs; do not
+           blindly drop them in crowds. All ordinary guns have a policy below. */
+        if (weapon==SITHBIN_THERMAL_DETONATOR || weapon==SITHBIN_SEQUENCER_CHARGE) continue;
+        flex_t score=0;
+        switch (weapon) {
+            case SITHBIN_FISTS: score=distance<0.25f ? 12 : -20; break;
+            case SITHBIN_LIGHTSABER:
+                if (guns) score=Bot_CloseSaberOpportunity(self,target,distance) ? 95 : 20;
+                else score=distance<0.60f ? 95 : distance<1.0f ? 55 : 5;
+                break;
+            case SITHBIN_BRYARPISTOL: score=!guns && distance>4.0f ? 55 : 32; break;
+            case SITHBIN_STORMTROOPER_RIFLE: score=distance<3.5f ? 63 : 40; break;
+            case SITHBIN_REPEATER: score=distance<2.0f ? 77 : distance<4 ? 60 : 35; break;
+            case SITHBIN_TUSKEN_PROD:
+                score=distance>2 && distance<7 ? 65 : 45;
+                if (guns && target && Bot_ProtectedNear(self,self->position,8.0f)) score=24;
+                break;
+            case SITHBIN_CONCUSSION_RIFLE: score=88; break;
+            case SITHBIN_RAIL_DETONATOR:
+                score=guns ? (distance<9 ? 85 : 66) : (distance<9 ? 72 : 35);
+                break;
+        }
+        if (companion.policy.mode && companion.policy.weapon==weapon && score>0)
+            score+=24.0f;
+        if (weapon==SITHBIN_CONCUSSION_RIFLE || weapon==SITHBIN_RAIL_DETONATOR) {
+            if (target) {
+                BotGunShot shot=Bot_ChooseGunShot(self,target,weapon);
+                if (!Bot_GunSafe(self,target,&shot,guns ? 0.02f : 0)) continue;
+            } else if (!readyHeavy) continue;
+        }
+        /* Keep range boundaries stable, but let the starter pistol yield
+           as soon as an available, safe upgrade can be equipped. */
+        if (weapon==current && !(guns && weapon==SITHBIN_BRYARPISTOL)) score+=7;
+        if (score>best) { best=score; chosen=weapon; }
+    }
+    if (chosen && current!=chosen && bot.now>=bot.nextSelect) {
+        bot.keys[INPUT_FUNC_SELECT1+chosen-1]=1; bot.nextSelect=bot.now+0.8f;
+    }
+    return current;
+}
diff --git a/src/AI/jkBotCompanion.inc b/src/AI/jkBotCompanion.inc
new file mode 100644
index 0000000000000000000000000000000000000000..b890dc5fffb846c348790f8ab5376dfe5dbd4b9a
--- /dev/null
+++ b/src/AI/jkBotCompanion.inc
@@ -0,0 +1,421 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT
+   Private local companion transport. The ordinary game protocol is unchanged. */
+#include "Dss/sithMulti.h"
+#include <errno.h>
+#include <limits.h>
+#include <time.h>
+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+#elif !defined(PLATFORM_POSIX) && defined(SDL2_RENDER)
+#include <SDL_timer.h>
+#endif
+#ifdef PLATFORM_POSIX
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+enum { CP_STATE=1, CP_ACK, CP_CHAT, CP_SOUND, CP_OFFERS, CP_PROGRESS, CP_SENSE, CP_STRATEGY=16, CP_SAY, CP_RELEASE, CP_COMMIT, CP_MOTOR };
+enum { CP_APPLIED, CP_REJECTED, CP_EXPIRED, CP_STALE, CP_RATE };
+enum { CP_OK, CP_INVALID, CP_UNAVAILABLE, CP_OBSOLETE, CP_RESERVED, CP_TOO_FAST, CP_TOO_LATE };
+enum { CP_AUTO, CP_PRESSURE, CP_RESOURCE, CP_RECOVER };
+
+typedef struct CompanionPolicy {
+    double until;
+    int mode, weapon, resource;
+    float range, risk;
+    uint32_t net, guid, signature;
+} CompanionPolicy;
+
+typedef struct CompanionReply {
+    uint32_t sequence;
+    unsigned char kind, status, reason, length;
+    unsigned char request[118]; /* largest well-formed command: SAY */
+} CompanionReply;
+
+static struct {
+    int fd, identified, dead;
+    uint32_t world, life, eventSeq, highest, net, guid, signature, thing;
+    int slot;
+    double nextState, nextChat;
+    uint32_t drops;
+    flex_t heardAt;
+    rdVector3 heardPosition;
+    int heardKind, hasPursuit;
+    rdVector3 pursuitAt;
+    flex_t pursuitTime;
+    int (*emit)(const uint8_t *,size_t);
+    unsigned queueRead, queueCount;
+    struct { unsigned short length; unsigned char data[512]; } queue[16];
+    double now;
+    CompanionPolicy policy;
+    CompanionReply replies[64];
+} companion = {.fd=-1};
+
+static int Companion_Connected(void) { return companion.fd>=0 || companion.emit!=NULL; }
+static double Companion_Clock(void)
+{
+#if defined(__EMSCRIPTEN__)
+    return emscripten_get_now()/1000.0;
+#elif defined(PLATFORM_POSIX)
+    struct timespec t;
+    if (clock_gettime(CLOCK_MONOTONIC,&t)==0) return t.tv_sec+t.tv_nsec/1e9;
+#elif defined(SDL2_RENDER)
+    uint64_t frequency=SDL_GetPerformanceFrequency();
+    if (frequency) return (double)SDL_GetPerformanceCounter()/frequency;
+#endif
+    return -1;
+}
+static int Bot_EnemyAllowed(SithThing *self, int slot);
+static int Bot_PlayerSlot(SithThing *thing);
+
+static void Companion_ResetPlan(void)
+{
+    if (companion.policy.mode) {
+        bot.goal=-1;
+        bot.nextPlan=bot.nextScan=bot.nextSelect=0;
+    }
+    companion.policy=(CompanionPolicy){0};
+}
+static uint32_t Companion_Next(uint32_t n) { return n==UINT32_MAX ? 1 : n+1; }
+
+static void Companion_NewWorld(void)
+{
+    Lily_NewFence(3);
+    if (!Companion_Connected()) return;
+    Companion_ResetPlan();
+    companion.world=Companion_Next(companion.world);
+    companion.life=1; companion.nextState=0;
+    companion.identified=companion.heardKind=companion.hasPursuit=0;
+    companion.highest=0;
+    memset(companion.replies,0,sizeof(companion.replies));
+}
+
+static void Companion_Configure(void)
+{
+#ifdef PLATFORM_POSIX
+    const char *arg=getenv("JK_BOT_COMPANION_FD");
+    int fd=-1;
+    if (arg && *arg>='0' && *arg<='9') {
+        char *end;
+        long value=strtol(arg,&end,10);
+        if (!*end && value>=3 && value<=INT_MAX) fd=(int)value;
+    }
+    if (companion.fd>=0 && companion.fd!=fd) close(companion.fd);
+    int (*emit)(const uint8_t *,size_t)=companion.emit;
+    memset(&companion,0,sizeof(companion)); companion.fd=-1; companion.emit=emit;
+    struct sockaddr_storage peer;
+    socklen_t length=sizeof(peer), size=sizeof(int);
+    int type=0;
+    if (fd<0 || getsockopt(fd,SOL_SOCKET,SO_TYPE,&type,&size)<0 || type!=SOCK_DGRAM ||
+        getpeername(fd,(struct sockaddr *)&peer,&length)<0 || peer.ss_family!=AF_UNIX) return;
+    int fl=fcntl(fd,F_GETFL), fdFlags=fcntl(fd,F_GETFD);
+    if (fl<0 || fdFlags<0 || fcntl(fd,F_SETFL,fl|O_NONBLOCK)<0 ||
+        fcntl(fd,F_SETFD,fdFlags|FD_CLOEXEC)<0) return;
+    companion.fd=fd;
+#endif
+}
+
+void jkBotCompanion_SetTransport(int (*emit)(const uint8_t *,size_t))
+{
+    if (companion.emit==emit) return;
+    Lily_NewFence(7);
+    Companion_ResetPlan();
+    companion.identified=0;
+    companion.queueRead=companion.queueCount=0;
+    companion.emit=emit;
+    if (Companion_Connected() && bot.joined && bot.world) Companion_NewWorld();
+}
+
+int jkBotCompanion_Receive(const uint8_t *data,size_t size)
+{
+    if (!companion.emit || !data || size<20 || size>512 || companion.queueCount>=16) return 0;
+    unsigned at=(companion.queueRead+companion.queueCount)%16;
+    companion.queue[at].length=(unsigned short)size;
+    memcpy(companion.queue[at].data,data,size);
+    companion.queueCount++;
+    return 1;
+}
+
+static uint32_t Companion_Word(const unsigned char *p)
+{
+    return p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);
+}
+static void Companion_Put(unsigned char *p,uint32_t value)
+{
+    p[0]=(unsigned char)value; p[1]=(unsigned char)(value>>8);
+    p[2]=(unsigned char)(value>>16); p[3]=(unsigned char)(value>>24);
+}
+static float Companion_Float(const unsigned char *p)
+{
+    uint32_t bits=Companion_Word(p); float value;
+    memcpy(&value,&bits,4); return value;
+}
+static void Companion_PutFloat(unsigned char *p,float value)
+{
+    uint32_t bits; memcpy(&bits,&value,4); Companion_Put(p,bits);
+}
+static void Companion_Vector(unsigned char *p,rdVector3 pos)
+{
+    Companion_PutFloat(p,pos.x); Companion_PutFloat(p+4,pos.y); Companion_PutFloat(p+8,pos.z);
+}
+static void Companion_Send(int kind,uint32_t world,uint32_t life,uint32_t seq,
+                           const unsigned char *payload,int length)
+{
+    if (!Companion_Connected()) return;
+    unsigned char frame[512]={'J','K','C','P',1};
+    frame[5]=kind; frame[6]=length; frame[7]=length>>8;
+    Companion_Put(frame+8,world); Companion_Put(frame+12,life); Companion_Put(frame+16,seq);
+    memcpy(frame+20,payload,length);
+    if (companion.emit) {
+        if (!companion.emit(frame,(size_t)(20+length))) companion.drops++;
+        return;
+    }
+#ifdef PLATFORM_POSIX
+    if (send(companion.fd,frame,20+length,MSG_DONTWAIT)<0) {
+        companion.drops++;
+        if (errno==ECONNREFUSED || errno==EPIPE || errno==ENOTCONN) {
+            close(companion.fd); companion.fd=-1; Companion_ResetPlan();
+        }
+    }
+#endif
+}
+static void Companion_Event(int kind,const unsigned char *p,int length)
+{
+    companion.eventSeq=Companion_Next(companion.eventSeq);
+    Companion_Send(kind,companion.world,companion.life,companion.eventSeq,p,length);
+}
+
+static int Companion_Reserved(const unsigned char *p,int length)
+{
+    while (length && *p==' ') { p++; length--; }
+    return length>=5 && tolower(p[0])=='a' && tolower(p[1])=='d' && tolower(p[2])=='m' &&
+        tolower(p[3])=='i' && tolower(p[4])=='n' && (length==5 || p[5]==' ');
+}
+static int Companion_Printable(const unsigned char *p,int length)
+{
+    if (length<1 || length>110) return 0;
+    for (int i=0;i<length;i++) if (p[i]<32 || p[i]>126) return 0;
+    return 1;
+}
+/* Called only after ordinary game-message validation. Authoritative local
+   transport sender must agree with the claimed player slot. */
+void jkBot_ObserveChat(int destination,int slot,uint32_t sender,const char *text)
+{
+    if (!Companion_Connected() || !companion.identified || !bot.joined || !sithNet_isMulti ||
+        (g_submodeFlags&8) || bot.world!=sithWorld_g_pCurrentWorld || destination!=-1 || slot<0 ||
+        slot>=JKPLAYER_NUM_INFOS || (unsigned)slot>=jkPlayer_maxPlayers || !sender || !text) return;
+    SithPlayer *speaker=&jkPlayer_playerInfos[slot];
+    if (!(speaker->flags&1) || speaker->playerNetId!=sender) return;
+    int length=(int)strlen(text);
+    const unsigned char *data=(const unsigned char *)text;
+    if (!Companion_Printable(data,length) || Companion_Reserved(data,length)) return;
+    unsigned char payload[118];
+    Companion_Put(payload,slot); Companion_Put(payload+4,sender);
+    memcpy(payload+8,data,length); Companion_Event(CP_CHAT,payload,8+length);
+}
+
+static SithThing *Companion_Visible(SithThing *self,int slot)
+{
+    if (!Bot_EnemyAllowed(self,slot)) return NULL;
+    SithThing *t=jkPlayer_playerInfos[slot].pLocalPlayer;
+    rdVector3 delta=Bot_Sub(t->position,self->position);
+    flex_t distance=Bot_Len(delta);
+    if (distance<=0.0001f || distance>20 || Bot_Dot(delta,self->orient.lvec)<-0.12f*distance ||
+        !sithCollision_HasLOS(self,t,0)) return NULL;
+    return t;
+}
+static int Companion_ResourceAllowed(unsigned bin)
+{
+    switch (bin) {
+        case 0: case 11: case 12: case 14: case 15: case 40: case 60:
+        case 62: case 63: case 64: case 65: case 66: return 1;
+        default: return 0;
+    }
+}
+static int Companion_SetPolicy(SithThing *self,const unsigned char *p,double expiry)
+{
+    CompanionPolicy policy={.until=expiry,.mode=p[8],.weapon=p[9],.resource=p[10]|(p[11]<<8),
+        .range=Companion_Float(p+12),.risk=Companion_Float(p+16),
+        .net=Companion_Word(p+20),.guid=Companion_Word(p+24)};
+    if (policy.mode>CP_RECOVER || policy.weapon>10 || !Companion_ResourceAllowed(policy.resource) ||
+        !isfinite(policy.range) || (policy.range!=0 && (policy.range<0.2f || policy.range>12)) ||
+        !isfinite(policy.risk) || policy.risk<0 || policy.risk>1 || (!policy.net)!=(!policy.guid)) return CP_INVALID;
+    if (policy.net) {
+        int slot=bot.targetSlot;
+        SithThing *target=Companion_Visible(self,slot);
+        if (!target || jkPlayer_playerInfos[slot].playerNetId!=policy.net ||
+            target->guid!=policy.guid || (int)target->guid!=bot.targetGuid) return CP_OBSOLETE;
+        policy.signature=target->signature;
+    }
+    Companion_ResetPlan();
+    if (policy.mode!=CP_AUTO) {
+        companion.policy=policy;
+        bot.goal=-1; bot.nextPlan=bot.nextScan=bot.nextSelect=0;
+    }
+    return CP_OK;
+}
+static void Companion_Ack(uint32_t world,uint32_t life,uint32_t seq,int kind,int status,int reason)
+{
+    unsigned char p[4]={status,kind,reason,0};
+    Companion_Send(CP_ACK,world,life,seq,p,4);
+}
+static void Companion_Command(SithThing *self,const unsigned char *frame,int n,double now)
+{
+    if (n<20 || n>512 || memcmp(frame,"JKCP",4) || frame[4]!=1) return;
+    int kind=frame[5], size=frame[6]|(frame[7]<<8);
+    uint32_t seq=Companion_Word(frame+16);
+    if (size!=n-20 || !seq || kind<CP_STRATEGY || kind>CP_MOTOR) return;
+    if ((kind==CP_STRATEGY && size!=28) || (kind==CP_SAY && (size<9 || size>118)) ||
+        (kind==CP_RELEASE && size!=8)) return;
+    if (kind>=CP_COMMIT && (size<8 || size>(int)sizeof(companion.replies[0].request))) {
+        Companion_Ack(Companion_Word(frame+8),Companion_Word(frame+12),seq,kind,CP_REJECTED,CP_INVALID); return;
+    }
+    uint32_t world=Companion_Word(frame+8), life=Companion_Word(frame+12);
+    if (world!=companion.world || life!=companion.life) {
+        Companion_Ack(world,life,seq,kind,CP_STALE,CP_OBSOLETE); return;
+    }
+    const unsigned char *p=frame+20;
+    CompanionReply *r=&companion.replies[seq%64];
+    if (r->sequence==seq) {
+        if (r->kind==kind && r->length==size && !memcmp(r->request,p,size))
+            Companion_Ack(world,life,seq,kind,r->status,r->reason);
+        else Companion_Ack(world,life,seq,kind,CP_REJECTED,CP_INVALID);
+        return;
+    }
+    if (companion.highest && (int32_t)(seq-companion.highest)<=0) {
+        Companion_Ack(world,life,seq,kind,CP_STALE,CP_OBSOLETE); return;
+    }
+    companion.highest=seq;
+    uint64_t bits=Companion_Word(p)|((uint64_t)Companion_Word(p+4)<<32);
+    double expiry; memcpy(&expiry,&bits,sizeof(expiry));
+    int status=CP_APPLIED, reason=CP_OK;
+    if (!isfinite(expiry) || expiry>now+30) { status=CP_REJECTED; reason=CP_INVALID; }
+    else if (expiry<=now) { status=CP_EXPIRED; reason=CP_TOO_LATE; }
+    else if (kind==CP_RELEASE) { Lily_Clear(1); Companion_ResetPlan(); }
+    else if (!companion.identified || companion.dead) { status=CP_REJECTED; reason=CP_UNAVAILABLE; }
+    else if (kind>=CP_COMMIT) {
+        reason=Lily_Command(kind,p,size,seq,expiry);
+        if (reason) status=reason==CP_OBSOLETE ? CP_STALE : CP_REJECTED;
+    } else if (kind==CP_STRATEGY) {
+        reason=Companion_SetPolicy(self,p,expiry);
+        if (reason) status=reason==CP_OBSOLETE ? CP_STALE : CP_REJECTED;
+        else Lily_Clear(8);
+    } else if (!Companion_Printable(p+8,size-8)) { status=CP_REJECTED; reason=CP_INVALID; }
+    else if (Companion_Reserved(p+8,size-8)) { status=CP_REJECTED; reason=CP_RESERVED; }
+    else if (now<companion.nextChat) { status=CP_RATE; reason=CP_TOO_FAST; }
+    else {
+        char text[111];
+        memcpy(text,p+8,size-8); text[size-8]=0;
+        sithMulti_SendChat(text,-1,playerThingIdx);
+        companion.nextChat=now+5;
+    }
+    r->sequence=seq; r->kind=kind; r->status=status; r->reason=reason; r->length=size;
+    memcpy(r->request,p,size);
+    Companion_Ack(world,life,seq,kind,status,reason);
+}
+static void Companion_Tick(SithThing *self,int dead)
+{
+    if (!Companion_Connected()) return;
+    double now=Companion_Clock();
+    companion.now=now;
+    if (now<0) { Companion_ResetPlan(); return; }
+    SithPlayer *own=self->actorParams.pPlayer;
+    if (!own->playerNetId || playerThingIdx<0 || playerThingIdx>=JKPLAYER_NUM_INFOS ||
+        (unsigned)playerThingIdx>=jkPlayer_maxPlayers || &jkPlayer_playerInfos[playerThingIdx]!=own ||
+        !(own->flags&1) || own->pLocalPlayer!=self) {
+        if (companion.identified) Companion_NewWorld();
+        return;
+    }
+    if (companion.identified && (dead!=companion.dead || self->idx!=companion.thing ||
+        self->signature!=companion.signature || self->guid!=companion.guid ||
+        own->playerNetId!=companion.net || playerThingIdx!=companion.slot)) {
+        Lily_NewFence(2);
+        companion.life=Companion_Next(companion.life); companion.nextState=0;
+        Companion_ResetPlan(); companion.heardKind=companion.hasPursuit=0;
+        companion.highest=0; memset(companion.replies,0,sizeof(companion.replies));
+    }
+    companion.identified=1; companion.dead=dead; companion.thing=self->idx;
+    companion.guid=self->guid; companion.signature=self->signature; companion.slot=playerThingIdx;
+    companion.net=own->playerNetId;
+    if (companion.policy.until && now>=companion.policy.until) Companion_ResetPlan();
+    for (int i=0;i<8;i++) {
+        if (companion.emit) {
+            if (!companion.queueCount) break;
+            unsigned at=companion.queueRead;
+            unsigned char local[512];
+            int length=companion.queue[at].length;
+            memcpy(local,companion.queue[at].data,length);
+            companion.queueRead=(at+1)%16; companion.queueCount--;
+            Companion_Command(self,local,length,now);
+            continue;
+        }
+#ifdef PLATFORM_POSIX
+        if (companion.fd<0) break;
+        unsigned char frame[513];
+        ssize_t n=recv(companion.fd,frame,sizeof(frame),MSG_DONTWAIT);
+        if (n<0) break;
+        Companion_Command(self,frame,(int)n,now);
+#else
+        break;
+#endif
+    }
+}
+static void Companion_Publish(SithThing *self,int dead)
+{
+    if (!Companion_Connected() || !companion.identified) return;
+    double now=companion.now;
+    if (now<companion.nextState) {
+        if (Lily_SenseDue(now)) Lily_Publish(self,dead);
+        return;
+    }
+    companion.nextState=now+0.2;
+    unsigned char p[144]={0};
+    SithPlayer *own=self->actorParams.pPlayer;
+    Companion_Put(p,playerThingIdx); Companion_Put(p+4,own->playerNetId);
+    Companion_Put(p+8,self->guid); Companion_Put(p+12,self->signature);
+    Companion_PutFloat(p+16,sithTime_g_secGameTime); Companion_Vector(p+20,self->position);
+    Companion_PutFloat(p+32,self->actorParams.health);
+    Companion_PutFloat(p+36,sithInventory_GetInventory(self,SITHBIN_SHIELDS));
+    Companion_PutFloat(p+40,sithInventory_GetInventory(self,SITHBIN_FORCEMANA));
+    Companion_Put(p+44,sithInventory_GetCurrentWeapon(self)); Companion_Put(p+48,own->numKills);
+    Companion_Put(p+52,own->numKilled); Companion_Put(p+56,companion.policy.mode);
+    Companion_Put(p+60,(uint32_t)bot.goal); Companion_Put(p+68,UINT32_MAX);
+    uint32_t flags=(dead ? 1u:0u)|((self->actorParams.flags&SITH_AF_BLIND)?2u:0u)|4u|
+        (companion.policy.mode ? 32u:0u);
+    int slot=bot.targetSlot;
+    SithThing *t=dead ? NULL : Companion_Visible(self,slot);
+    if (t && (int)t->guid==bot.targetGuid) {
+        companion.hasPursuit=1; companion.pursuitTime=bot.now; companion.pursuitAt=t->position;
+        flags|=8; Companion_Put(p+68,slot); Companion_Put(p+72,jkPlayer_playerInfos[slot].playerNetId);
+        Companion_Put(p+76,t->guid); Companion_Put(p+80,t->signature); Companion_Vector(p+84,t->position);
+        /* LOS and view cone were just checked. This is a fresh observation. */
+    }
+    jkBotHearing cue;
+    int newSound=0;
+    if (!dead && jkBot_GetHearing(&cue) && cue.kind>=1 && cue.kind<=4) {
+        flags|=16; Companion_Put(p+100,cue.kind); Companion_Vector(p+104,cue.position);
+        Companion_PutFloat(p+116,cue.age); Companion_PutFloat(p+120,cue.strength);
+        flex_t start=bot.now-cue.age;
+        if (cue.kind!=companion.heardKind || fabsf(start-companion.heardAt)>0.025f ||
+            Bot_Distance(cue.position,companion.heardPosition)>0.1f) {
+            newSound=1;
+            companion.heardKind=cue.kind; companion.heardAt=start; companion.heardPosition=cue.position;
+        }
+    } else companion.heardKind=0;
+    Companion_Put(p+64,flags);
+    const int ammo[]={SITHBIN_ENERGY,SITHBIN_POWER,SITHBIN_THERMAL_DETONATOR,SITHBIN_RAILCHARGES};
+    for (int i=0;i<4;i++) Companion_PutFloat(p+124+4*i,sithInventory_GetInventory(self,ammo[i]));
+    uint32_t active=0;
+    for (int bin=21;bin<=34;bin++) if (sithInventory_IsInventoryActivated(self,bin)) active|=1u<<(bin-21);
+    Companion_Put(p+140,active);
+    /* STATE establishes the world/life fence for subsequent observations. */
+    Companion_Event(CP_STATE,p,sizeof(p));
+    Lily_Publish(self,dead);
+    if (newSound) {
+        unsigned char sound[24];
+        Companion_Put(sound,cue.kind); Companion_Vector(sound+4,cue.position);
+        Companion_PutFloat(sound+16,cue.strength); Companion_PutFloat(sound+20,cue.uncertainty);
+        Companion_Event(CP_SOUND,sound,sizeof(sound));
+    }
+}
diff --git a/src/AI/jkBotForce.inc b/src/AI/jkBotForce.inc
new file mode 100644
index 0000000000000000000000000000000000000000..2437d594401c2b235381e95dc88f8b4e47cbe863
--- /dev/null
+++ b/src/AI/jkBotForce.inc
@@ -0,0 +1,480 @@
+/* Copyright (c) 2026 Coda Lilitari. SPDX-License-Identifier: MIT
+   Use ordinary inventory hotkeys: stock COGs own eligibility, cost and effects. */
+static int Bot_PowerKey(int bin)
+{
+    for (int i=0;i<SITHINVENTORY_POWERKEYBIND_COUNT_JK;i++)
+        if (sithInventory_GetPowerKeybind(i)==bin) return INPUT_FUNC_ACTIVATE0+i;
+    return -1;
+}
+static flex_t Bot_ForceCost(SithThing *self, int bin)
+{
+    static const int costs[]={20,20,30,20,200,250,100,200,300,30,50,40,200,300};
+    if (bin<SITHBIN_F_JUMP || bin>SITHBIN_F_DEADLYSIGHT) return 0;
+    /* Nominal cost. Protection omits the minimum-mana check on activation. */
+    if (bin==SITHBIN_F_LIGHTNING)
+        return 45.0f-5.0f*Bot_Clamp(sithInventory_GetInventory(self,bin),1,4);
+    return (flex_t)costs[bin-SITHBIN_F_JUMP];
+}
+/* Read local inventory COG target without changing it. */
+static int Bot_ForceVictim(int bin, int *victim)
+{
+#ifndef COG_CRC32_SYMBOL_NAMES
+    SithInventoryType *type=sithInventory_GetType(bin);
+    sithCog *cog=type ? type->cog : NULL;
+    if (!cog || !cog->pSymbolTable || !cog->pSymbolTable->aSymbols) return 0;
+    SithCogSymbolTable *table=cog->pSymbolTable;
+    for (uint32_t i=0;i<table->numUsedSymbols && i<table->tableSize;i++) {
+        SithCogSymbol *sym=&table->aSymbols[i];
+        if (sym->pName && Bot_NameEquals(sym->pName,"victim") && sym->val.type==COG_TYPE_INT) {
+            *victim=(int)sym->val.data[0]; return 1;
+        }
+    }
+#else
+    (void)bin; (void)victim;
+#endif
+    return 0;
+}
+static void Bot_ForceLookAway(SithThing *self)
+{
+    bot.forceAvoid=1;
+    bot.keys[INPUT_FUNC_FIRE1]=bot.keys[INPUT_FUNC_FIRE2]=0;
+    bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+    bot.axes[INPUT_FUNC_PITCH]=self->actorParams.headPYR.x<75 ? 0.9f : 0;
+    bot.axes[INPUT_FUNC_TURN]=0.5f;
+}
+static int Bot_HostileForce(int bin);
+static int Bot_ForceReady(SithThing *self, int bin, flex_t cost)
+{
+    int victim;
+    if ((bin==SITHBIN_F_DEADLYSIGHT || bin==SITHBIN_F_THROW) &&
+        (bot.fistsPeace || (sithNet_MultiModeFlags&MULTIMODEFLAG_TEAMS))) return 0;
+    if (bin==SITHBIN_F_THROW && !Bot_ForceVictim(bin,&victim)) return 0;
+    if (!bot.forceEnabled || !self->actorParams.pPlayer ||
+        bin<SITHBIN_F_JUMP || bin>SITHBIN_F_DEADLYSIGHT ||
+        ((self->actorParams.flags&SITH_AF_CONTROLSDISABLED) ||
+         ((self->actorParams.flags&SITH_AF_BLIND) && Bot_HostileForce(bin))) ||
+        !sithInventory_IsInventoryAvailable(self,bin) || sithInventory_GetInventory(self,bin)<=0 ||
+        sithInventory_IsInventoryActivated(self,bin) || Bot_PowerKey(bin)<0) return 0;
+    return self->actorParams.pPlayer->aItems[bin].binWait<=sithTime_g_secGameTime &&
+        (bin==SITHBIN_F_PROTECTION || sithInventory_GetInventory(self,SITHBIN_FORCEMANA)>=cost);
+}
+static int Bot_HostileForce(int bin)
+{
+    return bin==SITHBIN_F_PULL || bin==SITHBIN_F_BLINDING ||
+        (bin>=SITHBIN_F_THROW && bin<=SITHBIN_F_DEADLYSIGHT);
+}
+static flex_t Bot_ForceRange(SithThing *self, int bin)
+{
+    if (bin==SITHBIN_F_GRIP) return 1.0f;
+    if (bin==SITHBIN_F_PULL) return 0.5f+sithInventory_GetInventory(self,bin)*0.5f;
+    if (bin==SITHBIN_F_BLINDING) return 1.0f+sithInventory_GetInventory(self,bin);
+    if (bin==SITHBIN_F_THROW) return 4.0f;
+    if (bin==SITHBIN_F_DEADLYSIGHT) return 2.0f+sithInventory_GetInventory(self,bin);
+    return 20.0f;
+}
+/* Slot and thing index can both be recycled between the request and release. */
+static int Bot_GripIdentityMatches(int slot)
+{
+    if (slot<0 || slot>=(int)jkPlayer_maxPlayers || slot>=JKPLAYER_NUM_INFOS) return 0;
+    SithPlayer *player=&jkPlayer_playerInfos[slot];
+    SithThing *thing=player->pLocalPlayer;
+    return thing && player->playerNetId==bot.gripTarget.netId && thing->idx==bot.gripTarget.idx &&
+        thing->guid==bot.gripTarget.guid && thing->signature==bot.gripTarget.signature;
+}
+static int Bot_GripMarkerMatches(void)
+{
+    int victim;
+    return Bot_ForceVictim(SITHBIN_F_GRIP,&victim) && victim>=0 && (uint32_t)victim==bot.gripTarget.idx;
+}
+static int Bot_ActiveCompetitiveGrip(SithThing *self)
+{
+    return bot.competitiveForce && bot.forceEffectBin==SITHBIN_F_GRIP &&
+        sithInventory_IsInventoryActivated(self,SITHBIN_F_GRIP);
+}
+static int Bot_PullWeapon(SithThing *target)
+{
+    int weapon=target->playerInfo ? Bot_WeaponFromModel(target->playerInfo->rd_thing.model3) : -1;
+    return weapon>SITHBIN_FISTS && weapon<SITHBIN_LIGHTSABER && !(target->actorParams.flags&SITH_AF_DROID) ? weapon : 0;
+}
+/* A failed acquisition needs a brief retry interval. Only ordinary releases
+   accumulate a delay while the same opponent keeps the same visible gun. */
+static void Bot_FinishPull(SithThing *self, int released)
+{
+    BotPeer *peer=Bot_Peer(bot.forceTarget);
+    if (!peer || !peer->pullPendingWeapon) return;
+    int weapon=peer->pullPendingWeapon;
+    peer->pullPendingWeapon=0;
+    if (!Bot_EnemyBase(self,bot.forceTarget)) return;
+    SithThing *target=jkPlayer_playerInfos[bot.forceTarget].pLocalPlayer;
+    if (target->idx!=peer->pullThingIdx || Bot_PullWeapon(target)!=weapon) return;
+    if (peer->pullWeapon!=weapon) peer->pullRetryDelay=0;
+    peer->pullWeapon=weapon;
+    if (released) peer->pullRetryDelay=Bot_Clamp(2*peer->pullRetryDelay,2.0f,20.0f);
+    peer->pullRetryAt=bot.now+(released ? peer->pullRetryDelay : 1.0f);
+}
+static int Bot_RequestForce(SithThing *self, int bin, flex_t holdSeconds, int targetSlot)
+{
+    if (bot.forceBin>=0 || bot.now<bot.nextForce || Bot_ActiveCompetitiveGrip(self) ||
+        !Bot_ForceReady(self,bin,Bot_ForceCost(self,bin))) return 0;
+    if (Bot_HostileForce(bin)) {
+        if (!Bot_EnemyAllowed(self,targetSlot)) return 0;
+        SithThing *target=jkPlayer_playerInfos[targetSlot].pLocalPlayer;
+        if (Bot_Distance(self->position,target->position)>Bot_ForceRange(self,bin) ||
+            !sithCollision_HasLOS(self,target,0) || Bot_ProtectedNear(self,self->position,8.0f)) return 0;
+        if (bin==SITHBIN_F_PULL) {
+            int weapon=Bot_PullWeapon(target);
+            if (!weapon) return 0;
+            if (bot.competitiveForce) {
+                BotPeer *peer=Bot_Peer(targetSlot);
+                if (!peer) return 0;
+                if (peer->pullThingIdx!=target->idx) peer->pullWeapon=0;
+                if (peer->pullWeapon==weapon && bot.now<peer->pullRetryAt) return 0;
+                peer->pullThingIdx=target->idx;
+                peer->pullPendingWeapon=weapon;
+            }
+        }
+        if (bot.competitiveForce && bin==SITHBIN_F_GRIP) {
+            bot.gripTarget.idx=target->idx;
+            bot.gripTarget.guid=target->guid;
+            bot.gripTarget.signature=target->signature;
+            bot.gripTarget.netId=jkPlayer_playerInfos[targetSlot].playerNetId;
+        }
+    }
+    int key=Bot_PowerKey(bin);
+    bot.forceBin=bin; bot.forceTarget=targetSlot; bot.forceCancel=0;
+    bot.forceUntil=bot.now+Bot_Clamp(holdSeconds,0.08f,bin==SITHBIN_F_JUMP ? 1.40f : 1.0f);
+    bot.nextForce=bot.now+(bot.competitiveForce ? 0.15f : 2.4f); bot.keys[key]=1;
+    if (Bot_HostileForce(bin)) { bot.forceEffectBin=bin; bot.forceEffectTarget=targetSlot; }
+    fprintf(stderr,"BOT_FORCE_INPUT name=%s bin=%d level=%.0f mana=%.1f hold=%.2f\n",
+        bot.name,bin,(double)sithInventory_GetInventory(self,bin),
+        (double)sithInventory_GetInventory(self,SITHBIN_FORCEMANA),(double)holdSeconds);
+    fflush(stderr); return 1;
+}
+static int Bot_ForceDebris(SithThing *self)
+{
+    int count=Bot_ThingCount();
+    for (int i=0;i<count;i++) {
+        SithThing *t=&bot.world->aThings[i];
+        if (t->type==SITH_THING_DEBRIS && !(t->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED)) &&
+            Bot_Distance(self->position,t->position)<5.0f && sithCollision_HasLOS(self,t,0)) return 1;
+    }
+    return 0;
+}
+/* Stock Seeing prevents subsequent Blind hits and reveals a persuaded opponent. */
+static int Bot_NeedsSeeing(SithThing *self)
+{
+    if (self->actorParams.flags&SITH_AF_BLIND) return 1;
+    for (unsigned slot=0;slot<jkPlayer_maxPlayers && slot<JKPLAYER_NUM_INFOS;slot++) {
+        SithThing *peer=jkPlayer_playerInfos[slot].pLocalPlayer;
+        if (peer && Bot_Persuaded(peer) && Bot_EnemyBase(self,(int)slot) &&
+            !Bot_IsPeaceful(self,(int)slot) && Bot_VisibleTarget(self,peer)) return 1;
+    }
+    return 0;
+}
+/* Run after movement and Force arbitration. A visible enemy can call for
+   chasing, backing away or strafing; check the direction actually selected. */
+static int Bot_SupplySwimRunway(SithThing *self)
+{
+    if (bot.frameDt>0.070f || nav.diveEscape || Bot_NeedsAir(self) || !Bot_StockWaterMotion(self) || self->attach_flags ||
+        self->sector!=bot.armContact.sector || bot.axes[INPUT_FUNC_FORWARD]<0.75f ||
+        fabsf(bot.axes[INPUT_FUNC_SLIDE])>0.45f || self->actorParams.health<40) return 0;
+    rdVector3 delta=Bot_Sub(bot.armContact.pos,self->position);
+    flex_t len=Bot_Len(delta);
+    if (len<0.50f || len>2 || Bot_Dot(delta,self->orient.lvec)<0.75f*len) return 0;
+    /* Check the actual target segment and extra side margin before accelerating
+       an already directed swimmer. Water exits and precision jumps own their
+       existing inputs. No breath deadline is extended by this request. */
+    return Bot_WaterClear(self->sector,self->position,bot.armContact.pos,self->moveSize) &&
+        Bot_WaterClear(self->sector,self->position,Bot_Mix(self->position,bot.armContact.pos,0.4f/len),
+                       self->moveSize+0.015f);
+}
+
+static void Bot_TryMovementSpeed(SithThing *self)
+{
+    if (!bot.competitiveForce || !bot.forceEnabled || bot.forceBin>=0 || bot.forceAvoid ||
+        bot.forceCancel || bot.keys[INPUT_FUNC_NEXTSKILL] || bot.now<bot.nextForce ||
+        bot.now<bot.nextSpeedProbe || bot.nextRecovery>0 || Bot_NavigationWaiting(self) ||
+        nav.waterExitUntil>0 || nav.seekingSurface || nav.crossingEntry ||
+        bot.keys[INPUT_FUNC_ACTIVATE] || !Bot_SectorSafe(self->sector) ||
+        (self->sector->flags&(SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY)) ||
+        (self->physicsParams.flags&(SITH_PF_ONWATERSURFACE|SITH_PF_CROUCHING)) ||
+        (self->actorParams.flags&SITH_AF_IMMOBILE) ||
+        ((self->attach_flags&SITH_ATTACH_SURFACE) && self->attachedSurface &&
+         (self->attachedSurface->flags&(SITH_SURFACE_WATER|SITH_SURFACE_VERYDEEPWATER))) ||
+        sithInventory_IsInventoryActivated(self,SITHBIN_F_GRIP)) return;
+    flex_t forward=bot.axes[INPUT_FUNC_FORWARD], slide=bot.axes[INPUT_FUNC_SLIDE];
+    if (forward*forward+slide*slide<0.30f) return; /* Includes slow pickup contact. */
+    int swim=(self->sector->flags&SITH_SECTOR_UNDERWATER)!=0;
+    if (swim && (bot.armItem<=0 || !bot.armDirect || !bot.followingRoute || bot.routeMode!=BOT_ROUTE_SWIM)) return;
+    if (!swim && (!(self->attach_flags&SITH_ATTACH_SURFACE) ||
+                  bot.keys[INPUT_FUNC_JUMP] || bot.keys[INPUT_FUNC_DUCK])) return;
+    const flex_t runway=0.60f;
+    int node=bot.armNode-1;
+    if (bot.armItem && bot.armDirect) {
+        if (Bot_Horizontal(Bot_Sub(bot.armContact.pos,self->position))<runway) return;
+        node=-1;
+    } else if (bot.followingRoute) {
+        if (bot.routeMode!=BOT_ROUTE_WALK || bot.routePos>=bot.routeCount) return;
+        node=bot.route[bot.routePos];
+    }
+    if (node>=0 && (node>=bot.nNodes || Bot_Horizontal(Bot_Sub(bot.nodes[node].pos,self->position))<runway)) return;
+
+    /* Keep two ordinary utility casts (Jump and Pull) in reserve. Stock
+       surges waive the debit but still require the activation minimum. */
+    flex_t budget=Bot_ForceCost(self,SITHBIN_F_SPEED);
+    if (sithInventory_GetInventory(self,SITHBIN_S_DARK)!=1 && sithInventory_GetInventory(self,SITHBIN_S_LIGHT)!=1)
+        budget+=Bot_ForceCost(self,SITHBIN_F_JUMP)+Bot_ForceCost(self,SITHBIN_F_PULL);
+    if (!Bot_ForceReady(self,SITHBIN_F_SPEED,budget)) return;
+    bot.nextSpeedProbe=bot.now+0.40f;
+    if (forward<0) forward*=0.5f;
+    slide*=0.7f;
+    rdVector3 direction={self->orient.lvec.x*forward+self->orient.rvec.x*slide,
+                         self->orient.lvec.y*forward+self->orient.rvec.y*slide,0}, blocked;
+    if (swim ? Bot_SupplySwimRunway(self) : Bot_GroundCorridor(self,direction,0,runway,1,&blocked))
+        Bot_RequestForce(self,SITHBIN_F_SPEED,0.10f,-1);
+}
+
+/* Ground drag can slow a charging player. Once the stock COG releases, zero
+   movement axes keep the player's existing horizontal momentum independent
+   of where the gun points. Bound the longest flight and highest apex for the
+   rank: a short tap receives the maximum impulse, while a delayed release
+   past 150 ms can receive a smaller one. Both stay inside the checked prism. */
+static int Bot_CombatJumpSpace(SithThing *self,rdVector3 waypoint,int rank,flex_t *flight)
+{
+    flex_t dt=bot.physicsStep, control=bot.frameDt, speed=Bot_Horizontal(self->physicsParams.vel);
+    flex_t drag=self->physicsParams.airDrag, groundDrag=self->physicsParams.surfDrag;
+    flex_t gravity=bot.world->gravity, radius=self->moveSize;
+    if (!(dt>=0.002f && dt<=0.067f && control>0 && control<=0.10f &&
+          gravity>=1 && gravity<=25 && drag>=0 && drag<=5 && groundDrag>=0 && groundDrag<=8 &&
+          speed>=0.45f && speed<=3 && radius>=0.02f && radius<=0.2f && rank>=1 && rank<=4) ||
+        fabsf(self->physicsParams.vel.z)>0.02f || fabsf(self->physicsParams.angularVelocity.y)>12) return 0;
+    rdVector3 dir={self->physicsParams.vel.x/speed,self->physicsParams.vel.y/speed,0};
+    rdVector3 delta=Bot_Sub(waypoint,self->position);
+    flex_t ahead=Bot_Dot(delta,dir), length=Bot_Horizontal(delta);
+    if (ahead<0.5f || ahead<0.90f*length) return 0;
+    /* If ground friction would stop this particular slow runner before the
+       next control-time release, leave movement with the supply route. */
+    flex_t charge=0.08f+control+dt;
+    flex_t slow=speed*powf(1-groundDrag*dt,ceilf(charge/dt));
+    if (slow<Bot_Max(0.25f,self->physicsParams.staticDrag)) return 0;
+    flex_t vz=2.5f+0.35f*rank+0.02f,z=0,top=0,travel=speed*charge,v=speed,time=0;
+    do {
+        v*=1-drag*dt; vz=vz*(1-drag*dt)-gravity*dt;
+        z+=vz*dt; top=Bot_Max(top,z); travel+=v*dt; time+=dt;
+    } while (z>0 && time<2.5f);
+    if (z>0 || top<0.25f || travel>=ahead-0.06f) return 0;
+    /* Restrict this tactical shortcut to one flat, convex sector and a single
+       floor polygon. Its four corners enclose the whole range of dry landing
+       points. The sector-plane tests include the player radius at the apex;
+       the extra lateral allowance covers small residual turn during the tap. */
+    flex_t side=radius+0.03f+travel*0.08f;
+    int remainingThings=Bot_ThingCount();
+    for (SithThing *t=self->sector->pFirstThingInSector;t;t=t->pNextThingInSector) {
+        if (remainingThings--<=0) return 0;
+        if (t==self || t->flags&(SITH_TF_DISABLED|SITH_TF_DESTROYED) ||
+            t->collide==SITH_COLLIDE_NONE || t->type==SITH_THING_ITEM || t->type==SITH_THING_WEAPON ||
+            t->type==SITH_THING_PARTICLE || t->type==SITH_THING_EXPLOSION) continue;
+        if (t->collide==SITH_COLLIDE_FACE) return 0;
+        rdVector3 offset=Bot_Sub(t->position,self->position);
+        flex_t along=Bot_Clamp(Bot_Dot(offset,dir),0,travel);
+        offset.x-=along*dir.x; offset.y-=along*dir.y;
+        if (Bot_Horizontal(offset)<=t->collideSize+side) return 0;
+    }
+    for (int end=0;end<2;end++) for (int flank=-1;flank<=1;flank+=2) {
+        flex_t along=end ? travel+radius : -radius;
+        rdVector3 at={self->position.x+along*dir.x-flank*side*dir.y,
+                      self->position.y+along*dir.y+flank*side*dir.x,self->position.z};
+        if (!sithIntersect_IsSphereInSector(&at,radius,self->sector)) return 0;
+        rdVector3 down={0,0,-1};
+        sithCollision_SearchForCollisions(self->sector,NULL,&at,&down,BOT_FOOT_HEIGHT+0.04f,0,
+                                         RAYCAST_200|RAYCAST_800|RAYCAST_2000);
+        SithCollision *hit=sithCollision_PopStack();
+        int supported=hit && (hit->type&SITHCOLLISION_WORLD) && hit->surface==self->attachedSurface &&
+                      fabsf(hit->distance-BOT_FOOT_HEIGHT)<0.025f;
+        sithCollision_DecreaseStackLevel();
+        if (!supported) return 0;
+        at.z+=top+0.04f;
+        if (!sithIntersect_IsSphereInSector(&at,radius,self->sector)) return 0;
+    }
+    *flight=time;
+    return 1;
+}
+
+static void Bot_TryCombatJump(SithThing *self,SithThing *target)
+{
+    if (nav.combatJumpUntil>bot.now) {
+        bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+        if (self->attach_flags) bot.axes[INPUT_FUNC_TURN]=0;
+        return;
+    }
+    if (!bot.competitiveForce || !bot.elite || bot.sabersOnly || !bot.armItem ||
+        !bot.followingRoute || bot.routeMode!=BOT_ROUTE_WALK || !target || !target->playerInfo ||
+        bot.now<nav.nextCombatJump || bot.now<bot.nextJump || Bot_NavigationWaiting(self) ||
+        Bot_ObjectiveUrgent(self) || nav.crossingEntry || nav.seekingSurface || bot.nextRecovery>0 ||
+        bot.forceAvoid || bot.forceCancel || bot.forceBin>=0 ||
+        !(self->attach_flags&SITH_ATTACH_SURFACE) || !self->attachedSurface ||
+        self->attachedSurface->surfaceInfo.face.normal.z<0.9999f ||
+        self->attachedSurface->flags&(SITH_SURFACE_WATER|SITH_SURFACE_VERYDEEPWATER|SITH_SURFACE_ICY|SITH_SURFACE_VERYICY) ||
+        !Bot_SectorSafe(self->sector) || self->sector->flags&(SITH_SECTOR_UNDERWATER|SITH_SECTOR_USETHRUST|SITH_SECTOR_NOGRAVITY) ||
+        self->physicsParams.flags&(SITH_PF_ONWATERSURFACE|SITH_PF_CROUCHING|SITH_PF_FLY|SITH_PF_PARTIALGRAVITY) ||
+        !(self->physicsParams.flags&SITH_PF_USEGRAVITY) || self->actorParams.flags&(SITH_AF_IMMOBILE|SITH_AF_CONTROLSDISABLED) ||
+        bot.keys[INPUT_FUNC_JUMP] || bot.keys[INPUT_FUNC_DUCK] || bot.keys[INPUT_FUNC_ACTIVATE] ||
+        !Bot_EnemyAllowed(self,Bot_PlayerSlot(target)) || !Bot_VisibleTarget(self,target) ||
+        Bot_WeaponFromModel(target->playerInfo->rd_thing.model3)!=SITHBIN_CONCUSSION_RIFLE ||
+        !Bot_ForceReady(self,SITHBIN_F_JUMP,Bot_ForceCost(self,SITHBIN_F_JUMP))) return;
+    int gun=sithInventory_GetCurrentWeapon(self);
+    /* Both stock heavy guns kick the shooter on discharge. A pending heavy
+       selection on the launch frame also takes precedence over the hop. */
+    if (Bot_CombatJumpRecoilGun(gun) || bot.keys[INPUT_FUNC_SELECT1+SITHBIN_CONCUSSION_RIFLE-1] ||
+        bot.keys[INPUT_FUNC_SELECT1+SITHBIN_RAIL_DETONATOR-1]) return;
+    if (gun<SITHBIN_BRYARPISTOL || gun>SITHBIN_CONCUSSION_RIFLE || gun==SITHBIN_THERMAL_DETONATOR ||
+        gun==SITHBIN_SEQUENCER_CHARGE || !Bot_HasWeapon(self,gun)) return;
+    rdVector3 attack=Bot_Sub(self->position,target->position);
+    flex_t distance=Bot_Len(attack);
+    if (distance<1.0f || distance>8.0f || Bot_Dot(attack,target->orient.lvec)<0.85f*distance ||
+        fabsf(bot.axes[INPUT_FUNC_FORWARD])+fabsf(bot.axes[INPUT_FUNC_SLIDE])<0.25f) return;
+    BotNode *toward=&bot.armContact;
+    if (!bot.armDirect) {
+        if (bot.routePos>=bot.routeCount) return;
+        int next=bot.route[bot.routePos];
+        if (next<0 || next>=bot.nNodes) return;
+        toward=&bot.nodes[next];
+    }
+    nav.nextCombatJump=bot.now+0.35f;
+    flex_t flight;
+    if (!Bot_CombatJumpSpace(self,toward->pos,(int)sithInventory_GetInventory(self,SITHBIN_F_JUMP),&flight) ||
+        !Bot_RequestForce(self,SITHBIN_F_JUMP,0.08f,-1)) return;
+    nav.combatJumpUntil=bot.now+flight+0.40f;
+    nav.combatJumpAirborne=0;
+    nav.nextCombatJump=nav.combatJumpUntil+2.0f;
+    bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=bot.axes[INPUT_FUNC_TURN]=0;
+}
+
+static void Bot_ForceControl(SithThing *self, SithThing *target, flex_t aimError,int autonomous)
+{
+    bot.forceAvoid=0;
+    /* Deadly Sight has no cancellation handler. New casts are forbidden in
+       peace/team play; a preexisting effect keeps its ordinary lifetime. */
+    if (sithInventory_IsInventoryActivated(self,SITHBIN_F_DEADLYSIGHT) &&
+        (!bot.forceEnabled || bot.fistsPeace || (sithNet_MultiModeFlags&MULTIMODEFLAG_TEAMS))) {
+        Bot_ForceLookAway(self); return;
+    }
+    if (bot.forceBin>=0) {
+        int bin=bot.forceBin, key=Bot_PowerKey(bin);
+        int hostile=Bot_HostileForce(bin);
+        int allowed=bot.forceEnabled && (!hostile ||
+            (Bot_EnemyAllowed(self,bot.forceTarget) &&
+             sithCollision_HasLOS(self,jkPlayer_playerInfos[bot.forceTarget].pLocalPlayer,0) &&
+             !Bot_ProtectedNear(self,self->position,8.0f)));
+        if (allowed && bot.competitiveForce && bin==SITHBIN_F_PULL) {
+            SithThing *intended=jkPlayer_playerInfos[bot.forceTarget].pLocalPlayer;
+            int victim;
+            BotPeer *peer=Bot_Peer(bot.forceTarget);
+            allowed=peer && peer->pullThingIdx==intended->idx && peer->pullPendingWeapon &&
+                peer->pullPendingWeapon==Bot_PullWeapon(intended) &&
+                Bot_Distance(self->position,intended->position)<=Bot_ForceRange(self,bin) &&
+                (bot.now<bot.forceUntil ||
+                 (Bot_ForceVictim(bin,&victim) && victim>=0 && (uint32_t)victim==intended->idx));
+        }
+        if (allowed && bot.competitiveForce && bin==SITHBIN_F_GRIP) {
+            SithThing *intended=jkPlayer_playerInfos[bot.forceTarget].pLocalPlayer;
+            allowed=!(self->actorParams.flags&SITH_AF_CONTROLSDISABLED) &&
+                Bot_GripIdentityMatches(bot.forceTarget) &&
+                Bot_Distance(self->position,intended->position)<=Bot_ForceRange(self,bin) &&
+                (bot.now<bot.forceUntil || Bot_GripMarkerMatches());
+        }
+        if (key<0) {
+            if (bot.competitiveForce && bin==SITHBIN_F_PULL) Bot_FinishPull(self,0);
+            bot.forceBin=-1; bot.forceTarget=-1; bot.forceCancel=0; return;
+        }
+        /* Throw's deselected only hides its marker. Keep the key held and
+           look away until its normal pulse loses the target, then release. */
+        if ((!allowed || bot.forceCancel) && bin==SITHBIN_F_THROW) {
+            int victim;
+            bot.forceCancel=1; Bot_ForceLookAway(self);
+            if (!Bot_ForceVictim(bin,&victim) || victim>=0) { bot.keys[key]=1; return; }
+            bot.forceBin=bot.forceTarget=bot.forceEffectBin=-1; bot.forceCancel=0; return;
+        }
+        /* Pull, grip and blind have actual deselected stop_power handlers. */
+        if ((!allowed || bot.forceCancel) && hostile &&
+            (bin==SITHBIN_F_PULL || bin==SITHBIN_F_GRIP || bin==SITHBIN_F_BLINDING)) {
+            if (self->actorParams.pPlayer->curPower==bin) {
+                bot.keys[key]=1;
+                bot.keys[INPUT_FUNC_NEXTSKILL]=!bot.previous[INPUT_FUNC_NEXTSKILL];
+                bot.forceCancel=1; return;
+            }
+            if (bot.competitiveForce && bin==SITHBIN_F_PULL) Bot_FinishPull(self,0);
+            bot.forceBin=-1; bot.forceTarget=-1; bot.forceCancel=0; return;
+        }
+        if (allowed && bot.now<bot.forceUntil) {
+            bot.keys[key]=1;
+            if (hostile) bot.keys[INPUT_FUNC_FIRE1]=bot.keys[INPUT_FUNC_FIRE2]=0;
+            return;
+        }
+        if (bot.competitiveForce && bin==SITHBIN_F_PULL) Bot_FinishPull(self,1);
+        bot.forceBin=-1; bot.forceTarget=-1; return; /* Normal key release. */
+    }
+    int activeGrip=Bot_ActiveCompetitiveGrip(self);
+    if (bot.forceEffectBin>=0 && bot.forceEffectBin!=SITHBIN_F_DEADLYSIGHT &&
+        sithInventory_IsInventoryActivated(self,bot.forceEffectBin) &&
+        (!bot.forceEnabled || !Bot_EnemyAllowed(self,bot.forceEffectTarget) ||
+         (activeGrip && (!Bot_GripIdentityMatches(bot.forceEffectTarget) || !Bot_GripMarkerMatches())))) {
+        if (self->actorParams.pPlayer->curPower==bot.forceEffectBin)
+            bot.keys[INPUT_FUNC_NEXTSKILL]=!bot.previous[INPUT_FUNC_NEXTSKILL];
+        else bot.forceEffectBin=-1;
+        return;
+    }
+    if (!autonomous || nav.waterExitUntil>0 || bot.now<bot.nextForce) return;
+    /* Bacta is an inventory item, independent of the Force checkbox. */
+    if (self->actorParams.health<=65 && sithInventory_IsInventoryAvailable(self,SITHBIN_BACTATANK) &&
+        sithInventory_GetInventory(self,SITHBIN_BACTATANK)>0 &&
+        self->actorParams.pPlayer->aItems[SITHBIN_BACTATANK].binWait<=sithTime_g_secGameTime) {
+        int key=Bot_PowerKey(SITHBIN_BACTATANK);
+        if (key>=0) { bot.keys[key]=1; bot.nextForce=bot.now+1.2f; return; }
+    }
+    if (!bot.forceEnabled || activeGrip) return;
+    if (self->actorParams.health<=60 && Bot_RequestForce(self,SITHBIN_F_HEALING,0.1f,-1)) return;
+    if (!sithInventory_IsInventoryActivated(self,SITHBIN_F_SEEING) && Bot_NeedsSeeing(self) &&
+        Bot_RequestForce(self,SITHBIN_F_SEEING,0.1f,-1)) return;
+    if (bot.now<bot.forceThreatUntil && Bot_RequestForce(self,SITHBIN_F_ABSORB,0.1f,-1)) return;
+    if (bot.competitiveForce) {
+        int engaged=target && Bot_EnemyAllowed(self,Bot_PlayerSlot(target)) &&
+            sithCollision_HasLOS(self,target,0);
+        if (engaged && Bot_RequestForce(self,SITHBIN_F_ABSORB,0.1f,-1)) return;
+    }
+    if (bot.now<bot.hurtUntil && self->actorParams.health<75 &&
+        Bot_RequestForce(self,SITHBIN_F_PROTECTION,0.1f,-1)) return;
+    if (self->actorParams.health<35 && Bot_RequestForce(self,SITHBIN_F_PERSUASION,0.1f,-1)) return;
+    if (!target || !Bot_EnemyAllowed(self,Bot_PlayerSlot(target))) {
+        if (!bot.competitiveForce && bot.routePos<bot.routeCount && bot.route[bot.routePos]>=0 && bot.route[bot.routePos]<bot.nNodes) {
+            BotNode here={0}; here.pos=self->position; here.sector=self->sector;
+            BotNode *goal=&bot.nodes[bot.route[bot.routePos]]; int drop=0;
+            /* Speed only for a verified straight supported walking segment. */
+            if (Bot_Distance(here.pos,goal->pos)>2.0f && Bot_Walkable(&here,goal,&drop) && !drop)
+                Bot_RequestForce(self,SITHBIN_F_SPEED,0.1f,-1);
+        }
+        return;
+    }
+    if (aimError>6.0f || bot.now<bot.reactionUntil ||
+        !sithCollision_HasLOS(self,target,0) || Bot_ProtectedNear(self,self->position,8.0f)) return;
+    flex_t distance=Bot_Distance(self->position,target->position);
+    int slot=Bot_PlayerSlot(target);
+    int enemies=0;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++)
+        if (Bot_EnemyAllowed(self,(int)i) &&
+            Bot_Distance(self->position,jkPlayer_playerInfos[i].pLocalPlayer->position)<4.0f) enemies++;
+    if (enemies>=2 && distance<4 && Bot_RequestForce(self,SITHBIN_F_DEADLYSIGHT,0.1f,slot)) return;
+    if (distance>3.2f && Bot_SafeShot(self,target,target->position,2.8f,0) &&
+        Bot_RequestForce(self,SITHBIN_F_DESTRUCTION,0.1f,slot)) return;
+    if (distance<=0.95f && Bot_RequestForce(self,SITHBIN_F_GRIP,0.46f,slot)) return;
+    if (distance<4.5f && Bot_SafeShot(self,target,target->position,0,0.20f) &&
+        Bot_RequestForce(self,SITHBIN_F_LIGHTNING,0.68f,slot)) return;
+    if (distance<0.45f+sithInventory_GetInventory(self,SITHBIN_F_PULL)*0.5f &&
+        Bot_RequestForce(self,SITHBIN_F_PULL,0.46f,slot)) return;
+    if (distance<0.95f+sithInventory_GetInventory(self,SITHBIN_F_BLINDING) &&
+        Bot_RequestForce(self,SITHBIN_F_BLINDING,0.46f,slot)) return;
+    if (distance<3.9f && Bot_ForceDebris(self)) Bot_RequestForce(self,SITHBIN_F_THROW,0.46f,slot);
+}
+
+static void Bot_ForceTick(SithThing *self,SithThing *target,flex_t aimError)
+{ Bot_ForceControl(self,target,aimError,1); }
diff --git a/src/AI/jkBotHearing.inc b/src/AI/jkBotHearing.inc
new file mode 100644
index 0000000000000000000000000000000000000000..3761a38178c54a93ae8e3771ae563fcfff93ffba
--- /dev/null
+++ b/src/AI/jkBotHearing.inc
@@ -0,0 +1,337 @@
+/* Perception of spatial playback requests. Anchors are estimates in world units.
+   Only an active, attached weapon loop may sample a moving source again. */
+enum { BOT_HEARD_MOVE=1, BOT_HEARD_WEAPON, BOT_HEARD_PROJECTILE, BOT_HEARD_ARRIVAL };
+enum { BOT_HEARD_CAP=24, BOT_SOUND_LOOPS=12, BOT_ACOUSTIC_PORTALS=40 };
+
+typedef struct BotHeard {
+    jkBotHearing cue;
+    flex_t first, last;
+    int slot;
+    uint32_t netId, guid, signature;
+} BotHeard;
+
+typedef struct BotSoundLoop {
+    const sithSound *sound;
+    uint32_t idx, signature;
+    flex_t volume, nearRadius, farRadius, next;
+    flex_t targetVolume, fadeStart, fadeEnd;
+} BotSoundLoop;
+
+static struct {
+    BotHeard records[BOT_HEARD_CAP];
+    BotSoundLoop loops[BOT_SOUND_LOOPS];
+    const SithThing *listener;
+    uint32_t guid, signature, netId;
+} ears;
+
+static void Bot_ResetHearing(void) { memset(&ears,0,sizeof(ears)); }
+
+static SithThing *Bot_HearingListener(void)
+{
+    SithThing *self=sithPlayer_g_pLocalPlayerThing;
+    if (!bot.enabled || !bot.joined || !bot.world || bot.world!=sithWorld_g_pCurrentWorld ||
+        !self || !self->sector || !self->actorParams.pPlayer || self->type!=SITH_THING_PLAYER ||
+        self->actorParams.health<=0 || self->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED)) {
+        if (ears.listener) Bot_ResetHearing();
+        return NULL;
+    }
+    uint32_t net=self->actorParams.pPlayer->playerNetId;
+    if (ears.listener!=self || ears.guid!=self->guid || ears.signature!=self->signature || ears.netId!=net) {
+        Bot_ResetHearing();
+        ears.listener=self; ears.guid=self->guid; ears.signature=self->signature; ears.netId=net;
+    }
+    return self;
+}
+
+static int Bot_SoundKind(const SithThing *emitter, const sithSound *sound, int mode)
+{
+    if (mode==JKBOT_SOUND_MUZZLE) return BOT_HEARD_WEAPON;
+    if (emitter && (emitter->type==SITH_THING_WEAPON || emitter->type==SITH_THING_EXPLOSION))
+        return BOT_HEARD_PROJECTILE;
+    if (emitter && emitter->type==SITH_THING_PLAYER) {
+        if (mode>=SITH_SC_LWALKHARD && mode<=SITH_SC_LANDHURT) return BOT_HEARD_MOVE;
+        if (mode>=SITH_SC_FIRE1 && mode<=SITH_SC_FIRE4) return BOT_HEARD_WEAPON;
+    }
+    if (Bot_NameEquals(sound->sound_fname,"ForceThrow01.wav")) return BOT_HEARD_ARRIVAL;
+    return 0;
+}
+
+static int Bot_OwnAudio(const SithThing *emitter,const SithThing *self)
+{
+    for (int i=0;emitter && i<5;i++) {
+        if (emitter==self) return 1;
+        if (!emitter->pParent || emitter->parentSignature!=emitter->pParent->signature) break;
+        emitter=emitter->pParent;
+    }
+    return 0;
+}
+
+typedef struct BotAcousticStep {
+    SithSector *sector;
+    SithSurfaceAdjoin *entry;
+    rdVector3 point, firstPortal;
+    flex_t length;
+    int indirect, done;
+} BotAcousticStep;
+
+/* Prefer the straight line across an aperture. When the ray misses its convex
+   polygon, use the doorway center as a coarse diffracted path. */
+static int Bot_AcousticOpening(SithSurface *surface, rdVector3 from, rdVector3 source,
+                               rdVector3 *opening, int *indirect)
+{
+    if (!surface || !bot.world->aVertices || !Bot_FaceCenter(surface,opening)) return 0;
+    rdFace *face=&surface->surfaceInfo.face;
+    rdVector3 direction=Bot_Sub(source,from);
+    flex_t denominator=Bot_Dot(direction,face->normal);
+    if (fabsf(denominator)>0.00001f) {
+        flex_t t=Bot_Dot(Bot_Sub(*opening,from),face->normal)/denominator;
+        if (t>=0 && t<=1) {
+            rdVector3 point=Bot_Mix(from,source,t);
+            int inside=1;
+            for (unsigned i=0;i<face->numVertices;i++) {
+                rdVector3 a=bot.world->aVertices[face->vertexPosIdx[i]];
+                rdVector3 b=bot.world->aVertices[face->vertexPosIdx[(i+1)%face->numVertices]];
+                rdVector3 edge=Bot_Sub(b,a), n=face->normal;
+                rdVector3 side={edge.y*n.z-edge.z*n.y,edge.z*n.x-edge.x*n.z,edge.x*n.y-edge.y*n.x};
+                if (Bot_Dot(Bot_Sub(point,a),side)*Bot_Dot(Bot_Sub(*opening,a),side)<-0.0000001f) { inside=0; break; }
+            }
+            if (inside) { *opening=point; return 1; }
+        }
+    }
+    *indirect=1;
+    return 1;
+}
+
+static int Bot_AcousticPath(SithThing *self,SithSector *sourceSector,rdVector3 source,
+                            flex_t radius,rdVector3 *anchor,flex_t *length,int *indirect)
+{
+    flex_t direct=Bot_Distance(self->position,source);
+    if (!isfinite(direct) || direct>radius || !sourceSector) return 0;
+    *anchor=source; *length=direct; *indirect=0;
+    if (sourceSector==self->sector) return 1;
+    BotAcousticStep path[BOT_ACOUSTIC_PORTALS]={{0}};
+    path[0].sector=self->sector; path[0].point=self->position;
+    int count=1, edges=0, found=0;
+    flex_t best=radius;
+    for (;;) {
+        int index=-1;
+        for (int i=0;i<count;i++)
+            if (!path[i].done && path[i].length<=best && (index<0 || path[i].length<path[index].length)) index=i;
+        if (index<0) break;
+        BotAcousticStep *step=&path[index]; step->done=1;
+        if (step->sector==sourceSector) {
+            flex_t distance=step->length+Bot_Distance(step->point,source);
+            if (distance<=best) {
+                best=distance; found=1; *indirect=step->indirect;
+                *anchor=step->indirect ? step->firstPortal : source;
+            }
+            continue;
+        }
+        for (SithSurfaceAdjoin *a=step->sector->adjoins;a && ++edges<=192;a=a->next) {
+            if (!a->sector || !a->mirror || !(a->flags&SITHSURF_ADJOIN_ALLOW_SOUND) ||
+                !(a->mirror->flags&SITHSURF_ADJOIN_ALLOW_SOUND) || a->sector==self->sector) continue;
+            rdVector3 point;
+            int bent=step->indirect;
+            if (!Bot_AcousticOpening(a->surface,step->point,source,&point,&bent)) continue;
+            flex_t lengthToPortal=step->length+Bot_Distance(step->point,point);
+            if (lengthToPortal+Bot_Distance(point,source)>best) continue;
+            int next=1;
+            while (next<count && path[next].entry!=a) next++;
+            if (next==count) {
+                if (count==BOT_ACOUSTIC_PORTALS) continue;
+                count++;
+            } else if (path[next].done || path[next].length<=lengthToPortal) continue;
+            path[next]=(BotAcousticStep){a->sector,a,point,index ? step->firstPortal : point,lengthToPortal,bent,0};
+        }
+    }
+    *length=best;
+    return found;
+}
+
+static flex_t Bot_HearingLifetime(int kind)
+{
+    return kind==BOT_HEARD_MOVE ? 1.15f : kind==BOT_HEARD_PROJECTILE ? 0.85f : 1.65f;
+}
+
+static int Bot_HearingCurrent(BotHeard *r)
+{
+    if (!r->cue.kind || bot.now-r->last>Bot_HearingLifetime(r->cue.kind)) return 0;
+    if (r->slot<0) return 1;
+    BotPeer *p=Bot_Peer(r->slot);
+    return p && p->netId==r->netId && p->guid==r->guid && p->signature==r->signature &&
+        !(jkPlayer_playerInfos[r->slot].pLocalPlayer->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED));
+}
+
+static flex_t Bot_AttentionScore(BotHeard *r)
+{
+    flex_t age=bot.now-r->last;
+    flex_t weight=r->cue.kind==BOT_HEARD_PROJECTILE ? 1.4f : r->cue.kind==BOT_HEARD_WEAPON ? 1.2f : 1;
+    return weight*r->cue.strength*(1-age/Bot_HearingLifetime(r->cue.kind));
+}
+
+static void Bot_Hear(SithThing *self,SithThing *emitter,SithSector *sector,rdVector3 source,
+                     flex_t volume,flex_t nearRadius,flex_t farRadius,int kind)
+{
+    rdVector3 anchor;
+    flex_t distance;
+    int indirect;
+    if (!Bot_AcousticPath(self,sector,source,farRadius,&anchor,&distance,&indirect)) return;
+    flex_t gain=Bot_Clamp(volume,0,1.5f);
+    if (farRadius>nearRadius) gain*=1-Bot_Clamp((distance-nearRadius)/(farRadius-nearRadius),0,1);
+    if (indirect) gain*=0.62f;
+    if (gain<0.055f) return;
+    gain=Bot_Min(gain,1);
+    /* A fixed grid avoids recovering precise coordinates by averaging jitter
+       across identical events. Never keep the true source position in memory. */
+    flex_t grid=indirect ? 0.4f : gain>=0.55f ? 0.16f : 0.32f;
+    anchor.x=(floorf(anchor.x/grid)+0.5f)*grid;
+    anchor.y=(floorf(anchor.y/grid)+0.5f)*grid;
+    anchor.z=(floorf(anchor.z/grid)+0.5f)*grid;
+    int slot=emitter && emitter->type==SITH_THING_PLAYER ? Bot_PlayerSlot(emitter) : -1;
+    BotPeer *peer=slot>=0 ? Bot_Peer(slot) : NULL;
+    uint32_t signature=emitter ? emitter->signature : 0;
+    int replace=0;
+    flex_t lowest=1e20f, first=bot.now;
+    for (int i=0;i<BOT_HEARD_CAP;i++) {
+        BotHeard *r=&ears.records[i];
+        int valid=Bot_HearingCurrent(r);
+        if (valid && r->cue.kind==kind && r->slot==slot && r->signature==signature &&
+            Bot_Distance(r->cue.position,anchor)<grid*2.2f && bot.now-r->last<0.32f) {
+            replace=i; first=r->first; break;
+        }
+        flex_t score=valid ? Bot_AttentionScore(r) : -1;
+        if (score<lowest) { replace=i; lowest=score; }
+    }
+    ears.records[replace]=(BotHeard){{kind,anchor,0,gain,indirect ? distance+grid : grid},first,bot.now,
+        slot,peer ? peer->netId : 0,peer ? peer->guid : 0,signature};
+    if (gain>=0.22f) bot.nextScan=bot.now;
+}
+
+static void Bot_RegisterAudioLoop(SithThing *thing,const sithSound *sound,flex_t volume,
+                                  flex_t nearRadius,flex_t farRadius)
+{
+    int dest=-1;
+    for (int i=0;i<BOT_SOUND_LOOPS;i++) {
+        BotSoundLoop *loop=&ears.loops[i];
+        if (loop->sound==sound && loop->idx==thing->idx && loop->signature==thing->signature) { dest=i; break; }
+        if (!loop->sound && dest<0) dest=i;
+    }
+    if (dest>=0) ears.loops[dest]=(BotSoundLoop){sound,thing->idx,thing->signature,volume,nearRadius,farRadius,bot.now+0.09f,volume,bot.now,bot.now};
+}
+
+void jkBot_ObserveSound(SithThing *emitter,SithSector *sector,const rdVector3 *position,
+    const sithSound *sound,flex_t volume,flex_t minRadius,flex_t maxRadius,int flags,int soundClass)
+{
+    if (!bot.enabled || !bot.joined || !sound || !position || !isfinite(volume) || volume<=0 ||
+        !isfinite(minRadius) || !isfinite(maxRadius) || minRadius<0 || maxRadius<=0 ||
+        maxRadius<minRadius || (flags&SITHSOUNDFLAG_AMBIENT_NOPAN)) return;
+    SithThing *self=Bot_HearingListener();
+    if (!self || Bot_OwnAudio(emitter,self)) return;
+    int kind=Bot_SoundKind(emitter,sound,soundClass);
+    if (!kind) return;
+    const int followLoop=SITHSOUNDFLAG_FOLLOWSTHING|SITHSOUNDFLAG_LOOP;
+    if ((flags&followLoop)==followLoop && soundClass>=0 && emitter && emitter->type==SITH_THING_WEAPON)
+        Bot_RegisterAudioLoop(emitter,sound,volume,minRadius,maxRadius);
+    if (!isfinite(position->x) || !isfinite(position->y) || !isfinite(position->z)) return;
+    rdVector3 source=*position;
+    if (!sector) {
+        if (Bot_Distance(source,self->position)>maxRadius) return;
+        sector=Bot_SectorAt(&source,self->sector);
+    }
+    Bot_Hear(self,emitter,sector,source,volume,minRadius,maxRadius,kind);
+}
+
+static flex_t Bot_LoopVolume(const BotSoundLoop *loop)
+{
+    if (bot.now>=loop->fadeEnd) return loop->targetVolume;
+    flex_t t=(bot.now-loop->fadeStart)/(loop->fadeEnd-loop->fadeStart);
+    return loop->volume+(loop->targetVolume-loop->volume)*Bot_Clamp(t,0,1);
+}
+
+void jkBot_AdjustSound(const sithPlayingSound *channel,flex_t volume,flex_t fadeSeconds)
+{
+    const int required=SITHSOUNDFLAG_LOOP|SITHSOUNDFLAG_FOLLOWSTHING;
+    if (!bot.enabled || !channel || !channel->thing || (channel->flags&required)!=required ||
+        !isfinite(volume) || !isfinite(fadeSeconds)) return;
+    for (int i=0;i<BOT_SOUND_LOOPS;i++) {
+        BotSoundLoop *loop=&ears.loops[i];
+        if (loop->sound && loop->sound==channel->sound && loop->idx==channel->thing->idx &&
+            loop->signature==channel->thing->signature) {
+            loop->volume=Bot_LoopVolume(loop);
+            loop->targetVolume=Bot_Clamp(volume,0,1.5f);
+            loop->fadeStart=bot.now; loop->fadeEnd=bot.now+Bot_Max(0,fadeSeconds);
+        }
+    }
+}
+
+void jkBot_StopSound(const SithThing *emitter,const sithSound *sound)
+{
+    if (!bot.enabled || !emitter) return;
+    for (int i=0;i<BOT_SOUND_LOOPS;i++) {
+        BotSoundLoop *loop=&ears.loops[i];
+        if (loop->idx==emitter->idx && loop->signature==emitter->signature && (!sound || sound==loop->sound))
+            loop->sound=NULL;
+    }
+}
+
+static void Bot_UpdateAudioLoops(SithThing *self)
+{
+    if (!Bot_HearingListener()) return;
+    for (int i=0;i<BOT_SOUND_LOOPS;i++) {
+        BotSoundLoop *loop=&ears.loops[i];
+        if (!loop->sound) continue;
+        if (loop->idx>=(unsigned)Bot_ThingCount()) { loop->sound=NULL; continue; }
+        SithThing *t=&bot.world->aThings[loop->idx];
+        if (t->signature!=loop->signature || t->type!=SITH_THING_WEAPON ||
+            !t->sector || t->flags&(SITH_TF_DEAD|SITH_TF_DISABLED|SITH_TF_DESTROYED)) { loop->sound=NULL; continue; }
+        if (bot.now>=loop->next) {
+            loop->next=bot.now+0.09f;
+            flex_t volume=Bot_LoopVolume(loop);
+            if (volume>0) Bot_Hear(self,t,t->sector,t->position,volume,loop->nearRadius,loop->farRadius,BOT_HEARD_PROJECTILE);
+        }
+    }
+}
+
+static BotHeard *Bot_Attention(void)
+{
+    BotHeard *best=NULL;
+    flex_t bestScore=0;
+    for (int i=0;i<BOT_HEARD_CAP;i++) {
+        BotHeard *r=&ears.records[i];
+        if (!Bot_HearingCurrent(r)) { r->cue.kind=0; continue; }
+        flex_t score=Bot_AttentionScore(r);
+        if (score>bestScore) { best=r; bestScore=score; }
+    }
+    return best;
+}
+
+int jkBot_GetHearing(jkBotHearing *out)
+{
+    if (!out) return 0;
+    memset(out,0,sizeof(*out));
+    if (!Bot_HearingListener()) return 0;
+    BotHeard *r=Bot_Attention();
+    if (!r) return 0;
+    *out=r->cue;
+    out->age=bot.now-r->last;
+    return 1;
+}
+
+static int Bot_InvestigateSound(SithThing *self)
+{
+    if (Bot_ObjectiveUrgent(self) || Bot_NavigationWaiting(self)) return 0;
+    BotHeard *r=Bot_Attention();
+    if (!r || bot.now-r->first<(r->cue.strength>=0.35f ? 0.05f : 0.12f)) return 0;
+    /* A projectile cue has no movement of its own. Keep making route
+       progress after a costly supply dive while still attending to the cue. */
+    if (r->cue.kind==BOT_HEARD_PROJECTILE && Bot_DeferSupplyApproaches(self) &&
+        (!(self->sector->flags&SITH_SECTOR_UNDERWATER) || Bot_OnDeferredCrossing())) {
+        Bot_Navigate(self);
+        if (bot.routeMode==BOT_ROUTE_SWIM || bot.routeMode==BOT_ROUTE_WATER_ENTRY) bot.routeAim=1;
+    }
+    rdVector3 d=Bot_Sub(r->cue.position,self->position);
+    flex_t error=Bot_Aim(self,r->cue.position,1);
+    if (error<45 && Bot_Horizontal(d)>0.28f && r->cue.kind!=BOT_HEARD_PROJECTILE)
+        Bot_Move(self,d,0);
+    return 1;
+}
diff --git a/src/AI/jkBotLily.inc b/src/AI/jkBotLily.inc
new file mode 100644
index 0000000000000000000000000000000000000000..718639043a3edf16ad4a1afdcf6c2510274f751f
--- /dev/null
+++ b/src/AI/jkBotLily.inc
@@ -0,0 +1,337 @@
+/* Opt-in companion input authority. Only the normal control driver consumes
+   these axes and keys. Transport and game clocks deliberately stay distinct. */
+enum { LILY_BASELINE,LILY_ROUTE,LILY_MOTOR };
+enum { LILY_IDLE,LILY_QUEUED,LILY_STARTED,LILY_RUNNING,LILY_COMPLETED,LILY_INTERRUPTED,LILY_FAILED,LILY_EXPIRED };
+enum { LILY_NONE,LILY_RELEASED,LILY_LIFE,LILY_WORLD,LILY_DEADLINE,LILY_INVALID_ROUTE,LILY_SURVIVAL,LILY_DISCONNECTED,LILY_REPLACED };
+enum { LILY_NO_OUTCOME,LILY_ARRIVED,LILY_PLAYBACK };
+typedef struct LilyStep {
+    unsigned duration,buttons,weapon,force;
+    float axes[4];
+} LilyStep;
+typedef struct LilyAction {
+    uint32_t seq,revision,sample;
+    int owner,node,count,index;
+    double expiry,applied,stepMs;
+    LilyStep steps[5];
+} LilyAction;
+static struct {
+    int enabled, neutral, motorBoundary, forceRequest;
+    uint32_t sample,offer;
+    struct { uint32_t id; double time; } samples[32];
+    int choices[8],choiceCount;
+    double offeredAt,tickMs,nextSense;
+    LilyAction active,queued;
+    struct { unsigned char data[24]; int repeats; } terminal[4];
+    unsigned terminalCursor;
+} lily;
+static const int lilyAxes[]={INPUT_FUNC_FORWARD,INPUT_FUNC_SLIDE,INPUT_FUNC_TURN,INPUT_FUNC_PITCH};
+static const int lilyButtons[]={INPUT_FUNC_JUMP,INPUT_FUNC_DUCK,INPUT_FUNC_ACTIVATE,INPUT_FUNC_FIRE1,INPUT_FUNC_FIRE2};
+
+static void Lily_Configure(void)
+{
+    memset(&lily,0,sizeof(lily));
+    const char *enabled=getenv("JK_BOT_LILY");
+    lily.enabled=enabled && !strcmp(enabled,"1");
+}
+static int Lily_Routing(void) { return lily.active.owner==LILY_ROUTE; }
+
+static void Lily_Progress(const LilyAction *a,int phase,int reason,int outcome)
+{
+    unsigned char data[24];
+    Companion_Put(data,a->seq); Companion_Put(data+4,a->revision); Companion_Put(data+8,a->sample);
+    data[12]=a->owner; data[13]=phase; data[14]=reason; data[15]=outcome;
+    Companion_Put(data+16,(a->applied>=UINT32_MAX ? UINT32_MAX : (uint32_t)(a->applied+0.5))); Companion_Put(data+20,(uint32_t)a->node);
+    Companion_Event(CP_PROGRESS,data,sizeof(data));
+    if (phase>=LILY_COMPLETED) {
+        unsigned i=lily.terminalCursor++%4;
+        memcpy(lily.terminal[i].data,data,sizeof(data)); lily.terminal[i].repeats=3;
+    }
+}
+static void Lily_Finish(LilyAction *a,int phase,int reason,int outcome)
+{
+    if (!a->seq) return;
+    Lily_Progress(a,phase,reason,outcome);
+    if (a==&lily.active && a->owner==LILY_ROUTE) {
+        bot.goal=-1; bot.routeCount=bot.routePos=0; bot.nextPlan=0;
+    }
+    memset(a,0,sizeof(*a));
+}
+static void Lily_ReleaseForce(int cancel)
+{
+    if (lily.forceRequest && bot.forceBin>=0) {
+        bot.forceUntil=bot.now;
+        if (cancel && (bot.forceBin==SITHBIN_F_THROW || bot.forceBin==SITHBIN_F_PULL ||
+            bot.forceBin==SITHBIN_F_GRIP || bot.forceBin==SITHBIN_F_BLINDING)) bot.forceCancel=1;
+    }
+    lily.forceRequest=0;
+}
+static void Lily_Clear(int reason)
+{
+    if (!lily.enabled) return;
+    if (lily.active.seq || lily.motorBoundary) lily.neutral=1;
+    Lily_ReleaseForce(lily.active.owner==LILY_MOTOR);
+    lily.motorBoundary=0;
+    Lily_Finish(&lily.active,LILY_INTERRUPTED,reason,0);
+    Lily_Finish(&lily.queued,LILY_INTERRUPTED,reason,0);
+}
+static void Lily_NewFence(int reason)
+{
+    Lily_Clear(reason);
+    lily.sample=lily.offer=0; lily.choiceCount=0; lily.offeredAt=lily.nextSense=0;
+    memset(lily.samples,0,sizeof(lily.samples));
+    memset(lily.terminal,0,sizeof(lily.terminal));
+}
+static int Lily_Atomic(SithThing *self)
+{
+    return (nav.liftWaitAt>0 && nav.waitUntil>bot.now) ||
+        (nav.crossingEntry && nav.crossingUntil>bot.now) ||
+        nav.waterExitUntil>0 || nav.jumpUntil>bot.now || nav.forceJumpPending ||
+        nav.combatJumpUntil>bot.now || bot.forceBin>=0 || bot.forceCancel || Bot_ActiveCompetitiveGrip(self);
+}
+static int Lily_Command(int kind,const unsigned char *p,int size,uint32_t seq,double expiry)
+{
+    if (!lily.enabled) return CP_UNAVAILABLE;
+    if ((kind==CP_COMMIT && size!=24) || (kind==CP_MOTOR && size<17)) return CP_INVALID;
+    LilyAction a={.seq=seq,.expiry=expiry,.revision=Companion_Word(p+12),.sample=Companion_Word(p+8),.node=-1};
+    if (!a.revision || !a.sample) return CP_INVALID;
+    if (lily.samples[a.sample%32].id!=a.sample || companion.now-lily.samples[a.sample%32].time>1)
+        return CP_OBSOLETE;
+    if (kind==CP_COMMIT) {
+        uint32_t offer=Companion_Word(p+16),node=Companion_Word(p+20);
+        if (!offer || node>=BOT_NODES) return CP_INVALID;
+        if (lily.offer!=offer || companion.now-lily.offeredAt>2) return CP_OBSOLETE;
+        int found=0;
+        for (int i=0;i<lily.choiceCount;i++) if (lily.choices[i]==(int)node) found=1;
+        if (!found) return CP_OBSOLETE;
+        a.owner=LILY_ROUTE; a.node=(int)node;
+    } else {
+        a.owner=LILY_MOTOR; a.count=p[16];
+        if (a.count<1 || a.count>5 || size!=17+9*a.count) return CP_INVALID;
+        unsigned total=0;
+        for (int i=0;i<a.count;i++) {
+            const unsigned char *step=p+17+9*i;
+            LilyStep *s=&a.steps[i];
+            s->duration=step[0]|(step[1]<<8); total+=s->duration;
+            s->buttons=step[6]; s->weapon=step[7]; s->force=step[8];
+            if (!s->duration || total>600 || s->buttons>31 || s->weapon>10 ||
+                (s->force && (s->force<21 || s->force>34))) return CP_INVALID;
+            for (int k=0;k<4;k++) {
+                int axis=step[k+2]; if (axis>127) axis-=256;
+                if (axis < -100 || axis>100) return CP_INVALID;
+                s->axes[k]=axis/100.0f;
+            }
+        }
+    }
+    if (lily.queued.seq || (lily.active.seq && (a.owner!=LILY_MOTOR || lily.active.owner!=LILY_MOTOR)))
+        return CP_UNAVAILABLE;
+    lily.queued=a; Lily_Progress(&a,LILY_QUEUED,0,0);
+    return CP_OK;
+}
+static int Lily_RouteStart(SithThing *self,int node)
+{
+    if (node<0 || node>=bot.nNodes || !Bot_SectorSafe(bot.nodes[node].sector) ||
+        bot.nodes[node].avoidUntil>bot.now) return 0;
+    BotGoalPaths paths;
+    paths.start=Bot_Nearest(self);
+    Bot_PathDistances(self,paths.start,paths.distance,paths.parent);
+    if (paths.start<0 || paths.distance[node]>=1e19f) return 0;
+    Bot_ClearEquipment("lily-route"); nav.pursuitNet=0; nav.objectiveRouteNode=-1;
+    return Bot_SetRoute(paths.start,node,paths.parent);
+}
+static int Lily_Arrived(SithThing *self,int node)
+{
+    if (!Lily_Routing() || lily.active.node!=node) return 0;
+    /* The follower verified horizontal and vertical proximity. Disconnected
+       overlapping sectors must not create a false arrival. */
+    if (self->sector==bot.nodes[node].sector)
+        Lily_Finish(&lily.active,LILY_COMPLETED,0,LILY_ARRIVED);
+    else Lily_Finish(&lily.active,LILY_FAILED,LILY_INVALID_ROUTE,0);
+    return 1;
+}
+static int Lily_FireAllowed(SithThing *self,int weapon)
+{
+    if (bot.sabersOnly && weapon!=SITHBIN_LIGHTSABER) return 0;
+    /* Policy aim is independent of the autonomous target. Check its actual
+       cone and splash margin for peaceful players and teammates. */
+    flex_t pitch=self->actorParams.headPYR.x/BOT_DEG;
+    rdVector3 aim=self->orient.lvec,up=self->orient.uvec;
+    aim=(rdVector3){aim.x*cosf(pitch)+up.x*sinf(pitch),aim.y*cosf(pitch)+up.y*sinf(pitch),
+                    aim.z*cosf(pitch)+up.z*sinf(pitch)};
+    int melee=weapon==SITHBIN_FISTS || weapon==SITHBIN_LIGHTSABER;
+    int splash=weapon==SITHBIN_CONCUSSION_RIFLE || weapon==SITHBIN_RAIL_DETONATOR ||
+               weapon==SITHBIN_THERMAL_DETONATOR || weapon==SITHBIN_SEQUENCER_CHARGE;
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        if (!Bot_ProtectedPlayer(self,(int)i)) continue;
+        SithThing *peer=jkPlayer_playerInfos[i].pLocalPlayer;
+        rdVector3 delta=Bot_Sub(peer->position,self->position);
+        flex_t length=Bot_Len(delta),along=Bot_Dot(delta,aim);
+        if (melee) { if (length<0.8f) return 0; continue; }
+        if (weapon==SITHBIN_TUSKEN_PROD && length<8) return 0;
+        flex_t margin=peer->collideSize+(splash ? 1.5f : 0.15f)+Bot_Max(0,along)*0.12f;
+        if ((splash && length<1.5f) || (along>0 && length*length-along*along<margin*margin)) return 0;
+    }
+    return 1;
+}
+static void Lily_Motor(SithThing *self)
+{
+    LilyAction *a=&lily.active; LilyStep *s=&a->steps[a->index];
+    for (int k=0;k<4;k++) bot.axes[lilyAxes[k]]=s->axes[k];
+    for (int k=0;k<5;k++) bot.keys[lilyButtons[k]]=!!(s->buttons&(1u<<k));
+    if ((s->buttons&24) && !Lily_FireAllowed(self,sithInventory_GetCurrentWeapon(self)))
+        bot.keys[INPUT_FUNC_FIRE1]=bot.keys[INPUT_FUNC_FIRE2]=0;
+    if (s->weapon && (!bot.sabersOnly || s->weapon==SITHBIN_LIGHTSABER) &&
+        Bot_HasWeapon(self,s->weapon)) bot.keys[INPUT_FUNC_SELECT1+s->weapon-1]=1;
+    if (lily.forceRequest && lily.forceRequest!=(int)s->force) {
+        Lily_ReleaseForce(0);
+        Bot_ForceControl(self,NULL,180,0);
+    }
+    if (s->force && lily.forceRequest!=(int)s->force &&
+        Bot_RequestForce(self,s->force,s->duration/1000.0f,bot.targetSlot)) lily.forceRequest=s->force;
+    if (s->force && (int)s->force==bot.forceBin) bot.forceUntil=bot.now+bot.frameDt+0.001f;
+    Bot_ForceControl(self,NULL,180,0);
+    a->stepMs+=lily.tickMs; a->applied+=lily.tickMs;
+}
+/* The frame's sense sample retains the identity of the controls just emitted.
+   Commit its elapsed duration before a later deadline, command or fence can
+   reinterpret already played input. The next tick can renew the held keys. */
+static void Lily_EndFrame(void)
+{
+    LilyAction *a=&lily.active;
+    if (a->owner!=LILY_MOTOR || a->stepMs+0.0001<a->steps[a->index].duration) return;
+    a->stepMs=0;
+    if (++a->index==a->count) {
+        Lily_Finish(a,LILY_COMPLETED,0,LILY_PLAYBACK);
+        lily.motorBoundary=1;
+    }
+}
+static int Lily_Drive(SithThing *self)
+{
+    if (!lily.enabled) return 0;
+    if (!Companion_Connected() || !companion.identified) Lily_Clear(LILY_DISCONNECTED);
+    if (lily.queued.seq && companion.now>=lily.queued.expiry)
+        Lily_Finish(&lily.queued,LILY_EXPIRED,LILY_DEADLINE,0);
+    if (lily.active.seq && companion.now>=lily.active.expiry) {
+        Lily_ReleaseForce(1); Lily_Finish(&lily.active,LILY_EXPIRED,LILY_DEADLINE,0); lily.neutral=1;
+    }
+    if (lily.neutral) { lily.neutral=0; Bot_ForceControl(self,NULL,180,0); return 1; }
+    if (lily.motorBoundary) {
+        lily.motorBoundary=0;
+        if (lily.queued.owner!=LILY_MOTOR) {
+            Lily_ReleaseForce(0); Bot_ForceControl(self,NULL,180,0); return 1;
+        }
+    }
+    if (!lily.active.seq && lily.queued.seq) {
+        if (Lily_Atomic(self) && !lily.forceRequest) return 0;
+        lily.active=lily.queued; memset(&lily.queued,0,sizeof(lily.queued));
+        if (Lily_Routing() && !Lily_RouteStart(self,lily.active.node)) {
+            Lily_Finish(&lily.active,LILY_INTERRUPTED,LILY_INVALID_ROUTE,0); return 0;
+        }
+        /* The old strategy timer must never clear a newly owned route. Its
+           plan-reset helper owns the legacy goal and is not a handover API. */
+        companion.policy=(CompanionPolicy){0};
+        Lily_Progress(&lily.active,LILY_STARTED,0,0);
+        bot.stuckAt=bot.now; bot.progressPos=self->position; bot.nextRecovery=0;
+    }
+    if (!lily.active.seq) return 0;
+    Bot_UpdateAudioLoops(self); (void)Bot_UpdateTarget(self);
+    if (lily.active.owner==LILY_MOTOR) { Lily_Motor(self); return 1; }
+    if (Bot_NeedsAir(self) || nav.diveEscape) {
+        Lily_Finish(&lily.active,LILY_INTERRUPTED,LILY_SURVIVAL,0); return 0;
+    }
+    if (bot.goal!=lily.active.node || bot.routePos>=bot.routeCount) {
+        Lily_Finish(&lily.active,LILY_FAILED,LILY_INVALID_ROUTE,0); return 0;
+    }
+    lily.active.applied+=lily.tickMs;
+    if (nav.waterExitUntil>0) Bot_ContinueWaterExit(self);
+    else { Bot_Navigate(self); Bot_ForceControl(self,NULL,180,0); }
+    if (Lily_Routing()) {
+        Bot_Recovery(self);
+        if (bot.goal!=lily.active.node) Lily_Finish(&lily.active,LILY_FAILED,LILY_INVALID_ROUTE,0);
+    }
+    return 1;
+}
+static void Lily_Offers(SithThing *self,int dead)
+{
+    unsigned char data[9+8*30];
+    float costs[8],scores[8]; lily.choiceCount=0;
+    if (!dead && bot.graphDone && bot.nNodes) {
+        BotGoalPaths paths;
+        paths.start=Bot_Nearest(self);
+        Bot_PathDistances(self,paths.start,paths.distance,paths.parent);
+        for (int n=0;paths.start>=0 && n<bot.nNodes;n++) {
+            BotNode *node=&bot.nodes[n]; float cost=paths.distance[n];
+            if (!Bot_SectorSafe(node->sector) || node->avoidUntil>bot.now || cost>=1e19f || !isfinite(cost)) continue;
+            float direct=Bot_Distance(self->position,node->pos);
+            if (direct<0.13f) continue;
+            float value=Bot_ItemValue(self,node->item);
+            if (node->item>=0 && (!Bot_NavThing(node->item) || value<=0.05f)) continue;
+            cost+=Bot_Distance(self->position,bot.nodes[paths.start].pos);
+            float score=(node->item>=0 ? value : 1.0f+Bot_Clamp((bot.now-node->visited)/40.0f,0,2)) /
+                         (1.0f+0.25f*cost);
+            int j=lily.choiceCount;
+            while (j && scores[j-1]<score) j--;
+            if (j>=8) continue;
+            int from=n,length=0;
+            while (from>=0 && from!=paths.start && length<BOT_PATH) { from=paths.parent[from]; length++; }
+            if (from!=paths.start) continue;
+            if (lily.choiceCount<8) lily.choiceCount++;
+            for (int k=lily.choiceCount-1;k>j;k--) {
+                costs[k]=costs[k-1]; scores[k]=scores[k-1]; lily.choices[k]=lily.choices[k-1];
+            }
+            costs[j]=cost; scores[j]=score; lily.choices[j]=n;
+        }
+    }
+    lily.offer=Companion_Next(lily.offer); lily.offeredAt=companion.now;
+    Companion_Put(data,lily.sample); Companion_Put(data+4,lily.offer); data[8]=lily.choiceCount;
+    for (int i=0;i<lily.choiceCount;i++) {
+        unsigned char *p=data+9+30*i;
+        int n=lily.choices[i]; BotNode *node=&bot.nodes[n];
+        SithThing *item=Bot_NavThing(node->item);
+        Companion_Put(p,n); Companion_Put(p+4,node->sector->id);
+        p[8]=item!=NULL; p[9]=item ? Bot_PickupType(item).bin : 0;
+        Companion_Vector(p+10,node->pos); Companion_PutFloat(p+22,costs[i]); Companion_PutFloat(p+26,scores[i]);
+    }
+    Companion_Event(CP_OFFERS,data,9+lily.choiceCount*30);
+}
+static void Lily_Publish(SithThing *self,int dead)
+{
+    if (!lily.enabled) return;
+    lily.nextSense=companion.now+0.05;
+    unsigned char p[108+8*40]={0};
+    LilyAction *a=lily.active.seq ? &lily.active : &lily.queued;
+    lily.sample=Companion_Next(lily.sample);
+    lily.samples[lily.sample%32].id=lily.sample; lily.samples[lily.sample%32].time=companion.now;
+    Companion_Put(p,lily.sample); Companion_Put(p+4,a->seq); Companion_Put(p+8,a->revision);
+    Companion_Put(p+12,a->sample); Companion_Put(p+16,a->seq ? (uint32_t)a->node : UINT32_MAX);
+    p[20]=a->owner; p[21]=lily.active.seq ? LILY_RUNNING : lily.queued.seq ? LILY_QUEUED : LILY_IDLE;
+    p[22]=!dead && !a->seq && !Lily_Atomic(self); p[23]=!!self->attach_flags;
+    Companion_Put(p+24,!!(self->sector->flags&SITH_SECTOR_UNDERWATER));
+    Companion_Vector(p+28,self->position); Companion_Vector(p+40,self->physicsParams.vel);
+    Companion_Vector(p+52,self->orient.lvec); Companion_Vector(p+64,self->orient.uvec);
+    Companion_PutFloat(p+76,self->actorParams.headPYR.x); Companion_PutFloat(p+80,self->actorParams.endurance);
+    Companion_PutFloat(p+84,(float)lily.tickMs);
+    for (int i=0;i<4;i++) Companion_PutFloat(p+88+i*4,bot.axes[lilyAxes[i]]);
+    for (int i=0;i<5;i++) if (bot.keys[lilyButtons[i]]) p[104]|=1u<<i;
+    for (int w=1;w<=10;w++) if (bot.keys[INPUT_FUNC_SELECT1+w-1]) p[105]=w;
+    for (int f=21;f<=34;f++) {
+        int key=Bot_PowerKey(f);
+        if (key>=0 && bot.keys[key]) p[106]=f;
+    }
+    for (unsigned i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS && p[107]<8;i++) {
+        SithPlayer *player=&jkPlayer_playerInfos[i]; SithThing *t=player->pLocalPlayer;
+        if (!(player->flags&1) || !player->playerNetId || !t || t==self || !t->sector ||
+            t->type!=SITH_THING_PLAYER || t->flags&(SITH_TF_DESTROYED|SITH_TF_DISABLED|SITH_TF_DEAD)) continue;
+        unsigned char *q=p+108+p[107]++*40;
+        Companion_Put(q,i); Companion_Put(q+4,player->playerNetId); Companion_Put(q+8,t->guid);
+        Companion_Put(q+12,t->sector->id); Companion_Vector(q+16,t->position); Companion_Vector(q+28,t->physicsParams.vel);
+    }
+    Companion_Event(CP_SENSE,p,108+p[107]*40);
+    if (!lily.offer || companion.now-lily.offeredAt>=1) Lily_Offers(self,dead);
+    for (int i=0;i<4;i++) if (lily.terminal[i].repeats) {
+        lily.terminal[i].repeats--;
+        Companion_Event(CP_PROGRESS,lily.terminal[i].data,sizeof(lily.terminal[i].data));
+    }
+    if (lily.active.seq) Lily_Progress(&lily.active,LILY_RUNNING,0,0);
+}
+
+static int Lily_SenseDue(double now) { return lily.enabled && now>=lily.nextSense; }
diff --git a/src/AI/jkBotLoadout.h b/src/AI/jkBotLoadout.h
new file mode 100644
index 0000000000000000000000000000000000000000..d167eb8e228734fa0eab9a9b7f060524a0586fd8
--- /dev/null
+++ b/src/AI/jkBotLoadout.h
@@ -0,0 +1,59 @@
+#ifndef _JKBOTLOADOUT_H
+#define _JKBOTLOADOUT_H
+
+#include <string.h>
+
+/* A saved JK multiplayer character, built before joining a session.
+ * The stock character editor grants three stars per rank, four per power,
+ * neutral powers at rank 1 and successive side powers at ranks 4..7.
+ * These are JK inventory bins, not input ordinals or MotS bins.
+ * No live inventory, mana, health or ammunition is changed here.
+ */
+typedef struct jkBotLoadout {
+    int rank, unspent;
+    int stars[35];
+} jkBotLoadout;
+
+enum { JKBOT_STYLE_BALANCED, JKBOT_STYLE_MASTER, JKBOT_STYLE_COMPETITIVE };
+
+static inline int jkBotLoadout_Style(const char *name)
+{
+    if (!name || !strcmp(name, "balanced")) return JKBOT_STYLE_BALANCED;
+    if (!strcmp(name, "master")) return JKBOT_STYLE_MASTER;
+    if (!strcmp(name, "competitive")) return JKBOT_STYLE_COMPETITIVE;
+    return -1;
+}
+
+static inline int jkBotLoadout_Plan(int rank, int dark, int style, jkBotLoadout *out)
+{
+    if (!out || rank < 0 || rank > 8 || (dark != 0 && dark != 1)
+            || style < JKBOT_STYLE_BALANCED || style > JKBOT_STYLE_COMPETITIVE) return 0;
+    *out = (jkBotLoadout){0};
+    out->rank = rank;
+    out->unspent = rank * 3;
+    if (!rank) return 1;
+    const int side = dark ? 30 : 25;
+    if (rank == 8 && style == JKBOT_STYLE_MASTER) {
+        /* The original editor derives the rank-eight special only with all
+         * four side powers at four stars and no neutral/opposite powers.
+         * The remaining eight stars stay unspent, exactly as in the editor. */
+        for (int i = 0; i < 4; ++i) out->stars[side + i] = 4;
+        out->unspent -= 16;
+        return 1;
+    }
+    const int balanced[] = {21, 22, side, 24, 23, side+1, side+2, side+3};
+    const int competitive[] = {21, 22, 23, 24, dark ? 31 : 28, dark ? 33 : 25};
+    const int *order = style == JKBOT_STYLE_COMPETITIVE ? competitive : balanced;
+    int count = style == JKBOT_STYLE_COMPETITIVE ? sizeof(competitive)/sizeof(*competitive)
+                                                 : sizeof(balanced)/sizeof(*balanced);
+    for (int level = 1; level <= 4 && out->unspent; ++level) {
+        for (int i = 0; i < count && out->unspent; ++i) {
+            int bin = order[i];
+            if (bin >= side && bin < side+4 && rank < 4 + bin-side) continue;
+            out->stars[bin]++;
+            out->unspent--;
+        }
+    }
+    return 1;
+}
+#endif
diff --git a/src/AI/jkBotNavigate.inc b/src/AI/jkBotNavigate.inc
new file mode 100644
index 0000000000000000000000000000000000000000..9e564192a040fafbe84056f2095cc2a7fb5342b3
--- /dev/null
+++ b/src/AI/jkBotNavigate.inc
@@ -0,0 +1,592 @@
+/* Movement execution for jkBotNavigation.inc; ordinary inputs only. */
+/* Stock FreeCam tilts forward thrust with head pitch. Keep the extra
+   upward stroke inside checked water clearance, including its lateral drift. */
+static void Bot_SwimUp(SithThing *self)
+{
+    if (self->actorParams.headPYR.x<=55 || (self->physicsParams.flags&SITH_PF_ONWATERSURFACE)) return;
+    flex_t pitch=self->actorParams.headPYR.x/BOT_DEG;
+    rdVector3 up=self->position;
+    flex_t reach=0.16f*cosf(pitch);
+    up.x+=self->orient.lvec.x*reach; up.y+=self->orient.lvec.y*reach;
+    up.z+=0.16f*sinf(pitch);
+    if (Bot_WaterClear(self->sector,self->position,up,self->moveSize)) bot.axes[INPUT_FUNC_FORWARD]=1;
+}
+
+/* When a swim route is obstructed, a directly reachable breathing surface
+   takes precedence. Recheck the open column as the swimmer drifts. */
+static int Bot_SeekSurface(SithThing *self)
+{
+    nav.seekingSurface=0;
+    if (!Bot_NeedsAir(self) || !self->actorParams.endurance ||
+        (self->physicsParams.flags&SITH_PF_ONWATERSURFACE)) return 0;
+    BotNode actual={.pos=self->position,.sector=self->sector};
+    rdVector3 surface;
+    if (!Bot_WaterSurface(&actual,self->moveSize,&surface)) return 0;
+    surface.x+=self->orient.lvec.x*0.01f; surface.y+=self->orient.lvec.y*0.01f;
+    bot.followingRoute=0; bot.routeAim=1;
+    Bot_Aim(self,surface,0); Bot_SwimUp(self);
+    bot.keys[INPUT_FUNC_JUMP]=1; nav.seekingSurface=1;
+    return 1;
+}
+
+/* Match the acceleration used to validate a precision jump even if stock
+   Speed activates or expires between two control frames. */
+static flex_t Bot_PrecisionThrottle(SithThing *self)
+{
+    flex_t thrust=self->actorParams.maxThrust, extra=self->actorParams.extraSpeed;
+    return extra>0 && thrust>0 ? thrust/(thrust+extra) : 1.0f;
+}
+
+static int Bot_NavDirectMove(SithThing *self, rdVector3 target, int swim)
+{
+    rdVector3 delta=Bot_Sub(target,self->position);
+    flex_t horizontal=Bot_Horizontal(delta), length=Bot_Len(delta);
+    if (length<0.025f) return 1;
+    rdVector3 probe=Bot_Mix(self->position,target,Bot_Min(1.0f,0.16f/length));
+    if (!Bot_Clear(self,self->sector,self->position,probe,self->collideSize*0.8f,0)) return 0;
+    if (horizontal>0.035f) {
+        rdVector3 direction={delta.x/horizontal,delta.y/horizontal,0};
+        flex_t throttle=horizontal<0.13f ? 0.4f : 1.0f;
+        bot.axes[INPUT_FUNC_FORWARD]=Bot_Clamp(Bot_Dot(direction,self->orient.lvec)*throttle,-0.65f,1.0f);
+        bot.axes[INPUT_FUNC_SLIDE]=Bot_Clamp(Bot_Dot(direction,self->orient.rvec)*throttle,-1.0f,1.0f);
+        if (!swim && nav.jumpUntil>bot.now) {
+            flex_t scale=Bot_PrecisionThrottle(self);
+            bot.axes[INPUT_FUNC_FORWARD]*=scale;
+            bot.axes[INPUT_FUNC_SLIDE]*=scale;
+        }
+    }
+    if (swim) {
+        if (delta.z>0.05f) {
+            if (Bot_NeedsAir(self) && delta.z>0.16f &&
+                (horizontal<0.035f || Bot_Dot(delta,self->orient.lvec)>0.5f*horizontal))
+                Bot_SwimUp(self);
+            /* Surface jump needs a fresh key press; underwater ascent may be held. */
+            if (!(self->physicsParams.flags&SITH_PF_ONWATERSURFACE) || fmodf(bot.now,0.5f)<0.32f)
+                bot.keys[INPUT_FUNC_JUMP]=1;
+        } else if (delta.z < -0.05f) bot.keys[INPUT_FUNC_DUCK]=1;
+    }
+    return 1;
+}
+
+static int Bot_EnterWater(SithThing *self, const BotNode *node, int mode, int from)
+{
+    if ((self->sector->flags&SITH_SECTOR_UNDERWATER) || !(node->sector->flags&SITH_SECTOR_UNDERWATER)) return 0;
+    if (Bot_DeferSupplyApproaches(self) && Bot_ApproachDeferred(Bot_ApproachBank(self),node->sector)) {
+        SithThing *gear=Bot_NavThing(bot.armItem-1);
+        int optional=Bot_OptionalSupply(self,gear);
+        if (!gear && !nav.pursuitNet && nav.objective==BOT_OBJECTIVE_NONE &&
+            bot.goal>=0 && bot.goal<bot.nNodes && nav.supplyApproach.lastResortGoal!=bot.goal+1) {
+            BotNode *goal=&bot.nodes[bot.goal];
+            optional=Bot_OptionalPatrolNode(self,goal,Bot_ItemValue(self,goal->item));
+        }
+        if (optional) {
+            /* This older route may have been valid before recovery/rearming. */
+            bot.goal=-1; bot.routeCount=bot.routePos=0; bot.armNext=bot.nextPlan=0;
+            return 1;
+        }
+    }
+    BotNode actual={.pos=self->position,.sector=self->sector};
+    if (Bot_WaterEntry(&actual,node)) {
+        rdVector3 opening=node->pos; opening.z=self->position.z;
+        Bot_NavDirectMove(self,opening,0); return 1;
+    }
+    if (mode==BOT_ROUTE_WATER_ENTRY && self->attach_flags) {
+        /* First edges start at a graph anchor, which may still lie ahead.
+           Approach it on supported ground before retrying the water entry. */
+        if (from>=0 && bot.nodes[from].sector==self->sector) {
+            BotNode *anchor=&bot.nodes[from];
+            rdVector3 toward=Bot_Sub(anchor->pos,self->position);
+            int drop=0;
+            if (Bot_WaterEntry(anchor,node) && Bot_WalkableSpan(&actual,anchor,&drop,0.001f) && !drop) {
+                Bot_Move(self,toward,0);
+                return 1;
+            }
+        }
+        bot.goal=-1; bot.nextPlan=0; return 1;
+    }
+    return 0;
+}
+
+/* Only ordinary movement axes are used throughout the swim run-up and jump. */
+static void Bot_WaterSteer(SithThing *self,rdVector3 direction)
+{
+    /* Stock Force Speed adds to the actor's thrust. Use the same planned
+       acceleration by easing the analog input during this precision jump. */
+    flex_t throttle=Bot_PrecisionThrottle(self);
+    bot.axes[INPUT_FUNC_FORWARD]=Bot_Clamp(Bot_Dot(direction,self->orient.lvec),-1,1)*throttle;
+    bot.axes[INPUT_FUNC_SLIDE]=Bot_Clamp(Bot_Dot(direction,self->orient.rvec)/0.7f,-1,1)*throttle;
+}
+
+static int Bot_StockWaterMotion(SithThing *self)
+{
+    uint32_t required=SITH_PF_USETHRUST|SITH_PF_USEGRAVITY;
+    uint32_t altered=SITH_PF_FLY|SITH_PF_PARTIALGRAVITY|SITH_PF_200000;
+    return (self->physicsParams.flags&required)==required && !(self->physicsParams.flags&altered) &&
+        self->physicsParams.mass>0 && self->actorParams.maxThrust>0 &&
+        isfinite(self->actorParams.extraSpeed) && self->actorParams.extraSpeed>=0 &&
+        fabsf(self->actorParams.jumpSpeed-nav.jumpVelocity)<0.001f &&
+        !(self->actorParams.flags&(SITH_AF_IMMOBILE|SITH_AF_CONTROLSDISABLED));
+}
+
+static void Bot_ExitWaterMove(SithThing *self)
+{
+    BotNode *wet=&bot.nodes[nav.waterExitFrom], *dry=&bot.nodes[nav.waterExitTo];
+    rdVector3 toward=Bot_Sub(dry->pos,self->position), aim=dry->pos;
+    flex_t distance=Bot_Horizontal(toward);
+    aim.z=self->position.z;
+    Bot_Aim(self,aim,0);
+    if (self->sector==dry->sector && self->attach_flags && distance<0.14f && fabsf(toward.z)<0.15f) {
+        nav.waterExitUntil=0;
+        return;
+    }
+    /* A fast normal ascent can breach the surface before the run-up. Keep
+       the checked shore while gravity returns the swimmer to the same column. */
+    if ((nav.waterExitPhase==0 || nav.waterExitPhase==3) && !self->attach_flags &&
+        self->sector!=wet->sector && Bot_SectorSafe(self->sector) &&
+        !(self->sector->flags&SITH_SECTOR_UNDERWATER) &&
+        Bot_Horizontal(Bot_Sub(self->position,nav.waterExitStart))<0.25f &&
+        self->position.z>=nav.waterExitStart.z) {
+        nav.waterExitPhase=4; nav.waterExitUntil=bot.now+2;
+    }
+    if (bot.now>=nav.waterExitUntil || !Bot_StockWaterMotion(self) || !Bot_SectorSafe(self->sector) ||
+        (nav.waterExitPhase<2 && self->sector!=wet->sector)) {
+        dry->avoidUntil=bot.now+5;
+        nav.waterExitUntil=0; bot.goal=-1; bot.routeCount=0; bot.nextPlan=0;
+        return;
+    }
+    if (nav.waterExitPhase>=3) {
+        /* The stock dry controls release the crouch bit above the water.
+           Let this ordinary vertical hop return to the checked swim start. */
+        if (nav.waterExitPhase==4 && self->sector==wet->sector &&
+            (self->physicsParams.flags&SITH_PF_ONWATERSURFACE)) {
+            nav.waterExitPhase=0; nav.waterExitUntil=bot.now+4;
+        }
+        return;
+    }
+    if (distance<0.01f) return;
+    toward.x/=distance; toward.y/=distance; toward.z=0;
+    if (nav.waterExitPhase==2) {
+        if (distance>0.04f) Bot_WaterSteer(self,toward);
+        return;
+    }
+    int surface=(self->physicsParams.flags&SITH_PF_ONWATERSURFACE)!=0;
+    if (!nav.waterExitPhase) {
+        if (!surface && Bot_NeedsAir(self) && self->position.z<nav.waterExitStart.z-0.075f) {
+            rdVector3 above=nav.waterExitStart;
+            above.z=self->position.z+0.8f;
+            if (Bot_Horizontal(Bot_Sub(above,self->position))<0.001f) {
+                above.x+=self->orient.lvec.x*0.01f; above.y+=self->orient.lvec.y*0.01f;
+            }
+            Bot_Aim(self,above,0); Bot_SwimUp(self);
+            bot.keys[INPUT_FUNC_JUMP]=1;
+            return;
+        }
+        /* Center and settle at the checked swim start. Approach with velocity
+           feedback so momentum from the preceding edge does not carry over. */
+        rdVector3 adjust=Bot_Sub(nav.waterExitStart,self->position);
+        flex_t error=Bot_Horizontal(adjust);
+        adjust.x=5.0f*(3.0f*adjust.x-self->physicsParams.vel.x);
+        adjust.y=5.0f*(3.0f*adjust.y-self->physicsParams.vel.y); adjust.z=0;
+        Bot_WaterSteer(self,adjust);
+        if (!surface) {
+            /* The surface controller captures rise below 0.2 units/s. A
+               long swim can arrive faster, coast into air and lose its run-up.
+               Brake with the ordinary dive input over its stopping distance. */
+            flex_t vz=self->physicsParams.vel.z;
+            flex_t remaining=nav.waterExitStart.z-self->position.z;
+            flex_t braking=(vz*vz-0.15f*0.15f)/(0.6f*self->actorParams.maxThrust);
+            if (vz>0.15f && remaining<=0.05f+vz*bot.frameDt+braking)
+                bot.keys[INPUT_FUNC_DUCK]=1;
+            else bot.keys[INPUT_FUNC_JUMP]=1;
+        }
+        if (!surface || self->position.z<nav.waterExitStart.z || error>0.025f ||
+            Bot_Horizontal(self->physicsParams.vel)>0.085f || fabsf(self->actorParams.headPYR.x)>5 ||
+            Bot_Dot(toward,self->orient.lvec)<0.97f) return;
+        if (self->physicsParams.flags&SITH_PF_CROUCHING) {
+            /* A crouched water jump has only 70% of normal impulse. Clear
+               crouch through the usual dry controls before the bank run-up. */
+            rdVector3 up=self->position; up.z+=0.23f;
+            SithSector *air=Bot_SectorAt(&up,self->sector);
+            if (!bot.previous[INPUT_FUNC_JUMP] && Bot_SectorSafe(air) &&
+                !(air->flags&SITH_SECTOR_UNDERWATER) &&
+                Bot_WaterClear(self->sector,self->position,up,self->moveSize)) {
+                bot.keys[INPUT_FUNC_JUMP]=1; nav.waterExitPhase=3; nav.waterExitUntil=bot.now+2;
+            }
+            return;
+        }
+        nav.waterExitPhase=1; nav.waterExitUntil=bot.now+4;
+    }
+    /* Release underwater ascent first. Take off only while an actual fresh
+       press is available and the measured velocity still clears the rim. */
+    Bot_WaterSteer(self,toward);
+    if (!surface || bot.previous[INPUT_FUNC_JUMP]) return;
+    flex_t speed=Bot_Dot(toward,self->physicsParams.vel);
+    flex_t lateral=toward.x*self->physicsParams.vel.y-toward.y*self->physicsParams.vel.x;
+    flex_t flight;
+    if (speed>=0 && fabsf(lateral)<0.035f &&
+        Bot_WaterLanding(self,wet,dry,speed,lateral,&flight)) {
+        bot.keys[INPUT_FUNC_JUMP]=1;
+        nav.waterExitPhase=2; nav.waterExitUntil=bot.now+flight+0.65f;
+    }
+}
+
+static int Bot_LiftMove(SithThing *self, int from, int to)
+{
+    int id=nav.liftForNode[to];
+    if (!id && from>=0) id=nav.liftForNode[from];
+    if (id<1 || id>nav.liftCount) return 0;
+    BotLift *lift=&nav.lifts[id-1]; SithThing *thing=Bot_NavThing(lift->thing);
+    if (!thing || thing->moveType!=SITH_MT_PATH || !thing->trackParams.aFrames || thing->trackParams.loadedFrames!=2) return 0;
+    int riding=(self->attach_flags&(SITH_ATTACH_THING|SITH_ATTACH_THINGFACE)) && self->attachedThing==thing;
+    int frame=(lift->node[1]==to || (nav.liftForNode[to]==0 && lift->node[1]==from)) ? 1 : 0;
+    if (!nav.liftWaitAt) nav.liftWaitAt=bot.now;
+    if (bot.now-nav.liftWaitAt>16.0f) {
+        bot.nodes[to].avoidUntil=bot.now+20; bot.goal=-1; bot.routeCount=0;
+        nav.liftWaitAt=0; nav.waitUntil=0; return 1;
+    }
+    if (bot.now>=bot.nextUse) {
+        bot.keys[INPUT_FUNC_ACTIVATE]=1; bot.nextUse=bot.now+1.2f;
+    }
+    int atStop=Bot_Distance(thing->position,thing->trackParams.aFrames[frame].pos)<0.07f;
+    if (riding) {
+        nav.waitUntil=bot.now+0.4f;
+        if (!atStop) { bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0; return 1; }
+        if (!nav.liftForNode[to]) {
+            nav.waitUntil=0; nav.liftWaitAt=0;
+            Bot_NavDirectMove(self,bot.nodes[to].pos,0);
+        } else {
+            Bot_NavDirectMove(self,bot.nodes[to].pos,0);
+        }
+        return 1;
+    }
+    /* Wait on the safe landing until the actual platform is present. */
+    if (!atStop) { nav.waitUntil=bot.now+0.4f; return 1; }
+    nav.waitUntil=0;
+    Bot_NavDirectMove(self,bot.nodes[to].pos,0);
+    return 1;
+}
+
+static int Bot_JoinMove(SithThing *self)
+{
+    if (!nav.ctf || !self->actorParams.pPlayer || self->actorParams.pPlayer->teamNum!=0) {
+        if (nav.crossingEntry) {
+            nav.crossingEntry=0; nav.crossingUntil=0; nav.waitUntil=0;
+            bot.goal=-1; bot.nextPlan=0;
+        }
+        return 0;
+    }
+    int index=nav.crossingEntry ? nav.crossingEntry-1 : nav.selectedEntry;
+    if (nav.objective!=BOT_OBJECTIVE_JOIN || index<0 || index>=nav.entryCount) return 0;
+    BotTeamEntry *entry=&nav.entries[index];
+    if (entry->team!=nav.requestedTeam || entry->node<0 || entry->node>=bot.nNodes) return 0;
+    if (nav.crossingEntry && bot.now>=nav.crossingUntil) {
+        bot.nodes[entry->node].avoidUntil=bot.now+8.0f;
+        nav.crossingEntry=0; nav.selectedEntry=-1; nav.waitUntil=0;
+        bot.goal=-1; bot.nextPlan=0; return 0;
+    }
+    if (!nav.crossingEntry) {
+        rdVector3 delta=Bot_Sub(bot.nodes[entry->node].pos,self->position);
+        if (Bot_Horizontal(delta)>0.18f || fabsf(delta.z)>0.20f ||
+            Bot_Horizontal(Bot_Sub(entry->inside,self->position))>1.0f ||
+            !sithIntersect_IsSphereInSector(&entry->inside,0.04f,entry->sector) ||
+            !Bot_Clear(self,self->sector,self->position,entry->inside,self->collideSize*0.85f,0)) return 0;
+        nav.crossingEntry=index+1; nav.crossingUntil=bot.now+1.25f;
+    }
+    nav.waitUntil=bot.now+0.2f;
+    if (self->sector==entry->sector) {
+        /* Wait for the ordinary server COG response after crossing. */
+        bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+        return 1;
+    }
+    Bot_Aim(self,entry->inside,0);
+    /* Only this bounded, verified stock trigger entrance bypasses the
+       ordinary floor-depth guard. It never walks toward the shaft bottom. */
+    Bot_NavDirectMove(self,entry->inside,0);
+    return 1;
+}
+
+static int Bot_StartForceJump(SithThing *self,BotNode *landing,flex_t flight,flex_t hold)
+{
+    if (!Bot_RequestForce(self,SITHBIN_F_JUMP,hold,-1)) return 0;
+    bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+    bot.keys[INPUT_FUNC_JUMP]=0;
+    nav.forceJumpPending=1; nav.forceChargeUntil=bot.now+hold;
+    nav.forceFlight=flight; nav.jumpTarget=landing->pos;
+    bot.nextJump=bot.now+hold+flight+0.25f;
+    bot.routeAim=1;
+    Bot_Aim(self,landing->pos,0);
+    return 1;
+}
+
+/* At the existing stuck deadline, consider a nearby upper foothold even when
+   the current lower anchor has no edge to it. Only a failed movement attempt
+   can trigger this search. Check at most four candidate landings per deadline. */
+static int Bot_RecoveryForceJump(SithThing *self,int waypoint)
+{
+    if (!bot.graphDone || (self->sector->flags&SITH_SECTOR_UNDERWATER) ||
+        !(self->attach_flags&SITH_ATTACH_SURFACE) || nav.objectiveValid || Bot_ObjectiveUrgent(self) ||
+        bot.forceBin>=0 || bot.forceCancel || bot.forceAvoid || bot.now<bot.nextForce ||
+        Bot_Horizontal(self->physicsParams.vel)>0.12f || !Bot_ForceReady(self,SITHBIN_F_JUMP,20)) return 0;
+    if (waypoint<0 && !bot.keys[INPUT_FUNC_JUMP] && !bot.keys[INPUT_FUNC_ACTIVATE] &&
+        fabsf(bot.axes[INPUT_FUNC_FORWARD])+fabsf(bot.axes[INPUT_FUNC_SLIDE])<0.1f) return 0;
+    int rank=(int)sithInventory_GetInventory(self,SITHBIN_F_JUMP);
+    if (rank<1 || rank>4) return 0;
+    int goal=bot.goal;
+    flex_t remaining=(goal>=0 && goal<bot.nNodes) ? Bot_Distance(self->position,bot.nodes[goal].pos) : -1;
+    int candidates[4]={-1,-1,-1,-1}; flex_t scores[4]={1e20f,1e20f,1e20f,1e20f};
+    for (int i=0;i<bot.nNodes;i++) {
+        BotNode *n=&bot.nodes[i]; rdVector3 delta=Bot_Sub(n->pos,self->position);
+        flex_t h=Bot_Horizontal(delta);
+        if (!Bot_SectorSafe(n->sector) || (n->sector->flags&SITH_SECTOR_UNDERWATER) || nav.liftForNode[i] ||
+            n->avoidUntil>bot.now || delta.z<=BOT_STEP_UP || delta.z>1.6f || h<0.16f || h>0.8f) continue;
+        flex_t score=h;
+        if (remaining>=0) {
+            flex_t next=Bot_Distance(n->pos,bot.nodes[goal].pos);
+            if (next>=remaining-0.05f) continue;
+            score+=next;
+        }
+        for (int j=0;j<4;j++) if (score<scores[j]) {
+            for (int k=3;k>j;k--) { scores[k]=scores[k-1]; candidates[k]=candidates[k-1]; }
+            scores[j]=score; candidates[j]=i; break;
+        }
+    }
+    BotNode actual={.pos=self->position,.sector=self->sector}; flex_t flight,hold=0.35f*rank;
+    for (int i=0;i<4 && candidates[i]>=0;i++) {
+        BotNode *landing=&bot.nodes[candidates[i]];
+        int drop=0;
+        if (Bot_Walkable(&actual,landing,&drop) || Bot_Jumpable(&actual,landing,&flight) ||
+            !Bot_FullForceJump(&actual,landing,hold,&flight)) continue;
+        /* Let the ordinary key hold cover the turn to the landing. */
+        rdVector3 d=Bot_Sub(landing->pos,self->position);
+        flex_t yaw=fabsf(atan2f(Bot_Dot(d,self->orient.rvec),Bot_Dot(d,self->orient.lvec))*BOT_DEG);
+        if (yaw>Bot_Max(0,hold-0.10f)*self->actorParams.maxRotVelocity*0.70f) continue;
+        if (Bot_StartForceJump(self,landing,flight,hold)) {
+            bot.goal=-1; bot.routeCount=0; bot.nextPlan=0;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Hold a reachable, supported shore after a breach. If the lip blocks
+   the underwater chord, rise through a checked column before stroking in. */
+static int Bot_ApproachShore(SithThing *self,const BotNode *bank)
+{
+    if ((bank->sector->flags&SITH_SECTOR_UNDERWATER) || Bot_Distance(self->position,bank->pos)>=0.9f) return 0;
+    if (Bot_WaterClear(self->sector,self->position,bank->pos,self->moveSize) &&
+        Bot_NavDirectMove(self,bank->pos,1)) {
+        bot.routeMode=BOT_ROUTE_SWIM; bot.routeAim=1; Bot_Aim(self,bank->pos,0);
+        return 1;
+    }
+    if (!(self->sector->flags&SITH_SECTOR_UNDERWATER)) return 0;
+    BotNode wet={.sector=self->sector,.pos=self->position};
+    rdVector3 surface;
+    if (!Bot_WaterSurface(&wet,self->moveSize,&surface)) return 0;
+    surface.z+=self->moveSize;
+    SithSector *air=Bot_SectorAt(&surface,self->sector);
+    if (!Bot_SectorSafe(air) || (air->flags&SITH_SECTOR_UNDERWATER) ||
+        !Bot_WaterClear(air,surface,bank->pos,self->moveSize)) return 0;
+    bot.routeMode=BOT_ROUTE_SWIM; bot.routeAim=1; Bot_Aim(self,bank->pos,0);
+    bot.keys[INPUT_FUNC_JUMP]=!(self->physicsParams.flags&SITH_PF_ONWATERSURFACE) || !bot.previous[INPUT_FUNC_JUMP];
+    return 1;
+}
+
+static void Bot_Navigate(SithThing *self)
+{
+    bot.followingRoute=1;
+    if (nav.combatJumpUntil>bot.now) {
+        if (!self->attach_flags) nav.combatJumpAirborne=1;
+        if ((self->attach_flags && (nav.combatJumpAirborne || bot.forceBin!=SITHBIN_F_JUMP)) ||
+            (self->sector->flags&SITH_SECTOR_UNDERWATER)) nav.combatJumpUntil=0;
+        else {
+            bot.axes[INPUT_FUNC_SLIDE]=bot.axes[INPUT_FUNC_FORWARD]=0;
+            if (self->attach_flags) bot.axes[INPUT_FUNC_TURN]=0;
+            return; /* Keep actual gun aim available through the ballistic coast. */
+        }
+    }
+    if (nav.waterExitUntil>0) { bot.routeMode=BOT_ROUTE_WATER_EXIT; bot.routeAim=1; Bot_ExitWaterMove(self); return; }
+    if (nav.seekingSurface && Bot_SeekSurface(self)) return;
+    /* On breaching the surface, keep swimming toward the dry landing which
+       brought us here. A nearest-anchor replan midair can send the swimmer
+       backward down its last underwater segment before reaching the bank. */
+    if (nav.diveEscape==BOT_DIVE_BANK && nav.diveBank>=0 && nav.diveBank<bot.nNodes &&
+        bot.now<nav.diveBankUntil && !nav.forceJumpPending && nav.jumpUntil<=bot.now) {
+        if (Bot_ApproachShore(self,&bot.nodes[nav.diveBank])) return;
+    }
+    if (Bot_JoinMove(self)) return;
+    if (nav.forceJumpPending) {
+        bot.routeMode=BOT_ROUTE_FORCEJUMP; bot.routeAim=1;
+        if (!(self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE)) &&
+            (bot.now<nav.forceChargeUntil || self->physicsParams.vel.z<=0)) {
+            /* Knockback can remove support mid-charge. Release the real key;
+               the stock script decides whether there is a takeoff. */
+            if (bot.forceBin==SITHBIN_F_JUMP) bot.forceUntil=bot.now;
+            nav.forceJumpPending=0; bot.goal=-1; bot.routeCount=0; bot.nextPlan=0;
+            return;
+        }
+        if (!self->attach_flags && bot.now>=nav.forceChargeUntil) {
+            nav.forceJumpPending=0; nav.jumpStarted=bot.now;
+            nav.jumpUntil=bot.now+nav.forceFlight+0.4f;
+        } else if (bot.now<nav.forceChargeUntil+0.35f) {
+            bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+            Bot_Aim(self,nav.jumpTarget,0); return;
+        } else {
+            nav.forceJumpPending=0; bot.goal=-1; bot.nextPlan=0;
+        }
+    }
+    if (nav.jumpUntil>bot.now) {
+        if (self->attach_flags && bot.now-nav.jumpStarted>0.2f) nav.jumpUntil=0;
+        else {
+            bot.routeAim=1;
+            Bot_Aim(self,nav.jumpTarget,0);
+            Bot_NavDirectMove(self,nav.jumpTarget,0);
+            return;
+        }
+    }
+    if (!Lily_Routing() && (bot.now>=bot.nextPlan || bot.goal<0 || bot.routePos>=bot.routeCount)) Bot_Plan(self);
+    if (Bot_JoinMove(self)) return;
+    if (bot.goal<0 || bot.routePos>=bot.routeCount) {
+        bot.axes[INPUT_FUNC_TURN]=0.35f;
+        if (self->sector->flags&SITH_SECTOR_UNDERWATER) bot.keys[INPUT_FUNC_JUMP]=1;
+        return;
+    }
+    int nodeIndex=bot.route[bot.routePos];
+    BotNode *node=&bot.nodes[nodeIndex];
+    rdVector3 d=Bot_Sub(node->pos,self->position);
+    int waitingForBank=!(self->attach_flags&SITH_ATTACH_SURFACE) &&
+        !(node->sector->flags&SITH_SECTOR_UNDERWATER) &&
+        ((self->sector->flags&SITH_SECTOR_UNDERWATER) ||
+         (bot.routePos>0 && (bot.nodes[bot.route[bot.routePos-1]].sector->flags&SITH_SECTOR_UNDERWATER)));
+    if (!waitingForBank && Bot_Horizontal(d)<0.11f && fabsf(d.z)<0.18f &&
+        (bot.routePos+1<bot.routeCount || !Bot_PickupNeedsContact(self,node) || Lily_Routing())) {
+        node->visited=bot.now;
+        if (bot.routePos+1>=bot.routeCount && Lily_Arrived(self,nodeIndex)) return;
+        if (bot.routePos+1>=bot.routeCount && bot.goal==nav.objectiveRouteNode && nav.objectiveValid) {
+            rdVector3 objectiveDelta=Bot_Sub(nav.objectivePos,self->position);
+            flex_t horizontal=Bot_Horizontal(objectiveDelta);
+            flex_t stop=nav.objective==BOT_OBJECTIVE_ESCORT ? 0.65f : nav.objective==BOT_OBJECTIVE_DEFEND ? 0.35f : 0.04f;
+            if (horizontal<stop && fabsf(objectiveDelta.z)<0.3f) {
+                nav.waitUntil=bot.now+0.3f;
+                bot.axes[INPUT_FUNC_TURN]=nav.objective==BOT_OBJECTIVE_DEFEND ? 0.12f : 0;
+                return;
+            }
+            if (horizontal<1.6f && fabsf(objectiveDelta.z)<0.4f &&
+                Bot_Clear(self,self->sector,self->position,nav.objectivePos,0.025f,1)) {
+                Bot_Aim(self,nav.objectivePos,0);
+                Bot_Move(self,objectiveDelta,0);
+                return;
+            }
+        }
+        bot.routePos++;
+        if (bot.routePos>=bot.routeCount) {
+            if (bot.goal>=0) bot.nodes[bot.goal].avoidUntil=bot.now+3.0f;
+            bot.goal=-1; bot.nextPlan=0; nav.liftWaitAt=0; return;
+        }
+        nodeIndex=bot.route[bot.routePos]; node=&bot.nodes[nodeIndex];
+        d=Bot_Sub(node->pos,self->position);
+    }
+    int mode=BOT_ROUTE_WALK;
+    int from=(bot.routePos>0) ? bot.route[bot.routePos-1] : Bot_Nearest(self);
+    if (from>=0) for (int i=0;i<bot.nodes[from].nEdges;i++) {
+        BotEdge *edge=&bot.nodes[from].edges[i];
+        if (edge->to==nodeIndex) { mode=edge->drop; break; }
+    }
+    if (bot.routePos==0 && from==nodeIndex && self->attach_flags && !nav.liftForNode[nodeIndex]) {
+        /* An unreached nearest anchor has no graph edge from the actual
+           player position. Validate that first segment instead of assuming
+           it is a walk; a small supported lip can require a normal jump. */
+        BotNode actual=*node; actual.pos=self->position; actual.sector=self->sector;
+        int drop=0; flex_t duration;
+        if (Bot_Walkable(&actual,node,&drop)) mode=drop ? BOT_ROUTE_DROP : BOT_ROUTE_WALK;
+        else if (Bot_Jumpable(&actual,node,&duration)) mode=BOT_ROUTE_JUMP;
+        else if (Bot_ForceReady(self,SITHBIN_F_JUMP,20)) {
+            flex_t hold;
+            if (Bot_ForceJumpProfile(&actual,node,(int)sithInventory_GetInventory(self,SITHBIN_F_JUMP),
+                                     &duration,&hold)) mode=BOT_ROUTE_FORCEJUMP;
+        }
+    }
+    if (mode==BOT_ROUTE_FORCEJUMP && self->attach_flags && self->sector==node->sector) {
+        BotNode actual={.pos=self->position,.sector=self->sector}; int drop=0;
+        if (Bot_Walkable(&actual,node,&drop) && !drop) mode=BOT_ROUTE_WALK;
+    }
+    bot.routeMode=mode;
+    bot.routeAim=mode==BOT_ROUTE_JUMP || mode==BOT_ROUTE_FORCEJUMP || mode==BOT_ROUTE_WATER_EXIT;
+    rdVector3 aim=node->pos;
+    if (mode!=BOT_ROUTE_SWIM) aim.z=self->position.z;
+    Bot_Aim(self,aim,0);
+    if (mode==BOT_ROUTE_WATER_EXIT && from>=0) {
+        if (bot.forceBin>=0 || bot.forceAvoid || bot.forceCancel) return;
+        flex_t flight;
+        if (Bot_WaterExitArc(&bot.nodes[from],node,&nav.waterExitStart,&flight)) {
+            nav.waterExitFrom=from; nav.waterExitTo=nodeIndex;
+            nav.waterExitPhase=0; nav.waterExitUntil=bot.now+4.0f;
+            Bot_ExitWaterMove(self);
+        } else { node->avoidUntil=bot.now+5; bot.goal=-1; bot.nextPlan=0; }
+        return;
+    }
+    if (Bot_EnterWater(self,node,mode,from)) return;
+    if (mode==BOT_ROUTE_SWIM || mode==BOT_ROUTE_WATER_ENTRY || (self->sector->flags&SITH_SECTOR_UNDERWATER)) {
+        /* Dijkstra omits the start anchor. At a portal the actual swimmer
+           may have to approach that anchor before the verified edge is clear. */
+        if (mode==BOT_ROUTE_SWIM && from>=0 && (bot.nodes[from].sector->flags&SITH_SECTOR_UNDERWATER) &&
+            !(node->sector->flags&SITH_SECTOR_UNDERWATER) && Bot_ApproachShore(self,node)) return;
+        int shore=(self->sector->flags^node->sector->flags)&SITH_SECTOR_UNDERWATER;
+        rdVector3 swimProbe=node->pos;
+        flex_t span=Bot_Distance(self->position,node->pos);
+        /* A surface stroke curves as buoyancy and dry gravity change. The
+           shoreline edge already has a full-body chord between its anchors.
+           Sweep this next stroke from the player's actual position too. */
+        if (shore && span>0.16f) swimProbe=Bot_Mix(self->position,node->pos,0.16f/span);
+        if (mode==BOT_ROUTE_SWIM &&
+            !Bot_WaterClear(self->sector,self->position,swimProbe,self->moveSize)) {
+            /* During a surface hop the next stroke can clip the lip while
+               falling in dry air. Keep the selected bank until landing or
+               reentry instead of marking it unreachable for this one frame. */
+            if (self->sector==node->sector && !(node->sector->flags&SITH_SECTOR_UNDERWATER) &&
+                !self->attach_flags && self->physicsParams.vel.z<0) return;
+            if (Bot_SeekSurface(self)) return;
+            if (from>=0 && from!=nodeIndex && bot.nodes[from].sector==self->sector &&
+                Bot_Distance(self->position,bot.nodes[from].pos)>0.025f &&
+                Bot_WaterClear(self->sector,self->position,bot.nodes[from].pos,self->moveSize)) {
+                Bot_Aim(self,bot.nodes[from].pos,0);
+                Bot_NavDirectMove(self,bot.nodes[from].pos,1);
+                return;
+            }
+            node->avoidUntil=bot.now+5; bot.goal=-1; bot.routeCount=0; bot.nextPlan=0;
+            return;
+        }
+        if (!Bot_NavDirectMove(self,node->pos,1)) Bot_SeekSurface(self);
+        return;
+    }
+    if (mode==BOT_ROUTE_LIFT && Bot_LiftMove(self,from,nodeIndex)) return;
+    nav.liftWaitAt=0;
+    if (mode==BOT_ROUTE_FORCEJUMP && from>=0 && (self->attach_flags&(SITH_ATTACH_SURFACE|SITH_ATTACH_THINGFACE)) && bot.now>=bot.nextJump) {
+        BotNode actual=*node; actual.pos=self->position; actual.sector=self->sector;
+        flex_t duration, hold, horizontal=Bot_Horizontal(d);
+        if (horizontal>0.001f && Bot_Dot(d,self->orient.lvec)/horizontal>0.65f &&
+            Bot_ForceJumpProfile(&actual,node,(int)sithInventory_GetInventory(self,SITHBIN_F_JUMP),&duration,&hold) &&
+            Bot_ForceReady(self,SITHBIN_F_JUMP,20)) {
+            bot.axes[INPUT_FUNC_FORWARD]=bot.axes[INPUT_FUNC_SLIDE]=0;
+            nav.waitUntil=bot.now+0.3f;
+            if (Bot_Horizontal(self->physicsParams.vel)>0.12f) return;
+            Bot_StartForceJump(self,node,duration,hold);
+            return;
+        }
+        if (!bot.forceEnabled || sithInventory_GetInventory(self,SITHBIN_FORCEMANA)<20) {
+            bot.goal=-1; bot.nextPlan=0; return;
+        }
+    }
+    if (mode==BOT_ROUTE_JUMP && from>=0 && self->attach_flags && bot.now>=bot.nextJump) {
+        BotNode actual=*node; /* Check the actual takeoff point, not just the graph edge. */
+        actual.pos=self->position; actual.sector=self->sector;
+        flex_t duration;
+        flex_t horizontal=Bot_Horizontal(d);
+        if (horizontal>0.001f && Bot_Dot(d,self->orient.lvec)/horizontal>0.65f &&
+            Bot_Jumpable(&actual,node,&duration)) {
+            bot.keys[INPUT_FUNC_JUMP]=1; bot.nextJump=bot.now+duration+0.5f;
+            nav.jumpTarget=node->pos; nav.jumpStarted=bot.now; nav.jumpUntil=bot.now+duration+0.4f;
+            Bot_NavDirectMove(self,node->pos,0); return;
+        }
+    }
+    Bot_Move(self,d,mode==BOT_ROUTE_DROP && self->actorParams.health>=30);
+}
diff --git a/src/AI/jkBotNavigation.inc b/src/AI/jkBotNavigation.inc
new file mode 100644
index 0000000000000000000000000000000000000000..6d823092ed8ff2a9eda571f9917727ed5b983ddd
--- /dev/null
+++ b/src/AI/jkBotNavigation.inc
@@ -0,0 +1,1528 @@
+/* Ordinary-input navigation; see jkBot.c for license.
+ * The graph is made from the loaded map, not a map-name waypoint lookup.
+ * CTF observes stock CTF_MAIN bindings and synchronized flag attachment state;
+ * every team selection, pickup, return and capture still comes from movement
+ * and the unchanged stock level COGs.
+ */
+#include <stdlib.h>
+#include "Primitives/rdModel3.h"
+
+enum { BOT_ROUTE_WALK, BOT_ROUTE_DROP, BOT_ROUTE_JUMP, BOT_ROUTE_SWIM, BOT_ROUTE_LIFT, BOT_ROUTE_FORCEJUMP, BOT_ROUTE_WATER_ENTRY, BOT_ROUTE_WATER_EXIT };
+enum { BOT_OBJECTIVE_NONE, BOT_OBJECTIVE_JOIN, BOT_OBJECTIVE_CAPTURE,
+       BOT_OBJECTIVE_RETURN, BOT_OBJECTIVE_RECOVER, BOT_OBJECTIVE_ESCORT,
+       BOT_OBJECTIVE_DEFEND, BOT_OBJECTIVE_INTERCEPT, BOT_OBJECTIVE_AIR };
+enum { BOT_ITEM_UNKNOWN, BOT_ITEM_WEAPON, BOT_ITEM_AMMO, BOT_ITEM_BACTA, BOT_ITEM_HEALTH,
+       BOT_ITEM_SHIELD, BOT_ITEM_MANA, BOT_ITEM_DAMAGE, BOT_ITEM_LIGHT,
+       BOT_ITEM_DARK, BOT_ITEM_REVIVE, BOT_ITEM_PACK, BOT_ITEM_KEY,
+       BOT_ITEM_SUPERSHIELD, BOT_ITEM_FLAG, BOT_ITEM_TOOL };
+
+enum { BOT_DIVE_NONE, BOT_DIVE_AIR, BOT_DIVE_BANK };
+
+enum { BOT_FAILED_DIVES = 8, BOT_DIVE_RETRY_SECONDS = 45, BOT_COSTLY_DIVE_SECONDS = 4 };
+/* Each recorded approach consumes a distinct supported-bank excursion lasting
+   at least four seconds. This holds every approach in one retry window. */
+enum { BOT_FAILED_APPROACHES = 1 + BOT_DIVE_RETRY_SECONDS / BOT_COSTLY_DIVE_SECONDS };
+typedef struct BotFailedApproach {
+    SithSector *bank, *water;
+    flex_t until;
+} BotFailedApproach;
+typedef struct BotDiveFailure {
+    int item; /* one-based thing slot */
+    uint32_t guid, signature;
+    flex_t until;
+} BotDiveFailure;
+
+typedef struct BotPickupKind { int kind, bin, ammo; flex_t cap; } BotPickupKind;
+typedef struct BotLift { int thing, node[2]; flex_t top; } BotLift;
+typedef struct BotTeamEntry { int team, node; rdVector3 inside; SithSector *sector; } BotTeamEntry;
+static struct {
+    int ctf, flag[2], base[2], mark[2], requestedTeam;
+    int objective, objectiveThing, objectiveTeam, objectiveValid;
+    rdVector3 objectivePos;
+    SithSector *objectiveSector;
+    int pursuitSlot;
+    uint32_t pursuitNet, pursuitGuid, pursuitSignature;
+    int objectiveRouteNode, itemNodes, missingItemNodes, truncated;
+    int liftCount, liftForNode[BOT_NODES];
+    BotLift lifts[64];
+    uint32_t itemGuid[BOT_NODES];
+    flex_t unavailableAt[BOT_NODES];
+    unsigned char unavailable[BOT_NODES];
+    flex_t waterSince, waitUntil, liftWaitAt, jumpUntil, jumpStarted, nextObjectiveLog;
+    flex_t jumpVelocity, maxRunSpeed;
+    int forceJumpKnown, forceJumpPending;
+    flex_t combatJumpUntil, nextCombatJump;
+    int combatJumpAirborne;
+    int hadBreathDebt, diveEscape, diveBank;
+    flex_t diveBankUntil, diveOverflowUntil;
+    BotDiveFailure failedDives[BOT_FAILED_DIVES];
+    struct {
+        SithSector *bank, *water;
+        flex_t enteredAt, latestRetry;
+        int enteredForGear, lastResortGoal; /* one-based dry exploration goal */
+        BotFailedApproach failed[BOT_FAILED_APPROACHES];
+    } supplyApproach;
+    int waterExitFrom, waterExitTo, waterExitPhase, seekingSurface;
+    rdVector3 waterExitStart;
+    flex_t waterExitUntil;
+    flex_t forceChargeUntil, forceFlight;
+    rdVector3 jumpTarget;
+    int loggedObjective, lastGoal, coverageTeam;
+    BotTeamEntry entries[16];
+    int entryCount, selectedEntry, crossingEntry;
+    flex_t crossingUntil;
+} nav;
+
+static int Bot_NameIs(const char *a, const char *b)
+{
+    if (!a || !b) return 0;
+    while (*a && *b) {
+        unsigned char ca=(unsigned char)*a++, cb=(unsigned char)*b++;
+        if (ca>='A' && ca<='Z') ca+=(unsigned char)('a'-'A');
+        if (cb>='A' && cb<='Z') cb+=(unsigned char)('a'-'A');
+        if (ca!=cb) return 0;
+    }
+    return !*a && !*b;
+}
+
+static int Bot_CogReference(sithCog *cog, const char *name)
+{
+#ifndef COG_CRC32_SYMBOL_NAMES
+    if (!cog || !cog->pSymbolTable || !cog->pSymbolTable->aSymbols) return -1;
+    SithCogSymbolTable *table=cog->pSymbolTable;
+    for (uint32_t i=0;i<table->numUsedSymbols && i<table->tableSize;i++) {
+        SithCogSymbol *symbol=&table->aSymbols[i];
+        if (symbol->pName && Bot_NameIs(symbol->pName,name) && symbol->val.type==COG_TYPE_INT)
+            return (int)symbol->val.data[0];
+    }
+#else
+    (void)cog; (void)name;
+#endif
+    return -1;
+}
+
+static SithThing *Bot_NavThing(int index)
+{
+    if (index<0 || index>=Bot_ThingCount()) return NULL;
+    SithThing *thing=&bot.world->aThings[index];
+    return thing->type!=SITH_THING_FREE && !(thing->flags&SITH_TF_DESTROYED) ? thing : NULL;
+}
+
+static void Bot_ReadCtfBindings(void)
+{
+    nav.ctf=0;
+    for (int i=0;i<bot.world->numCogs;i++) {
+        sithCog *cog=&bot.world->aCogs[i];
+#ifdef SITH_DEBUG_STRUCT_NAMES
+        if (!cog->pScript || !Bot_NameIs(cog->pScript->aName,"ctf_main.cog")) continue;
+#else
+        continue; /* Do not guess a CTF contract without its script identity. */
+#endif
+        int red=Bot_CogReference(cog,"flag_red"), gold=Bot_CogReference(cog,"flag_gold");
+        int redBase=Bot_CogReference(cog,"flag_ghost_red"), goldBase=Bot_CogReference(cog,"flag_ghost_gold");
+        int redMark=Bot_CogReference(cog,"mark_red"), goldMark=Bot_CogReference(cog,"mark_gold");
+        if (!Bot_NavThing(red) || !Bot_NavThing(gold) || !Bot_NavThing(redBase) || !Bot_NavThing(goldBase) ||
+            red==gold || redMark<0 || goldMark<0 || redMark>=bot.world->numSectors || goldMark>=bot.world->numSectors) continue;
+        nav.flag[0]=red; nav.flag[1]=gold; nav.base[0]=redBase; nav.base[1]=goldBase;
+        nav.mark[0]=redMark; nav.mark[1]=goldMark; nav.ctf=1;
+        fprintf(stderr,"BOT_CTF_BINDINGS map=%s red_flag=%d gold_flag=%d red_mark=%d gold_mark=%d team=%d\n",
+            bot.world->map_jkl_fname,red,gold,redMark,goldMark,nav.requestedTeam);
+        break;
+    }
+}
+
+static SithThing *Bot_FlagCarrier(int team)
+{
+    if (!nav.ctf || team<1 || team>2) return NULL;
+    SithThing *flag=Bot_NavThing(nav.flag[team-1]);
+    if (!flag || !(flag->attach_flags&(SITH_ATTACH_THING|SITH_ATTACH_THINGFACE|SITH_ATTACH_NOMOVE))) return NULL;
+    SithThing *carrier=flag->attachedThing;
+    /* Compare pointers with real roster entries before dereferencing attachment. */
+    for (unsigned int i=0;i<jkPlayer_maxPlayers && i<JKPLAYER_NUM_INFOS;i++) {
+        SithPlayer *p=&jkPlayer_playerInfos[i];
+        if ((p->flags&1) && p->playerNetId && p->pLocalPlayer && p->pLocalPlayer==carrier &&
+            carrier->type==SITH_THING_PLAYER && !(carrier->flags&(SITH_TF_DEAD|SITH_TF_DESTROYED|SITH_TF_DISABLED))) return carrier;
+    }
+    return NULL;
+}
+
+static int Bot_ObjectiveCarrier(SithThing *thing)
+{ return thing && nav.ctf && (Bot_FlagCarrier(1)==thing || Bot_FlagCarrier(2)==thing); }
+
+static int Bot_NeedsAir(SithThing *self)
+{
+    return self->sector && (self->sector->flags&SITH_SECTOR_UNDERWATER) &&
+        (self->actorParams.health<30 || self->actorParams.endurance>=8000 ||
+         (nav.waterSince>0 && bot.now-nav.waterSince>8.0f));
+}
+
+static int Bot_ObjectiveUrgent(SithThing *self)
+{
+    if (nav.diveEscape || Bot_NeedsAir(self)) return 1;
+    if (!nav.ctf || !self->actorParams.pPlayer) return 0;
+    int team=self->actorParams.pPlayer->teamNum;
+    return team==0 || (team>=1 && team<=2 && Bot_FlagCarrier(3-team)==self);
+}
+
+static int Bot_NavigationWaiting(SithThing *self)
+{ (void)self; return nav.waitUntil>bot.now || nav.jumpUntil>bot.now || nav.forceJumpPending || nav.waterExitUntil>bot.now; }
+
+static const char *Bot_ItemName(SithThing *item)
+{
+#ifdef SITH_DEBUG_STRUCT_NAMES
+    if (item->pTemplate) return item->pTemplate->aName;
+    return item->aName;
+#else
+    if (item->renderData.model3) return item->renderData.model3->filename;
+    return "";
+#endif
+}
+
+static BotPickupKind Bot_ClassifyPickup(const char *name)
+{
+    /* Stock template names and their original model basenames. No community
+       replacements or localized display text are assumed. */
+    static const struct { const char *name, *model; BotPickupKind pickup; } rows[]={
+        {"bryarpistol","bryp.3do",{BOT_ITEM_WEAPON,SITHBIN_BRYARPISTOL,SITHBIN_ENERGY,500}},
+        {"strifle","strp.3do",{BOT_ITEM_WEAPON,SITHBIN_STORMTROOPER_RIFLE,SITHBIN_ENERGY,500}},
+        {"crossbow","bowp.3do",{BOT_ITEM_WEAPON,SITHBIN_TUSKEN_PROD,SITHBIN_POWER,500}},
+        {"repeatergun","rptp.3do",{BOT_ITEM_WEAPON,SITHBIN_REPEATER,SITHBIN_POWER,500}},
+        {"railgun","rldp.3do",{BOT_ITEM_WEAPON,SITHBIN_RAIL_DETONATOR,SITHBIN_RAILCHARGES,30}},
+        {"concrifle","conp.3do",{BOT_ITEM_WEAPON,SITHBIN_CONCUSSION_RIFLE,SITHBIN_POWER,500}},
+        {"lightsaber","sabp.3do",{BOT_ITEM_WEAPON,SITHBIN_LIGHTSABER,0,1}},
+        {"detonator","detp.3do",{BOT_ITEM_AMMO,SITHBIN_THERMAL_DETONATOR,0,30}},
+        {"singledetonator","detp_1.3do",{BOT_ITEM_AMMO,SITHBIN_THERMAL_DETONATOR,0,30}},
+        {"seqcharge","seqp.3do",{BOT_ITEM_AMMO,SITHBIN_SEQUENCER_CHARGE,0,30}},
+        {"singleseqcharge","seqp_1.3do",{BOT_ITEM_AMMO,SITHBIN_SEQUENCER_CHARGE,0,30}},
+        {"energycell","ecel.3do",{BOT_ITEM_AMMO,SITHBIN_ENERGY,0,500}},
+        {"powercell","pcel.3do",{BOT_ITEM_AMMO,SITHBIN_POWER,0,500}},
+        {"railcharges","rcrg.3do",{BOT_ITEM_AMMO,SITHBIN_RAILCHARGES,0,30}},
+        {"bactatank","bact.3do",{BOT_ITEM_BACTA,SITHBIN_BACTATANK,0,5}},
+        {"healthpack","hepk.3do",{BOT_ITEM_HEALTH,0,0,100}},
+        {"shieldrecharge","shld.3do",{BOT_ITEM_SHIELD,SITHBIN_SHIELDS,0,200}},
+        {"fullshield","vest.3do",{BOT_ITEM_SHIELD,SITHBIN_SHIELDS,0,200}},
+        {"supershield","vestl.3do",{BOT_ITEM_SUPERSHIELD,SITHBIN_SUPERSHIELDS,0,1}},
+        {"manaboost","dark.3do",{BOT_ITEM_MANA,SITHBIN_FORCEMANA,0,400}},
+        {"powerboost","boost.3do",{BOT_ITEM_DAMAGE,SITHBIN_POWERBOOST,0,2}},
+        {"lightside","lite.3do",{BOT_ITEM_LIGHT,SITHBIN_S_LIGHT,0,1}},
+        {"darkside","mana1.3do",{BOT_ITEM_DARK,SITHBIN_S_DARK,0,1}},
+        {"revivepack","packrev.3do",{BOT_ITEM_REVIVE,SITHBIN_REVIVE,0,1}},
+        {"+backpack","bpck.3do",{BOT_ITEM_PACK,0,0,1}},
+        {"ctf_redkey","r-key.3do",{BOT_ITEM_KEY,SITHBIN_REDKEY,0,1}},
+        {"ctf_goldkey","y-key.3do",{BOT_ITEM_KEY,SITHBIN_GOLDKEY,0,1}},
+        {"ctf_redflag","flgr.3do",{BOT_ITEM_FLAG,81,0,1}},
+        {"ctf_goldflag","flgy.3do",{BOT_ITEM_FLAG,82,0,1}},
+        {"goggles","gogl.3do",{BOT_ITEM_TOOL,SITHBIN_IRGOGGLES,0,1}},
