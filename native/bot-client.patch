+static int Main_BotSafeName(const char *value, size_t maximum, const char *suffix)
+{
+    size_t length = value ? strlen(value) : 0;
+    if (!length || length > maximum) return 0;
+    for (size_t i = 0; i < length; ++i) {
+        unsigned char c = value[i];
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+              || (c >= '0' && c <= '9') || c == '_' || c == '-'
+              || (suffix && c == '.'))) return 0;
+    }
+    if (suffix) {
+        size_t n = strlen(suffix);
+        if (length <= n || __strcmpi(value + length - n, suffix)) return 0;
+        if (strchr(value, '.') != value + length - n) return 0;
+    }
+    return 1;
+}
+
+static int Main_BotSafeHost(const char *value)
+{
+    const char *colon;
+    size_t length = value ? strlen(value) : 0;
+    if (!length || length > 254) return 0;
+    for (size_t i = 0; i < length; ++i) {
+        unsigned char c = value[i];
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+              || (c >= '0' && c <= '9') || c == '-' || c == '.' || c == ':')) return 0;
+    }
+    colon = strchr(value, ':');
+    if (colon) {
+        unsigned port = 0;
+        if (colon == value || !colon[1]) return 0;
+        for (const char *c = colon + 1; *c; ++c) {
+            if (*c < '0' || *c > '9') return 0;
+            port = port * 10 + (unsigned)(*c - '0');
+            if (port > 65535) return 0;
+        }
+        if (!port) return 0;
+    }
+    return 1;
+}
+
+static void Main_BotArg(char *destination, size_t capacity, const char *value)
+{
+    if (destination[0] || !value || !value[0] || strlen(value) >= capacity) {
+        fprintf(stderr, "BOT_JOIN_REJECTED invalid or repeated bot option\n");
+        exit(6);
+    }
+    stdString_SafeStrCopy(destination, value, capacity);
+}
