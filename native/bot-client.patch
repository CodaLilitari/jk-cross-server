+    jkPlayer_fpslimit = 30;
+    jkPlayer_SetMpcInfo(name, Main_botModel, Main_botSound,
+                        "sabergreen1.mat", "sabergreen0.mat");
+    for (int i = SITHBIN_FP_START; i <= SITHBIN_FP_END; ++i)
