+/* Configure an isolated saved character after discovering the actual host
+ * rank, before the ordinary world/join lifecycle loads its inventory. */
+static int jkGuiMultiplayer_BotCharacter(int rank)
+{
+    const char *side = getenv("JK_BOT_FORCE_SIDE");
+    const char *style = getenv("JK_BOT_FORCE_STYLE");
+    int dark = side && !strcmp(side, "dark");
+    int master = style && !strcmp(style, "master");
+    jkBotLoadout plan;
+    if ((side && strcmp(side, "dark") && strcmp(side, "light")) ||
+        (style && strcmp(style, "balanced") && strcmp(style, "master")) ||
+        !jkBotLoadout_Plan(rank, dark, master, &plan)) return 0;
+    _Static_assert(SITHBIN_F_JUMP == 21 && SITHBIN_F_HEALING == 25 &&
+                   SITHBIN_F_THROW == 30 && SITHBIN_F_DEADLYSIGHT == 34,
+                   "Saved character planner requires original JK inventory bins");
+    for (int bin = SITHBIN_F_JUMP; bin <= SITHBIN_F_DEADLYSIGHT; ++bin)
+        sithPlayer_SetInvItemAmount(bin, (flex_t)plan.stars[bin]);
+    jkPlayer_SetRank(rank);
+    jkPlayer_SetChoice(0);
+    sithPlayer_SetInvItemAmount(SITHBIN_NEW_STARS, 0);
+    sithPlayer_SetInvItemAmount(SITHBIN_SPEND_STARS, (flex_t)plan.unspent);
+    jkPlayer_SetAccessiblePowers(rank);
+    jkPlayer_SetProtectionDeadlysight();
+    jkPlayer_DisallowOtherSide(rank);
+    jkPlayer_InitForceBins();
+    jkPlayer_CalcAlignment(1);
+    if (!jkPlayer_MPCWrite(NULL, jkPlayer_playerShortName, jkPlayer_name) ||
+        !jkPlayer_MPCParse(&jkGuiMultiplayer_mpcInfo, NULL,
+                          jkPlayer_playerShortName, jkPlayer_name, 1)) return 0;
+    fprintf(stderr, "BOT_LOADOUT rank=%d side=%s style=%s spent=%d remaining=%d\n",
+            rank, dark ? "dark" : "light", master ? "master" : "balanced",
+            rank*3-plan.unspent, plan.unspent);
+    fflush(stderr);
+    return 1;
+}
+
+/* Ordinary native client discovery/open path with only its GUI replaced. */
+int jkGuiMultiplayer_BotConnect(const char *endpoint)
+{
+#ifdef SDL2_RENDER
+    uint32_t started = stdPlatform_GetTimeMsec();
+    jkMultiEntry entry;
+    char16_t password[32] = {0};
+    stdString_CharToWchar(jkGuiMultiplayer_ipText, endpoint, 255);
+    jkGuiMultiplayer_ipText[255] = 0;
+    if (stdComm_OpenConnection(NULL)) return 0;
+    for (;;) {
+        if (stdComm_EnumSessions(1, password)) return 0;
+        if (dplay_dword_55D618 > 0) break;
+        if ((uint32_t)(stdPlatform_GetTimeMsec() - started) > 30000) {
+            fprintf(stderr, "BOT_JOIN_REJECTED discovery timeout\n");
+            exit(6);
+        }
+        SDL_Delay(100);
+    }
+    entry = jkGuiMultiplayer_aEntries[0];
+    int isCtf = !__strcmpi(entry.episodeGobName, "JK1CTF");
+    int allowedModes = MULTIMODEFLAG_TEAMS | MULTIMODEFLAG_2 | MULTIMODEFLAG_4 |
+        MULTIMODEFLAG_TIMELIMIT | MULTIMODEFLAG_SCORELIMIT | MULTIMODEFLAG_20 |
+        MULTIMODEFLAG_SINGLE_LEVEL | MULTIMODEFLAG_100;
+    if ((!isCtf && __strcmpi(entry.episodeGobName, "JK1MP")) || entry.field_E0 != 10 ||
+        entry.maxRank < 0 || entry.maxRank > 8
+        || entry.wPassword[0] || (entry.sessionFlags & (SESSIONFLAG_PASSWORD | SESSIONFLAG_20))
+        || (entry.multiModeFlags & ~allowedModes) ||
+        (!isCtf && (entry.multiModeFlags & MULTIMODEFLAG_TEAMS) &&
+         !(entry.multiModeFlags & MULTIMODEFLAG_100))) {
+        fprintf(stderr, "BOT_JOIN_REJECTED requires open stock JK1MP or JK1CTF, rank 0..8; team deathmatch requires team skins\n");
+        exit(6);
+    }
+    if (!jkGuiMultiplayer_BotCharacter(entry.maxRank)) {
+        fprintf(stderr, "BOT_JOIN_REJECTED cannot prepare legal saved character\n");
+        exit(6);
+    }
+    /* Open uses the discovered native transport and its genuine player ID. */
+    if (stdComm_Open(0, password)) return 0;
+    sithMulti_multiModeFlags = entry.multiModeFlags;
+    sithMulti_InitTick(entry.tickRateMs);
+    return jkMain_loadFile2(entry.episodeGobName, entry.mapJklFname);
+#else
+    (void)endpoint;
+    return 0;
+#endif
+}
